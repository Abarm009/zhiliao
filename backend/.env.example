# Copy to .env only when configuring real model calls. No credentials included.
# Use your provider's supported OpenAI-compatible URL and model identifier.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Empty values retain the inherited backend defaults; set all three explicitly.
# Local embeddings are deterministic fallback vectors, not API-quality semantics.
WAGENT_EMBEDDING=local
# The provided launcher defaults to the small demonstration dataset.
WAGENT_OPS_SIMSEED=0
