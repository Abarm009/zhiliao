[
  {
    "start": 0,
    "end": 6,
    "text": "知了维修协作，贯通报修、处置与验收。"
  },
  {
    "start": 6,
    "end": 12,
    "text": "报修、接单、完工验收，按任务推进。"
  },
  {
    "start": 12,
    "end": 17,
    "text": "演示涵盖报修人、技工和项目经理。"
  },
  {
    "start": 17,
    "end": 22,
    "text": "填写报修描述，选择空间与任务类别。"
  },
  {
    "start": 22,
    "end": 27,
    "text": "提交报修草稿，进入待接单状态。"
  },
  {
    "start": 27,
    "end": 32,
    "text": "技工查看与自身技能匹配的维修任务。"
  },
  {
    "start": 32,
    "end": 37,
    "text": "技工接单后，任务进入已接单状态。"
  },
  {
    "start": 37,
    "end": 42,
    "text": "绑定设备并预约，等待报修人确认。"
  },
  {
    "start": 42,
    "end": 47,
    "text": "经理查看项目任务，协调维修安排。"
  },
  {
    "start": 47,
    "end": 52,
    "text": "预约确认后，技工按约到场处置。"
  },
  {
    "start": 52,
    "end": 57,
    "text": "提交维修证据，由报修人独立验收。"
  },
  {
    "start": 57,
    "end": 62,
    "text": "验收未通过，退回重做并补充证据。"
  },
  {
    "start": 62,
    "end": 67,
    "text": "验收通过后，维修任务完成。"
  },
  {
    "start": 67,
    "end": 72,
    "text": "原生应用采用石墨主题与分步布局。"
  },
  {
    "start": 72,
    "end": 77,
    "text": "原生入口按角色组织任务操作步骤。"
  },
  {
    "start": 77,
    "end": 82,
    "text": "持续跟进，独立验收。"
  }
]