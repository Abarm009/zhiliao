fn m6_cmd_invalidate(task_id){
    let n = m6_invalidate_for_task(task_id, "manual_ui")
    // D-M6-02 (r7)：拒写时显示准确失败，不显示「已失效」完成文案。
    if n > 0 && STATE.m6_followups_last_save_ok == false {
        STATE.status = n.to_string() + " 条旧提醒已失效（内存），但保存失败未落盘，待重试"
    } else {
        STATE.status = "已失效 " + n.to_string() + " 条旧提醒"
    }
    saveState()
    refreshDesktop()
}
