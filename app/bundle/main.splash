             m6_search_input: nil,              // 由 refreshDesktop 注入；M6 用 ui.<m6_search_input>.text() 读
             m6_cmd_arg_by_run: {},             // runAction 子命令的字符串参数（fu_id / task_id 等）
             m6_follow_ups: [],                 // [{fu_id,task_id,role,kind,due_ms,payload_summary,created_ms,status}]
             m6_follow_ups_index: {},           // fu_id -> index (重建)
