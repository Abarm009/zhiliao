fn appleRoleText(user){
    if user.id == "" { return "" }
    let result = ""
    if hasRole(user, STATE.project, "REPORTER") { result = "报修人" }
    if hasRole(user, STATE.project, "TECHNICIAN") {
        if result != "" { result = result + " / " }
        result = result + "技工"
    }
    if hasRole(user, STATE.project, "MANAGER") {
        if result != "" { result = result + " / " }
        result = result + "项目经理"
    }
    if result == "" { result = "无当前项目角色" }
    return result
}
fn appleRefreshPages(user){
    let signed_in = user.id != ""
    // Hide the outgoing page first; never reveal the workbench before identity validation.
    if signed_in {
        APPLE_REFRESH_STAGE = "appleRefreshPages:login_page"
        ui.login_page.set_visible(false)
        APPLE_REFRESH_STAGE = "appleRefreshPages:workbench_page"
        ui.workbench_page.set_visible(true)
    } else {
        APPLE_REFRESH_STAGE = "appleRefreshPages:workbench_page"
        ui.workbench_page.set_visible(false)
        APPLE_REFRESH_STAGE = "appleRefreshPages:login_page"
        ui.login_page.set_visible(true)
    }
    let drafting = STATE.panel == "draft"
    APPLE_REFRESH_STAGE = "appleRefreshPages:detail_overview_page"
    ui.detail_overview_page.set_visible(!drafting)
    APPLE_REFRESH_STAGE = "appleRefreshPages:draft_editor_page"
    ui.draft_editor_page.set_visible(drafting)
    APPLE_REFRESH_STAGE = "appleRefreshPages:header_role"
    let role_text = appleRoleText(user)
    ui.header_role.set_text(role_text)
    APPLE_REFRESH_STAGE = "appleRefreshPages:header_actor"
    ui.header_actor.set_text(user.name)
    APPLE_REFRESH_STAGE = "appleRefreshPages:draft_feedback"
    ui.draft_feedback.set_text(appleFeedbackText(STATE.status))
    let current = selectedTask()
    APPLE_REFRESH_STAGE = "appleRefreshPages:detail_empty_state"
    ui.detail_empty_state.set_visible(current == nil)
    APPLE_REFRESH_STAGE = "appleRefreshPages:detail_selected_content"
    ui.detail_selected_content.set_visible(current != nil)
    APPLE_REFRESH_STAGE = "appleRefreshPages:empty_selection_hint"
    ui.empty_selection_hint.set_text(appleEmptySelectionText())
    APPLE_REFRESH_STAGE = "appleRefreshPages:main_action_slot"
    ui.main_action_slot.set_visible(current != nil)
    APPLE_REFRESH_STAGE = "appleRefreshPages:task_operations_page"
    ui.task_operations_page.set_visible(current != nil)
    let secondary_count = 0
    if current != nil { secondary_count = secondaryActions(current, user).len() }
    APPLE_REFRESH_STAGE = "appleRefreshPages:secondary_slot_1"
    ui.secondary_slot_1.set_visible(secondary_count >= 1)
    APPLE_REFRESH_STAGE = "appleRefreshPages:secondary_slot_2"
    ui.secondary_slot_2.set_visible(secondary_count >= 2)
}

fn refreshDesktop(){
    appleRefreshPages(getMe())
    APPLE_REFRESH_STAGE = "refreshDesktop:login_hint"
    // D-M2-01/D-M2-07 (r10)：启动恢复/冻结错误在**当前可见**界面给出真实出口 ——
    // 未登录时只有登录页可见，恢复告警必须出现在 login_hint，不能只落在认证后
    // 才刷新的状态行。
    let _lh_text = appleAuthText()
    // A-M4-R13-01 (r12)：任务盘恢复未决说明接入既有登录反馈出口（复用既有
    // m7_tasks_mark_corrupt 写入 STATE.status 的说明：原因/备份路径/副本摘要；
    // 不加页面/控件/字段）。
    if STATE.tasks_pending_recovery == true {
        let _tr_text = STATE.status
        if _tr_text == nil || _tr_text == "" { _tr_text = m7_tasks_banner_text() }
        if _tr_text != "" { _lh_text = "⚠ " + _tr_text + "\n" + _lh_text }
    }
    if M2_RECOVERY_NOTICE != "" { _lh_text = "⚠ " + M2_RECOVERY_NOTICE + "\n" + _lh_text }
    ui.login_hint.set_text(_lh_text)
    APPLE_REFRESH_STAGE = "refreshDesktop:login_submit_btn"
    if AUTH_JOB != nil { ui.login_submit_btn.set_text("正在登录…") }
    else { ui.login_submit_btn.set_text("登录") }
    appleRefreshTaskHeading()
    appleRefreshPresentation()
    let t = selectedTask()
    APPLE_REFRESH_STAGE = "refreshDesktop:header_project"
    ui.header_project.set_text("")
    APPLE_REFRESH_STAGE = "refreshDesktop:scope_note"
    ui.scope_note.set_text(filteredVisibleIndices().len().to_string() + " 项任务 · " + m6_unread_follow_ups().len().to_string() + " 条提醒")
    APPLE_REFRESH_STAGE = "refreshDesktop:visible_count"
    ui.visible_count.set_text("")
    // M1 r2 修复 D-M1-01：详情页签通过共享 detail_panel 内的命名 Label 切换，
    // 页签仍共享文本面板；登录/报修页面容器另由 appleRefreshPages 切换。
    refreshTaskList()
    refreshDetail()
    refreshActionArea()
    refreshListPickIds()
    // 二级（已选详情）状态行仍写 status_line
    APPLE_REFRESH_STAGE = "refreshDesktop:status_line"
    ui.status_line.set_text(appleFeedbackText(STATE.status))
}

// tick：1Hz 周期复算
let _ZH_RESTORED = false
fn tick(){
    // D-M2-01 (r9 修复轮)：启动时 state.json 读失败（时序/暂不可用）则每个
    // tick 重试并入；期间 saveState 拒写已有文件，偏好不被默认空值覆盖。
    if !_VIEW_STATE_OK { loadViewState() }
    // D-M3-02 (r7)：冷启动后一次性把持久化的未提交原文恢复到 TASK_INPUT
    // 与真实 zh_input 控件（视图安装后 ui.* 才可用，故放在首个 tick）。
    // D-M3-02 (r8)：catch _ 绑定形式在本宿主实测会报
    // "variable _ not found in scope"，改用 bare catch；只在控件实际恢复
    // 成功后置 _ZH_RESTORED，失败保留下个 tick 重试且原文不清空。
    if !_ZH_RESTORED {
        if STATE.pending_input != nil && STATE.pending_input != "" {
            let _restore_ok = true
            if TASK_INPUT.raw_text == "" {
                TASK_INPUT.raw_text = STATE.pending_input
                TASK_INPUT.raw_input_version = TASK_INPUT.raw_input_version + 1
                TASK_INPUT.raw_text_hash = hashRawText(STATE.pending_input)
                TASK_INPUT.last_edit_at_ms = nowMs()
            }
            try {
                if ui.zh_input.text() == "" { ui.zh_input.set_text(STATE.pending_input) }
            } catch {
                _restore_ok = false
                STATE.status = "输入恢复重试中：控件暂未就绪，原文已保留"
            }
            if _restore_ok { _ZH_RESTORED = true }
        } else {
            _ZH_RESTORED = true
        }
    }
    let t = selectedTask()
    // B-M4-01 (r7)：周期刷新整体隔离异常——单次刷新失败不进入 1Hz 错误循环，
    // 也不阻断后续 tick；视图未安装窗口期 ui.* 不可用时同样安全跳过。
    // M7 r7 (R-M7-02)：catch _ 绑定形式在本宿主实测异常真实发生时报
    // "variable _ not found in scope"（30 条/场错误循环的来源）；改为无绑定
    // bare catch，并保留可见诊断与计数，不吞错、不假就绪。
    try {
        APPLE_REFRESH_STAGE = "tick:refreshLabels"
        refreshLabels(t)
        refreshDesktop()
        APPLE_REFRESH_STAGE = "tick:complete"
    } catch {
        APPLE_REFRESH_ERROR_STAGE = APPLE_REFRESH_STAGE
        if STATE.tick_exception_count == nil { STATE.tick_exception_count = 0 }
        STATE.tick_exception_count = STATE.tick_exception_count + 1
        STATE.status = "周期刷新异常已隔离（累计 " + STATE.tick_exception_count.to_string() + " 次）：界面可能未更新，业务数据未写"
    }
}

// ─── M2 r7 集中初始化块（D-M2-01/D-M2-07 修复）─────────────
// 发行宿主按定义顺序解析顶层语句：所有 fn 与命名 widget 全局均已定义，
// 此处才允许执行 load/迁移/对账/选中初始化。顺序固定：
// load → model → forms → 启动对账 → 选中兜底 → 落盘。
load()
loadModelConfig()
m4_init_forms()
bootReconcilePending()
// D-M2-03 (r11)：H4 恢复屏障 —— 启动时消费 tx 索引中"有提交决定但无已绑定
// applied 标记"的事务，幂等补完投影；未登录保持未决并阻断业务写。
hf_recover_commits()
_m1_init_selection()
saveState()

// Credential material is kept only in AUTH_JOB; callback never logs or persists it.
// r4: K=1; floor(0.60*200000/94570)=1. Shorten scheduling only; each evaluation keeps 52.7% headroom.
start_interval(0.005, || authTick())
start_interval(1.0, || tick())
// D-M3-01 修复(r7)：顶层不再直接 refreshDesktop()（视图未安装前 ui.* 不可用）；
// 首次刷新由 1Hz tick 完成。

// D-M3-01 修复(r7)：根视图作为脚本最后一个顶层表达式返回（宿主取末位值挂载）。
root
