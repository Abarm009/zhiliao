}
// D-M6-03 (r6)：既定桌面触发 —— 详情面板「设备历史」「阶段说明」两链的人工触发。
// 成功：建议写入 m6_history_view（人工采纳位，不写业务）；失败：status 给出人工出口。
fn m6_cmd_request_history(){
    let t = currentTask()
    if t == nil { STATE.status = "请先选择任务"; refreshDesktop(); return }
    let res = m6_request_device_history(t, nil)
    // D-M6-03 (r8)：视图缓存携带主体/项目/任务事实版本/到期/出处上下文，
    // 供重开与渲染重核；缺上下文即不可恢复为建议。
    let _hv_ctx_req = ""
    let _hv_ctx_exp = 0
    let _res_rid = nil
    try { _res_rid = res.request_id } catch { _res_rid = nil }
    if _res_rid != nil && _res_rid != "" {
        _hv_ctx_req = _res_rid
        _hv_ctx_exp = PENDING_AI_REQUEST.expires_at_ms
    }
    if res.success {
        // D-M6-03 (r7)：保存并渲染真实 items 正文与合法依据（request_id / 引用），
        // 不再存「模型已返回」固定文案；零有效条目视为未知。
        // D-M6-03 (r10)：引用按结构化 ref_type/ref_id 字段保存（不再只拼进 source
        // 字符串），load/render 可逐条按当前权限重核；缓存带事实/证据版本快照，
        // 事实或证据变化即失效。
        let _its = []
        let _vi = 0
        while _vi < res.items.len() {
            let _it = res.items[_vi]
            let _irt = ""
            let _iri = ""
            try { if _it.ref_type != nil { _irt = _it.ref_type } } catch { _irt = "" }
            try { if _it.ref_id != nil { _iri = _it.ref_id } } catch { _iri = "" }
            _its.push({kind: "suggestion",
                       text: _truncate(_it.text, 200),
                       source: "model · request_id=" + (res.request_id or "") + " · ref=" + (_it.ref_type or "?") + "/" + (_it.ref_id or "?"),
                       ref_type: _irt, ref_id: _iri,
                       refs: [m6_ref_snapshot(_irt, _iri)]})
            _vi = _vi + 1
        }
        // D-M6-03 (r10)：缓存保存实际送入模型的历史来源集合快照（逐来源任务
        // 版本/证据版本）；load/render 按同一集合重核，来源变化即失效。
        let _hv_sources = []
        try { if res.sources != nil { _hv_sources = res.sources } } catch { _hv_sources = [] }
        let _hv_fv = _currentFactsVersion()
        let _hv_ev = _currentEvidenceVersion(t.id)
        if _its.len() == 0 {
            STATE.m6_history_view = {task_id: t.id, kind: "none", ts: nowMs(), items: [],
                actor: sessionActor(), project: STATE.project, task_version: t.version,
                request_id: _hv_ctx_req, expires_at_ms: _hv_ctx_exp,
                facts_version: _hv_fv, evidence_version: _hv_ev,
                source_versions: _hv_sources}
            STATE.status = "模型返回无有效设备历史建议（视为未知）；人工出口：可点「存为手工历史备注」"
        } else {
            STATE.m6_history_view = {task_id: t.id, kind: "device", ts: nowMs(), items: _its,
                actor: sessionActor(), project: STATE.project, task_version: t.version,
                request_id: _hv_ctx_req, expires_at_ms: _hv_ctx_exp,
                facts_version: _hv_fv, evidence_version: _hv_ev,
                source_versions: _hv_sources}
            STATE.status = "设备历史建议已返回 " + _its.len().to_string() + " 条（request_id=" + (res.request_id or "") + "）；请人工核对后采纳（模型不直接写业务）"
        }
        // D-M6-03 (r8)：消费保存结果 —— 保存失败如实覆盖成功文案，不显示「已保存」。
        if !m6_save_history_view() {
            STATE.status = "设备历史建议已返回但保存失败（待重试；内容仅在当前会话可见，未落盘）"
        }
    } else {
        STATE.m6_history_view = {task_id: t.id, kind: "none", ts: nowMs(), items: [],
            actor: sessionActor(), project: STATE.project, task_version: t.version,
            request_id: _hv_ctx_req, expires_at_ms: _hv_ctx_exp,
            facts_version: _currentFactsVersion(), evidence_version: _currentEvidenceVersion(t.id),
            source_versions: []}
        m6_save_history_view()
        STATE.status = "设备历史建议未获得（" + res.kind + "）：" + res.msg + "；人工出口：可点「存为手工历史备注」"
    }
    STATE.detail_tab = "history"
    refreshDesktop()
}
fn m6_cmd_request_phase(){
    let t = currentTask()
    if t == nil { STATE.status = "请先选择任务"; refreshDesktop(); return }
    let res = m6_request_phase_meaning(t, nil)
    let _hv_ctx_req = ""
    let _hv_ctx_exp = 0
    let _res_rid = nil
    try { _res_rid = res.request_id } catch { _res_rid = nil }
    if _res_rid != nil && _res_rid != "" {
        _hv_ctx_req = _res_rid
        _hv_ctx_exp = PENDING_AI_REQUEST.expires_at_ms
    }
    if res.success {
        // D-M6-03 (r7)：渲染真实 phase 正文 + request_id 依据；不写业务。
        // D-M6-03 (r10 修复轮，对 r11 Review D03-B)：保留全部结构化 refs（不再压成
        // 第一个）并带逐引用来源快照；模型缺引用时不替代成本任务 ID 制造合法来源，
        // 按未知处理（kind=none + 人工出口）。
        let _res_refs = nil
        try { _res_refs = res.refs } catch { _res_refs = nil }
        let _refs_ok = false
        if _res_refs != nil && m7_is_array_value(_res_refs) && _res_refs.len() > 0 { _refs_ok = true }
        if !_refs_ok {
            STATE.m6_history_view = {task_id: t.id, kind: "none", ts: nowMs(), items: [],
                actor: sessionActor(), project: STATE.project, task_version: t.version,
                request_id: _hv_ctx_req, expires_at_ms: _hv_ctx_exp,
                facts_version: _currentFactsVersion(), evidence_version: _currentEvidenceVersion(t.id),
                source_versions: []}
            m6_save_history_view()
            STATE.status = "阶段建议缺可核依据（模型未给出来源引用，视为未知），正文不落；人工出口：可点「存为手工阶段说明」"
            STATE.detail_tab = "phase"
            refreshDesktop()
            return
        }
        let _prft = "task"
        let _prfi = t.id
        let _r0 = _res_refs[0]
        try { if _r0.ref_type != nil && _r0.ref_type != "" { _prft = _r0.ref_type } } catch { }
        try { if _r0.ref_id != nil && _r0.ref_id != "" { _prfi = _r0.ref_id } } catch { }
        STATE.m6_history_view = {task_id: t.id, kind: "phase", ts: nowMs(),
            items: [{kind: "suggestion", text: _truncate(res.phase_text, 200),
                     source: "model · request_id=" + (res.request_id or "") + " · refs=" + _res_refs.len().to_string() + " · first=" + _prft + "/" + _prfi,
                     ref_type: _prft, ref_id: _prfi,
                     refs: _res_refs}],
            actor: sessionActor(), project: STATE.project, task_version: t.version,
            request_id: _hv_ctx_req, expires_at_ms: _hv_ctx_exp,
            facts_version: _currentFactsVersion(), evidence_version: _currentEvidenceVersion(t.id),
            // D-M6-03 (r11 修复轮，对 r12 Review D03-B1)：阶段自身来源与历史来源
            // 集合统一 schema（task_id/task_version/evidence_version）；不再用
            // ref_type/ref_id 引用结构充当来源，避免来源闸误拒。
            source_versions: [hf_source_version(t.id, t.version, _currentEvidenceVersion(t.id))]}
        // D-M6-03 (r8)：消费保存结果 —— 失败如实覆盖成功文案。
        if !m6_save_history_view() {
            STATE.status = "阶段建议已返回但保存失败（待重试；内容仅在当前会话可见，未落盘）"
        } else {
            STATE.status = "阶段建议已返回：" + _truncate(res.phase_text, 60) + "（建议需人工采纳，模型不写业务）"
        }
    } else {
        STATE.m6_history_view = {task_id: t.id, kind: "none", ts: nowMs(), items: [],
            actor: sessionActor(), project: STATE.project, task_version: t.version,
            request_id: _hv_ctx_req, expires_at_ms: _hv_ctx_exp,
            facts_version: _currentFactsVersion(), evidence_version: _currentEvidenceVersion(t.id),
            source_versions: []}
        m6_save_history_view()
        STATE.status = "阶段建议未获得（" + res.kind + "）：" + res.msg + "；人工出口：可点「存为手工阶段说明」继续"
    }
    STATE.detail_tab = "phase"
    refreshDesktop()
}
// D-M6-03 (r7)：建议视图持久化（sandbox 内，不写业务库；模型/人工内容均只作建议）。
fn m6_history_view_path(){
    return STATE.m6_sandbox_root + "/m6_history_view.json"
}
fn m6_save_history_view(){
    // D-M6-03 (r8)：返回真实保存结果（写后读回逐字节核实），caller 据此如实反馈，
    // 不再「写未抛异常即成功」。
    let _hv_ok = true
    let _body = STATE.m6_history_view.to_json()
    try { fs.write(m6_history_view_path(), _body) } catch _ { _hv_ok = false }
    if _hv_ok {
        let _rb = nil
        try { _rb = fs.read(m6_history_view_path()) } catch { _rb = nil }
        if _rb == nil || _rb != _body { _hv_ok = false }
    }
    STATE.m6_history_dirty = !_hv_ok
    if !_hv_ok { STATE.status = "建议视图保存失败，待重试：" + m6_history_view_path() }
    return _hv_ok
}
// D-M6-03 (r10)：建议缓存共享重核 —— load 与 render 双闸共用。
// 条目级：kind 仅允许 suggestion|manual；suggestion 必须带结构化 ref_type/ref_id
// 且按当前身份/项目/权限重核可见（撤权/跨项目/不存在即拒）；manual 必须空引用
// （显式人工 schema，不与模型建议混同）。返回 "" 通过，否则拒绝原因。
fn m6_history_items_recheck(items, t){
    if t == nil { return "no_task" }
    if items == nil { return "items_missing" }
    let i = 0
    while i < items.len() {
        let it = items[i]
        if it == nil || !m7_is_object_value(it) { return "item_not_object" }
        let _k = nil
        try { _k = it.kind } catch { _k = nil }
        if _k == "suggestion" {
            let _rt = nil
            let _ri = nil
            try { _rt = it.ref_type } catch { _rt = nil }
            try { _ri = it.ref_id } catch { _ri = nil }
            if !m7_is_nonempty_string(_rt) || !m7_is_nonempty_string(_ri) { return "suggestion_ref_missing" }
            if !m6_validate_reference({ref_type: _rt, ref_id: _ri}, t) { return "ref_not_visible:" + _rt + "/" + _ri }
            // D-M6-03 (r10)：全部结构化 refs 逐条按当前权限重核（阶段正文第二及
            // 以后引用同样核；撤权/跨项目/不存在即拒）。
            let _refs = nil
            try { _refs = it.refs } catch { _refs = nil }
            if _refs != nil && m7_is_array_value(_refs) {
                let _rj = 0
                while _rj < _refs.len() {
                    let _rrt = nil
                    let _rri = nil
                    try { _rrt = _refs[_rj].ref_type } catch { _rrt = nil }
                    try { _rri = _refs[_rj].ref_id } catch { _rri = nil }
                    if !m7_is_nonempty_string(_rrt) || !m7_is_nonempty_string(_rri) { return "suggestion_refs_entry_missing" }
                    if !m6_validate_reference({ref_type: _rrt, ref_id: _rri}, t) { return "refs_not_visible:" + _rrt + "/" + _rri }
                    _rj = _rj + 1
                }
            }
        } else {
            if _k == "manual" {
                let _mrt = ""
                let _mri = ""
                try { if it.ref_type != nil { _mrt = it.ref_type } } catch { _mrt = "" }
                try { if it.ref_id != nil { _mri = it.ref_id } } catch { _mri = "" }
                if _mrt != "" || _mri != "" { return "manual_ref_unexpected" }
            } else {
                return "item_kind_unknown"
            }
        }
        i = i + 1
    }
    return ""
}
// D-M6-03 (r10)：manual/suggestion 门禁分流 —— 含模型建议的缓存必须有非空
// request_id 与正 expires_at_ms（缺出处/缺期限一律拒，不再以空值跳过校验）；
// 纯人工缓存必须是显式人工 schema（request_id 为空）。返回 "" 通过。
fn m6_history_schema_class(hv){
    let _has_sug = false
    if hv.items != nil {
        let i = 0
        while i < hv.items.len() {
            let it = hv.items[i]
            if it != nil && m7_is_object_value(it) {
                let _k = nil
                try { _k = it.kind } catch { _k = nil }
                if _k == "suggestion" { _has_sug = true }
            }
            i = i + 1
        }
    }
    if _has_sug {
        if hv.request_id == nil || hv.request_id == "" { return "suggestion_missing_request_id" }
        if hv.expires_at_ms == nil { return "suggestion_missing_expiry" }
        if !m7_is_strict_number_value(hv.expires_at_ms) { return "suggestion_expiry_not_strict_number" }
        if hv.expires_at_ms <= 0 { return "suggestion_expiry_not_positive" }
    } else {
        if hv.request_id != nil && hv.request_id != "" { return "manual_unexpected_request_id" }
    }
    return ""
}
// D-M6-03 (r10)：出处重核 —— AI_REQUESTS_LOG 中须存在同 request_id + 同任务 +
// 同主体 + 同项目的成功记录（HISTORY_ISSUED/PHASE_ISSUED/OK），且不存在同
// request_id 的 STALE_RESPONSE 作废记录；只核实体存在不算出处合法。
// D-M6-03 (r12 修复轮，对 r13 Review D03-C)：diagnostic 永不参与出处 —— 不证明
// 成功、也不作废成功；旧无 entry_kind 的成功记录（恢复后标 request_result）与
// STALE 撤销语义不变。
fn m6_history_provenance_ok(hv){
    if hv == nil { return false }
    if hv.request_id == nil || hv.request_id == "" { return false }
    let _ok = false
    let i = 0
    while i < AI_REQUESTS_LOG.len() {
        let _e = AI_REQUESTS_LOG[i]
        if _e != nil && _e.request_id == hv.request_id {
            let _ek = ""
            try { if _e.entry_kind != nil { _ek = _e.entry_kind } } catch { _ek = "" }
            if _ek != "diagnostic" {
                let _rk = ""
                try { if _e.result_kind != nil { _rk = _e.result_kind } } catch { _rk = "" }
                if _rk == "STALE_RESPONSE" { return false }
                if _e.task_id == hv.task_id && _e.actor == hv.actor && _e.project_id == hv.project {
                    if _rk == "HISTORY_ISSUED" || _rk == "PHASE_ISSUED" || _rk == "OK" { _ok = true }
                }
            }
        }
        i = i + 1
    }
    return _ok
}
// D-M6-03 (r10)：事实/证据版本快照重核 —— 缓存缺快照（旧格式）或快照与当前
// 不一致即失效；返回 "" 通过，否则拒绝原因。
fn m6_history_facts_check(hv){
    let _fv = nil
    let _ev = nil
    try { _fv = hv.facts_version } catch { _fv = nil }
    try { _ev = hv.evidence_version } catch { _ev = nil }
    if _fv == nil { return "facts_version_missing" }
    if _ev == nil { return "evidence_version_missing" }
    if _fv != _currentFactsVersion() { return "facts_changed" }
    let _tid = ""
    try { if hv.task_id != nil { _tid = hv.task_id } } catch { _tid = "" }
    if _ev != _currentEvidenceVersion(_tid) { return "evidence_changed" }
    return ""
}
// D-M6-03 (r10 修复轮，对 r11 Review D03-A/B)：引用快照 —— task 引用带任务版本与
// 证据版本（来源演进后重核失效）；asset/space 引用由 facts_version 闸覆盖，版本留 nil。
fn m6_ref_snapshot(rt, ri){
    let _tv = nil
    let _ev = nil
    if rt == "task" && ri != nil && ri != "" {
        _tv = latestTaskVersion(ri)
        _ev = _currentEvidenceVersion(ri)
    }
    return {ref_type: (rt or ""), ref_id: (ri or ""), task_version: _tv, evidence_version: _ev}
}
// D-M6-03 (r10)：实际送入模型的历史来源集合快照 —— 按 task_id 去重，
// 逐来源记录任务版本/证据版本（来源任务 H 后续变化即可识别）。
fn m6_history_source_snapshot(harr){
    let out = []
    if harr == nil { return out }
    let i = 0
    while i < harr.len() {
        let _tid = ""
        try { if harr[i].task_id != nil { _tid = harr[i].task_id } } catch { _tid = "" }
        if _tid != "" {
            let _seen = false
            let j = 0
            while j < out.len() {
                if out[j].task_id == _tid { _seen = true }
                j = j + 1
            }
            if !_seen {
                out.push({task_id: _tid, task_version: latestTaskVersion(_tid),
                          evidence_version: _currentEvidenceVersion(_tid)})
            }
        }
        i = i + 1
    }
    return out
}
// D-M6-03 (r10)：来源集合漂移重核 —— 任一来源任务缺失/版本/证据变化即返回原因。
fn m6_history_sources_drift(src){
    if src == nil { return "sources_missing" }
    let i = 0
    while i < src.len() {
        let _tid = ""
        try { if src[i].task_id != nil { _tid = src[i].task_id } } catch { _tid = "" }
        if _tid == "" { return "source_task_id_empty" }
        let _lv = latestTaskVersion(_tid)
        if _lv == nil { return "source_task_missing:" + _tid }
        let _stv = nil
        let _sev = nil
        try { _stv = src[i].task_version } catch { _stv = nil }
        try { _sev = src[i].evidence_version } catch { _sev = nil }
        if _stv == nil { return "source_version_missing:" + _tid }
        if _lv != _stv { return "source_version_changed:" + _tid }
        if _sev == nil { return "source_evidence_missing:" + _tid }
        if _currentEvidenceVersion(_tid) != _sev { return "source_evidence_changed:" + _tid }
        i = i + 1
    }
    return ""
}
// D-M6-03 (r10)：逐引用漂移重核 —— 全部 refs（不只第一个）逐一核；task 引用
// 缺快照或漂移即拒，asset/space 引用由 facts_version 闸覆盖。
fn m6_history_refs_drift(refs){
    if refs == nil { return "" }
    let i = 0
    while i < refs.len() {
        let _rt = ""
        let _ri = ""
        try { if refs[i].ref_type != nil { _rt = refs[i].ref_type } } catch { _rt = "" }
        try { if refs[i].ref_id != nil { _ri = refs[i].ref_id } } catch { _ri = "" }
        if _rt == "task" && _ri != "" {
            let _tv = nil
            let _ev = nil
            try { _tv = refs[i].task_version } catch { _tv = nil }
            try { _ev = refs[i].evidence_version } catch { _ev = nil }
            if _tv == nil { return "ref_version_missing:" + _ri }
            let _lv = latestTaskVersion(_ri)
            if _lv == nil { return "ref_task_missing:" + _ri }
            if _lv != _tv { return "ref_version_changed:" + _ri }
            if _ev == nil { return "ref_evidence_missing:" + _ri }
            if _currentEvidenceVersion(_ri) != _ev { return "ref_evidence_changed:" + _ri }
        }
        i = i + 1
    }
    return ""
}
// D-M6-03 (r10)：缓存级来源重核 —— 含模型建议的缓存必须带 source_versions 快照，
// 逐来源核存在/同项目/当前可见/版本/证据，并核每条建议的全部 refs 快照。
// 纯人工缓存（无 suggestion 条目）不适用。返回 "" 通过，否则拒绝原因。
fn m6_history_sources_check(hv, t){
    let _has_sug = false
    if hv.items != nil {
        let i = 0
        while i < hv.items.len() {
            let it = hv.items[i]
            if it != nil && m7_is_object_value(it) {
                let _k = nil
                try { _k = it.kind } catch { _k = nil }
                if _k == "suggestion" { _has_sug = true }
            }
            i = i + 1
        }
    }
    if !_has_sug { return "" }
    let _sv = nil
    try { _sv = hv.source_versions } catch { _sv = nil }
    if _sv == nil || !m7_is_array_value(_sv) { return "source_versions_missing" }
    let i = 0
    while i < _sv.len() {
        let _tid = ""
        try { if _sv[i].task_id != nil { _tid = _sv[i].task_id } } catch { _tid = "" }
        if _tid == "" { return "source_task_id_empty" }
        let _ot = findTaskById(_tid)
        if _ot == nil { return "source_task_missing:" + _tid }
        if _ot.project != hv.project { return "source_cross_project:" + _tid }
        if !visible(_ot, getMe()) { return "source_not_visible:" + _tid }
        i = i + 1
    }
    let _drift = m6_history_sources_drift(_sv)
    if _drift != "" { return _drift }
    let j = 0
    while j < hv.items.len() {
        let it2 = hv.items[j]
        if it2 != nil && m7_is_object_value(it2) {
            let _k2 = nil
            try { _k2 = it2.kind } catch { _k2 = nil }
            if _k2 == "suggestion" {
                let _r = nil
                try { _r = it2.refs } catch { _r = nil }
                if _r == nil || !m7_is_array_value(_r) || _r.len() == 0 { return "item_refs_missing" }
                let _rd = m6_history_refs_drift(_r)
                if _rd != "" { return _rd }
            }
        }
        j = j + 1
    }
    return ""
}
fn m6_load_history_view(){
    // D-M6-03 (r7)：跨重启恢复建议视图；严格 schema 门禁（同 D-M6-02 风格），
    // 非法文件直接忽略并保持 kind=none，不阻断启动。
    // D-M6-03 (r8)：重开重核 —— 恢复时核主体 / 项目 / 任务事实版本 / 到期 /
    // 合法出处（request_id 须在 AI_REQUESTS_LOG 有同任务同主体记录）；任一不符
    // → 不恢复正文（kind=none）并明示原因，不把旧缓存当合法建议。typeof 语义
    // 未证实（M7_REVIEW_r7），一律用 m7_is_* 行为探针。
    // D-M6-03 (r10 修复轮，对 r11 Review D03-C)：消费前先恢复持久请求日志 —
    // 出处闸依赖 AI_REQUESTS_LOG 内存记录，重开后内存为空会让合法缓存一律被拒；
    // 在 history 消费之前从 ai_requests.jsonl 安全恢复（损坏保源、出处按未知）。
    m6_restore_ai_requests_log()
    let p = m6_history_view_path()
    if !fs.exists(p) { return }
    let raw = nil
    try { raw = fs.read(p) } catch _ { raw = nil }
    if raw == nil || raw == "" { return }
    let parsed = nil
    try { parsed = raw.parse_json() } catch _ { parsed = nil }
    if parsed == nil || !m7_is_object_value(parsed) { return }
    let _tid = nil
    let _kind = nil
    try { _tid = parsed.task_id } catch { _tid = nil }
    try { _kind = parsed.kind } catch { _kind = nil }
    if !m7_is_nonempty_string(_tid) { return }
    if _kind != "device" && _kind != "phase" && _kind != "none" { return }
    let items = []
    // D-M6-03 (r11 修复轮，对 r12 Review D03-B2)：suggestion 条目 refs 缺失/非数组
    // 即整份按未知拒复（不默默丢引用、不伪造空数组）；原盘字节不动。
    // D-M6-03 (r12 修复轮，对 r13 Review D03-B2)：manual 条目豁免模型引用门禁
    // （人工协议本无 refs），manual 的 refs 存在但非数组仍整份拒。
    let _refs_invalid = false
    let _pitems = nil
    try { _pitems = parsed.items } catch { _pitems = nil }
    if _pitems != nil && m7_is_array_value(_pitems) {
        let i = 0
        while i < _pitems.len() {
            let it = _pitems[i]
            if it != nil && m7_is_object_value(it) {
                let _itext = nil
                try { _itext = it.text } catch { _itext = nil }
                if m7_is_nonempty_string(_itext) {
                    let _ik = nil
                    let _isrc = nil
                    let _irt = nil
                    let _iri = nil
                    let _irefs = nil
                    try { _ik = it.kind } catch { _ik = nil }
                    try { _isrc = it.source } catch { _isrc = nil }
                    try { _irt = it.ref_type } catch { _irt = nil }
                    try { _iri = it.ref_id } catch { _iri = nil }
                    try { _irefs = it.refs } catch { _irefs = nil }
                    // D-M6-03 (r11 修复轮，对 r12 Review D03-B2)：显式核 _irefs 为
                    // 数组后原值赋独立变量；宿主 or 默认值不保留数组，(_irefs or [])
                    // 会把合法引用集合清空，禁止对数组使用该写法。
                    // D-M6-03 (r12 修复轮，对 r13 Review D03-B2)：按条目 kind 分流 ——
                    // manual 兼容既有无 refs / 空引用协议（writer 不落 refs），保留
                    // 人工正文与 manual 标记；manual 的 refs 存在但非数组不默默丢弃，
                    // 按整份未知拒。suggestion 仍必须带合法数组 refs，缺/坏整份未知。
                    let _ikind = (_ik or "suggestion")
                    if _ikind == "manual" {
                        if _irefs == nil {
                            items.push({kind: "manual", text: _itext, source: (_isrc or ""),
                                        ref_type: (_irt or ""), ref_id: (_iri or ""),
                                        refs: []})
                        } else {
                            if m7_is_array_value(_irefs) {
                                let _kept_mrefs = _irefs
                                items.push({kind: "manual", text: _itext, source: (_isrc or ""),
                                            ref_type: (_irt or ""), ref_id: (_iri or ""),
                                            refs: _kept_mrefs})
                            } else {
                                _refs_invalid = true
                            }
                        }
                    } else {
                        if _irefs != nil && m7_is_array_value(_irefs) {
                            let _kept_refs = _irefs
                            items.push({kind: _ikind, text: _itext, source: (_isrc or ""),
                                        ref_type: (_irt or ""), ref_id: (_iri or ""),
                                        refs: _kept_refs})
                        } else {
                            _refs_invalid = true
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    if _refs_invalid && _kind != "none" {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议缓存条目缺可核出处（refs 缺失或非法），整份视为未知；原盘未改，可重新请求或手工记录"
        return
    }
    // 缺键读取不保证返回 nil（M5 实测 caveat）：逐字段 try，缺失按缺上下文处理。
    let _pts = nil
    let _pactor = nil
    let _pproj = nil
    let _ptv = nil
    let _prid = nil
    let _pexp = nil
    let _pfv = nil
    let _pev = nil
    let _psv = nil
    try { _pts = parsed.ts } catch { _pts = nil }
    try { _pactor = parsed.actor } catch { _pactor = nil }
    try { _pproj = parsed.project } catch { _pproj = nil }
    try { _ptv = parsed.task_version } catch { _ptv = nil }
    try { _prid = parsed.request_id } catch { _prid = nil }
    try { _pexp = parsed.expires_at_ms } catch { _pexp = nil }
    try { _pfv = parsed.facts_version } catch { _pfv = nil }
    try { _pev = parsed.evidence_version } catch { _pev = nil }
    try { _psv = parsed.source_versions } catch { _psv = nil }
    let hv = {task_id: _tid, kind: _kind, ts: (_pts or 0), items: items,
              actor: (_pactor or ""), project: (_pproj or ""),
              task_version: _ptv, request_id: (_prid or ""),
              expires_at_ms: (_pexp or 0),
              facts_version: _pfv, evidence_version: _pev,
              source_versions: _psv}
    if _kind == "none" { STATE.m6_history_view = hv; return }
    if !identityActive(sessionActor()) {
        // 未登录（boot 阶段）：先载入内存但不判合法；登录后由 m6_load_history_view
        // 重核（m2_login_begin 调用），渲染侧另有 m6_history_view_usable 兜底。
        STATE.m6_history_view = hv
        return
    }
    if hv.actor == "" || hv.actor != sessionActor() || hv.project == "" || hv.project != STATE.project {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议缓存主体/项目不符，不再显示（视为未知）；可重新请求或手工记录"
        return
    }
    let _lv = latestTaskVersion(_tid)
    if hv.task_version == nil || _lv == nil || _lv != hv.task_version {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议已过期（任务事实已变化），不再显示；请重新请求或手工记录"
        return
    }
    // D-M6-03 (r10)：manual/suggestion 分流门禁 —— 含模型建议缺 request_id/正期限
    // 一律拒（不再以空值跳过出处/到期校验）；纯人工必须是显式人工 schema。
    let _cls = m6_history_schema_class(hv)
    if _cls != "" {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议缓存缺合法出处/期限（" + _cls + "），不再显示（视为未知）；可重新请求或手工记录"
        return
    }
    if hv.expires_at_ms > 0 && nowMs() > hv.expires_at_ms {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议已过有效期，不再显示；请重新请求或手工记录"
        return
    }
    // D-M6-03 (r10)：出处重核 —— 须存在同项目同主体同任务的成功请求记录，
    // 且无同 request_id 的 STALE_RESPONSE 作废记录。
    if hv.request_id != "" {
        if !m6_history_provenance_ok(hv) {
            STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
            STATE.status = "历史建议出处不可核（无同项目同主体的成功请求记录或已被迟到回包作废），不再显示"
            return
        }
    }
    // D-M6-03 (r10)：事实/证据版本快照重核 —— 缺快照或已变化即失效。
    let _fwhy = m6_history_facts_check(hv)
    if _fwhy != "" {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议依据已变化（" + _fwhy + "），不再显示；请重新请求或手工记录"
        return
    }
    // D-M6-03 (r10)：引用按当前身份/项目/权限逐条重核 —— 撤权/跨项目/不存在即拒。
    let _lt = findTaskById(_tid)
    if _lt == nil {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议目标任务缺失，不再显示（视为未知）"
        return
    }
    let _rwhy = m6_history_items_recheck(hv.items, _lt)
    if _rwhy != "" {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议引用已不可核（" + _rwhy + "），不再显示；可重新请求或手工记录"
        return
    }
    // D-M6-03 (r10)：来源集合快照重核 —— 缺快照（旧格式）或来源任务版本/证据/
    // 可见性已变化即失效（视为未知），不继续使用旧事实的建议正文。
    let _swhy = m6_history_sources_check(hv, _lt)
    if _swhy != "" {
        STATE.m6_history_view = {task_id: _tid, kind: "none", ts: nowMs(), items: []}
        STATE.status = "历史建议来源已变化或不可核（" + _swhy + "），不再显示；可重新请求或手工记录"
        return
    }
    STATE.m6_history_view = hv
}
// D-M6-03 (r8)：渲染共用重核 —— 主体 / 项目 / 任务事实版本 / 到期；旧格式缓存
// 缺上下文字段一律不显示（视为未知）。load 与 render 双闸，防会话内切主体/切任务。
// D-M6-03 (r10)：渲染闸补 manual/suggestion 分流、出处（同项目成功请求且无
// STALE 作废）、事实/证据快照与引用当前权限重核，与 load 完全同标准。
fn m6_history_view_usable(hv, t){
    if hv == nil || t == nil { return false }
    if hv.task_id == nil || hv.task_id != t.id { return false }
    if hv.actor == nil || hv.actor != sessionActor() { return false }
    if hv.project == nil || hv.project != STATE.project { return false }
    if hv.task_version == nil { return false }
    if hv.task_version != t.version { return false }
    if m6_history_schema_class(hv) != "" { return false }
    if hv.expires_at_ms != nil && hv.expires_at_ms > 0 {
        if nowMs() > hv.expires_at_ms { return false }
    }
    if hv.request_id != nil && hv.request_id != "" {
        if !m6_history_provenance_ok(hv) { return false }
    }
    if m6_history_facts_check(hv) != "" { return false }
    if m6_history_items_recheck(hv.items, t) != "" { return false }
    // D-M6-03 (r10)：渲染闸与 load 同标准 —— 来源集合/全部 refs 快照重核。
    if m6_history_sources_check(hv, t) != "" { return false }
    return true
}
// D-M6-03 (r7)：人工出口 —— 模型不可用 / 无历史 / 回包被拒时的手工记录入口。
// 人工内容显式标 kind=manual，不与模型建议混同；仅记录到建议视图，不写业务字段。
fn m6_cmd_save_manual_entry(kind){
    let t = currentTask()
    if t == nil { STATE.status = "请先选择任务"; refreshDesktop(); return }
    if !authorizeTask(t) { STATE.status = "身份或项目角色无效，不能记录"; refreshDesktop(); return }
    // D-M6-03 (r8)：用实证文本接口 .text()（与登录控件一致），不再读 .text 属性；
    // 读取失败如实反馈，不当作空输入。
    let txt = ""
    let _read_ok = true
    try { txt = ui.m6_manual_entry_input.text() } catch _ { _read_ok = false }
    if !_read_ok {
        STATE.status = "手工输入读取失败：宿主控件文本接口不可用，未保存"
        refreshDesktop()
        return
    }
    if txt == "" { STATE.status = "手工内容为空，未保存"; refreshDesktop(); return }
    let _kind = "phase"
    if kind == "device" { _kind = "device" }
    STATE.m6_history_view = {task_id: t.id, kind: _kind, ts: nowMs(),
        items: [{kind: "manual", text: _truncate(txt, 200), source: "manual · " + sessionActor(),
                 ref_type: "", ref_id: ""}],
        actor: sessionActor(), project: STATE.project, task_version: t.version,
        request_id: "", expires_at_ms: 0,
        facts_version: _currentFactsVersion(), evidence_version: _currentEvidenceVersion(t.id)}
    // D-M6-03 (r8)：消费保存结果 —— 失败不显示「已保存」，输入保留在输入框可重试。
    if m6_save_history_view() {
        if _kind == "device" { STATE.detail_tab = "history" } else { STATE.detail_tab = "phase" }
        STATE.status = "手工记录已保存（人工内容，非模型建议）"
    } else {
        STATE.status = "手工记录保存失败（待重试；输入仍保留在输入框，未丢失）"
    }
    refreshDesktop()
}

// ─── M5 真实附件 · 生命周期常量 + 工具 ────────────────────────
// SELECTED → SAVING → VERIFYING → READY（唯一由字节一致触发）
// 任何不一致 / 隔离 / 越权 / 过期轮次 → MISSING / CORRUPTED / QUARANTINED / DENIED
let M5_LIFECYCLE_READY = "READY"
let M5_LIFECYCLE_MISSING = "MISSING"
let M5_LIFECYCLE_CORRUPTED = "CORRUPTED"
let M5_LIFECYCLE_QUARANTINED = "QUARANTINED"
let M5_LIFECYCLE_DENIED = "DENIED"
let M5_LIFECYCLE_SELECTED = "SELECTED"
let M5_LIFECYCLE_SAVING = "SAVING"
let M5_LIFECYCLE_VERIFYING = "VERIFYING"
let M5_MAX_BYTES = 16 * 1024 * 1024          // 16 MiB；超出直接拒
let M5_MAX_ATTACH_PER_ROUND = 10             // 单任务单轮最多 10 件
fn m5_sandbox_root_abs(){
    // D-M5-04（r7）：附件根解析。
    //   1) STATE.attach_sandbox_root_abs：仅测试 / 配置显式注入的绝对路径；
    //      默认 STATE 声明为 ""，缺字段错误值不会进入路径。
    //   2) 默认 = STATE.attach_sandbox_root（相对路径 "m5-test"），宿主 fs 原语
    //      把它解析进当前获准 app-data jail（与 state.json / tasks.json 同一
    //      边界），天然限制在本场；不再拼接项目绝对根（旧 r4 硬编码根在
    //      harness 隔离场下越界，是 D-M5-04 原生恢复失败的直接根因之一）。
    // 链接隔离 / fs.realpath 仍 BLOCKED（宿主无对应原语）；路径字面层只防
    // "前缀越界" + "父目录穿越"两类，不声称替代 fs.realpath。
    let abs = STATE.attach_sandbox_root_abs
    if abs != nil && abs != "" { return abs }
    let rel = STATE.attach_sandbox_root
    if rel == nil || rel == "" { return "m5-test" }
    return rel
}
fn m5_attach_dir_abs(){ m5_sandbox_root_abs() + "/attachments" }
fn m5_quarantine_dir_abs(){ m5_sandbox_root_abs() + "/quarantine" }
fn m5_lost_dir_abs(){ m5_sandbox_root_abs() + "/lost+found" }
fn m5_short(s, n){
    if s == nil { return "" }
    let out = ""
    let i = 0
    let lim = _textLenSafe(s)
    if lim > n { lim = n }
    while i < lim {
        out = out + _charAtSafe(s, i)
        i = i + 1
    }
    if _textLenSafe(s) > n { out = out + "…" }
    return out
}
fn m5_detect_mime(name){
    // 极简扩展名映射；不依赖宿主 IO。
    // B-M4-01 (r7)：宿主无 to_lowercase / ends_with；改用 strip_suffix 比较
    // （仅精确大小写匹配；大小写归一需宿主原语，当前不提供，如实记录）。
    if _strHasSuffix(name, ".png") { return "image/png" }
    if _strHasSuffix(name, ".jpg") || _strHasSuffix(name, ".jpeg") { return "image/jpeg" }
    if _strHasSuffix(name, ".gif") { return "image/gif" }
    if _strHasSuffix(name, ".webp") { return "image/webp" }
    if _strHasSuffix(name, ".pdf") { return "application/pdf" }
    if _strHasSuffix(name, ".txt") || _strHasSuffix(name, ".log") { return "text/plain" }
    if _strHasSuffix(name, ".mp4") { return "video/mp4" }
    if _strHasSuffix(name, ".json") { return "application/json" }
    return "application/octet-stream"
}
fn m5_extension(name){
    // D-M5-04（r9 修复轮）：_charAtSafe 返回 to_chars 码点元素；与字符串
    // 字面量 "." 直接比较恒类型不匹配，改为同型码点比较。
    let _dot_arr = ".".to_chars()
    let _dot = _dot_arr[0]
    let i = _textLenSafe(name) - 1
    while i >= 0 {
        let c = _charAtSafe(name, i)
        if c == _dot { return _strSlice(name, i + 1, 0) }
        i = i - 1
    }
    return ""
}
// Date(Year,Month,Day) → "Asia/Shanghai 2026-10-11 周六" 显示串。月份与星期可
// 由宿主做固定映射；本工程仅做固定本地化映射（不依赖系统时区），所有预约时
// 间均按 Asia/Shanghai 解释（系统时钟同样以 ms UTC 累积；换算时常量偏移 = 0
// 演示固定；运行时随宿主机所在时区调整；本工程采用固定偏移 28,800,000ms 不
// 实际依赖系统 locale）。
fn dayOfWeekNameShanghai(year, month, day){
    // 用 Zeller 式公式：Gregorian calendar; weekday = (d + 13*(m+1)/5 + y +
    // y/4 - y/100 + y/400) % 7；其中 1=Sun..7=Sat；Splash 内只取 0=Sat..6=Fri，
    // 我们重设到 1=Mon..7=Sun；下面为简化的查表（中国大陆习惯：周一开头）。
    // 因宿主无 date library，给出确定的手算表并容错回退。
    let y = year
    let m = month
    let d = day
    if m < 3 { m = m + 12; y = y - 1 }
    let k = y % 100
    let j = y / 100
    let h = (d + 13*(m + 1)/5 + k + k/4 + j/4 + 5*j) % 7
    // h: 0=Sat, 1=Sun, 2=Mon, 3=Tue, 4=Wed, 5=Thu, 6=Fri
    if h == 0 { return "周六" }
    if h == 1 { return "周日" }
    if h == 2 { return "周一" }
    if h == 3 { return "周二" }
    if h == 4 { return "周三" }
    if h == 5 { return "周四" }
    if h == 6 { return "周五" }
    return "未知"
}
fn formatShanghaiDateTimeFromMs(ms){
    // 不真正换时区；ms 是本地化的"系统毫秒"，与 Asia/Shanghai 一致即直接格式化。
    // 我们用 host time_now() 是秒级，按相对原点的偏移累加得到年/月/日（演示：
    // 2026-10-10 为原点 1762665600 秒）；本工程不去 parse 日期，而是回传源 ms
    // 和字符串表示，由调用方把它作为 "Asia/Shanghai 起止时间" 展示。
    return ms.to_string()
}
fn formatApptLine(t_or_a){
    // D-M6-01：同时接受「任务 t（含 appointments 列表）」与「单预约 appt（自身含
    // startMs/endMs/status）」；D-M2/M4 既有调用以 task 形态进入；M6 confirmAppointment
    // 确认后随记账时以单预约形态进入，避免把任务形状错传给单预约避免传参歧义。
    let appts = []
    if t_or_a == nil { return "无预约" }
    if t_or_a.appointments != nil { appts = t_or_a.appointments }
    else { appts = [t_or_a] }
    let out = ""
    let i = 0
    while i < appts.len() {
        let a = appts[i]
        if a.status == A_PROPOSED {
            let ps = _shanghaiYmdhFromMs(a.startMs)
            let pe = _shanghaiYmdhFromMs(a.endMs)
            if ps != nil && pe != nil {
                let dow = dayOfWeekNameShanghai(ps.y, ps.m, ps.d)
                if out != "" { out = out + " · " }
                out = out + "提议 " + ps.y.to_string() + "-" + pad2(ps.m) + "-" + pad2(ps.d)
                       + " " + dow + " "
                       + pad2(ps.h) + ":" + pad2(ps.mn)
                       + "-"
                       + pad2(pe.h) + ":" + pad2(pe.mn)
                       + " Asia/Shanghai"
            }
        }
        if a.status == A_CONFIRMED {
            let ps = _shanghaiYmdhFromMs(a.startMs)
            let pe = _shanghaiYmdhFromMs(a.endMs)
            if ps != nil && pe != nil {
                let dow = dayOfWeekNameShanghai(ps.y, ps.m, ps.d)
                if out != "" { out = out + " · " }
                out = out + "已确认 " + ps.y.to_string() + "-" + pad2(ps.m) + "-" + pad2(ps.d)
                       + " " + dow + " "
                       + pad2(ps.h) + ":" + pad2(ps.mn)
                       + "-"
                       + pad2(pe.h) + ":" + pad2(pe.mn)
                       + " Asia/Shanghai 技工 " + a.tech
            }
        }
        i = i + 1
    }
    if out == "" { return "无预约" }
    return out
}
fn pad2(n){
    if n < 10 { return "0" + n.to_string() }
    return n.to_string()
}
fn _daysInMonth(y, m){
    let mdays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if _isLeap(y) { mdays[1] = 29 }
    if m < 1 || m > 12 { return 0 }
    return mdays[m - 1]
}
fn _parseApptFormYmdh(y, m, d, h, mn){
    // 输入 y/m/d/h/mn (Asia/Shanghai 本地)；返回 UTC 毫秒（Unix epoch）。
    // 复用既有的 _daysBeforeYear / _daysBeforeMonth；保持上海 UTC+8 偏移 = -28800000ms。
    let days = _daysBeforeYear(y) + _daysBeforeMonth(y, m) + (d - 1)
    let ms_in_day = (h * 3600 + mn * 60) * 1000
    return days * 86400000 + ms_in_day - 28800000
}
fn parseApptFormToMs(y, m, d, h, mn, em, en){
    // D-M4-01：真正使用 y/m/d 计算日期偏移，并按 Asia/Shanghai 转 UTC 毫秒。
    // 旧版只取"今日 00:00 + 小时"，日期字段被忽略，11/31 也会通过。
    let start = _parseApptFormYmdh(y, m, d, h, mn)
    let end = _parseApptFormYmdh(y, m, d, em, en)
    return {start: start, end: end}
}
fn _shanghaiYmdhFromMs(ms){
    // UTC ms → Asia/Shanghai 本地 y/m/d/h/mn；用于从已落盘 appointment 读回完整日期。
    let local_ms = ms + 28800000
    let days = (local_ms - (local_ms % 86400000)) / 86400000
    let ms_in_day = local_ms - days * 86400000
    let h = (ms_in_day - (ms_in_day % 3600000)) / 3600000
    let mn = ((ms_in_day - h * 3600000) - ((ms_in_day - h * 3600000) % 60000)) / 60000
    // 反 days_from_civil
    let z = days + 719468
    let era = (z - (z % 146097)) / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe/1460 + doe/36524 - doe/146096) / 365
    let yy = yoe + era * 400
    let doy = doe - (365 * yoe + yoe/4 - yoe/100)
    let mp = (5 * doy + 2) / 153
    let dd = doy - (153 * mp + 2)/5 + 1
    let mm = mp + 3
    if mp >= 10 { mm = mp - 9 }
    let yyyy = yy
    if mm <= 2 { yyyy = yy + 1 }
    return {y: yyyy, m: mm, d: dd, h: h, mn: mn}
}
fn validateApptForm(form){
    if form == nil { return "未填写预约表单" }
    if form.date_y < 2026 { return "年份应在 2026 及以后" }
    if form.date_m < 1 || form.date_m > 12 { return "月份必须 1-12" }
    // D-M4-01：按 y/m 实际最大日数校验，拒绝 11/31、2/30 等非法日期。
    let max_d = _daysInMonth(form.date_y, form.date_m)
    if form.date_d < 1 || form.date_d > max_d {
        return "日期超出当月最大天数 " + max_d.to_string() + "（" + form.date_y.to_string() + "-" + form.date_m.to_string() + "）"
    }
    if form.h_start < 0 || form.h_start > 23 { return "开始小时必须 0-23" }
    if form.h_end < 0 || form.h_end > 23 { return "结束小时必须 0-23" }
    if form.min_start < 0 || form.min_start > 59 { return "起始分钟必须 0-59" }
    if form.min_end < 0 || form.min_end > 59 { return "终止分钟必须 0-59" }
    return ""
}
// 检测同技工（含跨项目）appointment 时间重叠；传入 same_proposal_id 表示本
// 任务中即将被新预约替代的旧 PROPOSED/CONFIRMED id，不进入对照。其余任务（含
// 跨项目）的同技工 CONFIRMED/PROPOSED 一律检查；相邻时段 start==end 视为不重叠。
// D-M3-06 / D-M4-02：跨任务 / 跨项目同技工重叠检测。same_task_exclude_ids 是
// 当前任务内即将被替换的旧预约 ID 集合（reschedule / 改约 / 再提议场景下不
// 自冲突）；其它任务的任何 PROPOSED / CONFIRMED 仍按经典重叠判定。
fn hasTechConflict(t, techId, startMs, endMs, same_task_exclude_ids){
    if techId == "" { return false }
    let i = 0
    while i < TASKS.len() {
        let other = TASKS[i]
        let j = 0
        while j < other.appointments.len() {
            let a = other.appointments[j]
            // 当前任务内被新预约替代的旧 PROPOSED/CONFIRMED 精确排除
            if other.id == t.id {
                if same_task_exclude_ids != nil {
                    let k = 0
                    let excluded = false
                    while k < same_task_exclude_ids.len() {
                        if a.id == same_task_exclude_ids[k] {
                            excluded = true
                            k = same_task_exclude_ids.len()
                        } else {
                            k = k + 1
                        }
                    }
                    if excluded { j = j + 1; continue }
                }
            }
            if a.status == A_CONFIRMED {
                if a.tech == techId {
                    if a.startMs < endMs {
                        if a.endMs > startMs { return true }
                    }
                }
            }
            if a.status == A_PROPOSED {
                if a.tech == techId {
                    if a.startMs < endMs {
                        if a.endMs > startMs { return true }
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return false
}
// 接单 / 改派 / 设备变化 / 改约 / 取消都会让相关旧 AI 建议与确认失效。
// D-M4-04 (r3 修复轮)：失效针对"具体的草稿/确认"绑定，不再要求
// last_confirmed_at_ms > 0；未确认的 AI 草稿（last_confirmed_at_ms == 0）
// 只要被改派 / 改约 / 解绑 / 取消触碰，也必须失效；让 confirmDraftModelBound
// 的拒绝条件（invalidated_by_edit == true）能成立。用户重新确认后由
// confirmDraftModelBound 把 invalidated_by_edit 写回 false。
// D-M4-04 (r4 修复轮)：在失效时把"当时的版本（draft_version / raw_input_version）"
// 快照到 STATE.m4_invalidations.last_invalidate_*。confirmDraftModelBound
// 用此快照判断"自上次失效后用户是否做了新编辑"：
//   - 当前 raw_input_version 或 draft_version 已越过快照 → 视为"新版本
//     上的重新确认"，放行（不要求清空面板）。
//   - 未越过快照（用户没动） → 视为"对同一旧内容的二次确认"，拒绝并提示
//     "请重新确认更新后的内容"。
// 这样改派/改约/解绑后用户只要输入了新内容（哪怕仅一个字符），就能照常
// 走 confirmDraftModelBound；旧 AI 标记不要求手工清空也不被无条件抹掉。
fn m4_invalidateConfirmation(reason){
    if STATE.m4_invalidations == nil { m4_init_forms() }
    STATE.m4_invalidations.last_accept = nowMs()
    // 快照当前版本，供 confirmDraftModelBound 判别"是否是新内容"
    let _snap_draft = 0
    let _snap_raw = 0
    if PENDING_DRAFT != nil && PENDING_DRAFT.draft_version != nil {
        _snap_draft = PENDING_DRAFT.draft_version
    }
    if TASK_INPUT != nil && TASK_INPUT.raw_input_version != nil {
        _snap_raw = TASK_INPUT.raw_input_version
    }
    STATE.m4_invalidations.last_invalidate_draft_version = _snap_draft
    STATE.m4_invalidations.last_invalidate_raw_input_version = _snap_raw
    // 不再依赖 last_confirmed_at_ms > 0；任何被触碰的草稿/确认都失效。
    CONFIRM_BIND.invalidated_by_edit = true
    // 推 AI_STATE 出 APPLIED；除非本来就是非 APPLIED（MANUAL/IDLE/...）。
    if AI_STATE == "APPLIED" { AI_STATE = "EXPIRED" }
    if PENDING_AI_REQUEST.active {
        PENDING_AI_REQUEST.active = false
        PENDING_AI_REQUEST.request_id = ""
    }
    STATE.m4_invalidations.last_invalidate_reason = reason
    // D-M4-04 (r5 修复轮)：失效把旧 proposal / 旧确认的 AI 绑定从 PENDING_DRAFT
    // 上拆掉，让旧 AI 来源 / 版本 / 历史 / 到期不再参与新确认；用户后续
    // 必须重新走"AI 重新生成"或"手工显式重填"路径。单凭 raw_input_version++
    // 或 draft_version++ 不能复活旧 proposal，因为旧 AI 绑定已不存在。
    // 旧失效审计（last_invalidate_*）继续保留作历史；不抹。
    PENDING_DRAFT.last_applied_request_id = ""
    PENDING_DRAFT.ai_request_id = ""
    PENDING_DRAFT.expires_at_ms = 0
    PENDING_DRAFT.ai_history_raw_text = ""
    PENDING_DRAFT.ai_history_raw_text_hash = ""
    PENDING_DRAFT.ai_history_raw_input_version = 0
    // 失效后 draft_source 必须非 ai：editRawText 的 auto-promote 分支仅在
    // draft_source == "ai" 时才把 "problem" 推入 human_edited_fields；先
    // 把它降为 manual，迫使后续真正修改走 editDraftField 路径（显式修改
    // 才会向 human_edited_fields 添加字段）。这样 confirmDraftModelBound
    // 的"manual refill"路径才能真正体现用户的核对意图。
    PENDING_DRAFT.draft_source = "manual"
    // D-M4-04 (r6 修复轮)：失效即开新 epoch —— 旧 human_edited_fields 仅作
    // 历史审计保留，不再参与"本轮已核对"判定；用户必须在失效后重新显式
    // 编辑（或经新 AI apply 绑定）关键字段才算本轮完成。
    PENDING_DRAFT.human_edited_epoch_fields = []
    saveState()
}

// D-M3-03 (r5)：UI "采纳 AI 建议" 进入前的完整守卫；
// 返回 "" = 可采纳；返回非空 = 拒绝原因。
// 守卫覆盖：1) AI_STATE == APPLIED；2) active 请求已结束；
// 3) 已采纳草稿与当前原文 / 输入版本 / actor / project / 主体绑定一致；
// 4) 失效标志未被 set；5) 草稿未过期。
fn _suggestionAcceptGate(){
    if AI_STATE != "APPLIED" { return "当前状态非 APPLIED" }
    if PENDING_AI_REQUEST.active { return "仍存在 active 请求" }
    if PENDING_DRAFT.draft_version == 0 { return "无 PENDING_DRAFT" }
    if PENDING_DRAFT.last_applied_request_id == "" { return "已采纳建议已被作废" }
    // D-M3-03 (r6)：不再凭"编辑失效"标志位一刀切拒绝 ——
    // 合法采纳（apply 后未再编辑）必须能过；编辑/切主体/切项目的失效由
    // 下面的逐条当前绑定比对承担。
    if PENDING_DRAFT.ai_history_raw_text_hash != TASK_INPUT.raw_text_hash { return "原文哈希与采纳时不一致" }
    if PENDING_DRAFT.ai_history_raw_input_version != TASK_INPUT.raw_input_version { return "输入版本与采纳时不一致" }
    if PENDING_DRAFT.expires_at_ms != 0 && nowMs() > PENDING_DRAFT.expires_at_ms { return "AI 建议已过期" }
    if sessionActor() == nil || sessionActor() == "" { return "当前无会话主体" }
    // D-M3-03 (r6)：采纳必须核原主体 / 原项目 / 当前权限 —— 只查"有 session"
    // 会让切主体 / 切项目后的旧建议仍被采纳。
    if PENDING_DRAFT.sources != nil && typeof(PENDING_DRAFT.sources) == "object" {
        if PENDING_DRAFT.sources.actor_at_apply != nil && PENDING_DRAFT.sources.actor_at_apply != "" {
            if sessionActor() != PENDING_DRAFT.sources.actor_at_apply { return "主体已切换；建议与当前主体不匹配" }
        }
        if PENDING_DRAFT.sources.project_at_apply != nil && PENDING_DRAFT.sources.project_at_apply != "" {
            if STATE.project != PENDING_DRAFT.sources.project_at_apply { return "项目已切换；建议与当前项目不匹配" }
        }
    }
    if !identityActive(sessionActor()) { return "当前主体已撤权 / 到期" }
    // D-M3-03 (r7)：采纳层补齐当前任务/事实/证据校验 —— 与首次确认共用
    // _currentBindingStaleReason；apply 之后任务改约、证据更新、设备服务
    // 关系变化都会使旧建议在此被拒，不再只查输入/主体/项目。
    let _stale = _currentBindingStaleReason()
    if _stale != "" { return _stale }
    return ""
}
// 同步 6 个 M4 TextInput 到 STATE.draft_*（D-M3-02 同样模式：宿主不支持 on_change）
fn m4SyncTextInputs(){
    m4_init_forms()
    m5_init_forms()
    // 学 D-M3-02 用 ui.<name>.text() 直读（属性写法 .text 在宿主报 widget text not found）；此处按命名 widget 实例拿文本。
    // 没有同名 widget 实例时回退空字符串。
    let reason_text = ""
    let reassign_text = ""
    let assign_text = ""
    let progress_text = ""
    let completion_text = ""
    if ui.m4_reason_input != nil { reason_text = ui.m4_reason_input.text() }
    if ui.m4_reassign_input != nil { reassign_text = ui.m4_reassign_input.text() }
    if ui.m4_assign_input != nil { assign_text = ui.m4_assign_input.text() }
    if ui.m4_progress_input != nil { progress_text = ui.m4_progress_input.text() }
    if ui.m4_completion_input != nil { completion_text = ui.m4_completion_input.text() }
    STATE.draft_reject.reason = reason_text
    STATE.draft_reassign.reason = reassign_text
    STATE.draft_assign.reason = assign_text
    STATE.draft_progress.note = progress_text
    STATE.draft_completion.text = completion_text
    // M5 同步：附件源路径 + 验收意见 / 经理代验理由
    let m5_path = ""
    if ui.m5_attach_path_input != nil { m5_path = ui.m5_attach_path_input.text() }
    if STATE.draft_attach_path == nil { STATE.draft_attach_path = {abs_source: ""} }
    STATE.draft_attach_path.abs_source = m5_path
    let m5_opinion = ""
    let m5_proxy = ""
    if ui.m5_acceptance_opinion_input != nil { m5_opinion = ui.m5_acceptance_opinion_input.text() }
    if ui.m5_manager_proxy_reason_input != nil { m5_proxy = ui.m5_manager_proxy_reason_input.text() }
    if STATE.draft_acceptance_opinion == nil { STATE.draft_acceptance_opinion = {text: "", manager_proxy_reason: ""} }
    STATE.draft_acceptance_opinion.text = m5_opinion
    STATE.draft_acceptance_opinion.manager_proxy_reason = m5_proxy
    // 拒绝预约 / 退回完成互用 m4_reason_input 时区分语义：拒绝原因带前缀
    if STATE.draft_reject._accept_as_completion_reject == nil {
        STATE.draft_reject._accept_as_completion_reject = false
    }
    saveState()
}
fn m4_asset_state_text(t){
    let aid = ""
    if STATE.draft_bind_asset != nil { aid = STATE.draft_bind_asset.asset_id }
    if aid == nil || aid == "" {
        if t != nil { aid = t.asset }
    }
    if aid == nil || aid == "" { return "尚未选择设备" }
    let a = pickUser(ASSETS, aid)
    if a == nil { return "设备：" + aid + "（该设备尚未登记，请重新选择）" }
    return "设备：" + a.name
}
fn m4_assign_state_text(t){
    let tid = ""
    if STATE.draft_assign != nil { tid = STATE.draft_assign.tech_id }
    if STATE.draft_reassign != nil {
        let ntid = STATE.draft_reassign.new_tech_id
        if ntid != nil && ntid != "" { tid = ntid }
    }
    if tid == nil || tid == "" {
        if t != nil { tid = t.assignee }
    }
    if tid == nil || tid == "" { return "尚未分配维修人员" }
    let person = pickUser(accountDirectory(), tid)
    if person == nil { return "分配给：" + tid }
    return "分配给：" + person.name
}
fn m4_appt_state_text(){
    if STATE.draft_appt == nil { return "（未填）" }
    let a = STATE.draft_appt
    let dow = dayOfWeekNameShanghai(a.date_y, a.date_m, a.date_d)
    return a.date_y.to_string() + "-" + pad2(a.date_m) + "-" + pad2(a.date_d) + " " + dow
         + " " + pad2(a.h_start) + ":" + pad2(a.min_start)
         + "-"
         + pad2(a.h_end) + ":" + pad2(a.min_end)
         + " (Asia/Shanghai)"
}
fn m4_invalidate_state_text(){
    if STATE.m4_invalidations == nil { return "（无）" }
    let inv = STATE.m4_invalidations
    return "accept=" + inv.last_accept.to_string() + " reassign=" + inv.last_reassign.to_string()
         + " bind=" + inv.last_bind.to_string() + " reject=" + inv.last_reject.to_string()
         + " cancel=" + inv.last_cancel.to_string()
         + " pending_proposal=" + inv.pending_proposal_id
}

// 在写命令边界前独立再读一次 tasks.json，与内存中的 t 比对。
// host 实际能走 fs.read + parse_json；这里给一个一致实现。
fn readTaskByIdFromDisk(taskId){
    if !fs.exists("tasks.json") { return nil }
    let arr = nil
    try { arr = fs.read("tasks.json").parse_json() } catch _ { arr = nil }
    if arr == nil { return nil }
    let i = 0
    while i < arr.len() {
        if arr[i].id == taskId { return arr[i] }
        i = i + 1
    }
    return nil
}
fn latestTaskVersion(taskId){
    let t = readTaskByIdFromDisk(taskId)
    if t == nil { return -1 }
    return t.version
}

// D-M4-03 (r4 修复轮)：诚实实现——不再声称 fs.rename 是原子 CAS。
//
// 之前（r3）依赖 fs.rename 把 actor 专属 stamp 文件改名到 tasks.lock，并且
// 通过"读回 stamp"判断是否持有；r3 独立 Review 已证明该模式在两个独立
// PID 下都会看到自己的 stamp（A、B 同时 acquired=true），且 A 释放会
// 把 B 当前持有的锁挪走——这不是互斥。原 r2 实现的 read+write+readback
// 也是 read+write 之间的竞争窗口问题，同样不成立。
//
// 宿主 fs API 不暴露 O_EXCL / flock / 真 rename 原子性（M3-r4 / M4-r3
// 独立 Review 均确认），所以在选定宿主内"无可验证的跨进程原子互斥原语"。
// r3 Review 明确要求：不得继续用 rename 或 write/readback 模拟 CAS；若
// 无原语，记 BLOCKED 并交付可运行最小复现，不自行引入未裁决业务服务。
//
// 本轮诚实改造：
//   - acquire：仅写 actor 专属 stamp 到 tasks.lock；不读回检查"是否真的
//     是自己写的"。同一进程内顺序可见，跨进程无原子保证。
//   - release：写空字符串作"已释放"标记。
//   - 真互斥依靠 (1) runCommandBound 的 expected_version 重读比对（line
//     2153 latestTaskVersion）、(2) commitBound 的 t.version!=expected+1
//     检查、(3) D-M4-02 hasTechConflict 同技工跨任务重叠检测、(4) D-M4-03
//     r4 新增的 runCommandBound 内权威 TASKS 重读 + 跨任务冲突复查。
//
// 跨进程并发接单/确认重叠预约在选定宿主内仍为 BLOCKED：真原子需宿主原语。
// HOST_PRIMITIVE_BLOCKED 标志提示后续轮次（如宿主 fs 模块升级到提供 O_EXCL
// 或 flock）时可重写此函数。
// D-M2-05 修复(r5):write-then-verify-after-write + owner stamp;真正 fs 层
// 原子由宿主提供,本轮不在 VM 假装已 NATIVE 解阻。所有 hit/reject/异常路径
// 必须经 _releaseTaskLock 释放;D-M4-03 (r7) 起 owner 绑定完整实例 token
// （actor@ms@nonce 全等），同 actor 的另一独立上下文不再算重入/不再放行。
fn _acquireTaskLock(){
    // HOST_PRIMITIVE_BLOCKED：宿主 fs 不暴露 O_EXCL/flock/真 rename 原子性;
    // 本锁为 in-process advisory lock,跨进程原子需宿主 fs 模块升级。
    if sessionActor() == "" {
        STATE.m2_lock_state = "no_actor"
        return false
    }
    let actor = sessionActor()
    let stamp = actor + "@" + nowMs().to_string() + "@" + ID_SEQ.to_string()
    // D-M4-03 (r8)：区分"首次尚无锁文件"与"真实读失败" —— 文件不存在 = 全新
    // 首次获取（合法，继续写 stamp）；文件存在但读失败 = 权威未知，fail-closed
    // 显式拒。不再对不存在的锁文件盲读，避免把"首次缺锁"误当 read_failed。
    let _cur = ""
    let _read_ok = true
    if fs.exists("tasks.lock") {
        try { _cur = fs.read("tasks.lock") } catch _ { _read_ok = false }
    }
    // D-M4-03 (r7)：锁读取失败不能按无锁继续——权威未知，显式拒。
    if !_read_ok {
        STATE.m2_lock_state = "read_failed"
        return false
    }
    // 已有人持有非空锁 → 只有完整 stamp 等于本进程持有 token 才算重入；
    // 同 actor 的另一个独立上下文（不同 token）不再被当作重入。
    if _cur != "" {
        let _my_token = STATE.m2_lock_token
        if _my_token == nil { _my_token = "" }
        if _my_token != "" && _cur == _my_token {
            STATE.m2_lock_state = "owned"
            return true
        }
        // 其它持有者；只有戳可解析且确超 5 分钟才允许回收（崩溃残留）。
        // D-M4-03 (r7)：to_f64 解析失败(NaN) / 格式未知 → 一律拒且绝不清锁。
        let _known = false
        let _stale = false
        let _parts = _cur.split("@")
        if _parts.len() >= 2 {
            let _ts = _parts[1].to_f64()
            if _ts > 0 {
                _known = true
                if nowMs() - _ts >= 300000 { _stale = true }
            }
        }
        if !_known {
            STATE.m2_lock_state = "held_by_other_unknown"
            return false
        }
        if !_stale {
            STATE.m2_lock_state = "held_by_other_actor"
            return false
        }
        // stale;尝试回收。
    }
    // 写入自己 stamp
    try { fs.write("tasks.lock", stamp) } catch _ {
        STATE.m2_lock_state = "write_failed"
        return false
    }
    // write-then-verify:写后立即读回,若不是自己 stamp → 别人抢先,丢失。
    let _check = ""
    let _verify_ok = true
    try { _check = fs.read("tasks.lock") } catch _ { _verify_ok = false }
    if !_verify_ok || _check != stamp {
        STATE.m2_lock_state = "lost"
        return false
    }
    // D-M4-03 (r7)：owner 绑定独立持有实例 token（完整 stamp 含 nonce）。
    STATE.m2_lock_token = stamp
    STATE.m2_lock_state = "owned"
    return true
}
fn _releaseTaskLock(){
    // D-M4-03 (r7)：仅当锁内容与本次获取的完整 token 相等才清空；
    // 无 token（本进程未持锁）/ 读失败 / 内容不符一律不动他人锁。
    let actor = sessionActor()
    if actor == "" { return }
    let token = STATE.m2_lock_token
    if token == nil { token = "" }
    if token == "" {
        STATE.m2_lock_state = "not_owner"
        return
    }
    let _cur = ""
    let _read_ok = true
    try { _cur = fs.read("tasks.lock") } catch _ { _read_ok = false }
    if !_read_ok {
        STATE.m2_lock_state = "read_failed"
        return
    }
    if _cur == "" {
        STATE.m2_lock_state = "released"
        STATE.m2_lock_token = ""
        return
    }
    if _cur == token {
        try { fs.write("tasks.lock", "") } catch _ {}
        STATE.m2_lock_state = "released"
        STATE.m2_lock_token = ""
    } else {
        STATE.m2_lock_state = "not_owner"
    }
}

// D-M4-03 (r8)：磁盘权威同技工跨任务冲突扫描，runCommandBound 步骤 4 与
// commitBound 提交点复核共用同一份实现。cc={tech,startMs,endMs,exclude_ids}。
// 返回 {error, conflict}：tasks.json 存在但读/解析失败 → error=true（fail-
// closed，调用方显式拒）；文件不存在 = 全新空盘，按无冲突处理；相邻时段
// （start==other.end / end==other.start）不算重叠。
fn _m4_disk_tech_conflict(cc, task_id){
    let _res = {error: false, conflict: false}
    let cc_tech = ""
    let cc_start = 0
    let cc_end = 0
    let cc_excl = nil
    if cc.tech != nil { cc_tech = cc.tech }
    if cc.startMs != nil { cc_start = cc.startMs }
    if cc.endMs != nil { cc_end = cc.endMs }
    if cc.exclude_ids != nil { cc_excl = cc.exclude_ids }
    if cc_tech == "" { return _res }
    if cc_end <= cc_start { return _res }
    // 权威重读：尽量走磁盘，即便 lock 不可靠也能拿到最新 TASKS
    let _disk_tasks = nil
    if fs.exists("tasks.json") {
        try {
            let _raw = fs.read("tasks.json")
            _disk_tasks = _raw.parse_json()
        } catch _ { _disk_tasks = nil }
        // 权威盘存在但读取/解析失败 ≠ 无冲突 —— 显式 error（坏盘明确拒），
        // 不把异常吞成"未发现冲突"放行提交。文件不存在 = 全新空盘（合法首次）。
        if _disk_tasks == nil { _res.error = true; return _res }
    }
    if _disk_tasks != nil {
        let _ti = 0
        while _ti < _disk_tasks.len() {
            let _other = _disk_tasks[_ti]
            if _other.appointments == nil { _ti = _ti + 1; continue }
            let _aj = 0
            while _aj < _other.appointments.len() {
                let _a = _other.appointments[_aj]
                // 同任务内即将被替换的 ID 集精确排除
                let _skip = false
                if _other.id == task_id && cc_excl != nil {
                    let _kk = 0
                    while _kk < cc_excl.len() {
                        if _a.id == cc_excl[_kk] { _skip = true; _kk = cc_excl.len() }
                        else { _kk = _kk + 1 }
                    }
                }
                if !_skip {
                    if _a.status == A_CONFIRMED || _a.status == A_PROPOSED {
                        if _a.tech == cc_tech {
                            if _a.startMs < cc_end {
                                if _a.endMs > cc_start { _res.conflict = true; _aj = _other.appointments.len(); _ti = _disk_tasks.len() }
                            }
                        }
                    }
                }
                _aj = _aj + 1
            }
            _ti = _ti + 1
        }
    }
    return _res
}

// M2 命令边界：单一入口。返回值 true = 允许调用者继续 mutate 并最终
// 调用 commitBound(...)；false = 已拒绝、已写拒绝回执、调用者必须 return。
fn runCommandBound(cmd, t, params, expected_version){
    // D-M4-03 (r6 修复轮)：纯内存 spec 的保存/清零必须覆盖授权出口 ——
    // 在 authorizeCommand 之前先把 STATE.m4_cross_check 拷到本地并清零全局；
    // 该操作纯内存、不产生任何业务持久写，授权拒绝 return 后也不会把旧
    // spec 留给下一次命令复用。（r5 注释声称在授权前，实际代码在授权后，
    // r6 Review 指出授权失败时 spec 仍残留；本轮把顺序落到实处。）
    let _cc = STATE.m4_cross_check
    STATE.m4_cross_check = nil
    _PENDING_CC = nil
    // D-M2-01: refreshed credentials/project/command authorization BEFORE lock/history/write.
    if !authorizeCommand(cmd,t,params) { fail("身份或项目角色无效；命令及旧回执均拒绝"); return false }
    // D-M2-03 (r8)：历史含坏行（actions/events 写已冻结）时整个命令禁写 ——
    // 不允许"任务照写、回执/事件被静默跳过"的部分提交；修复坏行后重启才放行。
    if M2_ACTIONS_DIRTY || M2_EVENTS_DIRTY {
        STATE.status = "拒绝：历史含坏行，业务写已冻结；请按 .bad_lines 修复后重启"
        saveState()
        return false
    }
    // D-M2-03 (r11)：H4 恢复屏障消费 —— 每次命令前先尝试收敛未决事务（登录
    // 授权后幂等补投影）；仍 pending 则普通命令禁写并记拒绝回执，绝不绕过
    // 恢复屏障写业务、绝不显示成功。
    if STATE.hf_recovery_pending == true { hf_recover_commits() }
    if STATE.hf_recovery_pending == true {
        let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                     task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                     status: "rejected", reason: "hf_recovery_pending：存在未收敛事务，业务写阻断；" + M2_RECOVERY_NOTICE, at: nowMs()}
        RECEIPTS.push(entry)
        saveReceipts()
        fail("存在未收敛事务，业务写阻断；请按提示人工核对 tx/ 或重启")
        return false
    }
    // M4 r8 (B-M4-01)：任务文件恢复未决 → 普通命令整体禁写（授权之后、取锁
    // 之前显式拒绝并写拒绝回执，事实与回执一致；恢复走专用入口，核可信权限）。
    if STATE.tasks_pending_recovery == true {
        let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                     task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                     status: "rejected", reason: "tasks_pending_recovery：任务文件恢复未决，普通命令禁写；请先用恢复入口", at: nowMs()}
        RECEIPTS.push(entry)
        saveReceipts()
        fail("tasks_pending_recovery：任务文件恢复未决，普通命令禁写")
        return false
    }
    // D-M2-05：先抢锁。两个独立上下文同目录时只有一个能进入提交阶段。
    let locked = _acquireTaskLock()
    let lock_lost = !locked
    // D-M2-02 修复：先查原动作 receipt——按 (actor, key, task_id, cmd) 命中 final；
    //   同 key 同 fp → 直接返回原 action_id + 原 result，不重做 commit/version++；
    //   同 key 异 fp → conflict（接受同 key 新 payload 走必须先用不同 key）；
    //   较新任务版本不抹掉旧动作回执。
    let fp = fingerprint(cmd, t, params)
    let _prior = findReceiptByKey(LAST_KEY, t.id, cmd)
    if _prior != nil {
        if _prior.status == "final" || _prior.status == "final_recovered" {
            if _prior.fp == fp {
                // D-M2-02/D-M2-04 修复(r5):命中 final 同 fp 必须返回原
                // action_id + 完整原 result,绝不允许再重做 commit/version++。
                // 通过 STATE.last_idem_hit 暴露给 caller/UI;较新任务版本不抹
                // 掉旧动作回执。
                STATE.last_idem_hit = {action_id: _prior.action_id,
                                       status: _prior.status,
                                       result: _prior.result,
                                       at: nowMs()}
                STATE.status = "原动作已 final（action_id=" + _prior.action_id + "），按稳定键 / fp 查询"
                saveState()
                if locked { _releaseTaskLock() }
                return false
            }
            let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                         task_id: t.id, fp: fp, expected_version: expected_version,
                         status: "rejected", reason: "idem_conflict：同 key 不同 payload",
                         at: nowMs()}
            RECEIPTS.push(entry)
            saveReceipts()
            if locked { _releaseTaskLock() }
            fail("idem_conflict：同 key 不同 payload；原 action_id=" + _prior.action_id)
            return false
        }
        // 命中 pending/needs_verify/superseded 等非 final:由 caller 自行按
        // bootReconcilePending 流程收敛,不直接当 hit 处理。
    }
    // 2. 项目匹配
    if STATE.project != t.project {
        let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                     task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                     status: "rejected", reason: "cross_project：current=" + STATE.project + " task=" + t.project,
                     at: nowMs()}
        RECEIPTS.push(entry)
        saveReceipts()
        if locked { _releaseTaskLock() }
        fail("cross_project：current=" + STATE.project + " task=" + t.project)
        return false
    }
    // 3. 期望版本（独立再读一次，避免内存陈旧 + 跨上下文竞争）
    let live_ver = latestTaskVersion(t.id)
    if live_ver != expected_version {
        let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                     task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                     status: "rejected", reason: "version_mismatch：current=" + live_ver.to_string() + " expected=" + expected_version.to_string(),
                     at: nowMs()}
        RECEIPTS.push(entry)
        saveReceipts()
        if locked { _releaseTaskLock() }
        fail("version_mismatch：current=" + live_ver.to_string() + " expected=" + expected_version.to_string())
        return false
    }
    // D-M2-05：抢不到锁的进程直接 version_mismatch 退出，不让两者都进 commit。
    if lock_lost {
        let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                     task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                     status: "rejected", reason: "concurrency_lost：tasks.lock 已被占",
                     at: nowMs()}
        RECEIPTS.push(entry)
        saveReceipts()
        fail("concurrency_lost：另一独立上下文已持有 tasks.lock")
        return false
    }
    // 4. 命令源状态
    if !sourceOk(cmd, t) {
        let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                     task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                     status: "rejected", reason: "source_state_invalid：" + cmd + " 不允许从 " + t.status,
                     at: nowMs()}
        RECEIPTS.push(entry)
        saveReceipts()
        if locked { _releaseTaskLock() }
        fail("source_state_invalid：" + cmd + " 不允许从 " + t.status)
        return false
    }
    // D-M4-03 (r4 修复轮)：跨任务跨项目同技工冲突重读。appointment 系命令
    // （confirmAppointment/proposeAppointment/rescheduleAppointment/
    // cancelAppointment）调用方在调用 runCommandBound 前把冲突上下文写入
    // STATE.m4_cross_check={tech, startMs, endMs, exclude_ids}。即便宿主 fs
    // 没有真原子锁（HOST_PRIMITIVE_BLOCKED），此处仍权威重读 tasks.json
    // 并重新走 hasTechConflict 兜底，确保"check 在锁内"+"以磁盘为准"，而
    // 不是仅核对内存快照 + 目标任务 version。命中冲突 → 释放锁、写 receipt、
    // 拒绝当前命令，旧任务/预约/历史均不变（调用方后续 if runCommandBound ==
    // false { return } 自然不进入 mutate 路径）。
    // _cc 已在入栈处拷到本地（line 2556-2557），此处直接判别与使用。
    if _cc != nil {
        // D-M4-03 (r8)：扫描实现抽到 _m4_disk_tech_conflict（与 commitBound
        // 提交点复核共用）；语义不变：盘存在但不可读 = fail-closed 拒绝，
        // 盘不存在 = 全新空盘按无冲突处理，同任务 exclude_ids 精确排除。
        let _ccr = _m4_disk_tech_conflict(_cc, t.id)
        if _ccr.error {
            let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                         task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                         status: "rejected", reason: "authority_unreadable：tasks.json 存在但读取/解析失败，冲突不可判定", at: nowMs()}
            RECEIPTS.push(entry)
            saveReceipts()
            if locked { _releaseTaskLock() }
            fail("authority_unreadable：tasks.json 读取/解析失败；拒绝提交，旧任务/预约保持不变")
            return false
        }
        if _ccr.conflict {
            let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                         task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                         status: "rejected", reason: "tech_conflict：与同技工跨任务预约重叠（runCommandBound 内权威重读）",
                         at: nowMs()}
            RECEIPTS.push(entry)
            saveReceipts()
            if locked { _releaseTaskLock() }
            fail("tech_conflict：与同技工跨任务预约重叠（重读自 tasks.json）")
            return false
        }
    }
    // D-M4-03 (r8)：冲突 spec 传递给 commitBound —— 提交点写盘前最后一刻用
    // 同一份磁盘扫描复核，缩小"锁内检查到实际写盘"竞争窗口；commitBound 消费后清零。
    _PENDING_CC = _cc
    // 5. 把"待办"上下文存到全局；commitBound 通过这些字段定位 receipt_id 并 finalize。
    _PENDING_CMD = cmd
    _PENDING_RESULT = {status: t.status, task_id: t.id}
    _PENDING_RECEIPT_ID = ""  // runCommand 内 idempotency hit/conflict 时不写 receipt
    let command_allowed = runCommand(cmd, t, params, {status: t.status})
    return command_allowed
}

// 拒绝回执 = 当前 LAST_KEY 对应的 receipt 改 status = "rejected"，或新增 reject 项。
fn rejectReceipt(cmd, t, reason, params, expected_version){
    let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                 task_id: t.id, fp: fingerprint(cmd, t, params), expected_version: expected_version,
                 status: "rejected", reason: reason, at: nowMs()}
    RECEIPTS.push(entry)
    saveReceipts()
}
// 把最近一条以 LAST_KEY / cmd 为准的收据标记成 final 或 needs_verify。
fn finalizeLastReceipt(cmd, final_status, result){
    let i = RECEIPTS.len() - 1
    while i >= 0 {
        let r = RECEIPTS[i]
        if r.command == cmd {
            if r.task_id != nil {
                // 当前任务的最近一条
                let t = currentTask()
                if t == nil {
                    if r.task_id == "" { i = -1; break }
                } else {
                    if r.task_id == t.id {
                        r.status = final_status
                        r.result = result
                        r.finalized_at = nowMs()
                        saveReceipts()
                        return
                    }
                }
            }
        }
        i = i - 1
    }
    // 没找到：直接落一条 final 收据（极少见兜底）
    let t = currentTask()
    let tid = ""
    if t != nil { tid = t.id }
    let entry = {action_id: newId(), key: LAST_KEY, actor: sessionActor(), command: cmd,
                 task_id: tid, status: final_status, result: result, at: nowMs()}
    RECEIPTS.push(entry)
    saveReceipts()
}

// 把 pending receipt 状态改成 final / needs_verify。
// D-M2-04 修复：必须按唯一 action_id (rid) 精确匹配；找不到时绝不"按 cmd 回退"，
// 避免不同 task / actor 的旧 final receipt 被本次写错覆盖。
fn _setReceiptStatusFinal(final_status, result){
    let rid = _PENDING_RECEIPT_ID
    let i = 0
    let matched = false
    while i < RECEIPTS.len() {
        if rid != "" {
            if RECEIPTS[i].action_id == rid {
                RECEIPTS[i].status = final_status
                RECEIPTS[i].result = result
                RECEIPTS[i].finalized_at = nowMs()
                matched = true
                break
            }
        }
        i = i + 1
    }
    if matched {
        // D-M2-03 (r8)：内存命中但回执未真实落盘 ≠ 已 finalize —— 返回 false，
        // 让 commitBound 按"结果未知"处理，不把保存失败包装成 committed。
        let _saved = saveReceipts()
        if !_saved { return false }
    } else {
        // D-M2-04 修复(r5):精确 rid 找不到时,绝不"按 cmd 回退"生成 final
        // 收据;只记 orphan needs_verify 占位,让 caller 通过 commitBound 返
        // 回值知道"未对账"。绝不允许凭内存构造 status=final 收据。
        let t = currentTask()
        let tid = ""
        if t != nil { tid = t.id }
        RECEIPTS.push({action_id: newId(), key: LAST_KEY, actor: sessionActor(),
                       command: _PENDING_CMD, task_id: tid, status: "needs_verify",
                       result: result, finalized_at: nowMs(),
                       note: "orphan: pending rid 未匹配；保留原 receipt 不变；caller 需走 bootReconcilePending"})
        saveReceipts()
    }
    return matched
}

// M2 提交边界：原子写读 + 独立核对 + finalize 回执。
// 调用者已 mutate t.status / t.assignee 等并调用 t.version = t.version + 1。
fn commitBound(t, expected_version, cmd, result){
    // D-M4-03 (r8)：消费 runCommandBound 传入的冲突 spec（本函数出口单一，
    // 进入即清零，避免残留给下一次命令）。
    let _cc_commit = _PENDING_CC
    _PENDING_CC = nil
    if !authorizeTask(t) { fail("提交前身份或项目角色失效"); _releaseTaskLock(); return false }
    // D-M2-03 (r8)：脏历史冻结时禁止提交任务主写 —— 否则回执/事件写被跳过
    // 而 tasks.json 已变更，构成业务上的部分提交。
    if M2_ACTIONS_DIRTY || M2_EVENTS_DIRTY {
        STATE.status = "拒绝提交：历史含坏行，业务写已冻结；请按 .bad_lines 修复后重启"
        saveState()
        _releaseTaskLock()
        return false
    }
    // D-M4-03 (r7 修复轮)：提交前复核锁归属升级为完整 token 全等 ——
    // tasks.lock 非空且不等于本进程持有 token 时绝不写 tasks.json（同 actor 的
    // 另一独立上下文也不再放行），记 needs_verify 待对账；锁读失败 = 权威
    // 未知，同样显式拒、不写盘。真原子互斥仍需宿主 fs 原语
    // （HOST_PRIMITIVE_BLOCKED，见 _acquireTaskLock），本检查只缩小竞争窗口。
    // D-M4-03 (r8)：获取/提交/释放守同一 owner token —— 本进程未持锁
    // （token 空）直接拒写；锁文件不存在/读失败/内容与本 token 不全等
    // （含被他人清空成 ""）一律按权威未知拒写。首次缺锁仅在 acquire 入口
    // 允许（见 _acquireTaskLock），提交点锁必须仍是本进程 token。
    let _lk_token = STATE.m2_lock_token
    if _lk_token == nil { _lk_token = "" }
    if _lk_token == "" {
        _setReceiptStatusFinal("needs_verify", t.to_json())
        STATE.status = "待核验：提交时本进程未持有 tasks.lock token；未写盘，按 receipt_id 查询原结果"
        saveState()
        _releaseTaskLock()
        return false
    }
    let _lk = ""
    let _lk_read_ok = true
    if fs.exists("tasks.lock") {
        try { _lk = fs.read("tasks.lock") } catch _ { _lk_read_ok = false }
    } else { _lk_read_ok = false }
    if !_lk_read_ok {
        _setReceiptStatusFinal("needs_verify", t.to_json())
        STATE.status = "待核验：提交前 tasks.lock 不存在或读取失败；未写盘，按 receipt_id 查询原结果"
        saveState()
        _releaseTaskLock()
        return false
    }
    if _lk != _lk_token {
        _setReceiptStatusFinal("needs_verify", t.to_json())
        STATE.status = "待核验：提交前锁非本进程 token（被清空/被覆盖/他人持有）；未写盘，按 receipt_id 查询原结果"
        saveState()
        _releaseTaskLock()
        return false
    }
    // D-M4-03 (r8)：写盘前最后一刻以磁盘为准复核版本，缩小"锁内检查到写盘"
    // 竞争窗口。盘无此任务且 expected_version==0 = 合法首次创建（盘存在但
    // 解析失败 ≠ 空盘，fail-closed 拒）；盘无此任务且 expected>0 = 任务已被
    // 移除/盘异常，拒；盘版本 != expected = 并发漂移，拒。
    let _dv = nil
    try { _dv = readTaskByIdFromDisk(t.id) } catch { _dv = nil }
    if _dv == nil {
        if expected_version != 0 {
            _setReceiptStatusFinal("needs_verify", t.to_json())
            STATE.status = "待核验：提交前权威盘无此任务（id=" + t.id + "）；未写盘，按 receipt_id 查询原结果"
            saveState()
            _releaseTaskLock()
            return false
        }
        if fs.exists("tasks.json") {
            let _dp = nil
            try { _dp = fs.read("tasks.json").parse_json() } catch { _dp = nil }
            if !m7_is_array_value(_dp) {
                _setReceiptStatusFinal("needs_verify", t.to_json())
                STATE.status = "待核验：创建前权威盘存在但不可解析；未写盘，按 receipt_id 查询原结果"
                saveState()
                _releaseTaskLock()
                return false
            }
        }
    } else {
        let _dver = -1
        try { _dver = _dv.version } catch { _dver = -1 }
        if _dver != expected_version {
            _setReceiptStatusFinal("needs_verify", t.to_json())
            STATE.status = "待核验：提交前盘版本漂移（disk=" + _dver.to_string() + " expected=" + expected_version.to_string() + "）；未写盘，按 receipt_id 查询原结果"
            saveState()
            _releaseTaskLock()
            return false
        }
    }
    // D-M4-03 (r8)：跨任务冲突复核推进到提交点（写盘前最后一刻），与
    // runCommandBound 步骤 4 共用 _m4_disk_tech_conflict 同一份磁盘扫描。
    if _cc_commit != nil {
        let _ccr2 = _m4_disk_tech_conflict(_cc_commit, t.id)
        if _ccr2.error {
            _setReceiptStatusFinal("needs_verify", t.to_json())
            STATE.status = "待核验：提交点 tasks.json 读取/解析失败，冲突不可判定；未写盘，按 receipt_id 查询原结果"
            saveState()
            _releaseTaskLock()
            return false
        }
        if _ccr2.conflict {
            _setReceiptStatusFinal("needs_verify", t.to_json())
            STATE.status = "待核验：提交点发现同技工跨任务预约重叠（权威重读）；未写盘，按 receipt_id 查询原结果"
            saveState()
            _releaseTaskLock()
            return false
        }
    }
    // D-M2-05：提交完成（无论成功 / 失败 / 拒核验）必须释放锁。
    let committed = false
    if t.version != expected_version + 1 {
        // 内部 version 漂移：标记 needs_verify
        // D-M2-04 修复:同样的 after-state 原则;即使写盘失败,result 也用
        // t 当前状态(memory committed_state)代替 _PENDING_RESULT(commit 前)。
        let matched = _setReceiptStatusFinal("needs_verify", t.to_json())
        if !matched {
            STATE.status = "待核验（internal drift，action_id 未匹配）：任务 " + t.id
        } else {
            STATE.status = "待核验（internal drift）：任务 " + t.id
        }
        saveState()
        committed = false
    } else {
        // 原子写：用 tmp + 主体 + clear-tmp 让宿主 fs 实现的最佳顺序写入。
        // 不宣称真原子；只是降低半写概率。
        let tmp_ok = true
        let main_ok = true
        let _main_payload = ""
        try { fs.write("tasks.json.tmp", TASKS.to_json()) } catch { tmp_ok = false }
        if !tmp_ok {
            // D-M2-04 修复:after-state result 原则。
            _setReceiptStatusFinal("needs_verify", t.to_json())
            STATE.status = "待核验：tmp 写入失败"
            saveState()
            committed = false
        } else {
            // M7 r7 (R-M7-02)：恢复未决时原子写主文件被拒，按写失败进 needs_verify
            if STATE.tasks_pending_recovery == true { main_ok = false } else {
                _main_payload = TASKS.to_json()
                try { fs.write("tasks.json", _main_payload) } catch { main_ok = false }
            }
            if !main_ok {
                // D-M2-04 修复:after-state result 原则。
                _setReceiptStatusFinal("needs_verify", t.to_json())
                STATE.status = "待核验：tasks.json 写入失败"
                saveState()
                committed = false
            } else {
                // D-M2-03 (r10)：清 tmp 写显式消费 —— 失败不改变已核验的提交
                // 事实，但如实记入 final 回执 note（下方 matched 分支），不静默。
                let _ct_ok = true
                try { fs.write("tasks.json.tmp", "") } catch { _ct_ok = false }
                // 独立读回核对。D-M2-04 (r10)：version/status 两字段相似不构成
                // 提交事实；确认修复(r13)：**不得**用 rb.to_json()==t.to_json() 判等
                // —— 宿主 map 迭代顺序（同源 VM heap.rs map_iter 非排序）使解析
                // 回环后键序改变，同一对象重序列化字符串不等（已复现：
                // [t].to_json().parse_json()[0].to_json() != t.to_json()）。
                // 改用落盘整文件字节与本次写入字节全等核对，并保留 id/version/
                // status 字段级独立核验；不放宽字段。
                let rb = nil
                try { rb = readTaskByIdFromDisk(t.id) } catch { rb = nil }
                let matched = false
                if rb != nil {
                    if rb.id == t.id {
                        if rb.version == t.version {
                            if rb.status == t.status {
                                let _full_eq = false
                                try { if fs.read("tasks.json") == _main_payload { _full_eq = true } } catch { _full_eq = false }
                                if _full_eq { matched = true }
                            }
                        }
                    }
                }
                if matched {
                    // D-M2-04 修复:final.result 取自"提交后从盘独立核对"的 after 事实,
                    // 即 t 当前内存状态(已 mutate+version++) 就是落盘事实。绝不
                    // 把 _PENDING_RESULT(commit 前快照)当 final。
                    // D-M2-04 (r6)：写盘+读回一致还不够——final 回执必须精确命中
                    // 本次 action_id (rid)；rid 缺失时返回明确未知，不显示成功。
                    let _fin_matched = _setReceiptStatusFinal("final", t.to_json())
                    if _fin_matched {
                        committed = true
                        if !_ct_ok {
                            // D-M2-03 (r10)：清 tmp 失败如实记入回执 note；
                            // 提交事实（主写+读回全等）已成立，不假报也不静默。
                            let _ni = 0
                            while _ni < RECEIPTS.len() {
                                if RECEIPTS[_ni].action_id == _PENDING_RECEIPT_ID {
                                    RECEIPTS[_ni].note = "tasks.json.tmp 清理失败：提交事实已核验成立，tmp 残留请人工清理"
                                    _ni = RECEIPTS.len()
                                }
                                _ni = _ni + 1
                            }
                            saveReceipts()
                        }
                    } else {
                        STATE.status = "未知：任务已写盘且读回一致，但 final 回执 action_id 未匹配；按 boot 对账查询原动作，勿重复操作"
                        saveState()
                        committed = false
                    }
                } else {
                    // D-M2-04 修复:needs_verify 也按已 mutate 的 after 状态记录,
                    // 反映"已写盘但 read-back 不匹配"的真实情况。
                    _setReceiptStatusFinal("needs_verify", t.to_json())
                    STATE.status = "待核验：写入后 read-back 不匹配；按 receipt_id 查询原结果"
                    saveState()
                    committed = false
                }
            }
        }
    }
    // D-M2-05：释放锁。
    _releaseTaskLock()
    return committed
}

// 启动期对账：扫所有 status=pending 的 receipt —— pending 表示已记但 commit
// 中断完成；按 receipt_id 找对应 task 最新 version。
// D-M2-03/D-M2-04 (r6)：
//   a) needs_verify 也按盘对账——查动作而非只看当前 version：盘 version ==
//      expected+1 且状态与 after 一致 → 确认已提交（final_recovered），并补齐
//      缺失事件；version == expected → 确定未提交（pending_orphan）；其余保留
//      needs_verify 待人工核对。合法后续版本不抹掉原动作回执。
//   b) final / final_recovered 收据若 EVENT_LOG 里没有同 action_id 的事件 →
//      追加一条 recovered 补齐事件（来源=收据 after，不重复业务写）。
// D-M2-01 修复(r7)：恢复/对账逐 task 核当前项目权限；会话活跃不等于授权。
// 被移除项目角色或跨项目的任务，其 receipt 保持原状，不在本会话恢复/补齐。
fn _m2_reconcile_allowed(tid){
    let _t = findTaskById(tid)
    if _t == nil { return false }
    if STATE.project != _t.project { return false }
    if !visible(_t, getMe()) { return false }
    return true
}
fn bootReconcilePending(){
    if !identityActive(sessionActor()) { return }
    let i = 0
    let recovered = 0
    while i < RECEIPTS.len() {
        let r = RECEIPTS[i]
        if r.status == "pending" {
            let tid = r.task_id
            if tid == nil { tid = "" }
            if tid != "" {
                if !_m2_reconcile_allowed(tid) { i = i + 1; continue }
                // D-M6-04 (r8)：togglePin 收藏不递增业务 version，「盘版本 == 预期」
                // 不能判「确定未提交」——已写偏好会被误判 pending_orphan 遭盲重做。
                // 无 after 事实可查，一律保持未知；由 m6_reconcile_marker_boot 按
                // 固定 key（主体/任务/预期 pinnedBy）核权威偏好事实收敛。
                if r.command == "togglePin" {
                    r.status = "needs_verify"
                    r.note = "boot_reconcile：togglePin 不递增版本，版本判据不适用且回执无预期偏好事实；提交与否未知，按 action_id / m6_reconcile_needed.json 对账，禁止盲重做"
                    recovered = recovered + 1
                    i = i + 1
                    continue
                }
                let latest = latestTaskVersion(tid)
                if latest == r.expected_version {
                    r.status = "pending_orphan"
                    r.note = "boot_reconcile：任务版本未变；该动作确定未提交，可按原 key 安全重试"
                    recovered = recovered + 1
                } else {
                    // D-M2-04 (r8)：pending 没有 after 事实 —— 版本升高既可能是
                    // 本动作已提交也可能是无关后续动作，一律保持未知待人工核对；
                    // 绝不按版本大小猜"已被覆盖(superseded)"，也不猜"已提交"。
                    r.status = "needs_verify"
                    r.note = "boot_reconcile：盘版本(" + latest.to_string() + ")已越过预期(" + r.expected_version.to_string() + ")；pending 无 after 事实，不判成功亦不判被覆盖；请按 action_id 人工核对原动作"
                    recovered = recovered + 1
                }
            }
        }
        i = i + 1
    }
    // (a) needs_verify 按盘对账：读盘独立核对，不靠内存 TASKS
    i = 0
    while i < RECEIPTS.len() {
        let r = RECEIPTS[i]
        if r.status == "needs_verify" {
            let tid = r.task_id
            if tid == nil { tid = "" }
            if tid != "" {
                if !_m2_reconcile_allowed(tid) { i = i + 1; continue }
                // D-M6-04 (r8)：togglePin 不走 version/after 通用判据（收藏不递增
                // version）；由 m6_reconcile_marker_boot 按固定 key 核 pinnedBy。
                if r.command == "togglePin" { i = i + 1; continue }
                let disk_t = readTaskByIdFromDisk(tid)
                if disk_t != nil {
                    let ev0 = 0
                    if r.expected_version != nil { ev0 = r.expected_version }
                    if disk_t.version == ev0 + 1 {
                        // D-M2-04 (r10)：版本号 +1 不构成"本动作已提交"证明 —— 无关
                        // 动作同样会让版本 +1。必须把回执保存的完整 after 事实与盘
                        // 面规范 JSON 逐字节全等核对才允许 final_recovered；不一致
                        // = 无关动作造成，保持未知。
                        let _after = nil
                        if r.result != nil {
                            try { _after = r.result.parse_json() } catch { _after = nil }
                        }
                        let _match = false
                        if _after != nil {
                            // D-M2-04 (r10 修复轮，对 r11 Review)：version/status/
                            // assignee 三字段相似不构成原动作证明 —— 无关动作同样
                            // 能让这三字段巧合相符。必须回执保存的完整 after 与盘
                            // 面规范 JSON 逐字节全等才允许 final_recovered；同三
                            // 字段但完整 after 不同 = 无关动作，保持 unknown。
                            let _full_eq2 = false
                            try { if _after.to_json() == disk_t.to_json() { _full_eq2 = true } } catch { _full_eq2 = false }
                            if _full_eq2 { _match = true }
                        }
                        if _match {
                            r.status = "final_recovered"
                            r.note = "boot_reconcile：盘面对账确认已提交（version=expected+1 且 after 事实全等）；原 action_id 结果可查"
                            recovered = recovered + 1
                        } else {
                            r.note = "boot_reconcile：盘版本虽为 expected+1，但事实与回执 after 不符（可能为无关动作）；保持未知，按 action_id 人工核对"
                        }
                    } else {
                        if disk_t.version == ev0 {
                            r.status = "pending_orphan"
                            r.note = "boot_reconcile：盘面对账确认未提交（version 未变）；可按原 key 安全重试"
                            recovered = recovered + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    // (b) final/final_recovered 缺事件补齐（按 action_id 精确匹配，不重复业务写）
    let events_added = 0
    i = 0
    while i < RECEIPTS.len() {
        let r = RECEIPTS[i]
        if r.status == "final" || r.status == "final_recovered" {
            let _tid2 = r.task_id
            if _tid2 == nil { _tid2 = "" }
            if _tid2 != "" {
                if !_m2_reconcile_allowed(_tid2) { i = i + 1; continue }
            }
            let _has_ev = false
            let ei = 0
            while ei < EVENT_LOG.len() {
                let _e = EVENT_LOG[ei]
                if _e.action_id != nil {
                    if _e.action_id == r.action_id { _has_ev = true; ei = EVENT_LOG.len() }
                }
                ei = ei + 1
            }
            if !_has_ev {
                let _evv0 = 0
                if r.expected_version != nil { _evv0 = r.expected_version }
                EVENT_LOG.push({at: nowMs(), kind: r.command + "_recovered",
                                actor: r.actor, task_id: r.task_id,
                                action_id: r.action_id,
                                task_version: _evv0 + 1,
                                after: r.result,
                                note: "boot_reconcile：final 收据缺事件，按收据 after 补齐；未重复业务写"})
                events_added = events_added + 1
            }
        }
        i = i + 1
    }
    // D-M2-03 (r8)：补齐事件只在真实落盘后才计数/报告；保存失败不累计"已补齐"，
    // 可见状态如实置为待核验，绝不在事件缺失时显示已恢复成功。
    if events_added > 0 {
        let _ev_saved = saveEvents()
        if _ev_saved {
            recovered = recovered + events_added
        } else {
            STATE.status = "待核验：对账补齐事件未能落盘（" + events_added.to_string() + " 条）；事实未收敛，请按 events.jsonl 检查后重启"
            saveState()
        }
    }
    if recovered > 0 {
        let _rc_saved = saveReceipts()
        if _rc_saved {
            STATE.status = "对账：处理 " + recovered.to_string() + " 条 pending/needs_verify receipt 或补齐事件；UI 可见 '待核验'"
        } else {
            STATE.status = "待核验：对账结果未能落盘（回执保存失败）；重启后将重新对账，请勿重复业务操作"
        }
        saveState()
    }
    // D-M6-04 (r8)：消费收藏对账标记 —— 按固定 key 核权威 pinnedBy 事实，
    // 成功清理，未知保留（详见 m6_reconcile_marker_boot）。
    m6_reconcile_marker_boot()
    return recovered
}

// 兼容旧演示按钮：仅保留展示标签，不建立或更换会话。
fn setActorM2(id){
    STATE.demo_view_as=id
    STATE.status="展示标签已改变；登录主体未改变"
    saveState()
}

// 启动对账
// D-M2-01 修复(r7)：bootReconcilePending() 移到脚本末尾集中初始化块，
// 必须在 load() 读完持久回执之后执行；此处不再提前调用。

// M1 r1：迁移 fallback——若 STATE 已有 selected_task_id 但旧版本没有，沿用旧 selectedIdx
// 选最近一个可见任务；若选中任务当前主体不可见，回退到首个可见任务。
fn _m1_init_selection(){
    if STATE.selected_task_id == "" {
        let si = STATE.selectedIdx
        if si != nil {
            if si >= 0 {
                if si < TASKS.len() {
                    STATE.selected_task_id = TASKS[si].id
                }
            }
        }
    }
    ensureSelectionVisible()
    if STATE.selectedIdx == nil { STATE.selectedIdx = 0 }
}

// ─── 幂等 ───────────────────────────────────────────────
fn fingerprint(cmd, t, params){
    let base = {command: cmd, actor: sessionActor(), project: t.project, task: t.id, params: params}
    return base.to_json()
}
fn receiptFor(key, fp){
    if !identityActive(sessionActor()) { return {kind:"denied"} }
    for r in RECEIPTS {
        if r.actor == sessionActor() {
            if r.key == key {
                // D-M2-02/D-M2-04 (r8)：rejected = 未执行的拒绝记录，不构成
                // 已占用意图；pending_orphan = 对账确定未提交 —— 两者都按 miss
                // 处理，允许持原 key 安全重试（未提交原 key 继续出口）。
                if r.status == "rejected" { continue }
                if r.status == "pending_orphan" { continue }
                let task=findTaskById(r.task_id)
                if !authorizeTask(task) { return {kind:"denied"} }
                // D-M2-04 (r6)：只有 status=final / final_recovered（盘面对账确
                // 认的已提交）的原动作才能当 hit 返回原结果；
                // pending/needs_verify/superseded 等一律 unknown，由调用方走对账
                // 查询，绝不把未知当成功、也不重复业务写。
                if r.fp == fp {
                    if r.status == "final" { return {kind: "hit", receipt: r} }
                    if r.status == "final_recovered" { return {kind: "hit", receipt: r} }
                    return {kind: "unknown", receipt: r}
                }
                if r.status == "final" { return {kind: "conflict", receipt: r} }
                if r.status == "final_recovered" { return {kind: "conflict", receipt: r} }
                return {kind: "unknown", receipt: r}
            }
        }
    }
    return {kind: "miss"}
}
// D-M2-04 修复：recordReceipt 现在写 status="pending" + expected_version，使
// bootReconcilePending 能识别未完成回执；final / needs_verify 由 commitBound
// 通过 _PENDING_RECEIPT_ID 命中同一行精确改写。绝不覆盖其它回执。
fn recordReceipt(key, cmd, t, fp, result, expected_version){
    let rid = newId()
    _PENDING_RECEIPT_ID = rid
    // D-M2-03 (r6)：mutation 前保存权威 before 快照（盘上任务当前状态），
    // 与 after(final.result) 一起构成可核对的动作日志；中断后据此判定
    // "未提交"或"已提交待补齐"。
    RECEIPTS.push({action_id: rid,
                   key: key,
                   actor: sessionActor(),
                   command: cmd,
                   task_id: t.id,
                   fp: fp,
                   expected_version: expected_version,
                   status: "pending",
                   params: result,
                   before: t.to_json(),
                   at: nowMs()})
    // D-M2-03 (r9)：pending 回执保存结果必须消费 —— 未落盘则内存也不留
    // （避免后续 saveReceipts 把从未落盘的 pending 补写进权威历史），返回
    // false 让调用方按「未进入业务写」fail-closed，绝不忽略返回继续提交。
    let _ok = saveReceipts()
    if !_ok {
        let _keep = []
        let _ri = 0
        while _ri < RECEIPTS.len() - 1 { _keep.push(RECEIPTS[_ri]); _ri = _ri + 1 }
        RECEIPTS = _keep
        _PENDING_RECEIPT_ID = ""
        STATE.status = "待核验：pending 回执未落盘；本次未进入业务写，请检查历史存储后重试"
        saveState()
    }
    return _ok
}

// D-M2-02 修复：按 (actor, key, task_id, cmd) 查原动作 final receipt，
// 用于 runCommandBound 早期命中（同 key 同 payload 重复提交）。不依赖 fp 字段。
fn findReceiptByKey(key, task_id, cmd){
    let i = 0
    while i < RECEIPTS.len() {
        let r = RECEIPTS[i]
        if r.actor == sessionActor() {
            if r.key == key {
                // D-M2-02/D-M2-04 (r8)：rejected（未执行）与 pending_orphan
                // （对账确定未提交）不占用意图键；原 key 可安全重试。
                if r.status == "rejected" { i = i + 1; continue }
                if r.status == "pending_orphan" { i = i + 1; continue }
                if r.task_id == task_id {
                    if r.command == cmd { return r }
                }
            }
        }
        i = i + 1
    }
    return nil
}

// ─── 命令边界与辅助 ─────────────────────────────────────
fn fail(msg){
    STATE.status = "拒绝：" + msg
    saveState()
}
fn currentTask(){
    if STATE.selectedIdx < 0 { return nil }
    if STATE.selectedIdx >= TASKS.len() { return nil }
    return TASKS[STATE.selectedIdx]
}
// 当前主体可见的任务下标列表。演示身份切换后必须按可见性过滤，
// 否则「报修人二」会看到「报修人一」的草稿；这只是前端展示过滤，
// 不等于宿主授权隔离，仍由宿主做最终访问控制。
fn visibleIndices(){
    let u = getMe()
    let out = []
    for i in 0..TASKS.len() {
        if visible(TASKS[i], u) { out.push(i) }
    }
    return out
}
fn firstVisibleIdx(){
    let idxs = visibleIndices()
    if idxs.len() == 0 { return -1 }
    return idxs[0]
}
fn stepVisible(from, dir){
    let idxs = visibleIndices()
    if idxs.len() == 0 { return -1 }
    let pos = -1
    for k in 0..idxs.len() {
        if idxs[k] == from { pos = k; break }
    }
    if pos < 0 { return idxs[0] }
    let np = pos + dir
    if np < 0 { return idxs[0] }
    if np >= idxs.len() { return idxs[idxs.len() - 1] }
    return idxs[np]
}
fn commit(t){
    // M2 提交边界：用 commitBound 完成原子写 + 独立读回核对 + 回执 finalize。
    // D-M2-03 修复：必须捕获 commitBound 返回值；false = 需要核对，绝不让调用方
    // 继续走 logEvent / "成功" STATE.status；true = 已落地，可继续。
    // D-M2-03 rollback 修复:失败时优先从盘独立 read-back 替换 t(磁盘为权威),
    // 避免 caller mutate 后 _snapshot 仍持有"已变更"状态的污染问题。
    let _expected_version = t.version
    let _snapshot = t.to_json()
    t.version = t.version + 1
    t.updatedAtMs = nowMs()
    let success_flag = commitBound(t, _expected_version, _PENDING_CMD, _PENDING_RESULT)
    // D-M2-03 (r6)：commit 成功暂存 action_id，供随后的 logEvent 关联；
    // 失败时清空，事件不会被错挂到上一次动作。
    if success_flag { _LAST_ACTION_ID = _PENDING_RECEIPT_ID } else { _LAST_ACTION_ID = "" }
    // 防止本次 commit 之后被误用 _pending_* 串到下一次
    _PENDING_CMD = ""
    _PENDING_RESULT = nil
    _PENDING_RECEIPT_ID = ""
    if !success_flag {
        // D-M2-03 优先从盘读权威事实替换内存 t,避免 caller mutate 后快照里仍
        // 是"已变更"字段。读失败再用 _snapshot 兜底。
        let _disk_t = readTaskByIdFromDisk(t.id)
        if _disk_t != nil {
            t.assignee = _disk_t.assignee
            t.status = _disk_t.status
            t.asset = _disk_t.asset
            t.appointments = _disk_t.appointments
            t.notes = _disk_t.notes
            t.evidence = _disk_t.evidence
            t.completions = _disk_t.completions
            t.version = _disk_t.version
            t.updatedAtMs = _disk_t.updatedAtMs
            t.pinnedBy = _disk_t.pinnedBy
        } else {
            let _old = nil
            try { _old = _snapshot.parse_json() } catch _ { _old = nil }
            if _old != nil {
                t.assignee = _old.assignee
                t.status = _old.status
                t.asset = _old.asset
                t.appointments = _old.appointments
                t.notes = _old.notes
                t.evidence = _old.evidence
                t.completions = _old.completions
                t.version = _old.version
                t.updatedAtMs = _old.updatedAtMs
                t.pinnedBy = _old.pinnedBy
            } else {
                t.version = _expected_version
            }
        }
        commitReturn = false
        return
    }
    commitReturn = true
}
// D-M2-03 配套：业务命令在 commit(t) 之后调用本函数；返回 false 表示提交失败，
// 必须立即 return，不要继续 logEvent / saveState / refreshLabels 发出"成功"事件。
fn commitSucceeded(){
    return commitReturn
}

// ─── M3 真实输入与AI报修 · 协议层 ───────────────────────
// 文件责任：raw 输入面板、AI 建议协议、版本绑定、人工确认到 M2 接线；AI 不
// 直写任务 / 不改变身份 / 不构造回执。所有 mutating 必须经 confirmDraftModelBound
// → M2 confirmDraft → M2 createDraft → M2 runCommandBound。
//
// 协议面：
//   bindRequestVersions / craftModelRequest / parseModelReturn /
//   validateSuggestion / applyDraftFromAI / editDraftField /
//   cancelAiRequest / confirmDraftModelBound / recordModelMeta

// 文本哈希：host 提供 text.concat；用 FNV-1a 32（不在宿主主流程，足够去标）。
fn _fnv1a_hash(s){
    let h = 2166136261
    if s == nil { return h }
    let n = _textLenSafe(s)
    let i = 0
    while i < n {
        let c = _charAtSafe(s, i)
        // c is single-byte or multibyte — wrap to byte representation
        // host 字符串字面量按 UTF-8 字节处理已确认；此处按 char-by-char OR
        h = (h ^ c) & 0xFFFFFFFF
        h = (h * 16777619) & 0xFFFFFFFF
        i = i + 1
    }
    return h
}

fn _hex32(n){
    let digits = "0123456789abcdef"
    let s = ""
    let i = 0
    let v = n
    while i < 8 {
        let d = v & 0xF
        s = _strSlice(digits, d, d + 1) + s
        v = v >> 4
        i = i + 1
    }
    return s
}

fn hashRawText(s){
    if s == nil { s = "" }
    return _hex32(_fnv1a_hash(s))
}

// 触发"提问"前调一次：快照 raw_input / draft / task / actor / project 版本。
fn bindRequestVersions(task_id){
    let now = nowMs()
    let raw_hash = hashRawText(TASK_INPUT.raw_text)
    let draft_v = PENDING_DRAFT.draft_version
    let task_v = 0
    if task_id != "" && task_id != nil {
        let lv = latestTaskVersion(task_id)
        if lv != nil { task_v = lv }
    } else {
        // 草稿未建任务：版本号由 pending_draft 承担
        task_v = -1   // sentinel "no task yet"
    }
    // D-M3-03：rid 同时绑定 issued_at + actor + project + raw_hash + draft_v；
    // 仅靠 raw_hash 不足以防切项目 / 切主体 / 关闭面板
    let rid = _hex32(_fnv1a_hash(now.to_string() + "|" + sessionActor() + "|" +
                                  STATE.project + "|" + raw_hash + "|" + draft_v.to_string() +
                                  "|" + PENDING_AI_REQUEST.request_version.to_string()))
    PENDING_AI_REQUEST.active = true
    PENDING_AI_REQUEST.request_id = rid
    PENDING_AI_REQUEST.request_version = PENDING_AI_REQUEST.request_version + 1
    PENDING_AI_REQUEST.issued_at_ms = now
    PENDING_AI_REQUEST.expected_actor = sessionActor()
    PENDING_AI_REQUEST.expected_project = STATE.project
    PENDING_AI_REQUEST.expected_raw_input_version = TASK_INPUT.raw_input_version
    PENDING_AI_REQUEST.expected_raw_text_hash = raw_hash
    PENDING_AI_REQUEST.expected_draft_version = draft_v
    PENDING_AI_REQUEST.expected_task_id = task_id
    PENDING_AI_REQUEST.expected_task_version = task_v
    // D-M3-03 (r6)：事实 / 证据版本一并绑定；回包时重算比对
    PENDING_AI_REQUEST.expected_facts_version = _currentFactsVersion()
    PENDING_AI_REQUEST.expected_evidence_version = _currentEvidenceVersion(task_id)
    PENDING_AI_REQUEST.expires_at_ms = now + MODEL_CONFIG.timeout_ms + 3000   // 给迟到缓冲
    PENDING_AI_REQUEST.provider_id = MODEL_CONFIG.provider_id
    PENDING_AI_REQUEST.model_id = MODEL_CONFIG.model_id
    return rid
}

// 构造发给模型的请求协议（main.splash 当前无 HTTP；返回的是结构化占位，
// 用于契约测试 + audit）。
fn craftModelRequest(){
    let sps = []
    for sp in SPACES {
        if sp.project == STATE.project { sps.push({id: sp.id, name: sp.name}) }
    }
    let asts = []
    for a_ in ASSETS {
        if a_.project == STATE.project && a_.active { asts.push({id: a_.id, code: a_.code, name: a_.name, category: a_.category}) }
    }
    return {
        request_id: PENDING_AI_REQUEST.request_id,
        expires_at_ms: PENDING_AI_REQUEST.expires_at_ms,
        actor: sessionActor(),
        project: STATE.project,
        raw_text: TASK_INPUT.raw_text,
        raw_input_version: TASK_INPUT.raw_input_version,
        pending_draft_version: PENDING_DRAFT.draft_version,
        spaces: sps,
        assets: asts,
        contacts: _contactWhitelist(),
        instructions: _modelInstructionText()
    }
}

fn _modelInstructionText(){
    // D-M3-01 (r6)：提示词必须携带本次绑定的真实值，模型逐字回声；
    // 不再用占位符让模型自行编造 request_id / expires / 版本号。
    let _tv = 0
    if PENDING_AI_REQUEST.expected_task_id != "" && PENDING_AI_REQUEST.expected_task_id != nil {
        _tv = PENDING_AI_REQUEST.expected_task_version
    }
    return "你是一个报修助手。把用户的中文描述解析成结构化 JSON。" +
        "本次请求的绑定值（必须原样回声，不得修改）：" +
        "request_id=" + PENDING_AI_REQUEST.request_id +
        "；expires_at_ms=" + PENDING_AI_REQUEST.expires_at_ms.to_string() +
        "；task_version=" + _tv.to_string() +
        "；draft_version=" + PENDING_DRAFT.draft_version.to_string() + "。" +
        "只输出以下字段：" +
        "{\"request_id\":\"" + PENDING_AI_REQUEST.request_id + "\"," +
        "\"expires_at_ms\":" + PENDING_AI_REQUEST.expires_at_ms.to_string() + "," +
        "\"task_version\":" + _tv.to_string() + ",\"draft_version\":" + PENDING_DRAFT.draft_version.to_string() + "," +
        "\"suggestion\":{\"problem\":\"...\",\"space_candidate_id\":...," +
        "\"asset_candidate_id\":...,\"asset_alternatives\":[...],\"category\":...," +
        "\"contact\":\"...\",\"desired_window\":\"YYYY-MM-DD HH:MM~YYYY-MM-DD HH:MM|null\"," +
        "\"sources\":{\"space\":\"...来源\",\"asset\":\"...来源\",\"category\":\"...来源\"}," +
        "\"missing_fields\":[...],\"ambiguous_fields\":[...],\"confidence\":\"high|medium|low\"}" +
        " sources 各项要么是字符串 \"unknown\"，要么是对象 " +
        "{\"fact_id\":\"<spaces/assets 清单里的真实 id>\",\"version\":N,\"quote\":\"<原文依据片段>\"}；" +
        "fact_id 必须来自本次注入的 spaces/assets 清单。" +
        " 严格：space_candidate_id / asset_candidate_id 必须是允许列表中真实存在的 id；" +
        "若不确定，给 null 并加入 missing_fields / ambiguous_fields。" +
        " 严禁自行编造设备 id 或推测维修根因。" +
        " 严禁发出写操作动词（createDraft / confirmDraft / bindAsset ...）。" +
        " 严禁返回 task_id / status / created_task_id 等写字段。"
}

fn _contactWhitelist(){
    let out = []
    for u in accountDirectory() {
        if u.id == sessionActor() {
            out.push({id: u.id, name: u.name})
        }
    }
    return out
}

fn _findSpace(id){
    if id == "" || id == nil { return nil }
    for sp in SPACES {
        if sp.id == id { return sp }
    }
    return nil
}

fn _findAsset(id){
    if id == "" || id == nil { return nil }
    for a_ in ASSETS {
        if a_.id == id { return a_ }
    }
    return nil
}

fn _isValidCategory(cat){
    if cat == nil { return true }
    if cat == "HVAC_NOT_COOLING" { return true }
    if cat == "ELECTRICAL" { return true }
    if cat == "" { return true }
    return false
}

// D-M3-03 (r6)：当前项目设备/空间事实版本 —— 对当前项目可见的 space/asset
// 事实（id + active + project + name/code）做 FNV-1a 指纹。任何事实增删 /
// 停用 / 改项目都会改变该版本；迟到回包在 validateSuggestion 里被拒。
fn _currentFactsVersion(){
    let acc = ""
    for sp in SPACES {
        if sp.project == STATE.project {
            acc = acc + "|sp:" + sp.id + ":" + sp.name
        }
    }
    for a_ in ASSETS {
        if a_.project == STATE.project {
            let _act = "0"
            if a_.active { _act = "1" }
            // D-M3-03 (r7)：指纹覆盖 category 与 services —— 服务关系 / 类目
            // 变化同样使旧建议失效（否则改服务关系后旧定位仍被采纳）。
            acc = acc + "|as:" + a_.id + ":" + _act + ":" + a_.code + ":" + a_.name +
                  ":" + a_.category + ":" + _strJoin(a_.services, ",")
        }
    }
    return _hex32(_fnv1a_hash(acc))
}

// D-M3-03 (r7)：采纳与首次确认共用的"当前绑定"校验 —— 比对采纳时快照的
// 任务版本 / 证据版本 / 事实版本；任一漂移返回原因，否则返回 ""。
// 手工草稿（无 apply_request_id）不做 AI 绑定校验。
fn _currentBindingStaleReason(){
    let src = PENDING_DRAFT.sources
    if src == nil { return "" }
    if !m7_is_object_value(src) { return "" }
    if src.apply_request_id == nil || src.apply_request_id == "" { return "" }
    if src.facts_version_at_apply != nil && src.facts_version_at_apply != "" {
        if _currentFactsVersion() != src.facts_version_at_apply {
            return "设备/空间事实已变化；建议基于旧事实，请重新请求 AI"
        }
    }
    let _tid = ""
    if src.task_id_at_apply != nil { _tid = src.task_id_at_apply }
    if _tid != "" {
        if src.task_version_at_apply != nil {
            if latestTaskVersion(_tid) != src.task_version_at_apply {
                return "绑定任务版本已变化；建议基于旧任务，请重新请求 AI"
            }
        }
        if src.evidence_version_at_apply != nil {
            if _currentEvidenceVersion(_tid) != src.evidence_version_at_apply {
                return "任务证据/版本已变化；建议基于旧证据，请重新请求 AI"
            }
        }
    }
    return ""
}

// D-M3-03 (r6)：相关证据版本 —— 绑定任务时取磁盘权威任务的 evidence 条数
// 与 task version 合成；未建任务（草稿）为 0。证据追加 / 任务演进都会使
// 旧建议失效。
fn _currentEvidenceVersion(task_id){
    if task_id == "" || task_id == nil { return 0 }
    let t = readTaskByIdFromDisk(task_id)
    if t == nil { return 0 }
    let n = 0
    if t.evidence != nil {
        try { n = t.evidence.len() } catch _ { n = 0 }
    }
    let v = 0
    if t.version != nil { v = t.version }
    return v * 1000 + n
}

// D-M3-04 (r6)：来源项结构化校验。模型给的 sources.* 只允许两种形态：
//   (a) 字符串 "unknown"（或任意描述文字 → unverified_text，不作确认依据）；
//   (b) 对象 {fact_id, version, quote} —— fact_id 必须在当前事实库存在、
//       同项目、（设备）active；事实带 version 字段时版本不一致标 stale。
// 返回 {status, id, version, version_present, quote, raw}；status ∈
//   verified / unknown / unverified_text / unknown_fact / cross_project /
//   inactive / stale / malformed。
// D-M3-04 (r8)：version_present 记录"模型/快照原本是否声明了 version"，
// 与归一化默认值 0 区分；确认重核只在原声明存在时回传版本（见
// _validateSourcesSnapshot），避免合法无版本事实被自拒。
fn _validateSourceEntry(kind, entry){
    let out = {status: "malformed", id: "", version: 0, version_present: false, quote: "", raw: ""}
    if entry == nil { return out }
    if m7_is_string_value(entry) {
        out.raw = entry
        if entry == "unknown" || entry == "" { out.status = "unknown" }
        else { out.status = "unverified_text" }
        return out
    }
    if !m7_is_object_value(entry) { return out }
    let fid = ""
    if entry.fact_id != nil { fid = entry.fact_id.to_string() }
    out.id = fid
    out.raw = entry.to_json()
    if entry.quote != nil {
        let q = entry.quote.to_string()
        if _textLenSafe(q) > 280 { q = _strSlice(q, 0, 280) }
        out.quote = q
    }
    if entry.version != nil { out.version = entry.version; out.version_present = true }
    if fid == "" { out.status = "malformed"; return out }
    // D-M3-04 (r7)：verified 只表示"事实 ID 当前存在、同项目、（设备）在用，
    // 且版本声明与事实一致"；引文内容无法对照事实库核验 —— 凡带非空 quote
    // 的一律降 unverified_text（可展示，不作确认依据）；事实本身无 version
    // 字段时，模型给的任意 version 同样不可核 → 降 unverified_text 而非放行。
    if kind == "category" {
        // category 是白名单枚举推断，不是可核事实来源；合法也只标 unverified_text。
        if _isValidCategory(fid) && fid != "" { out.status = "unverified_text" } else { out.status = "unknown_fact" }
        return out
    }
    if kind == "space" {
        let sp = _findSpace(fid)
        if sp == nil { out.status = "unknown_fact"; return out }
        if sp.project != STATE.project { out.status = "cross_project"; return out }
        if sp.version != nil && entry.version != nil {
            if entry.version != sp.version { out.status = "stale"; return out }
        }
        if sp.version == nil && entry.version != nil { out.status = "unverified_text"; return out }
        if out.quote != "" { out.status = "unverified_text"; return out }
        out.status = "verified"
        return out
    }
    if kind == "asset" {
        let a_ = _findAsset(fid)
        if a_ == nil { out.status = "unknown_fact"; return out }
        if a_.project != STATE.project { out.status = "cross_project"; return out }
        if a_.active == false { out.status = "inactive"; return out }
        if a_.version != nil && entry.version != nil {
            if entry.version != a_.version { out.status = "stale"; return out }
        }
        if a_.version == nil && entry.version != nil { out.status = "unverified_text"; return out }
        if out.quote != "" { out.status = "unverified_text"; return out }
        out.status = "verified"
        return out
    }
    return out
}

// D-M3-04 (r6)：确认前消费采纳时落下来的来源快照 —— 凡是 verified 的来源
// 必须此刻仍通过同一校验（存在 / 同项目 / active / 版本未变）；失效 → 拒。
// unknown / unverified_text 不作确认依据但允许存在（界面上显式标出）。
fn _validateSourcesSnapshot(){
    let src = PENDING_DRAFT.sources
    if src == nil { return {success: true, reason: ""} }
    if !m7_is_object_value(src) { return {success: true, reason: ""} }
    if src.space == nil || !m7_is_object_value(src.space) { return {success: true, reason: ""} }
    let kinds = ["space", "asset", "category"]
    let i = 0
    while i < kinds.len() {
        let k = kinds[i]
        let e = src[k]
        if e != nil && m7_is_object_value(e) {
            let st = ""
            if e.status != nil { st = e.status }
            if st == "verified" {
                // D-M3-04 (r8)：只在原声明存在时回传 version；旧快照没有
                // version_present 字段时，version 非 0 才视为曾声明（归一化
                // 默认值 0 不等于声明过）。
                let _re_in = {fact_id: e.id, quote: e.quote}
                let _vp = false
                if e.version_present != nil { _vp = e.version_present }
                else { if e.version != nil && e.version != 0 { _vp = true } }
                if _vp { _re_in.version = e.version }
                let re = _validateSourceEntry(k, _re_in)
                if re.status != "verified" {
                    return {success: false, reason: "来源 " + k + " 已失效（" + re.status + "）；请重新请求 AI 或人工改正"}
                }
            }
            if st == "cross_project" || st == "inactive" || st == "stale" || st == "unknown_fact" || st == "malformed" {
                return {success: false, reason: "来源 " + k + " 不可核（" + st + "）；不能作为确认依据"}
            }
        }
        i = i + 1
    }
    return {success: true, reason: ""}
}

// D-M3-04 (r6)：来源项的界面渲染 —— 显式读结构字段，不再把对象当字符串拼。
fn _fmtSourceEntry(kind, entry){
    if entry == nil { return kind + "=（无）" }
    if m7_is_string_value(entry) {
        if entry == "" { return kind + "=（无）" }
        return kind + "=文字(" + entry + ")"
    }
    let _id = ""
    if entry.id != nil { _id = entry.id }
    let _st = "unknown"
    if entry.status != nil { _st = entry.status }
    let _s = kind + "=" + _id + "[" + _st + "]"
    if entry.quote != nil && entry.quote != "" { _s = _s + "“" + entry.quote + "”" }
    return _s
}

// 解析 model 返回；成功=结构合法；失败=FORMAT_ERROR。
fn parseModelReturn(raw){
    let parsed = nil
    try { parsed = raw.parse_json() } catch _ { return {success: false, kind: "FORMAT_ERROR", msg: "返回不是合法 JSON"} }
    if parsed == nil { return {success: false, kind: "FORMAT_ERROR", msg: "返回不是合法 JSON"} }
    let req_id = parsed.request_id
    if req_id == nil || req_id == "" { return {success: false, kind: "FORMAT_ERROR", msg: "缺少 request_id"} }
    // D-M3-03：先查 request_id 是否对应当前 active 请求。
    // 当前没有 active 请求 / request_id 不匹配 → 直接 STALE_INPUT 不展示、不采纳。
    if PENDING_AI_REQUEST.active == false || PENDING_AI_REQUEST.request_id == "" {
        return {success: false, kind: "STALE_INPUT", msg: "当前没有 active 请求；迟到回包被拒"}
    }
    if req_id != PENDING_AI_REQUEST.request_id {
        return {success: false, kind: "STALE_INPUT", msg: "request_id 不匹配；本次提问已过期"}
    }
    let sugg = parsed.suggestion
    if sugg == nil { return {success: false, kind: "FORMAT_ERROR", msg: "缺少 suggestion"} }
    // D-M3-04 (r6)：sources 结构化校验 —— 每项允许 "unknown" / 描述文字
    // （unverified_text，不作确认依据）/ {fact_id, version, quote} 对象。
    // 对象形态必须指向当前事实库中可核的事实：不存在 / 跨项目 / 停用 /
    // 版本陈旧 → 直接拒绝整包；缺字段 / 空值仍按 FORMAT_ERROR 拒。
    if sugg.sources == nil { return {success: false, kind: "FORMAT_ERROR", msg: "缺少 sources"} }
    if typeof(sugg.sources) != "object" { return {success: false, kind: "FORMAT_ERROR", msg: "sources 不是对象"} }
    if sugg.sources.space == "" || sugg.sources.space == nil {
        return {success: false, kind: "FORMAT_ERROR", msg: "sources.space 缺失"}
    }
    if sugg.sources.asset == "" || sugg.sources.asset == nil {
        return {success: false, kind: "FORMAT_ERROR", msg: "sources.asset 缺失"}
    }
    if sugg.sources.category == "" || sugg.sources.category == nil {
        return {success: false, kind: "FORMAT_ERROR", msg: "sources.category 缺失"}
    }
    let _src_space = _validateSourceEntry("space", sugg.sources.space)
    let _src_asset = _validateSourceEntry("asset", sugg.sources.asset)
    let _src_cat = _validateSourceEntry("category", sugg.sources.category)
    let _src_entries = {space: _src_space, asset: _src_asset, category: _src_cat}
    let _src_kinds = ["space", "asset", "category"]
    let _si = 0
    while _si < _src_kinds.len() {
        let _sk = _src_kinds[_si]
        let _se = _src_entries[_sk]
        if _se.status == "malformed" {
            return {success: false, kind: "FORMAT_ERROR", msg: "sources." + _sk + " 结构不合法（需 unknown / 文字 / {fact_id,version,quote}）"}
        }
        if _se.status == "unknown_fact" {
            return {success: false, kind: "FABRICATED_FACT", msg: "sources." + _sk + " 引用了不存在的事实 " + _se.id}
        }
        if _se.status == "cross_project" {
            return {success: false, kind: "CROSS_PROJECT", msg: "sources." + _sk + " 引用跨项目事实 " + _se.id}
        }
        if _se.status == "inactive" {
            return {success: false, kind: "FABRICATED_FACT", msg: "sources." + _sk + " 引用已停用设备 " + _se.id}
        }
        if _se.status == "stale" {
            return {success: false, kind: "STALE_INPUT", msg: "sources." + _sk + " 引用的事实版本已陈旧 " + _se.id}
        }
        _si = _si + 1
    }
    let sp_id = sugg.space_candidate_id
    let as_id = sugg.asset_candidate_id
    let cat = sugg.category
    let problem = sugg.problem
    let contact = sugg.contact
    let window = sugg.desired_window
    let sources = sugg.sources
    let conf = sugg.confidence
    if conf != "high" && conf != "medium" && conf != "low" { return {success: false, kind: "FORMAT_ERROR", msg: "confidence 不合法"} }
    // D-M3-04：拒绝 status / actor 写入类字段（即使值是合法字符串）—— 模型不应改变身份 / 任务状态
    if parsed.created_task_id != nil || parsed.task_id != nil || parsed.status != nil {
        return {success: false, kind: "FORBIDDEN_WRITE", msg: "返回包含写任务 / 状态字段；模型不应直接写"}
    }
    if sugg.set_actor != nil || sugg.actor != nil || sugg.reassign != nil {
        return {success: false, kind: "FORBIDDEN_WRITE", msg: "返回包含改身份 / 改派字段；模型不应改主体"}
    }
    // 自报"已完成"字眼（写动词）=FORMAT_ERROR + 安全网
    let self_reported = false
    if sugg.problem != nil && (_strIndexOf(sugg.problem, "[已创建]") >= 0) { self_reported = true }
    if sugg.problem != nil && (_strIndexOf(sugg.problem, "已创建") >= 0 && _strIndexOf(sugg.problem, "工单") >= 0) { self_reported = true }
    if self_reported { return {success: false, kind: "FORBIDDEN_WRITE", msg: "模型不应回写 task_id / 已完成"} }
    // D-M3-04：候选必须属于当前项目；空间 / 设备都校验
    if sp_id != nil && sp_id != "" {
        let spobj = _findSpace(sp_id)
        if spobj == nil { return {success: false, kind: "FABRICATED_FACT", msg: "space_candidate_id 不在事实库"} }
        if spobj.project != STATE.project {
            return {success: false, kind: "CROSS_PROJECT", msg: "空间属于另一项目 " + spobj.project}
        }
    }
    if as_id != nil && as_id != "" {
        let aobj = _findAsset(as_id)
        if aobj == nil { return {success: false, kind: "FABRICATED_FACT", msg: "asset_candidate_id 不在事实库"} }
        if aobj.project != STATE.project {
            return {success: false, kind: "CROSS_PROJECT", msg: "设备属于另一项目 " + aobj.project}
        }
        if aobj.active == false {
            return {success: false, kind: "FABRICATED_FACT", msg: "设备已停用"}
        }
        // 设备必须服务于主空间（如已选）；否则要求确认
        if sp_id != nil && sp_id != "" {
            let spobj = _findSpace(sp_id)
            if spobj != nil {
                let served = false
                for sv in aobj.services {
                    if sv == spobj.id { served = true }
                }
                if !served { return {success: false, kind: "FABRICATED_FACT", msg: "设备未服务该空间"} }
            }
        }
    }
    // D-M3-04：所有 asset_alternatives 必须存在 + 属于本项目 + active；空 / 不存在都拒
    if sugg.asset_alternatives != nil {
        let i = 0
        while i < sugg.asset_alternatives.len() {
            let alt_id = sugg.asset_alternatives[i]
            if alt_id == nil || alt_id == "" {
                return {success: false, kind: "FORMAT_ERROR", msg: "asset_alternatives 含空 id"}
            }
            let aobj = _findAsset(alt_id)
            if aobj == nil {
                return {success: false, kind: "FABRICATED_FACT", msg: "asset_alternatives 含未知 id " + alt_id.to_string()}
            }
            if aobj.project != STATE.project {
                return {success: false, kind: "CROSS_PROJECT", msg: "asset_alternatives 跨项目 " + alt_id.to_string()}
            }
            if aobj.active == false {
                return {success: false, kind: "FABRICATED_FACT", msg: "asset_alternatives 含停用设备 " + alt_id.to_string()}
            }
            i = i + 1
        }
    }
    if !_isValidCategory(cat) { return {success: false, kind: "FORMAT_ERROR", msg: "category 不在白名单"} }
    if problem == nil { return {success: false, kind: "FORMAT_ERROR", msg: "缺少 problem"} }
    if !_isValidContact(contact) { return {success: false, kind: "FORMAT_ERROR", msg: "contact 不在白名单"} }
    // missing_fields / ambiguous_fields 必须是字符串数组
    if sugg.missing_fields != nil && typeof(sugg.missing_fields) != "array" {
        return {success: false, kind: "FORMAT_ERROR", msg: "missing_fields 不是数组"}
    }
    if sugg.ambiguous_fields != nil && typeof(sugg.ambiguous_fields) != "array" {
        return {success: false, kind: "FORMAT_ERROR", msg: "ambiguous_fields 不是数组"}
    }
    return {
        success: true,
        kind: "OK",
        parsed: parsed,
        suggestion: sugg,
        source_entries: _src_entries,
        task_version: parsed.task_version,
        draft_version: parsed.draft_version,
        expires_at_ms: parsed.expires_at_ms
    }
}

fn _isValidContact(c){
    if c == nil || c == "" { return true }
    let s = c.to_string()
    // 联系人必须是已核验会话账号的 name；不允许 raw_text 回显或外部名
    for u in accountDirectory() {
        if u.id == sessionActor() {
            if _strIndexOf(s, u.name) >= 0 { return true }
        }
    }
    return false
}

// 模型已通过 parseModelReturn 后，apply 阶段再做 5 道时间/版本闸。
fn validateSuggestion(rs){
    if !rs.success { return false }
    let now = nowMs()
    // D-M3-03：先看 active；非 active 任何回包都拒
    if PENDING_AI_REQUEST.active == false {
        AI_STATE = "STALE_INPUT"
        AI_LAST_ERROR = "没有 active 请求；迟到回包被拒"
        return false
    }
    if PENDING_AI_REQUEST.expires_at_ms != 0 && now > PENDING_AI_REQUEST.expires_at_ms {
        AI_STATE = "EXPIRED"
        AI_LAST_ERROR = "返回已过期"
        return false
    }
    if rs.draft_version != PENDING_DRAFT.draft_version {
        AI_STATE = "STALE_DRAFT_VERSION"
        AI_LAST_ERROR = "模型 draft_version 与当前不匹配"
        return false
    }
    if PENDING_AI_REQUEST.expected_task_id != "" && PENDING_AI_REQUEST.expected_task_id != nil {
        if rs.task_version != PENDING_AI_REQUEST.expected_task_version {
            AI_STATE = "STALE_TASK_VERSION"
            AI_LAST_ERROR = "任务版本已变（旧建议被覆盖）"
            return false
        }
        // D-M3-03 (r6)：不只比请求快照 —— 与当前磁盘权威任务版本比对；
        // 请求发出后任务演进（他人改派 / 改约 / 状态推进）使旧建议失效。
        let _live_tv = latestTaskVersion(PENDING_AI_REQUEST.expected_task_id)
        if _live_tv != PENDING_AI_REQUEST.expected_task_version {
            AI_STATE = "STALE_TASK_VERSION"
            AI_LAST_ERROR = "任务已演进（当前 v" + _live_tv.to_string() + "）；旧建议失效"
            return false
        }
        // D-M3-03 (r6)：相关证据版本比对（证据追加 / 任务演进 → 旧建议失效）
        if _currentEvidenceVersion(PENDING_AI_REQUEST.expected_task_id) != PENDING_AI_REQUEST.expected_evidence_version {
            AI_STATE = "STALE_INPUT"
            AI_LAST_ERROR = "相关证据已变更；旧建议失效"
            return false
        }
    }
    // D-M3-03 (r6)：设备 / 空间事实版本比对（事实增删 / 停用 / 改项目 → 失效）
    if PENDING_AI_REQUEST.expected_facts_version != "" {
        if _currentFactsVersion() != PENDING_AI_REQUEST.expected_facts_version {
            AI_STATE = "STALE_INPUT"
            AI_LAST_ERROR = "设备/空间事实已变更；旧建议失效"
            return false
        }
    }
    if hashRawText(TASK_INPUT.raw_text) != PENDING_AI_REQUEST.expected_raw_text_hash {
        AI_STATE = "STALE_INPUT"
        AI_LAST_ERROR = "用户已修改原文，旧建议已失效"
        return false
    }
    // D-M3-03：raw_input_version 也要对得上（不只 hash）；切换到另一输入版本号 = 失效
    if TASK_INPUT.raw_input_version != PENDING_AI_REQUEST.expected_raw_input_version {
        AI_STATE = "STALE_INPUT"
        AI_LAST_ERROR = "输入版本已变（已编辑）"
        return false
    }
    // D-M3-03：actor / project 快照比对；切主体 / 切项目 → 旧建议失效
    if PENDING_AI_REQUEST.expected_actor != "" && sessionActor() != PENDING_AI_REQUEST.expected_actor {
        AI_STATE = "STALE_INPUT"
        AI_LAST_ERROR = "主体已切换；旧建议失效"
        return false
    }
    if PENDING_AI_REQUEST.expected_project != "" && STATE.project != PENDING_AI_REQUEST.expected_project {
        AI_STATE = "STALE_INPUT"
        AI_LAST_ERROR = "项目已切换；旧建议失效"
        return false
    }
    if sessionActor() != nil && identityActive != nil {
        if !identityActive(sessionActor()) {
            AI_STATE = "UNAUTHORIZED"
            AI_LAST_ERROR = "身份已撤权 / 到期"
            return false
        }
    }
    return true
}

fn applyDraftFromAI(rs){
    if !validateSuggestion(rs) { return false }
    let s = rs.suggestion
    PENDING_DRAFT.draft_version = PENDING_DRAFT.draft_version + 1
    PENDING_DRAFT.problem = s.problem
    PENDING_DRAFT.space_id = s.space_candidate_id
    PENDING_DRAFT.asset_id = s.asset_candidate_id
    PENDING_DRAFT.category = s.category
    PENDING_DRAFT.contact = s.contact
    if s.desired_window != nil && s.desired_window != "" {
        let win = parseDesiredWindow(s.desired_window)
        if win != nil {
            PENDING_DRAFT.desired_window_start_ms = win.start
            PENDING_DRAFT.desired_window_end_ms = win.end
        }
    }
    // D-M3-04 (r6)：sources 直接来自 parseModelReturn 的结构化校验结果
    // （_validateSourceEntry）。verified 只授予"fact_id 指向当前项目可核事实"
    // 的来源项；描述文字保留为 unverified_text（可展示，不作确认依据）；
    // 不存在 / 跨项目 / 停用 / 陈旧的引用已在 parseModelReturn 阶段整包拒绝。
    let _se_space = {status: "unknown", id: "", version: 0, quote: "", raw: ""}
    let _se_asset = {status: "unknown", id: "", version: 0, quote: "", raw: ""}
    let _se_cat = {status: "unknown", id: "", version: 0, quote: "", raw: ""}
    if rs.source_entries != nil {
        _se_space = rs.source_entries.space
        _se_asset = rs.source_entries.asset
        _se_cat = rs.source_entries.category
    }
    // 来源 fact_id 与最终候选一致性：verified 来源的 id 必须与采纳进草稿的
    // 候选 id 相同，否则该来源不证明当前候选 → 降级 unverified_text。
    if _se_space.status == "verified" && _se_space.id != PENDING_DRAFT.space_id {
        _se_space.status = "unverified_text"
    }
    if _se_asset.status == "verified" && _se_asset.id != PENDING_DRAFT.asset_id {
        _se_asset.status = "unverified_text"
    }
    PENDING_DRAFT.sources = {
        space: _se_space,
        asset: _se_asset,
        category: _se_cat,
        raw_input_hash_at_apply: PENDING_AI_REQUEST.expected_raw_text_hash,
        raw_input_version_at_apply: PENDING_AI_REQUEST.expected_raw_input_version,
        facts_version_at_apply: PENDING_AI_REQUEST.expected_facts_version,
        // D-M3-03 (r7)：任务/证据版本一并落入采纳快照，供采纳守卫与首次确认
        // 比对当前值（任务改约/证据更新 → 旧建议失效）。
        task_id_at_apply: PENDING_AI_REQUEST.expected_task_id,
        task_version_at_apply: PENDING_AI_REQUEST.expected_task_version,
        evidence_version_at_apply: PENDING_AI_REQUEST.expected_evidence_version,
        actor_at_apply: PENDING_AI_REQUEST.expected_actor,
        project_at_apply: PENDING_AI_REQUEST.expected_project,
        apply_request_id: PENDING_AI_REQUEST.request_id,
        apply_at_ms: nowMs()
    }
    PENDING_DRAFT.ai_request_id = PENDING_AI_REQUEST.request_id
    // D-M3-06：原文（不仅是 hash）也进入草稿；确认时把原文 + 来源 + 缺项写入 task
    PENDING_DRAFT.ai_history_raw_text = TASK_INPUT.raw_text
    PENDING_DRAFT.ai_history_raw_text_hash = PENDING_AI_REQUEST.expected_raw_text_hash
    PENDING_DRAFT.ai_history_raw_input_version = PENDING_AI_REQUEST.expected_raw_input_version
    // D-M3-04 / D-M3-06：缺项 / 歧义 / 备选 ID 都进入 PENDING_DRAFT，方便确认时一并落 task
    if s.missing_fields != nil { PENDING_DRAFT.missing_fields = s.missing_fields } else { PENDING_DRAFT.missing_fields = [] }
    if s.ambiguous_fields != nil { PENDING_DRAFT.ambiguous_fields = s.ambiguous_fields } else { PENDING_DRAFT.ambiguous_fields = [] }
    if s.asset_alternatives != nil { PENDING_DRAFT.asset_alternatives = s.asset_alternatives } else { PENDING_DRAFT.asset_alternatives = [] }
    PENDING_DRAFT.ai_confidence = s.confidence
    PENDING_DRAFT.human_edited_fields = []
    // D-M4-04 (r6)：新 AI apply = 新基线，本轮 epoch 集合一并清空（确认走
    // last_applied_request_id + 原文 hash 的 AI 绑定路径，不消费 epoch 字段）。
    PENDING_DRAFT.human_edited_epoch_fields = []
    PENDING_DRAFT.draft_source = "ai"
    PENDING_DRAFT.created_at_ms = nowMs()
    PENDING_DRAFT.expires_at_ms = PENDING_AI_REQUEST.expires_at_ms
    PENDING_DRAFT.last_applied_request_id = PENDING_AI_REQUEST.request_id
    AI_STATE = "APPLIED"
    AI_LAST_ERROR = ""
    // D-M3-03 (r6)：一次新的 AI 采纳本身就是新的建议基线 —— 不再把
    // "编辑失效"标志位置 true（否则采纳守卫会把这次合法采纳也拒掉）。
    return true
}

// D-M3-06 (r4 修复轮)：根据 PENDING_DRAFT 实际填写情况推导 resolved_missing_fields；
// D-M3-06 (r5)：只有"人为显式填写"才算解决 ——
// 仅看值非空不足够；AI 自动填充不替代人工选择。
// human_edited_fields 由 editDraftField() 维护,是契约证据。
fn _computeResolvedFields(missing){
    let resolved = []
    if missing == nil { return resolved }
    let i = 0
    while i < missing.len() {
        let f = missing[i]
        let filled = false
        if f == "problem" {
            // D-M3-06 (r6)：空间定位 / 设备定位必须由对应字段（space_id /
            // asset_id）的人工解决痕迹证明，不再因 problem 人工非空而标
            // resolved；problem 分支只管 problem 本身。
            let _he_problem = _isHumanEdited("problem")
            let _has_problem = PENDING_DRAFT.problem != "" && PENDING_DRAFT.problem != nil
            if _has_problem && _he_problem { filled = true }
        }
        if f == "space" || f == "空间定位" {
            if PENDING_DRAFT.space_id != "" && PENDING_DRAFT.space_id != nil {
                if _findSpace(PENDING_DRAFT.space_id) != nil {
                    // 空间既要被用户显式选,又要存在/同项目
                    if _isHumanEdited("space_id") { filled = true }
                }
            }
        }
        if f == "asset" || f == "设备定位" || f == "具体是哪一组插座" {
            // 缺失项中的 asset:用户显式选了一个事实存在的设备
            if PENDING_DRAFT.asset_id != "" && PENDING_DRAFT.asset_id != nil {
                if _findAsset(PENDING_DRAFT.asset_id) != nil {
                    if _isHumanEdited("asset_id") { filled = true }
                }
            }
        }
        if f == "category" {
            if _isValidCategory(PENDING_DRAFT.category) {
                if _isHumanEdited("category") { filled = true }
            }
        }
        if f == "contact" {
            if PENDING_DRAFT.contact != "" && PENDING_DRAFT.contact != nil {
                if _isHumanEdited("contact") { filled = true }
            }
        }
        if f == "desired_window" {
            if PENDING_DRAFT.desired_window_start_ms > 0 && PENDING_DRAFT.desired_window_end_ms > 0 {
                if _isHumanEdited("desired_window") { filled = true }
            }
        }
        if filled { resolved.push(f) }
        i = i + 1
    }
    return resolved
}

// D-M3-06 (r5)：歧义字段已解决判定。
// 仅当用户在 alternatives 里显式选了一项,且该项与 AI 默认值不同 ——
// 才算"人工解决了歧义"。AI 默认值(applyDraftFromAI 设的 asset_id)
// 不替代用户选择。
fn _computeResolvedAmbiguous(ambiguous, alternatives, chosen_asset_id){
    let resolved = []
    if ambiguous == nil { return resolved }
    let i = 0
    while i < ambiguous.len() {
        let a = ambiguous[i]
        let picked = false
        // D-M3-06 (r7)：每个歧义字段只由"对应字段"的人工选择解决 ——
        // 选了设备不再连带消除空间歧义，反之亦然。
        if a == "asset" || a == "设备定位" || a == "具体是哪一组插座" {
            // 设备歧义：用户显式编辑过 asset_id，当前值在 alternatives 里，
            // 且该设备此刻仍是事实库中合法（存在/同项目/在用）候选。
            if _isHumanEdited("asset_id") {
                if chosen_asset_id != "" && chosen_asset_id != nil {
                    let _asset_ok = false
                    let _fa = _findAsset(chosen_asset_id)
                    if _fa != nil {
                        if _fa.project == STATE.project && _fa.active { _asset_ok = true }
                    }
                    if _asset_ok {
                        let j = 0
                        while j < alternatives.len() {
                            if alternatives[j] == chosen_asset_id { picked = true }
                            j = j + 1
                        }
                    }
                }
            }
        }
        if a == "space" || a == "空间定位" {
            // 空间歧义：只由人工显式选定合法空间解决。
            if _isHumanEdited("space_id") {
                if PENDING_DRAFT.space_id != "" && PENDING_DRAFT.space_id != nil {
                    let _fs = _findSpace(PENDING_DRAFT.space_id)
                    if _fs != nil {
                        if _fs.project == STATE.project { picked = true }
                    }
                }
            }
        }
        if a == "contact" {
            if _isHumanEdited("contact") {
                if PENDING_DRAFT.contact != "" && PENDING_DRAFT.contact != nil { picked = true }
            }
        }
        if a == "category" {
            if _isHumanEdited("category") {
                if _isValidCategory(PENDING_DRAFT.category) { picked = true }
            }
        }
        if picked { resolved.push(a) }
        i = i + 1
    }
    return resolved
}

// D-M3-06 (r5)：在 human_edited_fields 数组中查 field_name。
fn _isHumanEdited(field_name){
    let h = PENDING_DRAFT.human_edited_fields
    if h == nil { return false }
    let k = 0
    while k < h.len() {
        if h[k] == field_name { return true }
        k = k + 1
    }
    return false
}

fn parseDesiredWindow(s){
    if s == nil { return nil }
    let t = s.to_string()
    if _strIndexOf(t, "~") < 0 { return nil }
    let arr = t.split("~")
    if arr.len() != 2 { return nil }
    // 简化：年份/月份/日/时/分 全段转毫秒 (CST UTC+8 -> 0 + 28800000 偏移)
    // 真实生产解析需校时区；此处契约测试只关心结构
    let start = _parseDateTimeString(arr[0])
    let end = _parseDateTimeString(arr[1])
    if start == nil || end == nil { return nil }
    if end <= start { return nil }
    return {start: start, end: end}
}

fn _parseDateTimeString(s){
    if s == nil { return nil }
    let t = s.to_string()
    // 期望 "YYYY-MM-DD HH:MM" — 16 字符
    if _textLenSafe(t) != 16 { return nil }
    let yy = _toIntSafe(_strSlice(t, 0, 4))
    let mo = _toIntSafe(_strSlice(t, 5, 7))
    let dd = _toIntSafe(_strSlice(t, 8, 10))
    let hh = _toIntSafe(_strSlice(t, 11, 13))
    let mi = _toIntSafe(_strSlice(t, 14, 16))
    if yy == nil || mo == nil || dd == nil || hh == nil || mi == nil { return nil }
    let days = _daysBeforeYear(yy) + _daysBeforeMonth(yy, mo) + (dd - 1)
    let ms_in_day = (hh * 3600 + mi * 60) * 1000
    // CST = UTC+8; 这里把本地视为 CST 转 epoch 等价（与现有 task 字段行为一致：ms from epoch）
    // 直接基于 days*86400000 + ms_in_day - 28800000(UTC = local - 8h)
    return days * 86400000 + ms_in_day - 28800000
}

fn _toIntSafe(s){
    if s == nil { return nil }
    let t = s.to_string()
    // B-M4-01 (r7)：to_chars 逐字符严格解析；任何非数字字符 → nil（拒绝），
    // 不再把非数字当 0 累计。
    let chars = t.to_chars()
    let digit_chars = "0123456789".to_chars()
    let n = 0
    let i = 0
    let success_flag = false
    while i < chars.len() {
        let c_text = chars[i]
        let k = -1
        let m = 0
        while m < 10 {
            if digit_chars[m] == c_text { k = m }
            m = m + 1
        }
        if k < 0 { return nil }
        n = n * 10 + k
        success_flag = true
        i = i + 1
    }
    if !success_flag { return nil }
    return n
}

fn _daysBeforeYear(y){
    // 1970-01-01 起算，简化：忽略闰年精度。契约测试不依赖具体日期。
    let days = (y - 1970) * 365
    let leap = 0
    let yy = 1970
    while yy < y {
        if (_isLeap(yy)) { leap = leap + 1 }
        yy = yy + 1
    }
    return days + leap
}

fn _isLeap(y){
    if (y % 4) != 0 { return false }
    if (y % 100) == 0 && (y % 400) != 0 { return false }
    return true
}

fn _daysBeforeMonth(y, m){
    let mdays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if _isLeap(y) { mdays[1] = 29 }
    let d = 0
    let i = 0
    while i < (m - 1) {
        d = d + mdays[i]
        i = i + 1
    }
    return d
}

// D-M3-04 (r3)：共享字段守卫 — 在 parseModelReturn / editDraftField / confirmDraftModelBound
// 三入口都调用。统一核可信project、空间/设备project、active、服务关系。
// 返回 {success_flag, reason}；不通过 → 调用方拒收。
fn _validateDraftFacts(){
    // 空间
    if PENDING_DRAFT.space_id == "" || PENDING_DRAFT.space_id == nil {
        return {success: false, reason: "space 缺失"}
    }
    let sp = _findSpace(PENDING_DRAFT.space_id)
    if sp == nil { return {success: false, reason: "space 不在事实库"} }
    if sp.project != STATE.project { return {success: false, reason: "space 跨项目 " + sp.project} }
    // 设备
    if PENDING_DRAFT.asset_id != "" && PENDING_DRAFT.asset_id != nil {
        let a = _findAsset(PENDING_DRAFT.asset_id)
        if a == nil { return {success: false, reason: "asset 不在事实库"} }
        if a.project != STATE.project { return {success: false, reason: "asset 跨项目 " + a.project} }
        if a.active == false { return {success: false, reason: "asset 已停用"} }
        // 服务关系
        let served = false
        for sv in a.services {
            if sv == sp.id { served = true }
        }
        if !served { return {success: false, reason: "asset 未服务 space " + sp.id} }
    }
    // 类目
    if !_isValidCategory(PENDING_DRAFT.category) { return {success: false, reason: "category 不在白名单"} }
    return {success: true, reason: ""}
}
fn editDraftField(field, value){
    let prev = nil
    if field == "problem" {
        prev = PENDING_DRAFT.problem
        PENDING_DRAFT.problem = value
    } else if field == "space_id" {
        prev = PENDING_DRAFT.space_id
        if value != "" {
            let sp = _findSpace(value)
            if sp == nil { return false }
            if sp.project != STATE.project { return false }
        }
        PENDING_DRAFT.space_id = value
        // D-M3-04 (r3)：改 space 后立刻跑共享守卫（防止旧 asset 不再被新 space 服务）
        let _g = _validateDraftFacts()
        if !_g.success {
            PENDING_DRAFT.space_id = prev
            return false
        }
    } else if field == "asset_id" {
        prev = PENDING_DRAFT.asset_id
        if value != "" {
            let a = _findAsset(value)
            if a == nil { return false }
            if a.project != STATE.project { return false }
            if a.active == false { return false }
            if PENDING_DRAFT.space_id != "" {
                let sp = _findSpace(PENDING_DRAFT.space_id)
                if sp != nil {
                    let served = false
                    for sv in a.services {
                        if sv == sp.id { served = true }
                    }
                    if !served {
                        return false
                    }
                }
            }
        }
        PENDING_DRAFT.asset_id = value
    } else if field == "category" {
        prev = PENDING_DRAFT.category
        if !_isValidCategory(value) { return false }
        PENDING_DRAFT.category = value
    } else if field == "contact" {
        prev = PENDING_DRAFT.contact
        PENDING_DRAFT.contact = value
    } else if field == "desired_window" {
        // D-M3-06 (r4 修复轮)：value 形如 "YYYY-MM-DD HH:MM~YYYY-MM-DD HH:MM"；
        // 解析失败保留旧值；不允许把 start/end 都置 0 而丢失时间意图。
        if value == nil || value == "" {
            PENDING_DRAFT.desired_window_start_ms = 0
            PENDING_DRAFT.desired_window_end_ms = 0
        } else {
            let win = parseDesiredWindow(value)
            if win != nil {
                PENDING_DRAFT.desired_window_start_ms = win.start
                PENDING_DRAFT.desired_window_end_ms = win.end
            }
            // 解析失败 → 旧值保持不变
        }
    } else {
        return false
    }
    PENDING_DRAFT.draft_version = PENDING_DRAFT.draft_version + 1
    let already = false
    for f in PENDING_DRAFT.human_edited_fields {
        if f == field { already = true }
    }
    if !already { PENDING_DRAFT.human_edited_fields.push(field) }
    // D-M4-04 (r6)：同一编辑同时记入本次失效后 epoch 集合（确认守卫消费）。
    if PENDING_DRAFT.human_edited_epoch_fields == nil { PENDING_DRAFT.human_edited_epoch_fields = [] }
    let already_e = false
    for f2 in PENDING_DRAFT.human_edited_epoch_fields {
        if f2 == field { already_e = true }
    }
    if !already_e { PENDING_DRAFT.human_edited_epoch_fields.push(field) }
    if PENDING_DRAFT.draft_source == "ai" { PENDING_DRAFT.draft_source = "hybrid" }
    CONFIRM_BIND.invalidated_by_edit = true
    return true
}

fn cancelAiRequest(){
    PENDING_AI_REQUEST.active = false
    AI_STATE = "CANCELED"
    AI_LAST_ERROR = "用户取消"
}

fn openDraftPanel(){
    TASK_INPUT.panel_open = true
    STATE.panel = "draft"
    refreshDesktop()
}

fn closeDraftPanel(){
    TASK_INPUT.panel_open = false
    PENDING_DRAFT.draft_version = 0
    PENDING_DRAFT.problem = ""
    PENDING_DRAFT.space_id = ""
    PENDING_DRAFT.asset_id = ""
    PENDING_DRAFT.asset_alternatives = []
    PENDING_DRAFT.category = ""
    PENDING_DRAFT.contact = ""
    PENDING_DRAFT.contact_info = ""
    PENDING_DRAFT.desired_window_start_ms = 0
    PENDING_DRAFT.desired_window_end_ms = 0
    PENDING_DRAFT.sources = {space: "", asset: "", category: ""}
    PENDING_DRAFT.ai_request_id = ""
    PENDING_DRAFT.ai_history_raw_text = ""
    PENDING_DRAFT.ai_history_raw_text_hash = ""
    PENDING_DRAFT.ai_history_raw_input_version = 0
    PENDING_DRAFT.missing_fields = []
    PENDING_DRAFT.ambiguous_fields = []
    PENDING_DRAFT.ai_confidence = ""
    PENDING_DRAFT.human_edited_fields = []
    PENDING_DRAFT.human_edited_epoch_fields = []
    PENDING_DRAFT.draft_source = "manual"
    PENDING_DRAFT.created_at_ms = nowMs()
    PENDING_DRAFT.expires_at_ms = 0
    PENDING_DRAFT.last_applied_request_id = ""
    // D-M3-03：关面板也使 active 请求失效
    PENDING_AI_REQUEST.active = false
    PENDING_AI_REQUEST.request_id = ""
    CONFIRM_BIND.last_confirmed_at_ms = 0
    CONFIRM_BIND.last_confirmed_draft_version = 0
    CONFIRM_BIND.last_confirmed_raw_text_hash = ""
    CONFIRM_BIND.invalidated_by_edit = false
    STATE.panel = "none"
    refreshDesktop()
}

// 用户改原文：raw_input_version++（仅当文本真的变了）；hash 重算；任何未确认
// 的 AI 建议立即失效。
// D-M3-03 (r4 修复轮)：文本未变 → 不递增 raw_input_version、不写 hash、不重置
// active；这样合法采纳（用户没改输入就点"采纳 AI 建议"）不会因为本函数副作用
// 而触发 REJECT_STALE_INPUT；同时保证"键入后未点按钮"的反例仍能在后续任何入口
// 被 raw_text 变化检测出来。
fn editRawText(new_text){
    if new_text == nil { new_text = "" }
    let new_hash = hashRawText(new_text)
    if new_hash == TASK_INPUT.raw_text_hash && new_text == TASK_INPUT.raw_text {
        return  // 内容没变 → 完全空操作（不动版本 / 不失效）
    }
    TASK_INPUT.raw_text = new_text
    TASK_INPUT.raw_input_version = TASK_INPUT.raw_input_version + 1
    TASK_INPUT.raw_text_hash = new_hash
    TASK_INPUT.last_edit_at_ms = nowMs()
    // D-M3-03：任何对原文的编辑都让 active 请求 + 上一次确认失效；
    // validateSuggestion 会因此拒绝迟到回包；confirm 也会拒
    PENDING_AI_REQUEST.active = false
    PENDING_AI_REQUEST.request_id = ""
    // D-M3-03 (r5)：原文编辑同时使已落地的 APPLIED 建议失效 ——
    // 否则 UI "采纳 AI 建议" 的谓词 (AI_STATE=="APPLIED") 仍成立,
    // 用户会误把 A 描述对应的草稿当成 B 描述的新建议。
    if PENDING_DRAFT.last_applied_request_id != "" {
        // 仅在 raw_input_version 已递增的前提下清除；空草稿 / 已确认草稿不动。
        PENDING_DRAFT.last_applied_request_id = ""
        PENDING_DRAFT.ai_request_id = ""
        if AI_STATE == "APPLIED" {
            AI_STATE = "STALE_INPUT"
            AI_LAST_ERROR = "原文已编辑；旧 AI 建议被作废"
        }
    }
    // D-M3-03 (r5)：编辑也使"已采纳草稿"标脏，使 UI 看见 draft_source 回到 manual。
    // 这样"键入未点按钮"反例在采纳 / 首次确认两入口都会被 raw_text 检测拒。
    if PENDING_DRAFT.draft_source == "ai" {
        PENDING_DRAFT.draft_source = "manual"
        if !_strArrContains(PENDING_DRAFT.human_edited_fields, "problem") {
            PENDING_DRAFT.human_edited_fields.push("problem")
        }
        // D-M4-04 (r6)：与累计审计同步记入本轮 epoch 集合。
        if PENDING_DRAFT.human_edited_epoch_fields == nil { PENDING_DRAFT.human_edited_epoch_fields = [] }
        if !_strArrContains(PENDING_DRAFT.human_edited_epoch_fields, "problem") {
            PENDING_DRAFT.human_edited_epoch_fields.push("problem")
        }
        PENDING_DRAFT.draft_version = PENDING_DRAFT.draft_version + 1
    }
    CONFIRM_BIND.invalidated_by_edit = true
    // D-M3-02 (r7)：未提交原文随编辑持久化到 STATE.pending_input ——
    // 冷启动后由 tick 一次性恢复到 TASK_INPUT 与 zh_input 控件，
    // 输入失败 / 重启不丢用户原文。
    STATE.pending_input = new_text
    saveState()
}

// D-M3-02 / D-M3-03 (r4 修复轮)：所有"按下按钮前"的同步入口；只读 zh_input.text，
// 内容未变 → 完全空操作；避免把按钮按下当编辑事件。
fn _syncPanelInputFromUI(){
    try {
        if ui.zh_input == nil { return }
        let cur = ui.zh_input.text()
        if cur == nil { cur = "" }
        editRawText(cur)
    } catch _ { cur = cur }
}

// 启动"AI 提问"：调用真实 provider（已授权 MiniMax）；回包走 deliverModelReturn。
// D-M3-01 (r4 修复轮)：本函数必须真正调用 _callMinimaxProvider 并把结果喂给
// deliverModelReturn；不再只是 bind→ASKING→audit→return。失败 / 取消 / 超时按
// 错误状态机更新 AI_STATE，永不创建 / 修改 task。
// D-M6-03 (r6)：草稿期 AI 请求的显式绑定 —— 该链在任务创建前发出，task_id 显式
// 为空表示"未建任务种类"；project / actor 在发出时由调用点显式固定，不再留 nil
// 让记录端标 MISSING_BINDING（草稿链本就该可追踪到发出人与项目）。
fn _m6_draft_binding_task_id(){
    try {
        if PENDING_AI_REQUEST != nil && PENDING_AI_REQUEST.expected_task_id != nil {
            return PENDING_AI_REQUEST.expected_task_id
        }
    } catch _ { }
    return ""
}
fn requestAiSuggestion(){
    // D-M3-02 / D-M3-03：按下按钮先同步当前 TextInput 内容（如果面板已挂）。
    _syncPanelInputFromUI()
    if !MODEL_CONFIG.enabled || MODEL_ADAPTER == "no_op" {
        AI_STATE = "NO_SERVICE"
        AI_LAST_ERROR = "宿主未配置 provider；可手工继续"
        recordModelMeta({
            request_id: "",
            provider_id: "",
            model_id: "",
            host_label: MODEL_CONFIG.host_label,
            raw_text_length: _textLenSafe(TASK_INPUT.raw_text),
            raw_text_hash: hashRawText(TASK_INPUT.raw_text),
            result_kind: "NO_SERVICE",
            elapsed_ms: 0,
            task_id: _m6_draft_binding_task_id(),
            project_id: STATE.project,
            actor: sessionActor()
        })
        return false
    }
    let rid = bindRequestVersions("")
    AI_STATE = "ASKING"
    AI_LAST_ERROR = ""
    recordModelMeta({
        request_id: rid,
        provider_id: MODEL_CONFIG.provider_id,
        model_id: MODEL_CONFIG.model_id,
        host_label: MODEL_CONFIG.host_label,
        raw_text_length: _textLenSafe(TASK_INPUT.raw_text),
        raw_text_hash: hashRawText(TASK_INPUT.raw_text),
        result_kind: "REQUEST_ISSUED",
        elapsed_ms: 0,
        task_id: _m6_draft_binding_task_id(),
        project_id: STATE.project,
        actor: sessionActor()
    })
    // 真实调用：构造 SPACES / ASSETS 当前事实清单（仅事实核，不含联系方式 / 密钥）。
    let sps = []
    for sp in SPACES {
        if sp.project == STATE.project { sps.push({id: sp.id, name: sp.name}) }
    }
    let asts = []
    for a_ in ASSETS {
        if a_.project == STATE.project && a_.active { asts.push({id: a_.id, code: a_.code, name: a_.name, category: a_.category}) }
    }
    let sys_text = _modelInstructionText()
    let user_text = TASK_INPUT.raw_text
    let call = _callMinimaxProvider(sys_text, user_text, sps.to_json(), asts.to_json())
    // D-M3-01：失败 → 错误状态机；绝不修改 PENDING_DRAFT / TASK
    if !call.success {
        AI_STATE = call.kind
        AI_LAST_ERROR = call.msg
        recordModelMeta({
            request_id: PENDING_AI_REQUEST.request_id,
            provider_id: MODEL_CONFIG.provider_id,
            model_id: MODEL_CONFIG.model_id,
            host_label: MODEL_CONFIG.host_label,
            raw_text_length: _textLenSafe(TASK_INPUT.raw_text),
            raw_text_hash: hashRawText(TASK_INPUT.raw_text),
            result_kind: call.kind,
            elapsed_ms: call.elapsed_ms,
            task_id: _m6_draft_binding_task_id(),
            project_id: STATE.project,
            actor: sessionActor()
        })
        // 失败保留原文（用户可继续编辑）；active 留给下次重试
        PENDING_AI_REQUEST.active = false
        return false
    }
    // D-M3-03：回包落地前再核当前输入是否已被编辑（防"键入未点按钮"的反例）。
    // 这里用 delivered-time 比对：当前 raw_text_hash 必须 == expected_raw_text_hash
    let cur_hash = hashRawText(TASK_INPUT.raw_text)
    if cur_hash != PENDING_AI_REQUEST.expected_raw_text_hash {
        AI_STATE = "STALE_INPUT"
        AI_LAST_ERROR = "回包到达时原文已被改动；不覆盖"
        recordModelMeta({
            request_id: PENDING_AI_REQUEST.request_id,
            provider_id: MODEL_CONFIG.provider_id,
            model_id: MODEL_CONFIG.model_id,
            host_label: MODEL_CONFIG.host_label,
            raw_text_length: _textLenSafe(TASK_INPUT.raw_text),
            raw_text_hash: cur_hash,
            result_kind: "STALE_INPUT",
            elapsed_ms: call.elapsed_ms,
            task_id: _m6_draft_binding_task_id(),
            project_id: STATE.project,
            actor: sessionActor()
        })
        PENDING_AI_REQUEST.active = false
        return false
    }
    // 把 provider 返回的 inner JSON + request_id/expires_at_ms/draft_version/task_version
    // 重新组装为 deliverModelReturn 期望的协议格式。
    let inner = call.payload
    if inner.request_id == nil { inner.request_id = PENDING_AI_REQUEST.request_id }
    if inner.expires_at_ms == nil { inner.expires_at_ms = PENDING_AI_REQUEST.expires_at_ms }
    if inner.draft_version == nil { inner.draft_version = PENDING_DRAFT.draft_version }
    if inner.task_version == nil {
        if PENDING_AI_REQUEST.expected_task_id != "" && PENDING_AI_REQUEST.expected_task_id != nil {
            inner.task_version = PENDING_AI_REQUEST.expected_task_version
        } else {
            inner.task_version = 0
        }
    }
    let raw = inner.to_json()
    return deliverModelReturn(raw)
}

// 模型回包入口（由宿主注入回调 / 测试驱动）。
fn deliverModelReturn(raw){
    // D-M3-03 (r6)：回包到达时先重读真实输入控件 —— 不能只信 TASK_INPUT
    // 缓存；用户在等待期间键入但未点任何按钮的场景必须被此刻的比对捕获。
    _syncPanelInputFromUI()
    let rs = parseModelReturn(raw)
    if !rs.success {
        AI_STATE = rs.kind
        AI_LAST_ERROR = rs.msg
        recordModelMeta({
            request_id: PENDING_AI_REQUEST.request_id,
            provider_id: MODEL_CONFIG.provider_id,
            model_id: MODEL_CONFIG.model_id,
            host_label: MODEL_CONFIG.host_label,
            raw_text_length: _textLenSafe(TASK_INPUT.raw_text),
            raw_text_hash: hashRawText(TASK_INPUT.raw_text),
            result_kind: rs.kind,
            elapsed_ms: 0,
            task_id: _m6_draft_binding_task_id(),
            project_id: STATE.project,
            actor: sessionActor()
        })
        return false
    }
    if !applyDraftFromAI(rs) {
        recordModelMeta({
            request_id: PENDING_AI_REQUEST.request_id,
            provider_id: MODEL_CONFIG.provider_id,
            model_id: MODEL_CONFIG.model_id,
            host_label: MODEL_CONFIG.host_label,
            raw_text_length: _textLenSafe(TASK_INPUT.raw_text),
            raw_text_hash: hashRawText(TASK_INPUT.raw_text),
            result_kind: AI_STATE + "_REJECTED",
            elapsed_ms: 0,
            task_id: _m6_draft_binding_task_id(),
            project_id: STATE.project,
            actor: sessionActor()
        })
        return false
    }
    PENDING_AI_REQUEST.active = false
    recordModelMeta({
        request_id: PENDING_AI_REQUEST.request_id,
        provider_id: MODEL_CONFIG.provider_id,
        model_id: MODEL_CONFIG.model_id,
        host_label: MODEL_CONFIG.host_label,
        raw_text_length: _textLenSafe(TASK_INPUT.raw_text),
        raw_text_hash: hashRawText(TASK_INPUT.raw_text),
        result_kind: "APPLIED",
        elapsed_ms: 0,
        task_id: _m6_draft_binding_task_id(),
        project_id: STATE.project,
        actor: sessionActor()
    })
    return true
}

fn _safePreview(s){
    if s == nil { return "" }
    let t = s.to_string()
    let n = _textLenSafe(t)
    let lim = 24
    if n <= lim { return t }
    return _strSlice(t, 0, lim) + "..."
}

// 不写：raw_text 全文 / 截断 preview / auth header / prompt token / API key / 任何密钥 / 任何联系方式原文。
// 写：request_id / provider / model / host label / 长度 / 原文 hash（不可逆引用）/ result kind / elapsed_ms /
//     task_id / project_id / actor（D-M6-03：建立任务/项目/请求主体的可追踪绑定，
//     但仍不写敏感原文与凭证；过期与错误契约沿用）。
// D-M3-07：截断不等于脱敏——审计不写 raw_text 任何形式（包括 truncated preview）。
// D-M6-03 (r5 修复轮)：发出时必须由 caller 显式提供 task_id / project_id / actor 与
// 事实版本；不再从当前 UI / PENDING_DRAFT 派生。理由：回包到达时 UI 已切换会导致
// 元数据错绑（"谁的请求归属哪个任务"被错写）。仅当 caller 显式传 nil / 空串时
// 才视为"未知"——记 task_id="" / project_id="" / actor="" 并标 result_kind=
// "MISSING_BINDING"，消费端可识别为待核验。不依赖 UI 派生。
fn recordModelMeta(meta){
    let entry = {at: nowMs()}
    let keys = ["request_id", "provider_id", "model_id", "host_label",
                 "raw_text_length", "raw_text_hash", "result_kind",
                 "elapsed_ms",
                 "task_id", "project_id", "actor"]
    let i = 0
    while i < keys.len() {
        let k = keys[i]
        // D-M6-03 r5：不从 meta[k] 取默认 nil；保持原值，让 caller 必须提供。
        // B-M4-01 (r7)：map 无 has()；缺失键读取返回 nil，两种分支结果一致。
        if meta[k] != nil {
            entry[k] = meta[k]
        } else {
            entry[k] = nil
        }
        i = i + 1
    }
    // D-M6-03 r5：caller 未显式提供 task_id / project_id / actor 时，把对应的
    // 三个绑定视为"未知"（留空串），不再从 PENDING_DRAFT / STATE.selected_task_id
    // / STATE.project / sessionActor() 派生。理由：UI 派生会让"迟到回包"被错误
    // 归属到当前任务。把缺失标 MISSING_BINDING 以便消费端识别为待核验。
    let _missing = false
    if entry.task_id == nil || entry.task_id == "" {
        entry.task_id = ""
        _missing = true
    }
    if entry.project_id == nil || entry.project_id == "" {
        entry.project_id = ""
        _missing = true
    }
    if entry.actor == nil || entry.actor == "" {
        entry.actor = ""
        _missing = true
    }
    // 如果是 caller 没绑定，并且 entry.result_kind 未明示，附加 MISSING_BINDING
    // 标记（仅作标记，不覆盖 caller 给的 result_kind）。
    if _missing {
        if entry.result_kind == nil { entry.result_kind = "MISSING_BINDING" }
    }
    AI_REQUESTS_LOG.push(entry)
    // 同时落盘 evidence（无 secret）
    _persistAiLog()
}

// D-M6-03 (r10 修复轮，对 r11 Review D03-C)：持久请求日志恢复 —— 出处闸
// （m6_history_provenance_ok）依赖 AI_REQUESTS_LOG 内存记录；重开后内存为空会让
// 合法模型缓存一律被拒。在 history 消费之前从 ai_requests.jsonl 安全恢复：
//   1) 文件不存在/空 → 直接返回（无出处可恢复）；
//   2) 顶层非数组或任一条目非法 → AI_LOG_CORRUPT=true，保留原文件字节、禁止
//      _persistAiLog 覆盖，出处按未知（安全方向，不删 provenance 闸）；
//   3) 合法条目逐字段核 schema 后并入内存；恢复只在首次调用执行一次，
//      重开后第一次新请求在恢复之后 push，不会把旧出处全部覆盖丢失。
fn m6_restore_ai_requests_log(){
    if AI_LOG_RESTORED { return }
    AI_LOG_RESTORED = true
    if !fs.exists("ai_requests.jsonl") { return }
    let raw = nil
    try { raw = fs.read("ai_requests.jsonl") } catch _ { raw = nil }
    if raw == nil || raw == "" { return }
    let parsed = nil
    try { parsed = raw.parse_json() } catch _ { parsed = nil }
    if parsed == nil || !m7_is_array_value(parsed) {
        AI_LOG_CORRUPT = true
        return
    }
    let staged = []
    let bad = false
    let i = 0
    while i < parsed.len() {
        let e = parsed[i]
        if e == nil || !m7_is_object_value(e) { bad = true }
        if !bad {
            // D-M6-03 (r11 修复轮，对 r12 Review D03-C)：失败诊断与可核出处分
            // schema —— 应用自产 NO_SERVICE 空 rid 记录经 hf_normalize_ai_log_entry
            // 规范化为 diagnostic：不作为出处（出处闸要求 SUCCESS + 非空 rid），
            // 也不毒化整份恢复；其余记录（含旧版无 entry_kind 的成功/STALE）仍走
            // 原严格 rid/绑定校验，entry_kind 非法值一律拒。
            let _ne = hf_normalize_ai_log_entry(e, true)
            let _is_diag = false
            if _ne != nil {
                let _ek = ""
                try { if _ne.entry_kind != nil { _ek = _ne.entry_kind } } catch { _ek = "" }
                if _ek == "diagnostic" { _is_diag = true }
            }
            let _ek0 = nil
            try { _ek0 = e.entry_kind } catch { _ek0 = nil }
            if _ek0 != nil && _ek0 != "request_result" && _ek0 != "diagnostic" { bad = true }
            if !bad && _is_diag {
                // D-M6-03 (r12 修复轮，对 r13 Review D03-C)：诊断条目录入前按现有合法
                // 无请求失败诊断协议校验 —— result_kind 必须 NO_SERVICE、request_id
                // 必须缺失或空串、at 必须严格数值、task_id/project_id/actor 必须存在
                // 且为字符串（空串合法，草稿链本无任务）；任一不符即非法诊断：整份
                // 保源拒复（AI_LOG_CORRUPT），绝不充当成功出处。
                let _drk = nil
                let _drid = nil
                let _dtid = nil
                let _dpid = nil
                let _dact = nil
                let _dat = nil
                try { _drk = _ne.result_kind } catch { _drk = nil }
                try { _drid = _ne.request_id } catch { _drid = nil }
                try { _dtid = _ne.task_id } catch { _dtid = nil }
                try { _dpid = _ne.project_id } catch { _dpid = nil }
                try { _dact = _ne.actor } catch { _dact = nil }
                try { _dat = _ne.at } catch { _dat = nil }
                if !m7_is_nonempty_string(_drk) { bad = true }
                if !bad { if _drk != "NO_SERVICE" { bad = true } }
                if _drid != nil {
                    if !m7_is_string_value(_drid) { bad = true }
                    if !bad { if _drid != "" { bad = true } }
                }
                if _dtid == nil || _dpid == nil || _dact == nil { bad = true }
                if !bad {
                    if !m7_is_string_value(_dtid) || !m7_is_string_value(_dpid) || !m7_is_string_value(_dact) { bad = true }
                }
                if _dat == nil || !m7_is_strict_number_value(_dat) { bad = true }
                if !bad {
                    staged.push({schema_version: 2, entry_kind: "diagnostic",
                        at: _dat, request_id: "",
                        provider_id: (_ne.provider_id or ""), model_id: (_ne.model_id or ""),
                        host_label: (_ne.host_label or ""),
                        raw_text_length: (_ne.raw_text_length or 0), raw_text_hash: (_ne.raw_text_hash or ""),
                        result_kind: "NO_SERVICE", elapsed_ms: (_ne.elapsed_ms or 0),
                        task_id: (_ne.task_id or ""), project_id: (_ne.project_id or ""),
                        actor: (_ne.actor or "")})
                }
            }
            if !bad && !_is_diag {
                let _rid = nil
                let _rk = nil
                let _tid = nil
                let _pid = nil
                let _act = nil
                let _at = nil
                try { _rid = e.request_id } catch { _rid = nil }
                try { _rk = e.result_kind } catch { _rk = nil }
                try { _tid = e.task_id } catch { _tid = nil }
                try { _pid = e.project_id } catch { _pid = nil }
                try { _act = e.actor } catch { _act = nil }
                try { _at = e.at } catch { _at = nil }
                if !m7_is_nonempty_string(_rid) { bad = true }
                if !m7_is_nonempty_string(_rk) { bad = true }
                if _tid == nil || _pid == nil || _act == nil { bad = true }
                if _at == nil || !m7_is_strict_number_value(_at) { bad = true }
                if !bad {
                    staged.push({schema_version: 2, entry_kind: "request_result",
                        at: _at, request_id: _rid, provider_id: (e.provider_id or ""),
                        model_id: (e.model_id or ""), host_label: (e.host_label or ""),
                        raw_text_length: (e.raw_text_length or 0), raw_text_hash: (e.raw_text_hash or ""),
                        result_kind: _rk, elapsed_ms: (e.elapsed_ms or 0),
                        task_id: _tid, project_id: _pid, actor: _act})
                }
            }
        }
        i = i + 1
    }
    if bad {
        // 损坏保源：不并入、不覆盖，出处按未知；原文件字节保持不动。
        AI_LOG_CORRUPT = true
        return
    }
    let j = 0
    while j < staged.len() {
        AI_REQUESTS_LOG.push(staged[j])
        j = j + 1
    }
}

fn _persistAiLog(){
    // D-M6-03 (r10)：恢复发现损坏时保源 —— 不覆盖原文件，出处按未知。
    if AI_LOG_CORRUPT { return }
    try {
        let arr = []
        for e in AI_REQUESTS_LOG { arr.push(e) }
        fs.write("ai_requests.jsonl", arr.to_json())
    } catch _ { arr = arr }
}

// 把 confirmDraftModelBound 当作 M2 confirmDraft 的"协议网关"：
// 任何 version / state / identity 不匹配 → 不调 M2 confirmDraft；UI 提示拒绝原因。
// 通过则调 createDraftFromPanel()（代替旧 createDraft 的硬编码问题），然后
// 让 M2 confirmDraft 推 t.status=S_OPEN。
//
// D-M3-05：不依赖 currentTask()（那是当前选中任务，与本面板无关）；
// 用 PENDING_DRAFT 自身的 draft_version / raw_text_hash 与权威期望对比；
// 把 createDraftFromPanel / confirmDraft 的执行结果显式传播；失败 → 不写 CONFIRM_BIND。
fn confirmDraftModelBound(){
    let pb = PENDING_DRAFT
    // D-M3-02 / D-M3-03 (r4 修复轮)：按下按钮先同步当前 TextInput（仅在内容变化时生效）。
    _syncPanelInputFromUI()
    if TASK_INPUT.raw_text == "" && pb.problem == "" {
        // D-M2-02 (r10 修复轮，对 r11 Review)：冷开原意图重试直通 —— 面板为
        // 空但存在持久不可变意图（payload 完整且归属当前主体）时，本按钮语义是
        // 「查询/继续原动作」而非确认新内容：直接交 createDraftFromPanel 的
        // 对账/重放链（内部按原 payload fp 核验、任何占用状态异参拒绝、无原
        // 意图不创建空草稿），不被新内容前置守卫阻断。
        let _retry_intent = false
        if STATE.confirm_intent_id != nil && STATE.confirm_intent_id != "" {
            if STATE.confirm_intent != nil {
                let _pay = ""
                let _cia2 = ""
                try { if STATE.confirm_intent.payload != nil { _pay = STATE.confirm_intent.payload } } catch { _pay = "" }
                try { if STATE.confirm_intent.actor != nil { _cia2 = STATE.confirm_intent.actor } } catch { _cia2 = "" }
                if _pay != "" { if _cia2 == sessionActor() { _retry_intent = true } }
            }
        }
        if _retry_intent {
            // D-M3-05 (r9 修复轮，对 r11 Review)：恢复分支与正常确认共用显式
            // outcome 消费 —— "返回对象非 nil"不等于最终成功。unknown /
            // needs_verify 保留待核验与原意图键、绝不 return true；合法历史
            // final 成功与任务当前阶段分开显示；真实 task_id 只来自权威结果。
            let _rr = createDraftFromPanel()
            if _rr == nil {
                AI_LAST_ERROR = "原意图对账未决或权威未知；意图键与原文保留，未重复执行"
                return false
            }
            if _rr.commit_ok != true {
                AI_LAST_ERROR = "原意图落盘未确认（commit 未成功）；意图键与原文保留"
                return false
            }
            let _rr_final = ""
            try { if _rr.final_action_id != nil { _rr_final = _rr.final_action_id } } catch { _rr_final = "" }
            if _rr.confirmed_open == true {
                if _rr_final == "" {
                    AI_LAST_ERROR = "缺少最终确认 action_id；不能视为已提交"
                    return false
                }
                STATE.status = "✓ 原意图已确认；OPEN 工单 = " + _rr.task_id
                STATE.confirm_intent_id = ""
                STATE.confirm_intent = nil
                AI_STATE = "CONFIRMED"
                saveState()
                return true
            }
            let _rr_hist = false
            try { if _rr.historical_confirmed == true { _rr_hist = true } } catch { _rr_hist = false }
            if _rr_hist {
                STATE.status = "原确认动作已完成（action_id=" + _rr_final + "）；工单 " + _rr.task_id + " 当前状态=" + _rr.status + "（另读）；未重复执行"
                STATE.confirm_intent_id = ""
                STATE.confirm_intent = nil
                saveState()
                return true
            }
            let _rr_reason = "unknown"
            try { if _rr.confirm_reason != nil { if _rr.confirm_reason != "" { _rr_reason = _rr.confirm_reason } } } catch { _rr_reason = "unknown" }
            AI_LAST_ERROR = "原意图确认结果未决（" + _rr_reason + "）；意图键与原文保留，请核对后重试"
            return false
        }
        AI_STATE = "FORMAT_ERROR"
        AI_LAST_ERROR = "无原文 + 无草稿问题；不可确认"
        return false
    }
    if pb.problem == "" { AI_LAST_ERROR = "PENDING_DRAFT.problem 缺失"; return false }
    // D-M3-04 (r4 修复轮)：最终确认也必须跑共享守卫 — 刷新事实 / 权限 / 服务关系；
    // 不再只查存在。
    let _g = _validateDraftFacts()
    if !_g.success {
        AI_LAST_ERROR = "事实守卫：" + _g.reason
        AI_STATE = "FORMAT_ERROR"
        return false
    }
    // D-M3-04 (r6)：确认消费采纳时落下来的来源快照 —— verified 来源此刻仍
    // 须可核；不可核 / 已失效来源一律拒（unknown/unverified_text 不作依据
    // 但不阻断，界面上显式区分）。
    let _sg = _validateSourcesSnapshot()
    if !_sg.success {
        AI_LAST_ERROR = "来源守卫：" + _sg.reason
        AI_STATE = "FORMAT_ERROR"
        return false
    }
    // D-M3-03 (r6)：AI 来源草稿必须核 AI 历史绑定 —— 原文 hash / 主体 /
    // 项目任一漂移都拒；不能仅凭 draft_version 越过 M4 快照放行。
    if pb.ai_request_id != "" && pb.ai_request_id != nil {
        if pb.ai_history_raw_text_hash != TASK_INPUT.raw_text_hash {
            AI_LAST_ERROR = "AI 建议原文与当前输入不一致；旧建议不能确认"
            return false
        }
        if pb.sources != nil && m7_is_object_value(pb.sources) {
            if pb.sources.actor_at_apply != nil && pb.sources.actor_at_apply != "" {
                if sessionActor() != pb.sources.actor_at_apply {
                    AI_LAST_ERROR = "主体已切换；旧 AI 建议不能确认"
                    return false
                }
            }
            if pb.sources.project_at_apply != nil && pb.sources.project_at_apply != "" {
                if STATE.project != pb.sources.project_at_apply {
                    AI_LAST_ERROR = "项目已切换；旧 AI 建议不能确认"
                    return false
                }
            }
        }
        // D-M3-03 (r7)：首次确认与采纳守卫共用当前绑定校验 —— 任务版本 /
        // 证据版本 / 事实版本自采纳后漂移的一律拒，不只核原文与主体/项目。
        let _stale2 = _currentBindingStaleReason()
        if _stale2 != "" {
            AI_LAST_ERROR = _stale2
            return false
        }
    }
    // D-M3-06 (r6)：确认前拒未解核心定位歧义 / 缺项。缺项里 problem/space/
    // contact 由上方守卫覆盖；asset 缺失沿用"合法空间下设备可未知"的手工
    // 规则不拒。歧义（多候选）必须人工显式选择解决，否则不执行。
    let _resolved_m = _computeResolvedFields(PENDING_DRAFT.missing_fields)
    let _unresolved_m = []
    let _mi = 0
    while _mi < PENDING_DRAFT.missing_fields.len() {
        let _mf = PENDING_DRAFT.missing_fields[_mi]
        let _found = false
        let _ri = 0
        while _ri < _resolved_m.len() {
            if _resolved_m[_ri] == _mf { _found = true }
            _ri = _ri + 1
        }
        if !_found { _unresolved_m.push(_mf) }
        _mi = _mi + 1
    }
    let _resolved_a = _computeResolvedAmbiguous(PENDING_DRAFT.ambiguous_fields, PENDING_DRAFT.asset_alternatives, PENDING_DRAFT.asset_id)
    let _unresolved_a = []
    let _ai2 = 0
    while _ai2 < PENDING_DRAFT.ambiguous_fields.len() {
        let _af = PENDING_DRAFT.ambiguous_fields[_ai2]
        let _found2 = false
        let _ri2 = 0
        while _ri2 < _resolved_a.len() {
            if _resolved_a[_ri2] == _af { _found2 = true }
            _ri2 = _ri2 + 1
        }
        if !_found2 { _unresolved_a.push(_af) }
        _ai2 = _ai2 + 1
    }
    if _unresolved_a.len() > 0 {
        AI_LAST_ERROR = "核心定位歧义未解决（" + _strJoin(_unresolved_a, ",") + "）；请在备选设备/空间中显式选择后再确认"
        AI_STATE = "FORMAT_ERROR"
        return false
    }
    let _umi = 0
    while _umi < _unresolved_m.len() {
        let _uf = _unresolved_m[_umi]
        if _uf == "space" || _uf == "空间定位" {
            AI_LAST_ERROR = "空间定位缺项未解决；请选择空间后再确认"
            AI_STATE = "FORMAT_ERROR"
            return false
        }
        _umi = _umi + 1
    }
    if pb.contact == "" { AI_LAST_ERROR = "缺联系人"; return false }
    if pb.draft_version == 0 { AI_LAST_ERROR = "草稿版本未递增"; return false }
    if pb.expires_at_ms != 0 && nowMs() > pb.expires_at_ms {
        AI_LAST_ERROR = "草稿已过期，请重发"; return false
    }
    if !identityActive(sessionActor()) {
        AI_LAST_ERROR = "actor 已撤权 / 到期"; return false
    }
    // D-M3-03：confirm 也必须重对 raw_input_version（仅 hash 不够，可能 hash 相同但 version 已 ++）
    if PENDING_AI_REQUEST.active == true && PENDING_AI_REQUEST.expected_raw_input_version != TASK_INPUT.raw_input_version {
        AI_LAST_ERROR = "存在 active 请求但与当前输入版本不一致"
        return false
    }
    // D-M4-04 (r3 修复轮)：失效不再依赖 last_confirmed_at_ms > 0；任何被
    // 改派 / 改约 / 解绑 / 取消触碰的草稿/确认都标 invalidated_by_edit=true。
    // 用户重新确认成功后由 confirmDraftModelBound 把标志写回 false。
    // D-M4-04 (r4 修复轮)：恢复路径——若用户自上次失效后又做了新编辑
    // （raw_input_version 或 draft_version 已越过快照），视为"新绑定"，
    // 不再无条件拒绝。否则仍拒绝，提示重新确认更新后的内容。
    if CONFIRM_BIND.invalidated_by_edit == true {
        if STATE.m4_invalidations == nil { m4_init_forms() }
        let _snap_d = STATE.m4_invalidations.last_invalidate_draft_version
        let _snap_r = STATE.m4_invalidations.last_invalidate_raw_input_version
        let _cur_d = 0
        let _cur_r = 0
        if PENDING_DRAFT != nil && PENDING_DRAFT.draft_version != nil { _cur_d = PENDING_DRAFT.draft_version }
        if TASK_INPUT != nil && TASK_INPUT.raw_input_version != nil { _cur_r = TASK_INPUT.raw_input_version }
        // 旧 static snapshot 为 0 也算"未做新编辑"；与 _cur 比较只看严格 >0 进展
        let _draft_moved = (_cur_d > _snap_d)
        let _raw_moved = (_cur_r > _snap_r)
        if !(_draft_moved || _raw_moved) {
            AI_LAST_ERROR = "上次确认/草稿已被编辑失效；请重新确认新内容后再点确认"
            return false
        }
        // D-M4-04 (r5 修复轮)：快照恢复只证明"用户做了一次编辑",不等于"新
        // 绑定已形成"。m4_invalidateConfirmation 已把 PENDING_DRAFT 上的旧
        // AI 绑定（last_applied_request_id / ai_history_raw_text_hash /
        // expires_at_ms 等）拆掉；此处必须再核以下任一条件才放行:
        //   (a) AI 已重新生成并 applyDraftFromAI 落地 ——
        //       last_applied_request_id 非空且 ai_history_raw_text_hash
        //       与当前 TASK_INPUT.raw_text_hash 一致;或
        //   (b) 用户通过 editDraftField 显式重填了关键字段 problem /
        //       space_id / category,human_edited_epoch_fields 三项齐全。
        // D-M4-04 (r6 修复轮)：(b) 只消费"本次失效之后"的 epoch 集合 ——
        // 失效前的累计 human_edited_fields 仅作历史审计保留，不再计入本轮
        // 核对；旧编辑集齐备 + 仅改原文/联系人不能复活旧 proposal。
        // 仅满足快照恢复(raw_input_version++ / draft_version++)而既无新
        // AI 落地也无显式手工重填,不能复用旧 proposal / 旧确认。这把 r4
        // 任一版本增长复活旧AI 的路径关掉,旧失效审计保留。
        let _rebound = false
        let _ai_apid = ""
        if PENDING_DRAFT != nil && PENDING_DRAFT.last_applied_request_id != nil {
            _ai_apid = PENDING_DRAFT.last_applied_request_id
        }
        let _ai_h = ""
        if PENDING_DRAFT != nil && PENDING_DRAFT.ai_history_raw_text_hash != nil {
            _ai_h = PENDING_DRAFT.ai_history_raw_text_hash
        }
        let _cur_hash = ""
        if TASK_INPUT != nil && TASK_INPUT.raw_text_hash != nil { _cur_hash = TASK_INPUT.raw_text_hash }
        if _ai_apid != "" && _ai_h != "" && _ai_h == _cur_hash {
            _rebound = true
        }
        if !_rebound {
            let _hf = []
            if PENDING_DRAFT != nil && PENDING_DRAFT.human_edited_epoch_fields != nil {
                _hf = PENDING_DRAFT.human_edited_epoch_fields
            }
            let _has_p = false
            let _has_s = false
            let _has_c = false
            let _ki = 0
            while _ki < _hf.len() {
                if _hf[_ki] == "problem" { _has_p = true }
                if _hf[_ki] == "space_id" { _has_s = true }
                if _hf[_ki] == "category" { _has_c = true }
                _ki = _ki + 1
            }
            if _has_p && _has_s && _has_c { _rebound = true }
        }
        if !_rebound {
            AI_LAST_ERROR = "失效已被作废；请重新请求 AI 或手工填写 problem/space/category 后再确认"
            return false
        }
        // 否则放行；在尾部仍然只在 createDraftFromPanel 成功后
        // 才把 invalidated_by_edit 复位为 false（避免提前误复位）。
    }
    // 单路径入 M2 createDraftFromPanel → 拿到权威 task_id + receipt_id + status
    let outcome = createDraftFromPanel()
    if outcome == nil {
        AI_LAST_ERROR = "创建工单失败；M2 返回拒绝"
        return false
    }
    if outcome.task_id == "" {
        AI_LAST_ERROR = "创建工单失败；M2 未返回 task_id"
        return false
    }
    // D-M3-05 (r6)：只认权威最终回执 —— commit_ok + confirmed_open 都必须
    // 来自 createDraftFromPanel 内部对 confirmDraft 结构化结果、磁盘读回、
    // final 回执与关联事件的核验；内存态 OPEN 不再被当作提交证明。
    if outcome.commit_ok != true {
        AI_LAST_ERROR = "工单创建落盘未确认（commit 未成功）；草稿保留，请核对后重试"
        return false
    }
    if outcome.confirmed_open != true {
        AI_LAST_ERROR = "最终确认未获权威回执（任务未读回 OPEN / 回执未 final / 事件缺失）；草稿保留"
        return false
    }
    if outcome.final_action_id == nil || outcome.final_action_id == "" {
        AI_LAST_ERROR = "缺少最终确认 action_id；不能视为已提交"
        return false
    }
    if outcome.status != S_OPEN {
        AI_LAST_ERROR = "M2 未把工单推到 OPEN（status=" + outcome.status + "）"
        return false
    }
    // 仅在权威回执 / 读回一致后写 CONFIRM_BIND；否则任何旧确认都不被覆盖
    CONFIRM_BIND.last_confirmed_at_ms = nowMs()
    CONFIRM_BIND.last_confirmed_draft_version = PENDING_DRAFT.draft_version
    CONFIRM_BIND.last_confirmed_raw_text_hash = TASK_INPUT.raw_text_hash
    CONFIRM_BIND.invalidated_by_edit = false
    // D-M2-02 (r8)：本意图已权威完成 → 轮换 intent_id；此后同内容的确认是
    // 合法新独立意图（新 key），不再被旧意图回执折叠。
    STATE.confirm_intent_id = ""
    STATE.confirm_intent = nil
    STATE.panel = "none"
    AI_STATE = "CONFIRMED"
    // D-M3-05 (r9)：成功文案由本函数按权威结果（task_id）设置，按钮不得再
    // 凭 currentTask()/固定 OPEN 文案覆盖。
    STATE.status = "✓ 已确认；OPEN 工单 = " + outcome.task_id
    saveState()
    return true
}

// 改造 createDraft 使用面板输入 + PENDING_DRAFT 字段；本函数仍保留旧名以便
// 不被其他路径误改，但所有入口都改走 confirmDraftModelBound → createDraftFromPanel。
fn createDraft(){
    // 兜底：直接打开面板（用户从未填过）
    openDraftPanel()
}

// D-M3-05 / D-M3-06：把面板内容落为 task + 持久化原文 / 来源 / 缺项 / 歧义到 task 上；
// 走 M2 既有 runCommandBound → commitBound；返回 {task_id, action_id, status} 让
// confirmDraftModelBound 能判断是否真的 OPEN。
fn createDraftFromPanel(){
    let creator=getMe()
    if creator.id == "" || !hasRole(creator,STATE.project,"REPORTER") { fail("报修账号或项目角色无效"); return nil }
    // D-M2-02 (r8)：创建意图键 = 持久 intent_id —— 首次确认生成、跨重启沿用、
    // 权威确认完成后轮换（confirmDraftModelBound 尾部清空）。内容指纹只作
    // payload fp：同内容的双击/超时/重开重试命中同一意图 → 返回原结果不重建；
    // 上次确认完成后的同内容新确认 = 新 intent_id → 合法新意图允许新建；
    // 意图存续期间改内容 = 同 key 异 payload，对已 final 原动作一律 conflict。
    if STATE.confirm_intent_id == nil { STATE.confirm_intent_id = "" }
    // D-M2-02 (r9)：意图归属校验 —— 持久意图记录必须存在且 actor/project 与
    // 当前可信上下文相符才沿用；缺失或不相符 = 切换主体/项目后的新独立动作，
    // 轮换为新意图，绝不沿用旧 key 冒名原主体。
    let _ci_ok = false
    if STATE.confirm_intent_id != "" {
        if STATE.confirm_intent != nil {
            let _cia = ""
            let _cip = ""
            try { if STATE.confirm_intent.actor != nil { _cia = STATE.confirm_intent.actor } } catch { _cia = "" }
            try { if STATE.confirm_intent.project != nil { _cip = STATE.confirm_intent.project } } catch { _cip = "" }
            if _cia == sessionActor() { if _cip == STATE.project { _ci_ok = true } }
        }
    }
    if STATE.confirm_intent_id != "" && !_ci_ok {
        STATE.confirm_intent_id = ""
        STATE.confirm_intent = nil
    }
    let _cd_content = {project: STATE.project, space: PENDING_DRAFT.space_id,
                       category: PENDING_DRAFT.category, problem: PENDING_DRAFT.problem,
                       contact: PENDING_DRAFT.contact, contact_info: PENDING_DRAFT.contact_info,
                       asset: PENDING_DRAFT.asset_id, raw_text_hash: TASK_INPUT.raw_text_hash}
    if STATE.confirm_intent_id == "" {
        STATE.confirm_intent_id = "ci-" + newId()
        // D-M2-02 (r9)：首次操作即持久不可变确认内容（payload 快照）与稳定
        // key；跨重启沿用原 key 与原 payload 对账，重试不重生 key。
        STATE.confirm_intent = {id: STATE.confirm_intent_id, actor: sessionActor(),
                                project: STATE.project, command: "createDraft",
                                key: "createDraft|" + sessionActor() + "|" + STATE.project + "|" + STATE.confirm_intent_id,
                                payload: _cd_content.to_json(), phase: "issued", at: nowMs()}
        saveState()
    }
    let _cd_key = ""
    try { if STATE.confirm_intent.key != nil { _cd_key = STATE.confirm_intent.key } } catch { _cd_key = "" }
    if _cd_key == "" { _cd_key = "createDraft|" + sessionActor() + "|" + STATE.project + "|" + STATE.confirm_intent_id }
    let fp = "createDraft|" + _cd_content.to_json()
    // D-M2-02 (r9)：冷开恢复后面板内容为空但持久意图仍持原 payload —— 按原
    // 不可变 payload 对账（这是重试路径）；面板有内容时以当前内容为准
    // （意图存续期间改内容 = 同 key 异 payload → 对已 final 原动作 conflict）。
    let _live_empty = false
    if PENDING_DRAFT.problem == "" { if PENDING_DRAFT.space_id == "" { if PENDING_DRAFT.contact == "" { _live_empty = true } } }
    if _live_empty {
        let _cip_payload = ""
        try { if STATE.confirm_intent.payload != nil { _cip_payload = STATE.confirm_intent.payload } } catch { _cip_payload = "" }
        if _cip_payload != "" { fp = "createDraft|" + _cip_payload }
    }
    // 本意图键下所有占用回执（rejected=未执行 / pending_orphan=确定未提交 不占键）。
    let _ci = 0
    let _cd_prior = nil
    while _ci < RECEIPTS.len() {
        let _r = RECEIPTS[_ci]
        if _r.actor == sessionActor() {
            if _r.command == "createDraft" {
                if _r.key == _cd_key {
                    if _r.status != "rejected" {
                        if _r.status != "pending_orphan" { _cd_prior = _r }
                    }
                }
            }
        }
        _ci = _ci + 1
    }
    // D-M2-02 (r10)：空面板 + 无原意图回执 = 无事可对账 —— 拒创建空草稿；
    // 冷开重试直通只允许沿原意图对账/重放，绝不用空内容新建。
    if _cd_prior == nil { if _live_empty { fail("面板为空且无原意图可对账；不创建空草稿"); return nil } }
    if _cd_prior != nil {
        // D-M2-02 (r10 修复轮，对 r11 Review)：同 key 异 payload 在**任何占用
        // 状态**下一律 conflict 拒绝 —— 不只 final/final_recovered；pending /
        // needs_verify / unknown 同样占用意图键，绝不用已改内容顶替未完成的
        // 原意图（内容变更必须先由权威对账确定原动作未提交，经 orphan 出口）。
        if _cd_prior.fp != fp {
            fail("idem_conflict：同意图键不同 payload（原状态=" + _cd_prior.status + "）；原 action_id=" + _cd_prior.action_id)
            return nil
        }
        // 原动作 task_id：优先取回执 task_id 字段，兜底从 final result 解。
        let _rp_task_id = ""
        if _cd_prior.task_id != nil { _rp_task_id = _cd_prior.task_id }
        if _rp_task_id == "" {
            try {
                let _pj = _cd_prior.result.parse_json()
                if _pj != nil { if _pj.id != nil { _rp_task_id = _pj.id } }
            } catch _ { _rp_task_id = "" }
        }
        let _rp_status = S_DRAFT
        let _rp_disk = nil
        if _rp_task_id != "" {
            _rp_disk = readTaskByIdFromDisk(_rp_task_id)
            if _rp_disk != nil { _rp_status = _rp_disk.status }
        }
        // D-M3-05 (r7)：创建重放先过权威对账器 —— 只有磁盘 OPEN + 精确
        // confirmDraft final 回执 + 磁盘关联事件才算原意图已完成；
        // final_action_id 取自确认回执，绝不回填 createDraft 的动作 ID。
        let _ra = _authorityCheckConfirmedOpen(_rp_task_id)
        if _ra.open {
            // D-M2-02 (r12，对 r16 Review)：outcome 的 action_id 与 original_result
            // 必须同属一个原动作 —— 原创建动作的 outcome 用创建回执自己的
            // action_id + result；确认 action_id 只作独立字段 final_action_id，
            // 不再拿确认 ID 搭配创建 result（混绑会让对账把两个动作当一个）。
            let _oc1 = hf_action_outcome("historical", _cd_prior.action_id, _cd_prior.result, _rp_task_id, S_OPEN, "replay", _cd_key)
            _oc1.final_action_id = _ra.final_action_id
            STATE.last_idem_hit = {action_id: _cd_prior.action_id, status: _cd_prior.status,
                                   result: _cd_prior.result, at: nowMs(), outcome: _oc1}
            STATE.status = "相同内容工单已创建并确认（action_id=" + _ra.final_action_id + "）；返回原结果，不重复创建"
            saveState()
            return {task_id: _rp_task_id, action_id: _cd_prior.action_id, status: S_OPEN,
                    commit_ok: true, confirmed_open: true, final_action_id: _ra.final_action_id,
                    original_result: _cd_prior.result, outcome: _oc1}
        }
        // D-M2-02/D-M2-04 (r10)：原动作成功事实与当前任务状态分离 —— 任务已合法
        // 推进（ACCEPTED/v9 等，不再 OPEN）时，只要磁盘存在 confirmDraft final /
        // final_recovered 回执 + 关联同一 action_id 的 confirm_draft 事件，原确认
        // 动作即已完成：返回完整原结果，当前任务状态独立另读，不重复执行，
        // 合法后续状态不抹掉原历史。
        // D-M2-02 (r12，对 r16 Review)：历史核验禁止空绑定回退 —— 必须按原确认
        // 意图的真实 key/fp 精确绑定（fp 由盘任务 + 固定 params 重建，key 从持久
        // 意图记录取）；意图不可重建时 _authorityHistoricalConfirm 直接不确认，
        // 绝不退成「同 task 同 actor 最后一条 final」。
        let _fp_h = ""
        let _key_h = ""
        if _rp_disk != nil {
            _fp_h = fingerprint("confirmDraft", _rp_disk, {task_id: _rp_task_id})
            let _it_h = _action_intent_find(_rp_task_id, "confirmDraft", _fp_h)
            if _it_h != nil { _key_h = _it_h.key }
        }
        let _rh = _authorityHistoricalConfirm(_rp_task_id, _key_h, _fp_h)
        if _rh.confirmed {
            // D-M2-02 (r11)：统一 outcome —— original_result 取该 action_id 精确
            // 绑定的确认回执完整 result（不是同 task 任意一条 final）。
            let _oc2 = hf_action_outcome("historical", _rh.action_id, _rh.original_result, _rp_task_id, _rp_status, "replay", _cd_key)
            STATE.last_idem_hit = {action_id: _cd_prior.action_id, status: _cd_prior.status,
                                   result: _cd_prior.result, at: nowMs(), outcome: _oc2}
            STATE.status = "原确认动作已完成（action_id=" + _rh.action_id + "）；任务当前状态=" + _rp_status + "（另读）；返回原结果，不重复执行"
            saveState()
            return {task_id: _rp_task_id, action_id: _cd_prior.action_id, status: _rp_status,
                    commit_ok: true, confirmed_open: false, historical_confirmed: true,
                    final_action_id: _rh.action_id,
                    original_result: _rh.original_result, outcome: _oc2}
        }
        // 任务已建但确认未完成（丢响应 / 事件写失败）：不 newId 重建 ——
        // 恢复选中同一任务，直接走 confirmDraft 完成原意图。
        if _rp_disk != nil && _rp_status == S_DRAFT {
            let _rsi = 0
            let _rs_found = false
            while _rsi < TASKS.len() {
                if TASKS[_rsi].id == _rp_task_id { _rs_found = true; break }
                _rsi = _rsi + 1
            }
            if _rs_found {
                STATE.selected_task_id = _rp_task_id
                STATE.selectedIdx = _rsi
                STATE.status = "恢复未完成的确认（task_id=" + _rp_task_id + "）；继续原意图"
                saveState()
                let _cf3 = confirmDraft()
                if _cf3 != nil {
                    if _cf3.result == "final" {
                        return {task_id: _rp_task_id, action_id: _cd_prior.action_id, status: S_OPEN,
                                commit_ok: true, confirmed_open: true, final_action_id: _cf3.action_id}
                    }
                    let _st3 = _rp_status
                    if _cf3.status != nil && _cf3.status != "" { _st3 = _cf3.status }
                    return {task_id: _rp_task_id, action_id: _cd_prior.action_id, status: _st3,
                            commit_ok: true, confirmed_open: false, final_action_id: "",
                            confirm_result: _cf3.result, confirm_reason: _cf3.reason}
                }
                return {task_id: _rp_task_id, action_id: _cd_prior.action_id, status: _rp_status,
                        commit_ok: true, confirmed_open: false, final_action_id: "",
                        confirm_result: "unknown", confirm_reason: "确认恢复调用无返回"}
            }
        }
        // D-M2-02 (r8)：unknown（pending/needs_verify）先对账 —— 绝不直接
        // newId 重建。缺 task_id 或盘不可读 = 权威未知，明确出口不创建；
        // 盘可读且确无此任务 = 确定未提交，原回执标 orphan 后允许同一意图
        // 键继续（沿用原 key，下方是唯一新建路径）。
        if _rp_task_id == "" {
            STATE.status = "待核验：原意图回执（action_id=" + _cd_prior.action_id + "）缺 task_id，无法对账；未重复创建"
            saveState()
            return nil
        }
        if _rp_disk == nil {
            let _dq = nil
            if fs.exists("tasks.json") {
                try { _dq = fs.read("tasks.json").parse_json() } catch { _dq = nil }
            } else { _dq = [] }
            if _dq == nil {
                STATE.status = "待核验：tasks.json 读取/解析失败，原动作（action_id=" + _cd_prior.action_id + "）权威未知；未重复创建"
                saveState()
                return nil
            }
            _cd_prior.status = "pending_orphan"
            _cd_prior.note = "对账：盘无此任务，确定未提交；允许同意图按原 key 继续"
            saveReceipts()
        } else {
            // 其它情况（非 DRAFT 非 OPEN / 对账失败）：如实返回未确认，
            // 草稿保留，绝不包装成功。
            STATE.last_idem_hit = {action_id: _cd_prior.action_id, status: _cd_prior.status,
                                   result: _cd_prior.result, at: nowMs()}
            STATE.status = "原意图任务已在盘（action_id=" + _cd_prior.action_id + "，status=" + _rp_status + "）；但权威确认未完成：" + _ra.reason
            saveState()
            return {task_id: _rp_task_id, action_id: _cd_prior.action_id, status: _rp_status,
                    commit_ok: true, confirmed_open: false, final_action_id: "",
                    confirm_result: "unknown", confirm_reason: _ra.reason}
        }
    }
    let t = {id: newId(), project: STATE.project,
             space: PENDING_DRAFT.space_id,
             category: PENDING_DRAFT.category,
             problem: PENDING_DRAFT.problem,
             contact: PENDING_DRAFT.contact,
             contactInfo: PENDING_DRAFT.contact_info,
             reporter: sessionActor(), assignee: nil, asset: PENDING_DRAFT.asset_id,
             status: S_DRAFT, version: 0,
             appointments: [], evidence: [], completions: [],
             notes: [], pinnedBy: [], createdAtMs: nowMs(), updatedAtMs: nowMs(),
             // D-M3-06：原文 + AI 来源 / 缺项 / 歧义 / 备选 / 联系人原文 / 输入版本 / 草稿版本 全部落 task
             raw_text: TASK_INPUT.raw_text,
             raw_text_hash: TASK_INPUT.raw_text_hash,
             raw_input_version: TASK_INPUT.raw_input_version,
             draft_version_at_confirm: PENDING_DRAFT.draft_version,
             ai_request_id: PENDING_DRAFT.ai_request_id,
             ai_sources: PENDING_DRAFT.sources,
             ai_confidence: PENDING_DRAFT.ai_confidence,
             ai_missing_fields: PENDING_DRAFT.missing_fields,
             ai_ambiguous_fields: PENDING_DRAFT.ambiguous_fields,
             ai_asset_alternatives: PENDING_DRAFT.asset_alternatives,
             human_edited_fields: PENDING_DRAFT.human_edited_fields,
             draft_source: PENDING_DRAFT.draft_source,
             // D-M3-06 (r3)：AI 原文 / AI 输入版本 / 期望窗口 / 缺项歧义已解决标记 —
             // 让重开工单能同时追 A 来源 + B 原文 + 时间意图；不与 D-M3-04 重复校验
             ai_history_raw_text: PENDING_DRAFT.ai_history_raw_text,
             ai_history_raw_text_hash: PENDING_DRAFT.ai_history_raw_text_hash,
             ai_history_raw_input_version: PENDING_DRAFT.ai_history_raw_input_version,
             desired_window_start_ms: PENDING_DRAFT.desired_window_start_ms,
             desired_window_end_ms: PENDING_DRAFT.desired_window_end_ms,
             // D-M3-06 (r4 修复轮)：按当前 PENDING_DRAFT 实际填写情况计算
             // 缺项 / 歧义解决情况；empty 已填 / 备选已选 → 记为已解决；未填 → 保留
             // 在未解决数组里。重开工单能依据这两个数组核查人为解决痕迹。
             resolved_missing_fields: _computeResolvedFields(PENDING_DRAFT.missing_fields),
             resolved_ambiguous_fields: _computeResolvedAmbiguous(PENDING_DRAFT.ambiguous_fields, PENDING_DRAFT.asset_alternatives, PENDING_DRAFT.asset_id)}
    if !identityActive(sessionActor()) {
        fail("actor_invalid：身份 " + sessionActor() + " 不在注册表 / 已撤权 / 已到期")
        return nil
    }
    // D-M2-03 (r8)：历史含坏行时整个创建禁写（回执/事件保存本就会被冻结，
    // 不允许任务主写单独发生）。
    if M2_ACTIONS_DIRTY || M2_EVENTS_DIRTY {
        fail("历史含坏行，业务写已冻结；请按 .bad_lines 修复后重启")
        return nil
    }
    // M4 r8 (B-M4-01)：恢复未决时禁止创建 —— TASKS 不接纳新对象、盘不覆盖，
    // 避免"内存已 push、主写被 pending 拒"的半提交状态。
    if STATE.tasks_pending_recovery == true {
        fail("tasks_pending_recovery：任务文件恢复未决，禁止创建；请先用恢复入口")
        return nil
    }
    // D-M2-05 (r8)：创建与既有任务写进入同一锁边界 —— 先取锁再写 pending
    // 回执与 tasks.json；取锁失败直接拒，不允许绕过 commitBound 的锁核对。
    if !_acquireTaskLock() {
        fail("concurrency_lost：tasks.lock 已被占或不可用；创建未写入")
        return nil
    }
    // D-M2-02 (r8)：使用进入本函数前按持久 intent_id 建立的稳定 key（_cd_key）
    // 与内容 fp（上方已定义）；不走 generateStableKey（把 newId 的 t.id 编进
    // key 会让重试永远生成新 key 规避重放检测）。
    LAST_KEY = _cd_key
    let _pending_rid = newId()
    // D-M2-03 (r9)：pending 回执先于任务入内存/落盘，且保存结果必须消费 ——
    // 回执未落盘 = 提交前提不成立，fail-closed：任务不入 TASKS、盘不变、
    // 释放锁并如实拒绝，绝不忽略保存返回继续提交造成无回执业务写。
    RECEIPTS.push({action_id: _pending_rid, key: LAST_KEY, actor: sessionActor(),
                   command: "createDraft", task_id: t.id, fp: fp,
                   expected_version: 0, status: "pending", at: nowMs(),
                   params: {problem: t.problem},
                   before: ""})
    let _pr_ok = saveReceipts()
    if !_pr_ok {
        let _keep2 = []
        let _ri2 = 0
        while _ri2 < RECEIPTS.len() - 1 { _keep2.push(RECEIPTS[_ri2]); _ri2 = _ri2 + 1 }
        RECEIPTS = _keep2
        _releaseTaskLock()
        fail("pending 回执未落盘：创建未提交，任务与磁盘均未变更；请检查历史存储后重试")
        return nil
    }
    TASKS.push(t)
    STATE.selected_task_id = t.id
    STATE.selectedIdx = TASKS.len() - 1
    // D-M4-03：commitBound 契约要求 t.version == expected_version + 1；新任务 version
    // 起始 0，必须先自增到 1 再调 commitBound(expected_version=0)，否则内部版本
    // 漂移 → 待核验。
    t.version = t.version + 1
    t.updatedAtMs = nowMs()
    let _cd_params = {task_id: t.id, problem: t.problem}
    let _ev = 0
    _PENDING_CMD = "createDraft"
    _PENDING_RESULT = {task_id: t.id, status: t.status}
    _PENDING_RECEIPT_ID = _pending_rid
    // D-M2-03 修复(r5):成功提示必须等 commitBound 返回 true 才写;失败/待核
    // 验时 STATE.status 绝不能是"草稿已创建"——saveState 只写视图/会话无关字段。
    saveState()
    let _commit_ok = commitBound(t, 0, "createDraft", {task_id: t.id, status: t.status})
    _PENDING_CMD = ""
    _PENDING_RESULT = nil
    _PENDING_RECEIPT_ID = ""
    if !_commit_ok {
        // commitBound 已经落 reject/needs_verify receipt;不再写 success 事件
        // 也不再写"草稿已创建"状态。
        _LAST_ACTION_ID = ""
        return {task_id: t.id, action_id: _pending_rid, status: t.status, commit_ok: false}
    }
    // D-M2-03 (r6)：成功才暂存 action_id，随后的 logEvent 与之关联。
    _LAST_ACTION_ID = _pending_rid
    STATE.status = "草稿已创建 " + t.id
    saveState()
    logEvent("create_draft", t, {status: t.status, task_id: t.id, source: PENDING_DRAFT.draft_source})
    saveEvents()
    refreshLabels(t)
    // D-M3-05 (r6)：M2 confirmDraft 返回结构化最终结果；confirmed_open 只在
    // result=="final"（其内部已完成磁盘读回 + final 回执 + 关联事件核验）时
    // 成立。任何 rejected/unknown 都如实上抛，不把内存 OPEN 包装成成功。
    let _cf = confirmDraft()
    if _cf == nil {
        return {task_id: t.id, action_id: _pending_rid, status: t.status, commit_ok: true, confirmed_open: false, final_action_id: ""}
    }
    if _cf.result != "final" {
        let _st = t.status
        if _cf.status != nil && _cf.status != "" { _st = _cf.status }
        return {task_id: t.id, action_id: _pending_rid, status: _st, commit_ok: true, confirmed_open: false,
                final_action_id: "", confirm_result: _cf.result, confirm_reason: _cf.reason}
    }
    // 消费端再独立读回一次（不信任 callee 内存视图）
    let _final_disk = readTaskByIdFromDisk(t.id)
    if _final_disk == nil || _final_disk.status != S_OPEN {
        return {task_id: t.id, action_id: _pending_rid, status: t.status, commit_ok: true, confirmed_open: false,
                final_action_id: _cf.action_id, confirm_result: "readback_failed"}
    }
    return {task_id: t.id, action_id: _pending_rid, status: S_OPEN, commit_ok: true, confirmed_open: true,
            final_action_id: _cf.action_id}
}

// 投影 PENDING_DRAFT 到 UI label
fn pendingDraftLabelText(){
    let pb = PENDING_DRAFT
    if pb.draft_version == 0 { return "填写描述后，选择空间、设备和联系人。" }
    let s = "报修信息"
    s = s + "\n问题：" + pb.problem
    let _space_alias_4084 = "（待选）"
    if pb.space_id != "" { _space_alias_4084 = pb.space_id }
    s = s + "\n空间：" + _space_alias_4084
    let _asset_alias_4085 = "（待选）"
    if pb.asset_id != "" { _asset_alias_4085 = pb.asset_id }
    s = s + "  设备：" + _asset_alias_4085
    let _cat_alias_4086 = "（待选）"
    if pb.category != "" { _cat_alias_4086 = pb.category }
    s = s + "  类目：" + _cat_alias_4086
    let _contact_alias_4087 = "（待选）"
    if pb.contact != "" { _contact_alias_4087 = pb.contact }
    s = s + "\n联系人：" + _contact_alias_4087
    if pb.desired_window_start_ms > 0 && pb.desired_window_end_ms > 0 {
        s = s + "\n窗口：" + pb.desired_window_start_ms.to_string()
              + " ~ " + pb.desired_window_end_ms.to_string()
    }
    if pb.human_edited_fields.len() > 0 {
        s = s + "\n人工编辑："
        let j = 0
        while j < pb.human_edited_fields.len() {
            if j > 0 { s = s + "," }
            s = s + pb.human_edited_fields[j]
            j = j + 1
        }
    }
    return s
}

fn aiStateLabelText(){
    let message = "AI 建议暂不可用，请检查后重试"
    if AI_STATE == "IDLE" { message = "尚未请求 AI 建议" }
    if AI_STATE == "ASKING" { message = "正在获取 AI 建议…" }
    if AI_STATE == "APPLIED" { message = "AI 建议已返回，请核对后采纳" }
    if AI_STATE == "CONFIRMED" { message = "报修已确认" }
    if AI_STATE == "CANCELED" { message = "已取消 AI 请求" }
    if AI_STATE == "NO_SERVICE" { message = "AI 服务暂不可用，可手动填写" }
    if AI_STATE == "TIMEOUT" { message = "AI 请求超时，请重试或手动填写" }
    if AI_STATE == "UNAUTHORIZED" || AI_STATE == "AWAITING_AUTH" { message = "AI 服务需要授权" }
    if AI_STATE == "FORMAT_ERROR" { message = "AI 建议格式异常，请重试" }
    if AI_STATE == "EXPIRED" { message = "AI 建议已过期，请重新请求" }
    if AI_STATE == "STALE_INPUT" || AI_STATE == "STALE_DRAFT_VERSION" || AI_STATE == "STALE_TASK_VERSION" { message = "信息已更新，请重新请求 AI 建议" }
    if AI_LAST_ERROR != "" { message = message + "：" + AI_LAST_ERROR }
    return message
}

fn aiSuggestionLabelText(){
    if PENDING_AI_REQUEST.active == false && PENDING_DRAFT.draft_version == 0 {
        return "可直接手动填写，也可请求 AI 协助整理。"
    }
    if PENDING_AI_REQUEST.active && PENDING_DRAFT.draft_version == 0 {
        return "正在整理问题描述，请稍候…"
    }
    // D-M3-04 (r6)：来源显式按结构渲染（id[status]“quote”），不再把对象
    // 当字符串拼接；unknown / unverified_text 在界面上与 verified 区分。
    let src_text = _fmtSourceEntry("space", PENDING_DRAFT.sources.space) + "\n　" +
                   _fmtSourceEntry("asset", PENDING_DRAFT.sources.asset) + "\n　" +
                   _fmtSourceEntry("category", PENDING_DRAFT.sources.category)
    let _out = "建议依据：\n　" + src_text
    if PENDING_DRAFT.missing_fields.len() > 0 {
        _out = _out + "\n缺项追问：" + _strJoin(PENDING_DRAFT.missing_fields, ",")
    }
    if PENDING_DRAFT.ambiguous_fields.len() > 0 {
        _out = _out + "\n待澄清歧义：" + _strJoin(PENDING_DRAFT.ambiguous_fields, ",")
    }
    return _out
}

fn inputValidationLabelText(){
    let pb = PENDING_DRAFT
    let issues = []
    if pb.problem == "" { issues.push("问题") }
    if pb.space_id == "" || _findSpace(pb.space_id) == nil { issues.push("空间（请选择有效空间）") }
    if pb.asset_id == "" || _findAsset(pb.asset_id) == nil { issues.push("设备（请选择并确认）") }
    if pb.category == "" || !_isValidCategory(pb.category) { issues.push("类目（请选择有效类目）") }
    if pb.contact == "" { issues.push("联系人") }
    // D-M3-06 (r6)：缺项 / 歧义显式给出补充出口
    if pb.missing_fields != nil && pb.missing_fields.len() > 0 {
        let _rm = _computeResolvedFields(pb.missing_fields)
        let _i2 = 0
        while _i2 < pb.missing_fields.len() {
            let _mf = pb.missing_fields[_i2]
            let _fnd = false
            let _j2 = 0
            while _j2 < _rm.len() {
                if _rm[_j2] == _mf { _fnd = true }
                _j2 = _j2 + 1
            }
            if !_fnd { issues.push("缺项未解：" + _mf + "（请补充）") }
            _i2 = _i2 + 1
        }
    }
    if pb.ambiguous_fields != nil && pb.ambiguous_fields.len() > 0 {
        let _ra = _computeResolvedAmbiguous(pb.ambiguous_fields, pb.asset_alternatives, pb.asset_id)
        let _i3 = 0
        while _i3 < pb.ambiguous_fields.len() {
            let _af = pb.ambiguous_fields[_i3]
            let _fnd2 = false
            let _j3 = 0
            while _j3 < _ra.len() {
                if _ra[_j3] == _af { _fnd2 = true }
                _j3 = _j3 + 1
            }
            if !_fnd2 { issues.push("歧义未解：" + _af + "（请在备选中显式选择）") }
            _i3 = _i3 + 1
        }
    }
    if CONFIRM_BIND.invalidated_by_edit { issues.push("（上次确认已被编辑失效）") }
    if issues.len() == 0 { return "必填信息已齐全，请核对后提交" }
    let out = "待填写或核对："
    let j = 0
    while j < issues.len() {
        out = out + "\n· " + issues[j]
        j = j + 1
    }
    return out
}

// D-M2-02 修复:稳定 action_key —— 由 (cmd, task_id, expected_version, params fp)
// 派生，而不是每次点击重生。这样重试（无论是 UI 重复点击 / 响应丢失 / 调度重发）
// 都会得到同一 key；如果同 key 同参数命中已 final receipt，直接返回原 action_id。
// 同 key 不同参数 → idem_conflict（拒绝）。
// D-M2-02 配套:_prepareStableKey 把首次生成的 key 持久化到 STATE.action_keys_by_task;
// 用户重试/重开沿用同一 key,不再随 expected_version++ 重生。
// D-M2-02 修复(r5):不可变确认协议 — 意图记录按 (task_id, cmd, payload_fp)
// 索引,持久化跨 session/重启。同 fp 重试/重开沿用原 key;同 cmd 不同 fp
// 是新意图,生成新 key + 追加新记录;旧记录保留作为历史(action_id 不丢)。
// 不再用单一 (task_id, cmd) → key 槽位,因那样无法区分"重试"和"新意图"。
let _action_intents = {}    // key=task_id + "|" + cmd; value = [{fp, key, at}]
fn _action_intent_list(task_id, cmd){
    if STATE == nil { return [] }
    if STATE.action_keys_by_task == nil { STATE.action_keys_by_task = {} }
    let _k = task_id + "|" + cmd
    let _v = STATE.action_keys_by_task[_k]
    if _v == nil || _v == "" { return [] }
    return _v
}
fn _action_intent_find(task_id, cmd, fp){
    let _lst = _action_intent_list(task_id, cmd)
    let i = 0
    while i < _lst.len() {
        if _lst[i].fp == fp { return _lst[i] }
        i = i + 1
    }
    return nil
}
fn _action_intent_append(task_id, cmd, fp, key, payload){
    if STATE == nil { return }
    if STATE.action_keys_by_task == nil { STATE.action_keys_by_task = {} }
    let _k = task_id + "|" + cmd
    let _cur = STATE.action_keys_by_task[_k]
    if _cur == nil || _cur == "" { _cur = [] }
    // D-M2-02 (r6)：持久意图含 actor/task/command/不可变 payload/key/阶段；
    // append 立即 saveState 持久化，重开后仍可区分"重试"与"新确认"。
    _cur.push({actor: sessionActor(), task_id: task_id, command: cmd,
               fp: fp, key: key, payload: payload, phase: "issued", at: nowMs()})
    STATE.action_keys_by_task[_k] = _cur
    saveState()
}
fn _fp_of(cmd, t, params){
    return fingerprint(cmd, t, params)
}
fn generateStableKey(cmd, t, params, expected_version){
    // D-M2-02 修复(r5):同 fp 重试/重开 → 沿用原 key;新 fp → 新 key + 新记录,
    // 旧 key 与 action_id 全部保留作为历史。
    let _fp = _fp_of(cmd, t, params)
    let _hit = _action_intent_find(t.id, cmd, _fp)
    if _hit != nil { return _hit.key }
    let _fresh = cmd + "|" + sessionActor() + "|" + t.id + "|v=" + expected_version.to_string() + "|" + _fp
    _action_intent_append(t.id, cmd, _fp, _fresh, params.to_json())
    return _fresh
}

// D-M2-02 (r6)：授权后、业务前置校验之前的"原动作优先"查询。
// params 可重建时按 fp 查意图：同 payload 重试 → 返回完整原结果（action_id+
// result 进 STATE.last_idem_hit），跨状态/版本升高也成立；新 payload → false
// 走正常新意图流程。params 因状态变化不可重建（传 nil）且 allow_latest=true
// 时：该命令此时已不可能新执行（前置校验必拒），回退到该 (actor,task,cmd)
// 最近一条 final 的原结果——这正是"current v5 查原 action v1"的出口。
// allow_latest=false（可重复命令）时 params 不可重建则一律 false，绝不挡住
// 合法的新独立动作。
fn _m2_emit_replay(pr){
    // D-M2-02 (r11)：重放携带统一 outcome（hf_action_outcome）—— kind=
    // historical、完整 original_result、retry_key 原键；UI/调用方消费同一
    // 判据，不再只凭状态文本。
    let _oc = hf_action_outcome("historical", pr.action_id, pr.result, pr.task_id, "", "replay", pr.key)
    STATE.last_idem_hit = {action_id: pr.action_id, status: pr.status,
                           result: pr.result, at: nowMs(), outcome: _oc}
    STATE.status = "原动作已完成（action_id=" + pr.action_id + "）；返回原结果，不重复执行；当前任务状态请另读"
    saveState()
    return true
}
fn m2ReplayAtTop(cmd, t, params, allow_latest){
    if t == nil { return false }
    if !identityActive(sessionActor()) { return false }
    // D-M2-01 修复(r7)：replay 不只核会话活跃；逐 task 核当前项目权限，
    // 移除项目角色/跨项目后不得再读回原动作结果。
    if !visible(t, getMe()) { return false }
    if STATE.project != t.project { return false }
    if params != nil {
        let _fp = fingerprint(cmd, t, params)
        let _it = _action_intent_find(t.id, cmd, _fp)
        if _it == nil { return false }
        let _pr = findReceiptByKey(_it.key, t.id, cmd)
        if _pr == nil { return false }
        if _pr.status != "final" {
            if _pr.status != "final_recovered" { return false }
        }
        if _pr.fp != _fp { return false }
        return _m2_emit_replay(_pr)
    }
    if !allow_latest { return false }
    let _latest = nil
    let i = 0
    while i < RECEIPTS.len() {
        let r = RECEIPTS[i]
        if r.actor == sessionActor() {
            if r.command == cmd {
                if r.task_id == t.id {
                    if r.status == "final" { _latest = r }
                    if r.status == "final_recovered" { _latest = r }
                }
            }
        }
        i = i + 1
    }
    if _latest == nil { return false }
    return _m2_emit_replay(_latest)
}


// ─── 命令 ───────────────────────────────────────────────
// D-M3-02：原 M2 createDraft 硬编码内容已删除；面板入口（1790）= openDraftPanel，
// 用户在面板填字段 + （可选）请求 AI 建议 + confirmDraftModelBound 走 createDraftFromPanel。
// 重复的 createDraft 会让 ＋ 新建报修草稿 按钮在解析时不可预测；这里只留一处定义。

fn runCommand(cmd, t, params, result){
    if !authorizeCommand(cmd,t,params) { fail("身份或项目角色无效"); return false }
    let u = getMe()
    if !visible(t, u) { fail("任务不在当前主体可见范围内"); return false }
    if !sourceOk(cmd, t) { fail("命令 " + cmd + " 不允许从 " + t.status + " 执行"); return false }
    if LAST_KEY == "" { fail("缺少幂等键"); return false }
    let fp = fingerprint(cmd, t, params)
    let found = receiptFor(LAST_KEY, fp)
    if found.kind == "hit" {
        // D-M2-02/D-M2-04 (r6)：幂等命中必须把完整原结果暴露给 caller/UI，
        // 不只一句状态文本；不重做 commit/event/version++。
        STATE.last_idem_hit = {action_id: found.receipt.action_id,
                               status: found.receipt.status,
                               result: found.receipt.result,
                               at: nowMs()}
        STATE.status = "原动作已完成（action_id=" + found.receipt.action_id + "）；返回原结果，不重复执行；当前任务状态请另读"
        saveState()
        return false
    }
    if found.kind == "unknown" {
        // D-M2-04 (r6)：原动作结果未知（pending/needs_verify/superseded）——
        // 明确出口：查询原动作对账，绝不重复业务写。
        STATE.status = "待核验：存在未完成原动作（action_id=" + found.receipt.action_id + "，status=" + found.receipt.status + "）；请查询原动作对账，本次不重复写入"
        saveState()
        return false
    }
    if found.kind == "conflict" {
        fail("同 key 不同 payload 冲突：原命令已记录（" + cmd + "）")
        return false
    }
    let _expected_version = latestTaskVersion(t.id)
    // D-M2-03 (r9)：pending 落盘是进入业务写的前提；失败即中止，不做部分提交。
    let _rr_ok = recordReceipt(LAST_KEY, cmd, t, fp, result, _expected_version)
    if !_rr_ok { return false }
    return true
}

// D-M3-05 (r7)：正常 / 创建重放 / 确认重放 三路径共用的权威对账器。
// 成功只来自磁盘三重证据：任务读回 OPEN + actions.jsonl 中该任务的
// confirmDraft final/final_recovered 回执 + events.jsonl 中关联同一
// action_id 的 confirm_draft 事件。内存 EVENT_LOG / RECEIPTS 不作证据
// （saveEvents/saveReceipts 拒写时内存仍可能有记录）。
// 返回 {open, final_action_id, reason}；final_action_id 是磁盘 final
// 回执的 action_id（精确 confirm 动作），绝不回填 createDraft 的动作 ID。
fn _authorityCheckConfirmedOpen(task_id){
    let _out = {open: false, final_action_id: "", reason: ""}
    if task_id == "" || task_id == nil { _out.reason = "无 task_id"; return _out }
    let _disk = readTaskByIdFromDisk(task_id)
    if _disk == nil { _out.reason = "磁盘读回无任务"; return _out }
    if _disk.status != S_OPEN { _out.reason = "磁盘任务非 OPEN（" + _disk.status + "）"; return _out }
    let _rc = nil
    if fs.exists("actions.jsonl") {
        let _arr = loadJsonlLines("actions.jsonl")
        if _arr != nil {
            let _i = 0
            while _i < _arr.len() {
                let _r = _arr[_i]
                if _r.command == "confirmDraft" && _r.task_id == task_id {
                    if _r.status == "final" || _r.status == "final_recovered" { _rc = _r }
                }
                _i = _i + 1
            }
        }
    }
    if _rc == nil { _out.reason = "磁盘无 confirmDraft final 回执"; return _out }
    let _ev_ok = false
    if fs.exists("events.jsonl") {
        let _ea = loadJsonlLines("events.jsonl")
        if _ea != nil {
            let _j = 0
            while _j < _ea.len() {
                let _e = _ea[_j]
                if _e.kind == "confirm_draft" && _e.task_id == task_id {
                    if _e.action_id != nil && _e.action_id == _rc.action_id { _ev_ok = true }
                }
                _j = _j + 1
            }
        }
    }
    if !_ev_ok { _out.reason = "磁盘缺关联 confirm_draft 事件（action_id=" + _rc.action_id + "）"; return _out }
    _out.open = true
    _out.final_action_id = _rc.action_id
    return _out
}

// D-M2-02 (r9 修复轮)：历史原动作核验 —— 只要求磁盘 confirmDraft final /
// final_recovered 回执 + 关联同一 action_id 的 confirm_draft 事件；不要求
// 任务当前仍是 OPEN。原动作的成功事实与当前任务状态分离（当前状态另读），
// 合法推进到 ACCEPTED/v9 不把原 final 重放误判为 unknown。
// D-M3-01 (r8)：返回字段 `ok` 被本宿主解析器当作语法操作（冷开 4 条 parser
// 诊断来源）；改名为普通字段 `confirmed`。当前无消费点（历史核验路径经
// _authorityCheckConfirmedOpen），保留供后续精确版本核验使用。
fn _authorityHistoricalConfirm(task_id, key, fp){
    let _out = {confirmed: false, action_id: "", original_result: nil, reason: ""}
    if task_id == "" || task_id == nil { _out.reason = "无 task_id"; return _out }
    // D-M2-02 (r12，对 r16 Review)：空绑定回退废除 —— key/fp 不可重建时绝不
    // 退成「同 task 同 actor 最后一条 final」冒充原意图确认（较新状态下会把
    // 别的确认动作结果当原操作结果返回）。权威未知就不确认，由调用方保持
    // unknown / 对账出口。
    if key == "" || fp == "" { _out.reason = "原确认意图 key/fp 不可重建；拒用任务级最后确认替代精确绑定"; return _out }
    let _rc = nil
    if fs.exists("actions.jsonl") {
        let _arr = loadJsonlLines("actions.jsonl")
        if _arr != nil {
            let _i = 0
            while _i < _arr.len() {
                let _r = _arr[_i]
                if _r.command == "confirmDraft" && _r.task_id == task_id {
                    if _r.status == "final" || _r.status == "final_recovered" {
                        // D-M2-02 (r11，对 r15 Review)：按原 actor/key/fp 精确绑定
                        // 选择回执 —— 同 task 的任何一条 final 不足以证明是该原
                        // 意图的确认动作。
                        let _rb = true
                        if _r.actor != sessionActor() { _rb = false }
                        if _r.key != key { _rb = false }
                        if _r.fp != fp { _rb = false }
                        if _rb { _rc = _r }
                    }
                }
                _i = _i + 1
            }
        }
    }
    if _rc == nil { _out.reason = "磁盘无精确绑定的 confirmDraft final 回执"; return _out }
    let _ev_ok = false
    if fs.exists("events.jsonl") {
        let _ea = loadJsonlLines("events.jsonl")
        if _ea != nil {
            let _j = 0
            while _j < _ea.len() {
                let _e = _ea[_j]
                if _e.kind == "confirm_draft" && _e.task_id == task_id {
                    if _e.action_id != nil && _e.action_id == _rc.action_id { _ev_ok = true }
                }
                _j = _j + 1
            }
        }
    }
    if !_ev_ok { _out.reason = "磁盘缺关联 confirm_draft 事件（action_id=" + _rc.action_id + "）"; return _out }
    _out.confirmed = true
    _out.action_id = _rc.action_id
    // D-M2-02 (r11)：返回完整原结果（final 回执 result 原文），不只 action_id。
    let _rs = nil
    try { _rs = _rc.result } catch { _rs = nil }
    _out.original_result = _rs
    return _out
}

fn confirmDraft(){
    let t = currentTask()
    // D-M3-05 (r6)：本函数返回结构化最终结果 {result, task_id, action_id,
    // status, reason}；调用方（createDraftFromPanel）只凭 result=="final" +
    // 磁盘读回 + final 回执 + 关联事件才认成功，内存 OPEN 不是证明。
    if t == nil { fail("无选中任务"); return {result: "rejected", task_id: "", action_id: "", status: "", reason: "无选中任务"} }
    // D-M2-02 (r6)：授权后先查原动作；重试返回完整原结果，新 payload 走新意图
    if m2ReplayAtTop("confirmDraft", t, {task_id: t.id}, false) {
        // D-M2-02/D-M2-04 (r10)：历史重放不要求任务当前仍 OPEN —— 磁盘
        // confirmDraft final/final_recovered 回执 + 关联同一 action_id 的
        // confirm_draft 事件即原动作完成证明（_authorityHistoricalConfirm，
        // 实际消费点）；当前任务状态从权威盘独立另读，合法后续状态
        // （ACCEPTED/v9）不把原 final 误判为 unknown。
        // D-M2-02 (r11)：消费统一 outcome —— 按原 actor/key/fp 精确绑定原
        // 动作（hf_query_original_action），返回完整 original_result；最新
        // 任务状态独立另读，不与原动作成功事实混同。
        let _fp2 = fingerprint("confirmDraft", t, {task_id: t.id})
        let _key2 = ""
        let _it2 = _action_intent_find(t.id, "confirmDraft", _fp2)
        if _it2 != nil { _key2 = _it2.key }
        let _rh = _authorityHistoricalConfirm(t.id, _key2, _fp2)
        if !_rh.confirmed {
            return {result: "unknown", task_id: t.id, action_id: "", status: t.status, reason: "重放后历史对账未过：" + _rh.reason, replayed: true}
        }
        let _cur_st = t.status
        let _rd = nil
        try { _rd = readTaskByIdFromDisk(t.id) } catch { _rd = nil }
        if _rd != nil { _cur_st = _rd.status }
        let _qo = hf_query_original_action(_key2, "confirmDraft", t.id, _fp2)
        // D-M2-02 (r12，对 r16 Review)：非成功 query 不得仍构 historical
        // outcome —— conflict（同键异参）是明确矛盾，直接按未知出口；
        // miss/unknown 时以盘面精确绑定（_rh）为准但不覆盖 original_result。
        if _qo.kind == "conflict" {
            return {result: "unknown", task_id: t.id, action_id: _qo.action_id, status: _cur_st,
                    reason: "重放原动作查询冲突（同键异参）；保持未知，不返回成功", replayed: true}
        }
        let _oc = hf_action_outcome("historical", _rh.action_id, _rh.original_result, t.id, _cur_st, "replay", _key2)
        if _qo.kind == "historical" { _oc.original_result = _qo.original_result }
        STATE.last_idem_hit = {action_id: _rh.action_id, status: "final",
                               result: _oc.original_result, at: nowMs(), outcome: _oc}
        saveState()
        return {result: "final", task_id: t.id, action_id: _rh.action_id, status: _cur_st,
                reason: "replay", replayed: true, historical: true,
                original_result: _oc.original_result, outcome: _oc}
    }
    let u = getMe()
    if !isReporter(t, u) { fail("只有原报修人能提交草稿"); return {result: "rejected", task_id: t.id, action_id: "", status: t.status, reason: "只有原报修人能提交草稿"} }
    if t.space == "" { fail("提交前必须确认服务空间（草稿已保留）"); return {result: "rejected", task_id: t.id, action_id: "", status: t.status, reason: "缺空间"} }
    if t.contact == "" { fail("提交前必须填写报修联系人（草稿已保留）"); return {result: "rejected", task_id: t.id, action_id: "", status: t.status, reason: "缺联系人"} }
    let _ev = t.version
    LAST_KEY = generateStableKey("confirmDraft", t, {task_id: t.id}, _ev)
    if !runCommandBound("confirmDraft", t, {task_id: t.id}, _ev) {
        // 命令边界拒绝（含幂等命中/冲突/版本/并发）；回执里找精确状态
        let _rc = findReceiptByKey(LAST_KEY, t.id, "confirmDraft")
        let _rc_status = "rejected"
        let _rc_aid = ""
        if _rc != nil { _rc_status = _rc.status; _rc_aid = _rc.action_id }
        return {result: "rejected", task_id: t.id, action_id: _rc_aid, status: t.status, reason: "runCommandBound 拒绝（receipt=" + _rc_status + "）"}
    }
    t.status = S_OPEN
    commit(t)
    if !commitSucceeded() {
        refreshLabels(t)
        return {result: "unknown", task_id: t.id, action_id: "", status: t.status, reason: "commit 未确认成功；待核验"}
    }
    let _confirm_action_id = _LAST_ACTION_ID
    logEvent("confirm_draft", t, {status: S_OPEN, task_id: t.id})
    // D-M3-05 (r7)：正常路径与重放共用权威对账器 —— 磁盘任务 OPEN +
    // 磁盘 final 回执 + 磁盘关联事件（action_id 精确匹配）；saveEvents
    // 拒写 / 内存有事件但磁盘缺失时一律 unknown，不凭内存 EVENT_LOG 放行。
    let _na = _authorityCheckConfirmedOpen(t.id)
    if !_na.open {
        return {result: "unknown", task_id: t.id, action_id: _confirm_action_id, status: t.status, reason: "权威对账未过：" + _na.reason}
    }
    STATE.status = "已提交报修 → OPEN"
    saveState()
    refreshLabels(t)
    return {result: "final", task_id: t.id, action_id: _na.final_action_id, status: S_OPEN, reason: ""}
}

fn acceptTask(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if m2ReplayAtTop("acceptTask", t, {task_id: t.id}, false) { return }
    let u = getMe()
    if !hasRole(u, t.project, "TECHNICIAN") { fail("经理没有技工角色不得自主接单"); return }
    if !skillOk(u, t.category) { fail("技能与任务类别不匹配：" + t.category); return }
    if isTerminal(t) { fail("任务终态只读；不可接单"); return }
    let _ev = t.version
    LAST_KEY = generateStableKey("acceptTask", t, {task_id: t.id}, _ev)
    if !runCommandBound("acceptTask", t, {task_id: t.id}, _ev) { return }
    t.assignee = sessionActor()
    t.status = S_ACCEPTED
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("accept_task", t, {status: S_ACCEPTED, assignee: t.assignee, task_id: t.id})
    // D-M2-03 (r8)：事件未落盘时 logEvent 已置待核验；不得再写成功状态。
    if _m2_evok { STATE.status = "已接单 → ACCEPTED（" + sessionActor() + "）" }
    STATE.m4_invalidations.last_accept = nowMs()
    m4_invalidateConfirmation("acceptTask")
    saveState()
    refreshLabels(t)
}

fn assignTask(techId){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——按当前表单尽力重建 payload 查意图
    m4_init_forms()
    let _rp_picked = techId
    if _rp_picked == "" || _rp_picked == "u-tech-1" { _rp_picked = STATE.draft_assign.tech_id }
    let _rp_params = nil
    if _rp_picked != "" { _rp_params = {task_id: t.id, assignee: _rp_picked, reason: STATE.draft_assign.reason} }
    if m2ReplayAtTop("assignTask", t, _rp_params, false) { return }
    if !isManager(t, getMe()) { fail("只有项目经理能分配"); return }
    // M4：分配对象 + 理由从表单输入（STATE.draft_assign.tech_id +
    // .reason）。若调用方显式传 techId 仍允许（兼容由 runAction("assignTask")
    // 旧路由传入），但改为只能通过 STATE 选定的人才能提交。
    m4_init_forms()
    let picked = techId
    if picked == "" || picked == "u-tech-1" { picked = STATE.draft_assign.tech_id }
    if picked == "" { fail("请在『分配对象』面板选人；移除快捷写死参数"); return }
    if picked == "u-tech-1" {
        // 兼容 r3 旧按钮：若旧写法被旧回执命中，仍读取 state.draft_assign.tech_id
        picked = STATE.draft_assign.tech_id
        if picked == "" { fail("请在『分配对象』面板选人；移除快捷写死参数"); return }
    }
    let reason = STATE.draft_assign.reason
    if reason == "" { fail("请在『分配理由』框输入理由；不再使用默认『经理分配』"); return }
    if reason == "经理分配" { fail("分配理由不能为默认文案；请写明"); return }
    let target = activeAccount(picked)
    if target == nil { fail("分配对象不存在"); return }
    if !hasRole(target, t.project, "TECHNICIAN") { fail("分配对象不是本项目有效技工"); return }
    if !skillOk(target, t.category) { fail("分配对象技能不匹配：" + t.category); return }
    let _ev = t.version
    let _params = {task_id: t.id, assignee: target.id, reason: reason}
    LAST_KEY = generateStableKey("assignTask", t, _params, _ev)
    if !runCommandBound("assignTask", t, _params, _ev) { return }
    t.assignee = target.id
    t.status = S_ACCEPTED
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("assign_task", t, {status: S_ACCEPTED, assignee: target.id, reason: reason,
                                operator: sessionActor(), task_id: t.id})
    if _m2_evok { STATE.status = "已分配给 " + target.id + "（经理：" + reason + "）" }
    STATE.m4_invalidations.last_reassign = nowMs()
    m4_invalidateConfirmation("assignTask")
    saveState()
    refreshLabels(t)
}

fn bindAsset(assetId){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——按当前表单尽力重建 payload 查意图
    m4_init_forms()
    let _rp_picked = assetId
    if _rp_picked == "" || _rp_picked == "as-a-1" { _rp_picked = STATE.draft_bind_asset.asset_id }
    let _rp_params = nil
    if _rp_picked != "" {
        let _rp_a = pickUser(ASSETS, _rp_picked)
        if _rp_a != nil {
            _rp_params = {task_id: t.id, asset_id: _rp_a.id, reason: "",
                          services_contains_space: services(_rp_a.id, t.space),
                          asset_project: _rp_a.project, asset_active: _rp_a.active}
        }
    }
    if m2ReplayAtTop("bindAsset", t, _rp_params, false) { return }
    // M4：设备绑定走表单输入 STATE.draft_bind_asset.asset_id。兼容旧 runAction
    // 路由（依然接受硬编码参数，但若 assetId 明显是默认示例且 STATE 已选其它，
    // 优先用 STATE；不允许『安装位置相同即视为可绑定』）。
    m4_init_forms()
    let picked = assetId
    if picked == "" || picked == "as-a-1" {
        picked = STATE.draft_bind_asset.asset_id
    }
    if picked == "" { fail("请在『设备』面板选设备；移除快捷写死参数 as-a-1"); return }
    // M4 拒绝伪造设备：ID 必须在 ASSETS 注册表内；空串或未注册直接拒绝。
    let a = pickUser(ASSETS, picked)
    if a == nil { fail("设备不存在（" + picked + "）"); return }
    if !a.active { fail("设备已归档，不能新绑定"); return }
    if a.project != t.project { fail("设备不属于本项目"); return }
    if t.space == "" { fail("绑定前必须已确认服务空间"); return }
    // M4 硬验收：合法服务关系可绑定；安装位置相同 ≠ 服务关系。
    let services_match = services(a.id, t.space)
    if !services_match { fail("设备不服务该空间（" + _strJoin(a.services, ",") + " vs 任务 space=" + t.space + "）；安装位置相同不算服务关系"); return }
    let u = getMe()
    let reason = ""
    if t.status == S_DRAFT {
        if !isReporter(t, u) { fail("草稿阶段只能原报修人选择设备"); return }
    }
    if t.status == S_IN_PROGRESS {
        if !isManager(t, u) { fail("维修中换设备只能同项目经理执行"); return }
        reason = "经理更正设备（" + t.asset + " → " + a.id + "）"
    }
    if t.status == S_OPEN || t.status == S_ACCEPTED || t.status == S_SCHEDULED {
        if !isReporter(t, u) {
            if !isAssignee(t, u) {
                if !isManager(t, u) { fail("只有报修人、当前承接者或经理能绑定设备"); return }
            }
        }
    }
    let old = t.asset
    let _ev = t.version
    let _params = {task_id: t.id, asset_id: a.id, reason: reason,
                   services_contains_space: services_match,
                   asset_project: a.project, asset_active: a.active}
    LAST_KEY = generateStableKey("bindAsset", t, _params, _ev)
    if !runCommandBound("bindAsset", t, _params, _ev) { return }
    t.asset = a.id
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("bind_asset", t, {asset_id: a.id, previous_asset_id: old, reason: reason,
                               operator: sessionActor(), task_id: t.id,
                               services_match: services_match})
    if _m2_evok { STATE.status = "已绑定 " + a.code + "（设备归属 " + a.project + "；服务空间 " + t.space + "）" }
    STATE.m4_invalidations.last_bind = nowMs()
    m4_invalidateConfirmation("bindAsset")
    saveState()
    refreshLabels(t)
}

fn unbindAsset(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if m2ReplayAtTop("unbindAsset", t, {task_id: t.id, reason: "解除绑定"}, false) { return }
    let u = getMe()
    if t.status == S_IN_PROGRESS {
        if !isManager(t, u) { fail("维修中只能经理解绑"); return }
    }
    if !isReporter(t, u) {
        if !isAssignee(t, u) {
            if !isManager(t, u) { fail("只有报修人、当前承接者或经理能解绑"); return }
        }
    }
    let old = t.asset
    let _ev = t.version
    LAST_KEY = generateStableKey("unbindAsset", t, {task_id: t.id, reason: "解除绑定"}, _ev)
    if !runCommandBound("unbindAsset", t, {task_id: t.id, reason: "解除绑定"}, _ev) { return }
    t.asset = ""
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("unbind_asset", t, {previous_asset_id: old, reason: "解除绑定",
                                 operator: sessionActor(), task_id: t.id})
    if _m2_evok { STATE.status = "已解绑设备" }
    // D-M4-04：解绑也是事实变化；旧 AI 建议 / 确认应失效。
    STATE.m4_invalidations.last_bind = nowMs()
    m4_invalidateConfirmation("unbindAsset")
    saveState()
    refreshLabels(t)
}

fn proposeAppointment(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——表单可解析时按 fp 查意图；可重复命令不允许
    // "最近 final" 兜底，避免挡住合法的新提议。
    m4_init_forms()
    let _rp_params = nil
    if validateApptForm(STATE.draft_appt) == "" {
        let _rp_parsed = parseApptFormToMs(STATE.draft_appt.date_y, STATE.draft_appt.date_m,
                                           STATE.draft_appt.date_d, STATE.draft_appt.h_start,
                                           STATE.draft_appt.min_start, STATE.draft_appt.h_end,
                                           STATE.draft_appt.min_end)
        _rp_params = {task_id: t.id, start_at_ms: _rp_parsed.start, end_at_ms: _rp_parsed.end,
                      reason_text: STATE.draft_appt.reason,
                      start_display: STATE.draft_appt.date_y.to_string() + "-" + pad2(STATE.draft_appt.date_m) + "-" + pad2(STATE.draft_appt.date_d) + " " + dayOfWeekNameShanghai(STATE.draft_appt.date_y, STATE.draft_appt.date_m, STATE.draft_appt.date_d) + " " + pad2(STATE.draft_appt.h_start) + ":" + pad2(STATE.draft_appt.min_start) + "-" + pad2(STATE.draft_appt.h_end) + ":" + pad2(STATE.draft_appt.min_end) + " Asia/Shanghai"}
    }
    if m2ReplayAtTop("proposeAppointment", t, _rp_params, false) { return }
    let u = getMe()
    if !hasRole(u, t.project, "TECHNICIAN") { fail("没有技工角色不能提议预约"); return }
    if t.assignee == nil { fail("任务尚未承接"); return }
    if t.assignee != u.id {
        if !isManager(t, u) { fail("只有当前承接者（或代行的经理）能提议"); return }
    }
    // M4：用户实际输入替代默认示例参数。STATE.draft_appt 提供年/月/日 + 时/分。
    m4_init_forms()
    let form_err = validateApptForm(STATE.draft_appt)
    if form_err != "" { fail(form_err); return }
    let parsed = parseApptFormToMs(STATE.draft_appt.date_y, STATE.draft_appt.date_m,
                                    STATE.draft_appt.date_d, STATE.draft_appt.h_start,
                                    STATE.draft_appt.min_start, STATE.draft_appt.h_end,
                                    STATE.draft_appt.min_end)
    let start = parsed.start
    let end = parsed.end
    if end <= start { fail("结束必须晚于开始时间"); return }
    if end - start < MIN_MS { fail("预约时长不得短于 15 分钟"); return }
    if end - start > MAX_MS { fail("预约时长不得超过 240 分钟"); return }
    if start > nowMs() + LEAD_MS { fail("预约开始不得晚于 30 天后"); return }
    if start < nowMs() { fail("预约开始不得早于当前时刻"); return }
    let tech = t.assignee
    // D-M4-02 (r3 修复轮)：传当前 PROPOSED id 作为排除项之一；hasTechConflict
    // 按数组精确排除同任务内即将被替换的旧预约 ID。其它任务/项目冲突仍生效。
    let existing_proposed = apptOf(t, A_PROPOSED)
    let exclude_ids = []
    if existing_proposed != nil { exclude_ids.push(existing_proposed.id) }
    if hasTechConflict(t, tech, start, end, exclude_ids) {
        fail("该技工在其它任务上已有重叠的预约（含跨项目）")
        return
    }
    // D-M4-03 (r4 修复轮)：置跨任务冲突复查上下文；runCommandBound 锁内权威重读
    STATE.m4_cross_check = {tech: tech, startMs: start, endMs: end,
                            exclude_ids: exclude_ids}
    let _ev = t.version
    let _params = {task_id: t.id, start_at_ms: start, end_at_ms: end,
                   reason_text: STATE.draft_appt.reason,
                   start_display: STATE.draft_appt.date_y.to_string() + "-" + pad2(STATE.draft_appt.date_m) + "-" + pad2(STATE.draft_appt.date_d) + " " + dayOfWeekNameShanghai(STATE.draft_appt.date_y, STATE.draft_appt.date_m, STATE.draft_appt.date_d) + " " + pad2(STATE.draft_appt.h_start) + ":" + pad2(STATE.draft_appt.min_start) + "-" + pad2(STATE.draft_appt.h_end) + ":" + pad2(STATE.draft_appt.min_end) + " Asia/Shanghai"}
    LAST_KEY = generateStableKey("proposeAppointment", t, _params, _ev)
    if !runCommandBound("proposeAppointment", t, _params, _ev) { return }
    // D-M4-02 (r3 修复轮)：SUPERSEDED 旧 PROPOSED 必须在 runCommandBound 通过
    // 之后才执行；准入失败时旧预约状态保持 PROPOSED，任务/预约/历史不变。
    let _sup_count = 0
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED; _sup_count = _sup_count + 1 }
    }
    t.appointments.push({id: newId(), tech: tech, startMs: start, endMs: end,
                         status: A_PROPOSED, proposedBy: u.id, confirmedBy: "",
                         reason: STATE.draft_appt.reason, createdMs: nowMs()})
    STATE.m4_invalidations.pending_proposal_id = t.appointments[t.appointments.len() - 1].id
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("propose_appointment", t, {task_status: t.status, appt_status: A_PROPOSED,
                                        proposed_by: u.id, task_id: t.id,
                                        start_display: _params.start_display})
    if _m2_evok { STATE.status = "已提议预约（" + _params.start_display + "）；仍为 " + t.status + "，等报修人确认" }
    // D-M4-04：提议也是事实变化；让旧 AI 建议与确认失效。
    m4_invalidateConfirmation("proposeAppointment")
    saveState()
    refreshLabels(t)
}

fn confirmAppointment(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——PROPOSED 已不存在（跨状态重试）时前置校验
    // 必拒，回退到最近 final 的原结果（current v5 查原 action v1 出口）。
    let _rp_appt = apptOf(t, A_PROPOSED)
    let _rp_params = nil
    if _rp_appt != nil { _rp_params = {task_id: t.id, appointment_id: _rp_appt.id} }
    if m2ReplayAtTop("confirmAppointment", t, _rp_params, true) { return }
    if !isReporter(t, getMe()) { fail("只有原报修人能确认预约（P0 经理不代确认）"); return }
    let appt = apptOf(t, A_PROPOSED)
    if appt == nil { fail("没有待确认的提议"); return }
    let now = nowMs()
    let valid = PROPOSAL_MS
    if appt.startMs - appt.createdMs < valid { valid = appt.startMs - appt.createdMs }
    if now > appt.createdMs + valid { fail("提议已过期，请让技工重新提议"); return }
    if now >= appt.endMs { fail("提议时段已结束"); return }
    let tech = appt.tech
    // D-M4-03 (r4 修复轮)：把跨任务跨项目冲突上下文写入 STATE.m4_cross_check，
    // 让 runCommandBound 在锁内权威重读 tasks.json 后再判定。memory 内 for
    // 循环保留作为快速预检，避免无谓地进入边界后才拒；真权威判定搬到锁内。
    let _mem_conflict = false
    for other in TASKS {
        if other.id == t.id { continue }
        let c = apptOf(other, A_CONFIRMED)
        if c == nil { continue }
        if c.tech == tech {
            if c.startMs < appt.endMs {
                if c.endMs > appt.startMs { _mem_conflict = true }
            }
        }
    }
    if _mem_conflict { fail("该技工在其它任务上时间冲突"); return }
    // 设置跨任务冲突复查上下文，供 runCommandBound 锁内重读
    STATE.m4_cross_check = {tech: tech, startMs: appt.startMs, endMs: appt.endMs,
                            exclude_ids: [appt.id]}
    let _ev = t.version
    let _params = {task_id: t.id, appointment_id: appt.id}
    LAST_KEY = generateStableKey("confirmAppointment", t, _params, _ev)
    if !runCommandBound("confirmAppointment", t, _params, _ev) { return }
    for a in t.appointments {
        if a.status == A_CONFIRMED { a.status = A_SUPERSEDED }
    }
    appt.status = A_CONFIRMED
    appt.confirmedBy = sessionActor()
    t.status = S_SCHEDULED
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("confirm_appointment", t, {appointment_status: A_CONFIRMED, task_status: S_SCHEDULED,
                                        confirmed_by: sessionActor(), appointment_id: appt.id,
                                        task_id: t.id})
    if _m2_evok { STATE.status = "预约已确认 → SCHEDULED" }
    // D-M4-04：确认也是事实变化；让旧 AI 建议与确认失效。
    m4_invalidateConfirmation("confirmAppointment")
    // M6：登记得改-未改/接力到场的提醒（同 task_id 已存在的 ACTIVE kickoff_checkin 自动 dedupe）；
    // D-M6-02 (r3)：登记时挂上 appointment_id，方便改约/取消预约后让旧提醒自动失效。
    if appt != nil {
        let kickoff_at = appt.startMs - 30 * 60000
        if kickoff_at < nowMs() { kickoff_at = nowMs() + 5 * 60000 }
        m6_register_follow_up_ex(t.id, "kickoff_checkin", kickoff_at,
                                 "已确认 " + formatApptLine(appt), appt.id)
    }
    saveState()
    refreshLabels(t)
}

fn rejectAppointment(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    m4_init_forms()
    let _rp_appt = apptOf(t, A_PROPOSED)
    let _rp_params = nil
    if _rp_appt != nil { _rp_params = {task_id: t.id, appointment_id: _rp_appt.id, reason: STATE.draft_reject.reason} }
    if m2ReplayAtTop("rejectAppointment", t, _rp_params, true) { return }
    if !isReporter(t, getMe()) { fail("只有原报修人能拒绝预约"); return }
    let appt = apptOf(t, A_PROPOSED)
    if appt == nil { fail("没有可拒绝的提议"); return }
    // M4：拒绝原因由表单输入（STATE.draft_reject.reason）。保留兼容旧测试：
    // 若旧回执仍带 "时间不合适" 字面量则沿用，但本轮以后必须由用户填写。
    m4_init_forms()
    let reason = STATE.draft_reject.reason
    if reason == "" { fail("请在『拒绝原因』框输入原因；不再使用默认文案"); return }
    if reason == "时间不合适" { fail("拒绝原因不能为默认文案『时间不合适』；请写明原因"); return }
    let _ev = t.version
    let _params = {task_id: t.id, appointment_id: appt.id, reason: reason}
    LAST_KEY = generateStableKey("rejectAppointment", t, _params, _ev)
    if !runCommandBound("rejectAppointment", t, _params, _ev) { return }
    appt.status = A_SUPERSEDED
    appt.reason = reason
    let kept = apptOf(t, A_CONFIRMED)
    if kept != nil { t.status = S_SCHEDULED } else { t.status = S_ACCEPTED }
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("reject_appointment", t, {status: t.status, reason: reason,
                                       kept_confirmed: kept != nil, task_id: t.id})
    if _m2_evok {
        if kept == nil {
            STATE.status = "已拒绝提议；无已确认预约，回到 ACCEPTED"
        } else {
            STATE.status = "已拒绝提议；旧确认仍有效，保持 SCHEDULED"
        }
    }
    STATE.m4_invalidations.last_reject = nowMs()
    // D-M4-04：拒绝提议也是事实变化；让旧 AI 建议与确认失效。
    m4_invalidateConfirmation("rejectAppointment")
    saveState()
    refreshLabels(t)
}
// M4：取消当前活跃预约（PROPOSED 或 CONFIRMED）必须由用户输入原因；不动其它任
// 务的预约；保留 SUPERSEDED 历史。
fn cancelAppointment(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    m4_init_forms()
    let _rp_active = apptOf(t, A_PROPOSED)
    if _rp_active == nil { _rp_active = apptOf(t, A_CONFIRMED) }
    let _rp_params = nil
    if _rp_active != nil { _rp_params = {task_id: t.id, appointment_id: _rp_active.id, reason: STATE.draft_reject.reason} }
    if m2ReplayAtTop("cancelAppointment", t, _rp_params, true) { return }
    let u = getMe()
    // 操作权限定：报修人 / 当前承接者 / 经理。
    let permitted = isReporter(t, u) || isAssignee(t, u) || isManager(t, u)
    if !permitted { fail("只有报修人、当前承接者或经理能取消预约"); return }
    if isTerminal(t) { fail("任务终态只读；不可取消预约"); return }
    let active = apptOf(t, A_PROPOSED)
    if active == nil { active = apptOf(t, A_CONFIRMED) }
    if active == nil { fail("当前无可取消的活跃预约（PROPOSED/CONFIRMED）"); return }
    m4_init_forms()
    let reason = STATE.draft_reject.reason
    if reason == "" { fail("取消预约必须输入原因；不再使用默认示例"); return }
    let _ev = t.version
    let _params = {task_id: t.id, appointment_id: active.id, reason: reason}
    LAST_KEY = generateStableKey("cancelAppointment", t, _params, _ev)
    if !runCommandBound("cancelAppointment", t, _params, _ev) { return }
    let target_status = active.status
    active.status = A_SUPERSEDED
    active.reason = "CANCELED_BY_USER: " + reason
    if target_status == A_CONFIRMED {
        // 取消 CONFIRMED 后，退到 ACCEPTED；其它任务 CONFIRMED 不受影响
        if apptOf(t, A_CONFIRMED) == nil { t.status = S_ACCEPTED }
    }
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("cancel_appointment", t, {appointment_id: active.id,
                                       previous_status: target_status,
                                       reason: reason,
                                       task_status: t.status,
                                       operator: sessionActor(),
                                       task_id: t.id})
    if _m2_evok { STATE.status = "已取消预约（" + active.reason + "）" }
    STATE.m4_invalidations.last_cancel = nowMs()
    m4_invalidateConfirmation("cancelAppointment")
    // M6：取消预约 → 挂在本 appointment_id 上的旧 ACTIVE 提醒全部失效；
    // D-M6-02 (r3)：精确到 appointment_id，不误伤其它任务的提醒。
    m6_invalidate_for_appointment(t.id, active.id, "cancel_appointment")
    saveState()
    refreshLabels(t)
}
// M4：改约。新提议 SUPERSEDE 旧 PROPOSED，但当前 A_CONFIRMED 不被修改（本任务
// 即将被替换的旧 PROPOSED/CONFIRMED 邀请不进入跨任务冲突检查）。其它任务预约
// 完全不动；允许 CONFIRMED 与新 PROPOSED 共存（旧预约保留至报修人决定去留）。
fn rescheduleAppointmentFromForm(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——表单可解析时按 fp 查意图；可重复命令不兜底
    m4_init_forms()
    let _rp_params = nil
    if validateApptForm(STATE.draft_reschedule) == "" {
        let _rp_prev = ""
        let _rp_prop = apptOf(t, A_PROPOSED)
        if _rp_prop != nil { _rp_prev = _rp_prop.id }
        let _rp_parsed = parseApptFormToMs(STATE.draft_reschedule.date_y,
                                           STATE.draft_reschedule.date_m,
                                           STATE.draft_reschedule.date_d,
                                           STATE.draft_reschedule.h_start,
                                           STATE.draft_reschedule.min_start,
                                           STATE.draft_reschedule.h_end,
                                           STATE.draft_reschedule.min_end)
        _rp_params = {task_id: t.id, previous_proposed_id: _rp_prev,
                      start_at_ms: _rp_parsed.start, end_at_ms: _rp_parsed.end,
                      reason_text: STATE.draft_reschedule.reason}
    }
    if m2ReplayAtTop("rescheduleAppointment", t, _rp_params, false) { return }
    let u = getMe()
    if !hasRole(u, t.project, "TECHNICIAN") { fail("没有技工角色不能改约"); return }
    if t.assignee == nil { fail("任务尚未承接"); return }
    if t.assignee != u.id {
        if !isManager(t, u) { fail("只有当前承接者或经理能改约"); return }
    }
    if isTerminal(t) { fail("任务终态只读；不可改约"); return }
    // D-M4-02 (r3 修复轮)：不再要求 CONFIRMED 时先取消；只取当前 PROPOSED 作为
    // 即将被替换者。若只有 CONFIRMED 而无 PROPOSED，previous_proposed_id 留空，
    // 新提议自然不会自冲突。CONFIRMED 不被本函数触碰。
    let previous_proposed_id = ""
    let proposed = apptOf(t, A_PROPOSED)
    if proposed != nil { previous_proposed_id = proposed.id }
    let confirmed_appt = apptOf(t, A_CONFIRMED)
    let confirmed_appt_id = ""
    if confirmed_appt != nil { confirmed_appt_id = confirmed_appt.id }
    m4_init_forms()
    let form_err = validateApptForm(STATE.draft_reschedule)
    if form_err != "" { fail("改约表单：" + form_err); return }
    let parsed = parseApptFormToMs(STATE.draft_reschedule.date_y,
                                    STATE.draft_reschedule.date_m,
                                    STATE.draft_reschedule.date_d,
                                    STATE.draft_reschedule.h_start,
                                    STATE.draft_reschedule.min_start,
                                    STATE.draft_reschedule.h_end,
                                    STATE.draft_reschedule.min_end)
    let start = parsed.start
    let end = parsed.end
    if end <= start { fail("改约结束必须晚于开始时间"); return }
    if end - start < MIN_MS { fail("改约时长不得短于 15 分钟"); return }
    if end - start > MAX_MS { fail("改约时长不得超过 240 分钟"); return }
    if start > nowMs() + LEAD_MS { fail("改约开始不得晚于 30 天后"); return }
    if start < nowMs() { fail("改约开始不得早于当前时刻"); return }
    let tech = t.assignee
    // D-M4-02 (r3 修复轮)：传当前 PROPOSED + CONFIRMED 两个同任务预约 ID 作为
    // 排除集；改约时这两个旧预约都不应被自冲突，其它任务/项目冲突仍生效。
    let exclude_ids = []
    if previous_proposed_id != "" { exclude_ids.push(previous_proposed_id) }
    if confirmed_appt_id != "" { exclude_ids.push(confirmed_appt_id) }
    if hasTechConflict(t, tech, start, end, exclude_ids) {
        fail("新时段与该技工其它任务（含跨项目）冲突")
        return
    }
    // D-M4-03 (r4 修复轮)：置跨任务冲突复查上下文；runCommandBound 锁内权威重读
    STATE.m4_cross_check = {tech: tech, startMs: start, endMs: end,
                            exclude_ids: exclude_ids}
    let _ev = t.version
    let _params = {task_id: t.id, previous_proposed_id: previous_proposed_id,
                   start_at_ms: start, end_at_ms: end,
                   reason_text: STATE.draft_reschedule.reason}
    LAST_KEY = generateStableKey("rescheduleAppointment", t, _params, _ev)
    if !runCommandBound("rescheduleAppointment", t, _params, _ev) { return }
    // D-M4-02 (r3 修复轮)：SUPERSEDED 旧 PROPOSED 必须在 runCommandBound 通过
    // 之后才执行；准入失败时旧预约状态保持 PROPOSED，任务/预约/历史不变。
    let previous_proposed_id2 = ""
    let i = 0
    while i < t.appointments.len() {
        let a = t.appointments[i]
        if a.status == A_PROPOSED {
            a.status = A_SUPERSEDED
            previous_proposed_id2 = a.id
        }
        i = i + 1
    }
    t.appointments.push({id: newId(), tech: tech, startMs: start, endMs: end,
                         status: A_PROPOSED, proposedBy: u.id, confirmedBy: "",
                         reason: "RESCHEDULE: " + STATE.draft_reschedule.reason,
                         createdMs: nowMs(),
                         replaces: previous_proposed_id2})
    STATE.m4_invalidations.pending_proposal_id = t.appointments[t.appointments.len() - 1].id
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("reschedule_appointment", t, {task_status: t.status, appt_status: A_PROPOSED,
                                            proposed_by: u.id, task_id: t.id,
                                            previous_proposed_id: previous_proposed_id})
    if _m2_evok { STATE.status = "已改约：旧 PROPOSED SUPERSEDED，新 PROPOSED 待报修人确认" }
    m4_invalidateConfirmation("rescheduleAppointment")
    // D-M6-02：改约是提议，旧 CONFIRMED 仍有效；如旧 kickoff_checkin 仍挂旧
    // CONFIRMED，不应被 RESCHEDULE PROPOSE 一并失效；只在 reporter 真正 confirm
    // 新 appt 时（经 confirmAppointment → upsert_dedupe 同 task/kind 自动替换），
    // 旧的 ACTIVE kickoff 会自然被替换为新 appt 的 kickoff_checkin。
    saveState()
    refreshLabels(t)
}

fn startProgress(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if m2ReplayAtTop("startProgress", t, {task_id: t.id}, false) { return }
    if !isAssignee(t, getMe()) { fail("只有当前承接者能开工"); return }
    if t.asset == "" { fail("开工前必须绑定有效设备"); return }
    // D-M4-05：开工时重新核当前有效设备 — 设备仍存在 / active / 归属本项目 /
    // 服务空间仍包含 t.space。绑定后可能设备归档 / 服务关系撤销 / 项目变更；
    // 这些情况下不允许开工并提供重新确认入口。
    let cur_a = pickUser(ASSETS, t.asset)
    if cur_a == nil { fail("开工时设备不存在（已被删除/伪造）"); return }
    if !cur_a.active { fail("开工时设备已归档（active=false）；请重新选择设备"); return }
    if cur_a.project != t.project { fail("开工时设备归属项目已变更（" + cur_a.project + " vs 任务 " + t.project + "）"); return }
    // D-M4-05 (r3 修复轮)：开工时重新核当前承接者的项目角色与技能。
    // 设备检查只覆盖事实层面，承接者资格可能后续被撤（角色撤销 / 技能
    // 撤销 / 身份撤权 / 撤服务关系）；开工必须用实时身份状态而非接单快照。
    let _cur_assignee = nil
    try { _cur_assignee = pickUser(IDENTITIES, t.assignee) } catch _ { _cur_assignee = nil }
    if _cur_assignee == nil { fail("当前承接者账号不存在（已被撤回/伪造）；请重新分派"); return }
    if !identityActive(t.assignee) { fail("当前承接者身份已失效（全局撤权/到期）；请重新分派"); return }
    if !hasRole(_cur_assignee, t.project, "TECHNICIAN") {
        fail("当前承接者已被撤销本项目 TECHNICIAN 角色；请重新分派")
        return
    }
    if !skillOk(_cur_assignee, t.category) {
        fail("当前承接者已不具备所需技能 (" + t.category + ")；请重新分派")
        return
    }
    if !services(t.asset, t.space) {
        fail("开工时设备不再服务当前空间（设备服务空间：" + _strJoin(cur_a.services, ",") + " vs 任务空间：" + t.space + "）；请重新绑定有效设备")
        return
    }
    let appt = apptOf(t, A_CONFIRMED)
    if appt == nil { fail("开工前必须存在已确认预约"); return }
    if appt.tech != sessionActor() { fail("确认预约属于其它技工"); return }
    let now = nowMs()
    if now < appt.startMs { fail("还没到预约开始时间"); return }
    if now >= appt.endMs { fail("预约已超时，需重新预约后才能开工"); return }
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED }
    }
    let _ev = t.version
    LAST_KEY = generateStableKey("startProgress", t, {task_id: t.id}, _ev)
    if !runCommandBound("startProgress", t, {task_id: t.id}, _ev) { return }
    t.status = S_IN_PROGRESS
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("start_progress", t, {status: S_IN_PROGRESS, appointment_id: appt.id,
                                   task_id: t.id})
    if _m2_evok { STATE.status = "已开工 → IN_PROGRESS" }
    saveState()
    refreshLabels(t)
}

fn recordProgress(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    m4_init_forms()
    if m2ReplayAtTop("recordProgress", t, {task_id: t.id, kind: STATE.draft_progress.kind, note: STATE.draft_progress.note}, false) { return }
    if !isAssignee(t, getMe()) { fail("只有当前承接者能记录处置"); return }
    // M4：处置类别与说明由表单输入（STATE.draft_progress）。不再硬编码『到场
    // 检查压缩机与滤网』。
    m4_init_forms()
    let kind = STATE.draft_progress.kind
    let note = STATE.draft_progress.note
    if note == "" { fail("请在『处置说明』框输入内容；不再使用默认示例"); return }
    if note == "到场检查压缩机与滤网" { fail("处置说明不能为默认示例；请写真实处置"); return }
    let _ev = t.version
    let _params = {task_id: t.id, kind: kind, note: note}
    LAST_KEY = generateStableKey("recordProgress", t, _params, _ev)
    if !runCommandBound("recordProgress", t, _params, _ev) { return }
    t.notes.push({kind: kind, note: note, by: sessionActor(), at: nowMs()})
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("record_progress", t, {kind: kind, note: note, operator: sessionActor(), task_id: t.id})
    if _m2_evok { STATE.status = "已记录处置：" + kind }
    saveState()
    refreshLabels(t)
}

// ─── M5 真实附件 · 适配与索引 ─────────────────────────────
//
// 替代 addEvidence / quarantineEvidence 中的 demo 占位。核心约束：
//   1) READY 只能由"读回字节 == 存盘字节"自动触发；不通过元数据赋值。
//   2) 选择 / 保存 / 校验 / READY / 缺失 / 损坏 / 隔离 / 越权 / 过期轮次，状态
//      转移在 _verifyAttachBytes / lifecycleFromVerify 结果驱动。
//   3) 每个 attach_item 都关联 task_id / uploader_id / evidence_round，跨
//      重启通过 STATE.attach_items + evidence_index.json 重新打开。
//   4) submitCompletion 与 acceptCompletion 提交前再次校验，防止"上传时
//      READY、验收前已损坏"。
//
// 本工程不再依赖 demo 占位；任何 bytes==0 / sha=="" 的旧条目由
// m5_drop_legacy_demo_evidence 在 boot 时清退。
fn m5_init_forms(){ if STATE == nil { return } if m4_init_forms == nil { return }
    m4_init_forms()
    if STATE.draft_attach_path == nil { STATE.draft_attach_path = {abs_source: ""} }
    if STATE.draft_acceptance_opinion == nil { STATE.draft_acceptance_opinion = {text: "", manager_proxy_reason: ""} }
    // D-M5-04（r3）：draft_select.reuse_ids = 用户在『补充证据』面板显式勾选的、
    // 之前被 rejectCompletion 退回的证据 id 列表；submitCompletion 收集候选
    // 集合时只把 reuse_set 内的退回证据纳入。
    if STATE.draft_select == nil { STATE.draft_select = {reuse_ids: []} }
    if STATE.attach_proof_pick == nil { STATE.attach_proof_pick = "1" }
    if STATE.attach_items == nil { STATE.attach_items = [] }
    if STATE.attach_sandbox_root == nil || STATE.attach_sandbox_root == "" { STATE.attach_sandbox_root = "m5-test" }
    // D-M5-04（r7）：不再强制注入项目内绝对根（旧 r4 路径在 harness 隔离场下
    // 越界且与本场 app-data 无关）。空字符串 = 走相对根，由宿主 fs 解析进当前
    // 获准 app-data jail；测试 / 配置可显式注入绝对路径。
    if STATE.attach_sandbox_root_abs == nil { STATE.attach_sandbox_root_abs = "" }
    if STATE.m5_last_round == nil { STATE.m5_last_round = {by_task: {}} }
    // D-M5-01（r4）：最近一次 m5_open_attach_bound 的完整结果（含 content / preview）
    // 由 UI refreshDetail 在 attachments tab 渲染。nil = 还没打开过附件。
    if STATE.last_open_attach == nil { STATE.last_open_attach = nil }
    saveState()
}
// M5 用于 UI 标签的 inbox 提示：每次刷新都重算一次，给技工真实路径感。
fn m5_inbox_hint_text(){
    m5_init_forms()
    return "真实附件源请放在 " + m5_inbox_abs() + "/ 子目录下；输入绝对路径；路径不在该目录内会被拒绝。不再使用预置 demo 图。"
}
// B-M4-01 (r7)：路径/长度辅助全部改用宿主已确认原语（to_chars / len / strip_*）。
fn m5_basename(path){
    if path == nil { return "" }
    // D-M5-04（r9 修复轮）：to_chars 元素是 U32 码点（宿主 string.rs 实证），
    // 与字符串 "/" 直接比较恒类型不匹配 → 旧实装永远找不到 "/"，回退链产出
    // 错误路径。改为与 "/".to_chars()[0] 同型比较。
    let _slash_arr = "/".to_chars()
    let _slash = _slash_arr[0]
    let chars = path.to_chars()
    let n = chars.len()
    let i = n - 1
    while i >= 0 {
        if chars[i] == _slash {
            return _strSlice(path, i + 1, 0)
        }
        i = i - 1
    }
    return path
}
fn m5_text_len(s){
    // 字符数（to_chars）。二进制/文件字节测量用 m5_byte_len。
    if s == nil { return 0 }
    if s == "" { return 0 }
    return s.to_chars().len()
}
// D-M5-05 修复：M5 r1 用 m5_text_len 测附件字节。B-M4-01 (r7)：宿主
// string.len() 本来就是字节长度（Rust s.len()），直接用宿主原语替代
// slice 扫描；语义从"字符数"修正为真实字节数，M5_MAX_BYTES 校验更准。
fn m5_byte_len(s){
    if s == nil { return 0 }
    return s.len()
}
fn m5_inbox_abs(){ return m5_sandbox_root_abs() + "/inbox" }
fn m5_ensure_inbox_root(){
    let r = m5_inbox_abs()
    try { fs.mkdirs(r) } catch { let _ign = 0 }
    try { fs.mkdirs(m5_attach_dir_abs()) } catch { let _ign = 0 }
    try { fs.mkdirs(m5_quarantine_dir_abs()) } catch { let _ign = 0 }
    try { fs.mkdirs(m5_lost_dir_abs()) } catch { let _ign = 0 }
}
// D-M5-02 修复（r3）：M5 r2 把"任意 /inbox 段"作为授权依据，导致绝对路径
// `…/sandbox/unapproved/inbox/foreign.txt`（与配置 inbox 同目录名但不同父目录）
// 仍被放行。本实装：(1) 拒绝源与根路径中任何 `..` 段；(2) abs_source 必须以
// m5_inbox_abs() 字面前缀起首（这就是配置的真实隔离 inbox 目录），后续字符
// 只允许 "/" 或字符串末尾；(3) 不再做"任意 /inbox 段"兜底搜索，避免被名字
// 巧合绕过；(4) symlink 跟随需要宿主 fs.stat/realpath；当前宿主未提供，故该
// 项保留 BLOCKED（见 review D-M5-02 注释），但本路径层防御已就位。
fn m5_path_in_inbox(abs_source){
    if abs_source == nil { return false }
    if abs_source == "" { return false }
    if m5_path_contains_parent_seg(abs_source) { return false }
    let root = m5_inbox_abs()
    if m5_path_contains_parent_seg(root) { return false }
    let rl = m5_text_len(root)
    let sl = m5_text_len(abs_source)
    if sl < rl { return false }
    let head = _strSlice(abs_source, 0, rl)
    if head != root { return false }
    if sl == rl { return true }
    let next = _strSlice(abs_source, rl, rl + 1)
    return next == "/"
}
// 路径中是否含 `..` 段（首/中/末）；用于拒绝越过隔离根的相对穿越
// D-M5-04（r9 修复轮）：to_chars 元素为 U32 码点，与字符串 "." / "/" 直接
// 比较恒类型不匹配（旧实装永不命中，守卫失效）。改为同型码点比较。
fn m5_path_contains_parent_seg(p){
    let _dot_arr = ".".to_chars()
    let _dot = _dot_arr[0]
    let _slash_arr = "/".to_chars()
    let _slash = _slash_arr[0]
    let chars = p.to_chars()
    let n = chars.len()
    let i = 0
    while i + 1 < n {
        let c1 = chars[i]
        let c2 = chars[i + 1]
        if c1 == _dot && c2 == _dot {
            let prev = ""
            if i > 0 { prev = chars[i - 1] }
            let next = ""
            if i + 2 < n { next = chars[i + 2] }
            let is_seg_start = (prev == _slash) || (i == 0)
            let is_seg_end = (next == _slash) || (i + 2 == n)
            if is_seg_start && is_seg_end { return true }
        }
        i = i + 1
    }
    return false
}
// 真实附件选择 = 校验用户在 TextInput 输入的源路径在 inbox 内、可读、字节数合规；
// 然后从 inbox 复制到 attachments/<attach_id> 并做一次"读回比对"。
// 返回的字典（map）包含 attach_id / sha / bytes / name / mime / lifecycle /
// stored_abs / verified_ms / source。
fn m5_attach_from_path(t, abs_source, uploader_id, source){
    m5_init_forms()
    m5_ensure_inbox_root()
    if !m5_path_in_inbox(abs_source) {
        STATE.status = "拒绝：源路径未在隔离 inbox 内（" + m5_short(abs_source, 40) + "）"
        saveState()
        return nil
    }
    if !fs.exists(abs_source) {
        STATE.status = "拒绝：附件源文件不存在或不可读（" + m5_short(abs_source, 40) + "）"
        saveState()
        return nil
    }
    let bytes_size = 0
    try { bytes_size = m5_file_size(abs_source) } catch { bytes_size = 0 }
    if bytes_size <= 0 {
        STATE.status = "拒绝：附件源文件为空字节或无法测量大小（" + m5_short(abs_source, 40) + "）"
        saveState()
        return nil
    }
    if bytes_size > M5_MAX_BYTES {
        STATE.status = "拒绝：附件超过 " + M5_MAX_BYTES.to_string() + " 字节（" + bytes_size.to_string() + "）"
        saveState()
        return nil
    }
    // D-M5-05（r5）：先把源字节读一次，避免 fs.read(abs_source) 多次调用造成
    // 不一致。源文本是后续"读回比对"和 SHA 的唯一可信根基。
    let src_text = ""
    try { src_text = fs.read(abs_source) } catch { src_text = "" }
    let name = m5_basename(abs_source)
    let attach_id = "att-" + newId()
    let stored_rel = "attachments/" + attach_id + "-" + name
    let stored_abs = m5_sandbox_root_abs() + "/" + stored_rel
    // canonical_path：把 src_text 原文存一份；后续 verify/open 用它做内容
    // 对比（不被 m5_fingerprint 是否能区分控制字节影响）。
    let canonical_rel = stored_rel + ".canonical"
    let canonical_abs = m5_sandbox_root_abs() + "/" + canonical_rel
    // 复制源 → 存盘；canonical 同样写一份。
    let write_ok = true
    try { fs.write(stored_abs, src_text) } catch { write_ok = false }
    if !write_ok {
        STATE.status = "拒绝：附件写入存盘失败（" + stored_rel + "）"
        saveState()
        return nil
    }
    let canonical_ok = true
    try { fs.write(canonical_abs, src_text) } catch { canonical_ok = false }
    if canonical_ok {
        // D-M5-05（r7）：canonical 写入必须读回核对，不把"写入未抛错"当落盘成功。
        let canon_back = ""
        try { canon_back = fs.read(canonical_abs) } catch { canon_back = "" }
        if canon_back != src_text { canonical_ok = false }
    }
    if !canonical_ok {
        // canonical 写失败——清理已写的存盘
        try { fs.write(stored_abs, "") } catch { let _ign = 0 }
        STATE.status = "拒绝：canonical 快照写盘/读回失败（" + canonical_rel + "）；不存附件"
        saveState()
        return nil
    }
    // D-M5-05（r5）：完整内容读回比对。旧实装只比较 bytes_size 与 back_size，
    // 同尺寸但内容被改写（例如 m5 适配注入 80 个 0x01 → 80 个 0x02）会被错
    // 标为 READY。本修复：完整文本不相等 → CORRUPTED，不入 t.evidence。
    let back_text = ""
    try { back_text = fs.read(stored_abs) } catch { back_text = "" }
    let back_size = m5_byte_len(back_text)
    let lifecycle = M5_LIFECYCLE_VERIFYING
    if back_size != bytes_size {
        lifecycle = M5_LIFECYCLE_CORRUPTED
    } else if back_text != src_text {
        // 同尺寸但内容不同 → 写盘/读回存在字节被改写的情况，标 CORRUPTED。
        lifecycle = M5_LIFECYCLE_CORRUPTED
    } else {
        lifecycle = M5_LIFECYCLE_READY
    }
    // sha：使用源文本的 FNV-1a 哈希作为内容指纹（host 暂未公开 sha256；
    // 验收时再次 FNV 比对，字节匹配与 fingerprint 匹配双闸；任一不一致
    // 都拒绝）。m5_fingerprint 对非 printable 字节的 fallback 是位置依赖，
    // 因此本处同时以 canonical 与存盘字节全等为最终依据。
    let sha = m5_fingerprint(src_text)
    let mime = m5_detect_mime(name)
    let verified_ms = nowMs()
    // D-M5-04（r3）：固化内容摘要 = {bytes, sha, prefix32, suffix32, version}，
    // 在保存时一次性写入 attach_item；submitCompletion 把每件证据的内容摘要
    // 复制进 completion.evidence_digests；acceptCompletion 重新读取存盘字节
    // 比对 completion 固化的摘要；任一项不一致即拒。防止『同 ID 文件内容被
    // 替换 / 旧附件摘要被改写』绕过验收。
    let prefix32 = m5_prefix32(src_text)
    let suffix32 = m5_suffix32(src_text)
    let content_signature = {bytes: bytes_size, sha: sha,
                             prefix32: prefix32, suffix32: suffix32,
                             version: t.version + 1}
    // D-M5-01 修复：返回字段同时包含 name / original_name + verified_ms /
    // last_verified_ms，避免 consumer 按"短键"读取时落到 nil 引发旧 demo 行为。
    // D-M5-05（r5）：canonical_rel / canonical_abs 携带全文快照路径；
    // verify/open 据此做全字节内容对比，免疫非 printable 字节指纹碰撞。
    let item = {attach_id: attach_id, task_id: t.id,
                original_path: abs_source, original_name: name,
                name: name,
                stored_rel: stored_rel, stored_abs: stored_abs,
                canonical_rel: canonical_rel, canonical_abs: canonical_abs,
                sha: sha, bytes: bytes_size, mime: mime,
                lifecycle: lifecycle,
                uploader_id: uploader_id, source: source,
                version_added: t.version + 1,
                evidence_round: 0, last_verified_ms: verified_ms,
                verified_ms: verified_ms,
                content_signature: content_signature,
                prefix32: prefix32, suffix32: suffix32}
    STATE.status = "已保存 " + lifecycle + " 附件 " + attach_id + "（" + bytes_size.to_string() + " B）"
    if lifecycle == M5_LIFECYCLE_CORRUPTED {
        STATE.status = "拒绝：写盘字节与源内容不一致（size=" + bytes_size.to_string() + " vs back=" + back_size.to_string() + "）"
    }
    saveState()
    return item
}
// 文件字节长度：用 m5_byte_len 真实扫描到 EOF；不再用路径 65536 上限的
// m5_text_len。宿主真实部署应替换为 fs.stat / fs.file_size 原语（如可用）
// 以避免 16 MiB 文件 O(N) 扫描；当前宿主未提供，按 fs.read + 末端探测实装。
fn m5_file_size(abs_path){
    if !fs.exists(abs_path) { return 0 }
    let text = fs.read(abs_path)
    return m5_byte_len(text)
}
// D-M5-05 修复（r3）：M5 r2 m5_fingerprint 复用 _fnv1a_hash，而 _fnv1a_hash
// 以 _textLenSafe(s) 为循环上界。_textLenSafe 是"跳过换行段累加距离"算法，
// 对单行串返回 (首换行索引 + 1)；对无换行串返回 (total + 1024) 的下界估计。
// → 任何『首行同 + 尾不同』的真实附件会得到相同指纹，损坏检测核心不成立。
//
// 新实装 = 不依赖 _textLenSafe / _charAtSafe 的完整内容指纹：
//   (1) B-M4-01 (r7)：用 to_chars() 一次取字符数组得到真实长度；
//   (2) 循环 i < n：取单字符 c，对每个字符用『位置 + 字符分类 + c 自身
//       在字符表中的位置』混合进 FNV-1a。宿主无 ord()，用 _strIndexOf 反查
//       字符在表中的位置近似区分（B-M4-01 r7 起；宿主无 slice/index_of）。
//   (3) 全文件遍历覆盖完整内容（probe 期望 loop_length == full_length）。
//
// 注：宿主未提供 fs.stat / fs.file_size 等二进制原语；不假设 h ^ c 的字符串
// 数值语义；不混用 _textLenSafe；不依赖 _charAtSafe 的换行边界。本实装自包含。
// D-M5-05 修复（r4）：m5_fingerprint 全内容指纹 v2 — 每个 printable ASCII
// 字符独立位置值，区分 v/w/其它所有 95 个 printable ASCII 字符；非
// printable 码点走 i XOR 0x55 fallback 混合。
// D-M5-04 (r11 修复轮 C)：循环内直接消费 U32 码点数值（见函数内注释），
// 不再经 _ascii_byte_value / _nibble_of_byte_* 字符串反查。
// mix 顺序：先把 (i & 0xFF) 混入（位置），再混入字符分类值；
// FNV-1a 常量 2166136261，乘数 16777619。
// 实测 review-probes.json hash_counterexample：
//   original = 'R3 independent reviewer first line\n' + 'v'*80 + '\nR3 independent reviewer end line'
//   changed  = 同上但 'v' → 'w'
//   sha256 两者不同；m5_fingerprint 也必然不同（v=85 / w=86）。
// D-M5-04 (r12 修复轮 C)：宿主原生实测旧实装 fingerprint 恒输出 00000000
// （11 场 probe 全零；声明算法独立参考 50ce396a）——`& 0xFFFFFFFF` /
// `>>` 等位运算与超 i32 字面量在固定宿主上不可靠。本实装只使用宿主已
// 实证的原语：+ - * / %（日期运算 :4049-4155、登录进度 :12761 同款）
// 与数值比较；位 XOR 用 8 位展开，mod 2^32 用 16 位分片乘法（所有中间
// 值 < 2^53，精确整数）。Python 移植 200000 组随机 (h,b) 与声明的
// FNV-1a 32 位算法逐值一致；探针串 / 384 B 诊断件摘要分别复算为
// 50ce396a / 7bedec07，与既有登记一致 —— 算法语义不变，不迁移、不
// 追认任何现存文件为基准。
// 超 i32 常量拆写为两个 < 2^31 字面量之和，不依赖大整数字面量解析。
fn m5_xor8(x, y){
    // x, y 均 < 256；返回值 = x XOR y（仅用 % / 2 展开，不用位运算）。
    let r = 0
    let bit = 1
    let xx = x
    let yy = y
    let i = 0
    while i < 8 {
        let xb = xx % 2
        let yb = yy % 2
        if xb != yb { r = r + bit }
        xx = (xx - xb) / 2
        yy = (yy - yb) / 2
        bit = bit * 2
        i = i + 1
    }
    return r
}
fn m5_fnv_mix_byte(h, b){
    // h < 2^32，b < 256。b 只影响低 8 位：高位部分不变，低 8 位按位 XOR。
    let lo = h % 256
    let hi = (h - lo) / 256
    let x = hi * 256 + m5_xor8(lo, b)
    // x * 16777619 mod 2^32：16 位分片，乘积 < 2^40，和不超 2^53。
    let xlo = x % 65536
    let xhi = (x - xlo) / 65536
    let p1 = xlo * 16777619
    let p2 = (xhi * 16777619) % 65536
    return (p1 + p2 * 65536) % (4000000000 + 294967296)
}
fn m5_hex32(n){
    // 8 位小写 hex；只用 % / 16 取 nibble，不用 & / >>（宿主实测不可靠）。
    let digits = "0123456789abcdef"
    let s = ""
    let v = n
    let i = 0
    while i < 8 {
        let d = v % 16
        s = _strSlice(digits, d, d + 1) + s
        v = (v - d) / 16
        i = i + 1
    }
    return s
}
fn m5_fingerprint(text){
    if text == nil { return "00000000" }
    // 语义说明：码点（字符）语义，不是 UTF-8 字节循环；内容主闸仍是
    // canonical 全字节比对（cur_text == canon_text），指纹仅作登记一致性
    // 辅证。完整文件遍历（probe 期望 loop_length == full_length）。
    // 算法 = 声明的 FNV-1a 32 位（offset 2166136261，prime 16777619），
    // 混入序列 [i % 256, 字符分类值]：printable ASCII (32..126) 混 c-32；
    // 非 printable 混 ((i*7) % 256) XOR 85（与原 ((i*7)^85)&255 逐值相同）。
    let chars = text.to_chars()
    let n = chars.len()
    if n == 0 { return m5_hex32(2000000000 + 166136261) }
    let h = 2000000000 + 166136261
    let i = 0
    while i < n {
        let c = chars[i]
        h = m5_fnv_mix_byte(h, i % 256)
        if c >= 32 && c <= 126 {
            h = m5_fnv_mix_byte(h, c - 32)
        } else {
            h = m5_fnv_mix_byte(h, m5_xor8((i * 7) % 256, 85))
        }
        i = i + 1
    }
    return m5_hex32(h)
}
// 单字符 → 字节值映射。D-M5-05 r4 修复：旧 _hex_nibble_of_char 仅覆盖 hex 字
// 符 + a-z + 空格 + 几个中文标点，其它 ASCII（v/w 等）与所有非 ASCII 字节
// 全部 fallback 到 0，导致同前缀同长度但中间内容不同的真实损坏得到同一 sha。
// —— r3 reviewer 探测把 80 个 'v' 改成 80 个 'w' 后指纹仍相同，命中此缺陷。
// 新实装：用 _strIndexOf 命中 95 字符顺序（空格 + !"#$%&'()*+,-./  + 0-9 + :;<=>?
// + @ + A-Z + [\]^_` + a-z + {|}~），每个 printable ASCII 字符得到唯一位置；
// 非 printable 字节（控制字符 / UTF-8 续字节 0x80-0xBF / 多字节首字节 0xC0+）
// 走 fallback：分两组用 [low_table / high_table] 反向 _strIndexOf 取得高低 nibble
// —— 同一字节不会出现同时命中两组 table 的情况，故高低 nibble 唯一确定。
//
// 例：v → low_table "0123456789abcdef" 中 v 不存在 → (low=-1, high=-1) →
// fallback 通过 i 自身 + XOR 0x55 区分位置；w 同样 → 不同 i 同样区分。
// 但 r3 reviewer 测试的 v/w 都是 printable ASCII：v 命中 alpha[85]，w 命中
// alpha[86]，指纹必然不同 —— 修复达成 review-probes.json
// hash_counterexample original_m5 != changed_m5 的预期。
fn _ascii_byte_value(c){
    if c == nil || c == "" { return -1 }
    // 95 个 printable ASCII，按字符 ASCII 顺序排列（含空格）。
    let alpha = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    let pos = _strIndexOf(alpha, c)
    if pos >= 0 { return pos }
    return -1
}
// 把单字节 c 的高 4 位 / 低 4 位分别反查成 nibble 值；用于非 printable 字节。
// low_table：每位一个唯一字符；c 在 low_table 中不存在 → nibble = -1；
// high_table 同样。同一个字节 c 不能同时在两个表中出现 —— 命中其一即得
// 一个 nibble，另一 nibble 由表的位置推出。
fn _nibble_of_byte_low(c){
    // 低 4 位 0..15 唯一字符：16 个不同的非冲突 ASCII
    let low_table = "0123456789abcdef"
    let pos = _strIndexOf(low_table, c)
    if pos < 0 { return -1 }
    return pos
}
fn _nibble_of_byte_high(c){
    let high_table = "ABCDEFGHIJKLMNOP"
    let pos = _strIndexOf(high_table, c)
    if pos < 0 { return -1 }
    return pos
}
// D-M5-04 / D-M5-05 修复（r3）：内容签名辅助 — prefix32 / suffix32 / 完整签名。
// 不依赖 _textLenSafe；用 m5_byte_len 取真实长度 + slice 截取首/尾 32 字符。
// 32 字符在 UTF-8 下覆盖 32..128 字节，足以覆盖常见文本/PDF/PNG 头部 / 尾部
// 唯一性。completion 固化 prefix32 / suffix32 / bytes；验收时再读一次比对。
fn m5_prefix32(text){
    if text == nil { return "" }
    return _strSlice(text, 0, 32)
}
fn m5_suffix32(text){
    if text == nil { return "" }
    let n = _textLenSafe(text)
    if n <= 32 { return text }
    return _strSlice(text, n - 32, n)
}
// 读回附件并构造内容签名 {bytes, sha, prefix32, suffix32}；与保存时签名比对。
// 返回 nil 表示文件不可读。
fn m5_read_content_signature(stored_abs){
    if stored_abs == nil || stored_abs == "" { return nil }
    if !fs.exists(stored_abs) { return nil }
    let text = ""
    try { text = fs.read(stored_abs) } catch { return nil }
    let bytes = m5_byte_len(text)
    let sha = m5_fingerprint(text)
    let prefix32 = m5_prefix32(text)
    let suffix32 = m5_suffix32(text)
    return {bytes: bytes, sha: sha, prefix32: prefix32, suffix32: suffix32}
}
// 内容签名严格比对：四元组全等视为内容未变；任一不一致即返回差异项。
fn m5_content_signature_equal(a, b){
    if a == nil || b == nil { return false }
    if a.bytes != b.bytes { return false }
    if a.sha != b.sha { return false }
    if a.prefix32 != b.prefix32 { return false }
    if a.suffix32 != b.suffix32 { return false }
    return true
}
// m5 隔离 = 把 attachments/<attach_id>-<name> 移动到 quarantine/ 下；
// 同时把名字前加时间戳，避免同名覆盖。
// D-M5-05（r5）：canonical 快照随存盘文件一并移走；隔离后 verify 看到
// canonical 缺失或不一致仍判 CORRUPTED/MISSING（后者占主流，因为 quarantine
// 后 suspend 任何 read）。
fn m5_move_to_quarantine(ev){
    if ev == nil { return "" }
    let id_part = m5_basename(ev.stored_abs)
    let ts = nowMs().to_string()
    let target = m5_quarantine_dir_abs() + "/" + ts + "-" + id_part
    try { fs.rename(ev.stored_abs, target) } catch {
        try { fs.write(target, fs.read(ev.stored_abs)) } catch {}
        try { fs.write(ev.stored_abs, "") } catch {}
    }
    // canonical 也一并隔离
    if ev.canonical_abs != nil && ev.canonical_abs != "" {
        let canon_id = m5_basename(ev.canonical_abs)
        let canon_target = m5_quarantine_dir_abs() + "/" + ts + "-" + canon_id
        try { fs.rename(ev.canonical_abs, canon_target) } catch {
            try { fs.write(canon_target, fs.read(ev.canonical_abs)) } catch {}
            try { fs.write(ev.canonical_abs, "") } catch {}
        }
    }
    return m5_quarantine_dir_abs() + "/" + ts + "-" + id_part
}
// ─── M5 evidence_index.json 索引 ────────────────────────────────
// attach_items 索引跨重启保留；保存 / 读取走单独的 evidence_index.json
// 避免污染 tasks.json。state.json 同样保留 copy 以便 STATE 重启恢复。
fn m5_index_path(){
    return m5_sandbox_root_abs() + "/evidence_index.json"
}
// D-M5-04（r8）：索引序列化走信封 map（to_json 在 map 字面量上已被
// m5_reconcile_audit.json / state.json 原生实证），不再对 parse_json 产出的
// 顶层数组直接调 to_json。loader 兼容本信封与旧版顶层数组。
fn m5_index_envelope(arr){
    return {format: "m5-evidence-index", version: 3, saved_ms: nowMs(), items: arr}
}
fn m5_index_items_from_raw(raw){
    // 返回索引项数组；其它形状（标量 / 无 items 的对象 / 错误值）返回 nil。
    // D-M5-04 (r11 修复轮 B)：先判形状再取字段 —— 旧顶层数组没有 items
    // 字段，直接 raw.items 访问会触发宿主错误值与 catch 绑定链失败
    // （原生实测 "variable _ not found in scope"）。数组/对象判定用
    // m7_is_array_value / m7_is_object_value（合法任务加载同款、宿主
    // 实证的行为探针，不以 len 接受任意对象）；catch 一律用宿主实证的
    // 无绑定 bare catch（M7_REVIEW_r7 R-M7-02：catch _ 绑定形式在异常
    // 真实发生时报 scope 错误）。
    if raw == nil { return nil }
    if m7_is_array_value(raw) { return raw }
    let is_obj = false
    try { if m7_is_object_value(raw) { is_obj = true } } catch { is_obj = false }
    if !is_obj { return nil }
    let items = nil
    try { items = raw.items } catch { items = nil }
    if items == nil { return nil }
    if !m7_is_array_value(items) { return nil }
    return items
}
fn m5_save_attach_index(){
    if STATE.attach_items == nil { STATE.attach_items = [] }
    let arr = STATE.attach_items
    let p = m5_index_path()
    // D-M5-04（r8）落盘协议 = 宿主已实证可用的一组原语（与
    // m5_reconcile_audit.json 同一协议：map to_json + fs.write + 立即读回
    // 串比对）：
    //   1) 不再依赖 fs.rename —— D-M4-03（r4）已确认宿主无真 rename 原子
    //      语义，且 r7 原生 7 场证据显示 rename 链路持续失败（tmp 残留
    //      0 字节、目标不变）。tmp 现在只是崩溃恢复副本，不做改名。
    //   2) tmp 写 + 读回比对 → 目标直接写 + 读回比对；任一步失败返回
    //      false 并保留 tmp 完整内容，下次启动 loader 回退读 tmp 恢复。
    //   3) 成功不立即清 tmp：崩溃恢复副本保留到调用方完成权威核验
    //      （reconcile 逐成员读回核对 / commit 包装）后才清空。
    try { fs.mkdirs(m5_sandbox_root_abs()) } catch { let _ign = 0 }
    let body = ""
    let ser_ok = true
    try { body = m5_index_envelope(arr).to_json() } catch { ser_ok = false }
    if !ser_ok || body == "" {
        STATE.status = STATE.status + "（evidence_index 序列化失败）"
        return false
    }
    let tmp = p + ".tmp"
    try { fs.write(tmp, body) } catch {
        STATE.status = STATE.status + "（evidence_index.json.tmp 落盘失败）"
        return false
    }
    let tmp_back = ""
    let tmp_ok = true
    try { tmp_back = fs.read(tmp) } catch { tmp_ok = false }
    if !tmp_ok || tmp_back != body {
        STATE.status = STATE.status + "（evidence_index.json.tmp 读回不一致）"
        return false
    }
    try { fs.write(p, body) } catch {
        STATE.status = STATE.status + "（evidence_index.json 落盘失败）"
        return false
    }
    let back = ""
    let rd_ok = true
    try { back = fs.read(p) } catch { rd_ok = false }
    if !rd_ok || back != body {
        STATE.status = STATE.status + "（evidence_index.json 读回不一致）"
        return false
    }
    // D-M5-04 (r12 修复轮 B)：成功只代表字节级写+读回一致；tmp 崩溃恢复
    // 副本保留到调用方完成权威核验（reconcile 的逐成员读回核对）后才清。
    // 核验失败时 tmp 持有最近一次完整内容，loader 回退读 tmp 恢复。
    return true
}
// 核验整体成功后清空崩溃恢复副本（宿主无 fs.remove，空串 = 无待恢复副本）。
fn m5_attach_index_tmp_clear(){
    let tmp = m5_index_path() + ".tmp"
    try { fs.write(tmp, "") } catch { let _ign = 0 }
}
// 非 reconcile 路径（open/verify 生命周期更新）：字节级读回一致即完成，
// 成功同时清 tmp，保持 r8 协议的对外行为。
fn m5_save_attach_index_commit(){
    let _cok = m5_save_attach_index()
    if _cok { m5_attach_index_tmp_clear() }
    return _cok
}
// D-M5-04 (r12 修复轮 B)：索引读回逐成员核对的字段比较。parse_json /
// to_json 往返可能产生数值表示差异（r11 六场磁盘 items 与内存结构全等
// 却判失配；严格 != 的类型语义未经宿主实证）。先按数值比较（减法 +
// 关系运算，宿主已实证），不可数值化的两侧回退字符串相等；任一侧
// 无法取值 = 失配（安全失败，不放行、不硬改旗标）。
fn m5_index_field_eq(a, b){
    let num_done = false
    let num_eq = false
    try {
        let d = a - b
        // 真实数值恰居其一；宿主错误值三者全假或直接抛出 → 走字符串回退，
        // 不会把不可比较误判为相等（安全失败）。
        if d == 0 { num_eq = true; num_done = true }
        else if d < 0 { num_done = true }
        else if d > 0 { num_done = true }
    } catch { num_done = false }
    if num_done { return num_eq }
    let sa = ""
    let sb = ""
    let s_ok = true
    try { sa = a.to_string() } catch { s_ok = false }
    try { sb = b.to_string() } catch { s_ok = false }
    if !s_ok { return false }
    return sa == sb
}
fn m5_load_attach_index(){
    let p = m5_index_path()
    let loaded = nil
    // D-M5-04 (r11 修复轮 B)：catch 用宿主实证的无绑定 bare catch。
    if fs.exists(p) {
        try { loaded = m5_index_items_from_raw(fs.read(p).parse_json()) } catch { loaded = nil }
    }
    if loaded == nil {
        // D-M5-04（r8）：目标缺失/损坏时回退崩溃恢复副本（writer 不再
        // rename，tmp 持有最近一次读回一致的完整内容）。加载失败保全
        // 原盘、不改写索引文件，不默默转空数组。
        let tmp = p + ".tmp"
        if fs.exists(tmp) {
            try { loaded = m5_index_items_from_raw(fs.read(tmp).parse_json()) } catch { loaded = nil }
        }
    }
    if loaded == nil { return }
    if STATE.attach_items == nil { STATE.attach_items = [] }
    STATE.attach_items = loaded
}
// D-M5-04（r8）宿主原语探针：仅在测试根（m5-test）下运行。分步记录
// fs.mkdirs/write/read/exists/rename 与 to_json 各变体（原生数组 / parse_json
// 产出数组 / STATE.attach_items）的真实结果，每步立即经受控 map to_json +
// fs.write + 读回协议落盘 m5_fs_probe.json，供独立 Review 直接核对是哪一步
// 原语失败，而不是凭 0 字节 tmp 推测。探针只写本测试根内的小文件。
fn m5_fs_probe_flush(res){
    let pp = m5_sandbox_root_abs() + "/m5_fs_probe.json"
    try { fs.write(pp, res.to_json()) } catch { }
}
fn m5_fs_probe(){
    if m5_sandbox_root_abs() != "m5-test" { return }
    let root = m5_sandbox_root_abs()
    let res = {at: nowMs(), actor: "system:fs-probe", root: root,
               mkdirs: "unrun", write_string: "unrun", readback_string: "unrun",
               to_json_native_array: "unrun", to_json_parsed_array: "unrun",
               to_json_attach_items: "unrun", rename_result: "unrun",
               rename_src_exists: "unrun", rename_dst_exists: "unrun",
               abs_exists: "unrun", rel_exists: "unrun",
               abs_path_sample: "", rel_path_sample: "",
               bracket_tostring: "unrun", bracket_eq_str: "unrun",
               basename_probe: "unrun", slice_probe: "unrun",
               chars_roundtrip: "unrun", fingerprint_probe: "unrun",
               basename_probe_zh: "unrun", slice_probe_zh: "unrun",
               hex32_of_1: "unrun", fnv_offset_probe: "unrun",
               mod32_probe: "unrun", mul_probe: "unrun",
               xor8_probe: "unrun", mix_probe: "unrun",
               band_big_probe: "unrun", shift_probe: "unrun",
               fingerprint_zh: "unrun", fingerprint_ctrl: "unrun"}
    let _mk_ok = true
    try { fs.mkdirs(root) } catch { _mk_ok = false }
    if _mk_ok { res.mkdirs = "ok" } else { res.mkdirs = "throw" }
    m5_fs_probe_flush(res)
    let io = root + "/probe_io.txt"
    let _w_ok = true
    try { fs.write(io, "m5-probe") } catch { _w_ok = false }
    if _w_ok { res.write_string = "ok" } else { res.write_string = "throw" }
    if _w_ok {
        let rb = ""
        try { rb = fs.read(io) } catch { rb = "__throw__" }
        if rb == "m5-probe" { res.readback_string = "ok" } else { res.readback_string = "mismatch" }
    }
    let _na = [1, 2, 3]
    let _nj = ""
    try { _nj = _na.to_json() } catch { _nj = "__throw__" }
    if _nj == "__throw__" { res.to_json_native_array = "throw" } else { res.to_json_native_array = "ok:" + _nj }
    let _pa = nil
    try { _pa = "[1,2,3]".parse_json() } catch { _pa = nil }
    if _pa == nil { res.to_json_parsed_array = "parse_throw" }
    else {
        let _pj = ""
        try { _pj = _pa.to_json() } catch { _pj = "__throw__" }
        if _pj == "__throw__" { res.to_json_parsed_array = "throw" } else { res.to_json_parsed_array = "ok:" + _pj }
    }
    let _sj = ""
    try { _sj = STATE.attach_items.to_json() } catch { _sj = "__throw__" }
    if _sj == "__throw__" { res.to_json_attach_items = "throw" } else { res.to_json_attach_items = "ok:len=" + _sj.len().to_string() }
    m5_fs_probe_flush(res)
    let dst = root + "/probe_io_renamed.txt"
    let _rn_ok = true
    try { fs.rename(io, dst) } catch { _rn_ok = false }
    if _rn_ok { res.rename_result = "ok" } else { res.rename_result = "throw" }
    if fs.exists(io) { res.rename_src_exists = "true" } else { res.rename_src_exists = "false" }
    if fs.exists(dst) { res.rename_dst_exists = "true" } else { res.rename_dst_exists = "false" }
    m5_fs_probe_flush(res)
    // 字符串/码点语义探针：to_chars 元素类型（to_string 区分码点 91 与串 "["）、
    // 码点==字符串字面量是否恒假、basename/slice 实际输出。
    let _bk_arr = "[".to_chars()
    let _bkc = _bk_arr[0]
    res.bracket_tostring = _bkc.to_string()
    if _bkc == "[" { res.bracket_eq_str = "true" } else { res.bracket_eq_str = "false" }
    res.basename_probe = m5_basename("a/b.txt")
    res.slice_probe = _strSlice("abcdef", 1, 3)
    // D-M5-04 (r11 修复轮 A/C)：在固定宿主上实证新转换路径 ——
    // chars_roundtrip 复核 U32 码点数组 to_string() 回转字符；
    // fingerprint_probe 复核指纹函数直接消费数值码点、无类型错误；
    // 中文探针复核多字节字符路径不损坏。
    let _rt = ""
    try { _rt = "hi".to_chars().to_string() } catch { _rt = "__throw__" }
    res.chars_roundtrip = _rt
    let _fp = ""
    try { _fp = m5_fingerprint("M5 probe ABC xyz 123") } catch { _fp = "__throw__" }
    res.fingerprint_probe = _fp
    res.basename_probe_zh = m5_basename("a/中文附件.txt")
    res.slice_probe_zh = _strSlice("中文abc", 1, 4)
    // D-M5-04 (r12 修复轮 C)：按审查清单逐步实证指纹链原语 ——
    // hex32(1)、初始值、一次 mix、乘法 / 取模 / 旧位运算（对照诊断）、
    // 实际 ASCII / 中文 / 控制字符摘要。参考值（Python 移植复算）：
    // hex32_of_1=00000001；fnv_offset=2166136261；mul=83886095；
    // xor8(255,85)=170；mix(offset,65)=3289118412；
    // fingerprint_probe=50ce396a；fingerprint_zh=0a6e9c79；
    // fingerprint_ctrl=65496f3a。band_big / shift 记录旧实装依赖的
    // & 0xFFFFFFFF 与 >> 在固定宿主的实际行为（r11 恒零根因对照）。
    let _h1 = ""
    try { _h1 = m5_hex32(1) } catch { _h1 = "__throw__" }
    res.hex32_of_1 = _h1
    let _off = ""
    try { _off = (2000000000 + 166136261).to_string() } catch { _off = "__throw__" }
    res.fnv_offset_probe = _off
    let _m32 = ""
    try { _m32 = ((2000000000 + 166136261) % (4000000000 + 294967296)).to_string() } catch { _m32 = "__throw__" }
    res.mod32_probe = _m32
    let _mul = ""
    try { _mul = (5 * 16777619).to_string() } catch { _mul = "__throw__" }
    res.mul_probe = _mul
    let _x8 = ""
    try { _x8 = m5_xor8(255, 85).to_string() } catch { _x8 = "__throw__" }
    res.xor8_probe = _x8
    let _mx = ""
    try { _mx = m5_fnv_mix_byte(2000000000 + 166136261, 65).to_string() } catch { _mx = "__throw__" }
    res.mix_probe = _mx
    let _bb = ""
    // M6 r9 阻断适配（B-M5-01 阻断 M6 冷启动零解析门禁，最小语法修复，不撤销 M5
    // 探针语义）：原 `(2166136261 & 0xFFFFFFFF).to_string()` 在固定宿主解析期被拒
    // （宿主/vendored parser 均首报该处 Expected )），try/catch 无法保护解析期。
    // 改写为已实证宿主零解析的同构形（对照 5132 `h = (h ^ c) & 0xFFFFFFFF`），
    // `^ 0` 恒等不改变探针语义（仍探测大数 & 0xFFFFFFFF 的宿主行为）。
    let _bbn = 2166136261
    try { _bbn = (_bbn ^ 0) & 0xFFFFFFFF } catch { _bb = "__throw__" }
    if _bb == "" { _bb = _bbn.to_string() }
    res.band_big_probe = _bb
    let _sh = ""
    // 同上：`(32 >> 4).to_string()` 同形解析风险，改写为已实证同构形（对照 5147
    // `v = v >> 4`），探针语义不变（仍探测 >> 的宿主行为）。
    let _shn = 32
    try { _shn = _shn >> 4 } catch { _sh = "__throw__" }
    if _sh == "" { _sh = _shn.to_string() }
    res.shift_probe = _sh
    let _fzh = ""
    try { _fzh = m5_fingerprint("中文附件") } catch { _fzh = "__throw__" }
    res.fingerprint_zh = _fzh
    let _fct = ""
    try { _fct = m5_fingerprint("a\nb\t") } catch { _fct = "__throw__" }
    res.fingerprint_ctrl = _fct
    m5_fs_probe_flush(res)
    // 绝对 vs 相对路径语义：取首个登记附件（若有），同一文件两种写法分别探测。
    if STATE.attach_items != nil {
        if STATE.attach_items.len() > 0 {
            let it = STATE.attach_items[0]
            let ap = ""
            try { ap = it.stored_abs } catch { ap = "" }
            if ap != nil && ap != "" {
                if _strIndexOf(ap, "[Error") < 0 {
                    res.abs_path_sample = ap
                    if fs.exists(ap) { res.abs_exists = "true" } else { res.abs_exists = "false" }
                    let rp = root + "/attachments/" + m5_basename(ap)
                    res.rel_path_sample = rp
                    if fs.exists(rp) { res.rel_exists = "true" } else { res.rel_exists = "false" }
                }
            }
        }
    }
    m5_fs_probe_flush(res)
}
// D-M5-04（r8）：权威恢复的路径解析，相对路径优先 —— 宿主 fs 已实证 jail 内
// 相对语义（state.json / tasks.json / m5_reconcile_audit.json 同款），r7 原生
// 证据显示钉扎绝对路径在当前宿主不可达字节校验。顺序：可信任务登记的相对路径
// → 登记绝对路径（仅次选）→ 相对根 + attachments/<basename>；含宿主错误值
// 标记（"[Error"）的登记值直接跳过。返回 "" = 不可读，调用方按 MISSING 处理。
fn m5_resolve_existing(abs_path, rel_path){
    let root = m5_sandbox_root_abs()
    if rel_path != nil && rel_path != "" {
        if _strIndexOf(rel_path, "[Error") < 0 {
            if !m5_path_contains_parent_seg(rel_path) {
                let p = root + "/" + rel_path
                if fs.exists(p) { return p }
            }
        }
    }
    if abs_path != nil && abs_path != "" {
        if _strIndexOf(abs_path, "[Error") < 0 {
            if fs.exists(abs_path) { return abs_path }
        }
        let p2 = root + "/attachments/" + m5_basename(abs_path)
        if fs.exists(p2) { return p2 }
    }
    return ""
}
// D-M5-04（r6/r7）共同提交/恢复协议：任务库（commit(t) 先落盘）是权威事实，
// evidence_index.json 是派生索引。submit/reject/upload 都是「先 commit 任务、
// 后落索引」，中途失败会让磁盘索引落后于任务事实（旧索引无条件覆盖内存是
// 本缺陷根因）。启动加载索引后、开放操作前先对账：
//   (0) 权威轮次 — 从已提交 completions 历史重建 m5_last_round，不从 UI 偏好
//       / 旧 state.json 认定；
//   (1) 轮次/退回标记 — 以 t.evidence（随任务同一 commit 落盘）为准修平索引；
//   (2) 索引缺项 — 从 t.evidence 重建，并立刻重读真实字节定 lifecycle
//       （READY 只能由字节校验得出，不从任何登记值继承）；
//   (3) 索引孤儿（任务库不存在该证据）— 不删除、不放行，仅记入对账记录；
//   (4) 任务不存在 / 属于其他任务的外来项同样保留并记录，不为本任务所用。
// 统一 dirty 标记涵盖轮次 / 退回标记 / 索引项三类修复；writer 失败上抛
// （index_save_failed），成功必须读回实际目标逐成员核对后才算持久化。
// 恢复审计经受控系统来源文件 m5_reconcile_audit.json 持久化（启动时无登录会话，
// saveEvents 身份闸拒写是既有设计，不绕过、不造用户会话）。
// 无法用权威事实确认的项保持拒绝态，由既有 verify 守卫在安全重试时重新判定。
fn m5_reconcile_attach_index(){
    if STATE.attach_items == nil { STATE.attach_items = [] }
    let repaired_round = 0
    let rounds_fixed = 0
    let rebuilt_items = 0
    let orphan_items = 0
    let foreign_items = 0
    let dirty = false
    let touched = []
    let ti = 0
    while ti < TASKS.len() {
        let t = TASKS[ti]
        let t_repaired = 0
        let t_rebuilt = 0
        let t_orphan = 0
        let t_foreign = 0
        let t_round_fixed = 0
        // (0) 权威轮次：以已提交 completions 历史重建（commit 先落盘 = 权威）。
        let auth_round = 0
        try {
            if t.completions != nil {
                let cn = t.completions.len()
                if cn > 0 {
                    let lastc = t.completions[cn - 1]
                    if lastc.round != nil { auth_round = lastc.round }
                    else if lastc.evidence_round != nil { auth_round = lastc.evidence_round }
                    else { auth_round = cn }
                }
            }
        } catch { auth_round = 0 }
        if m5_current_round(t.id) != auth_round {
            m5_set_round(t.id, auth_round)
            rounds_fixed = rounds_fixed + 1
            t_round_fixed = t_round_fixed + 1
            dirty = true
        }
        if t.evidence == nil { ti = ti + 1; continue }
        // (1)+(2)：以 t.evidence 为权威遍历
        let ei = 0
        while ei < t.evidence.len() {
            let ev = t.evidence[ei]
            let ev_demo = false
            try { if ev.demo == true { ev_demo = true } } catch { ev_demo = false }
            if ev_demo { ei = ei + 1; continue }
            let ai = m5_index_get(ev.id)
            if ai != nil && ai.task_id != t.id {
                // D-M5-03/D-M5-04（r7）：索引中同 id 项属于其他任务——隔离保留，
                // 不修平、不重建、不为本任务所用。
                foreign_items = foreign_items + 1
                t_foreign = t_foreign + 1
            } else if ai != nil {
                if ai.evidence_round != ev.evidence_round {
                    ai.evidence_round = ev.evidence_round
                    repaired_round = repaired_round + 1
                    t_repaired = t_repaired + 1
                    dirty = true
                }
                let ev_rej = nil
                try { ev_rej = ev.last_rejected_at } catch { ev_rej = nil }
                if ev_rej != nil {
                    if ai.last_rejected_at != ev_rej {
                        ai.last_rejected_at = ev_rej
                        t_repaired = t_repaired + 1
                        dirty = true
                    }
                }
                // D-M5-04（r8）：登记路径当前不可读时按可信相对登记路径重解析
                // 并修平索引项，让 open/verify 到达真实字节校验而不是把完整件
                // 误报 MISSING；仍不可读保持原值，由 verify 守卫判定。
                let ai_ok = false
                try { if fs.exists(ai.stored_abs) { ai_ok = true } } catch { ai_ok = false }
                if !ai_ok {
                    let ai_rel = ""
                    try { ai_rel = ai.stored_rel } catch { ai_rel = "" }
                    let ai_res = m5_resolve_existing(ai.stored_abs, ai_rel)
                    if ai_res != "" {
                        ai.stored_abs = ai_res
                        ai.canonical_abs = ai_res + ".canonical"
                        dirty = true
                    }
                }
            } else {
                let ev_stored = ""
                try { ev_stored = ev.stored_abs } catch { ev_stored = "" }
                if ev_stored != nil && ev_stored != "" {
                    // D-M5-04（r8）：可信任务登记可能只有 stored_abs；相对登记
                    // 路径优先，缺失或错误值时由 attachments/<basename> 派生
                    // （真实保存的确定性命名），不依赖绝对路径在当前场可达。
                    let ev_rel = ""
                    try { ev_rel = ev.stored_rel } catch { ev_rel = "" }
                    if ev_rel == nil || ev_rel == "" { ev_rel = "attachments/" + m5_basename(ev_stored) }
                    else { if _strIndexOf(ev_rel, "[Error") >= 0 { ev_rel = "attachments/" + m5_basename(ev_stored) } }
                    let item = {attach_id: ev.id, task_id: t.id,
                                name: ev.name, original_name: ev.name,
                                stored_rel: ev_rel, stored_abs: ev_stored,
                                canonical_rel: ev_rel + ".canonical",
                                canonical_abs: ev_stored + ".canonical",
                                sha: ev.sha, bytes: ev.bytes, mime: ev.mime,
                                evidence_round: ev.evidence_round,
                                version_added: ev.version_added,
                                lifecycle: M5_LIFECYCLE_MISSING,
                                last_verified_ms: 0,
                                uploader_id: ev.uploader_id,
                                source: "rebuild_from_task_store",
                                prefix32: "", suffix32: "",
                                content_signature: nil}
                    // D-M5-04（r8）：相对登记路径优先解析；不可读则保持 MISSING。
                    let resolved = m5_resolve_existing(ev_stored, ev_rel)
                    if resolved != "" {
                        item.stored_abs = resolved
                        item.canonical_abs = resolved + ".canonical"
                    }
                    STATE.attach_items.push(item)
                    dirty = true
                    // 真实字节校验：与 canonical 快照全字节比对 + 登记指纹 + 尺寸；
                    // 全部通过才 READY，并回填当前内容签名。任一不符即 CORRUPTED/MISSING。
                    if resolved != "" {
                        let cur_text = ""
                        try { cur_text = fs.read(item.stored_abs) } catch { cur_text = "" }
                        let cur_size = m5_file_size(item.stored_abs)
                        let canon_text = nil
                        if fs.exists(item.canonical_abs) {
                            try { canon_text = fs.read(item.canonical_abs) } catch { canon_text = nil }
                        }
                        if canon_text == nil {
                            // D-M5-05（r7）：canonical 缺失 = 失去可信内容基准。
                            // 取消弱指纹自动重建分支：不再把现存字节追认为原件；
                            // 保持 CORRUPTED（未可信），补证出口 = 人工重传 / 显式复验。
                            item.lifecycle = M5_LIFECYCLE_CORRUPTED
                            item.source = "rebuild_from_task_store:no_canonical"
                        } else if cur_text == canon_text && cur_size == ev.bytes && m5_fingerprint(cur_text) == ev.sha {
                            let sig = m5_read_content_signature(item.stored_abs)
                            if sig != nil {
                                item.prefix32 = sig.prefix32
                                item.suffix32 = sig.suffix32
                                item.content_signature = sig
                                item.lifecycle = M5_LIFECYCLE_READY
                                item.last_verified_ms = nowMs()
                            } else {
                                item.lifecycle = M5_LIFECYCLE_MISSING
                            }
                        } else {
                            item.lifecycle = M5_LIFECYCLE_CORRUPTED
                        }
                    }
                    rebuilt_items = rebuilt_items + 1
                    t_rebuilt = t_rebuilt + 1
                }
            }
            ei = ei + 1
        }
        // (3)：索引孤儿（属于本任务但任务库无此证据）
        let ii = 0
        while ii < STATE.attach_items.len() {
            let ax = STATE.attach_items[ii]
            if ax.task_id == t.id {
                let found = false
                let ej = 0
                while ej < t.evidence.len() {
                    if t.evidence[ej].id == ax.attach_id { found = true; break }
                    ej = ej + 1
                }
                if !found {
                    orphan_items = orphan_items + 1
                    t_orphan = t_orphan + 1
                }
            }
            ii = ii + 1
        }
        if t_repaired > 0 || t_rebuilt > 0 || t_orphan > 0 || t_foreign > 0 || t_round_fixed > 0 {
            touched.push(t.id)
            logEvent("m5_index_reconcile", t, {task_id: t.id,
                                              repaired_round: t_repaired,
                                              rounds_fixed: t_round_fixed,
                                              rebuilt_items: t_rebuilt,
                                              orphan_items: t_orphan,
                                              foreign_items: t_foreign})
        }
        ti = ti + 1
    }
    // (4)：任务不存在的外来项（跨任务/已删除任务残留）
    let fi = 0
    while fi < STATE.attach_items.len() {
        let af = STATE.attach_items[fi]
        let has_task = false
        let tj = 0
        while tj < TASKS.len() {
            if TASKS[tj].id == af.task_id { has_task = true; break }
            tj = tj + 1
        }
        if !has_task { foreign_items = foreign_items + 1 }
        fi = fi + 1
    }
    // D-M5-04（r7）：统一 dirty 标记涵盖轮次 / 退回标记 / 索引项三类修复；
    // writer 失败上抛（index_save_failed），成功必须读回实际目标逐成员核对后
    // 才算持久化；不以计数提示掩盖落盘失败。
    // D-M5-04 (r12 修复轮 B)：核验链逐步落盘 m5_save_verify.json（仅 m5-test
    // 根），记录 writer 返回值 / 读回 / 抽取 / 两侧长度 / 逐成员逐字段实际
    // 比较结果与失配详情 —— 不再凭单一 rb_ok 推测失败点（r11 六场写盘正确
    // 却 index_saved=false 的定位依据）。tmp 副本在整个核验成功后才清空；
    // 失败保留完整副本供 loader 回退。
    let saved = false
    let save_failed = false
    if dirty {
        let sv = {at: nowMs(), actor: "system:save-verify",
                  save_return: "unrun", rb_read: "unrun", rb_parse: "unrun",
                  rb_extract_nil: "unrun", state_len: -1, rb_len: -1,
                  len_eq: "unrun", members: [], first_mismatch: "",
                  rb_ok: "unrun"}
        saved = m5_save_attach_index()
        if saved { sv.save_return = "true" } else { sv.save_return = "false" }
        if saved {
            // D-M5-04（r8）：读回经 m5_index_items_from_raw 兼容信封/旧数组。
            let rb_raw = ""
            let rb_read_ok = true
            try { rb_raw = fs.read(m5_index_path()) } catch { rb_read_ok = false }
            if rb_read_ok { sv.rb_read = "ok" } else { sv.rb_read = "throw" }
            let rb_parsed = nil
            let rb_parse_ok = true
            if rb_read_ok {
                try { rb_parsed = rb_raw.parse_json() } catch { rb_parse_ok = false }
            }
            if rb_parse_ok { sv.rb_parse = "ok" } else { sv.rb_parse = "throw_or_skip" }
            let rb = nil
            if rb_parse_ok {
                try { rb = m5_index_items_from_raw(rb_parsed) } catch { rb = nil }
            }
            if rb == nil { sv.rb_extract_nil = "true" } else { sv.rb_extract_nil = "false" }
            let rb_ok = false
            if rb != nil {
                rb_ok = true
                sv.state_len = STATE.attach_items.len()
                let rbl = -1
                try { rbl = rb.len() } catch { rb_ok = false }
                sv.rb_len = rbl
                if rb_ok {
                    if rbl != STATE.attach_items.len() {
                        rb_ok = false
                        sv.len_eq = "false"
                        sv.first_mismatch = "len state=" + STATE.attach_items.len().to_string() + " disk=" + rbl.to_string()
                    } else {
                        sv.len_eq = "true"
                    }
                }
                if rb_ok {
                    let vi = 0
                    while vi < STATE.attach_items.len() {
                        let a1 = STATE.attach_items[vi]
                        let a2 = rb[vi]
                        let m_id = m5_index_field_eq(a1.attach_id, a2.attach_id)
                        let m_round = m5_index_field_eq(a1.evidence_round, a2.evidence_round)
                        let m_lc = m5_index_field_eq(a1.lifecycle, a2.lifecycle)
                        let mrec = {i: vi, id_eq: m_id, round_eq: m_round, lifecycle_eq: m_lc}
                        sv.members.push(mrec)
                        if !m_id || !m_round || !m_lc {
                            rb_ok = false
                            if sv.first_mismatch == "" {
                                let d1 = ""
                                let d2 = ""
                                try { d1 = a1.evidence_round.to_string() } catch { d1 = "__throw__" }
                                try { d2 = a2.evidence_round.to_string() } catch { d2 = "__throw__" }
                                let _mid = "false"
                                if m_id { _mid = "true" }
                                let _mrd = "false"
                                if m_round { _mrd = "true" }
                                let _mlc = "false"
                                if m_lc { _mlc = "true" }
                                sv.first_mismatch = "i=" + vi.to_string() + " id_eq=" + _mid + " round_eq=" + _mrd + " lc_eq=" + _mlc + " round_state=" + d1 + " round_disk=" + d2
                            }
                        }
                        vi = vi + 1
                    }
                }
            }
            if rb_ok { sv.rb_ok = "true" } else { sv.rb_ok = "false" }
            if !rb_ok { saved = false; save_failed = true }
            else { m5_attach_index_tmp_clear() }
        } else {
            save_failed = true
        }
        // 核验诊断只在测试根落盘（与 m5_fs_probe 同边界），不影响真实根。
        if m5_sandbox_root_abs() == "m5-test" {
            let svp = m5_sandbox_root_abs() + "/m5_save_verify.json"
            try { fs.write(svp, sv.to_json()) } catch {}
        }
    }
    // 恢复审计持久化：受控系统来源文件，直接 fs.write + 读回核对。
    let audit_saved = false
    if dirty || orphan_items > 0 || foreign_items > 0 || save_failed {
        let audit = {at: nowMs(), actor: "system:boot-reconcile",
                     repaired_round: repaired_round, rounds_fixed: rounds_fixed,
                     rebuilt_items: rebuilt_items, orphan_items: orphan_items,
                     foreign_items: foreign_items, tasks: touched,
                     index_saved: saved, index_save_failed: save_failed}
        let ap = m5_sandbox_root_abs() + "/m5_reconcile_audit.json"
        let aw = true
        try { fs.write(ap, audit.to_json()) } catch { aw = false }
        if aw {
            try {
                let arb = fs.read(ap)
                if arb == audit.to_json() { audit_saved = true }
            } catch { audit_saved = false }
        }
    }
    STATE.m5_last_reconcile = {at: nowMs(),
                               repaired_round: repaired_round,
                               rounds_fixed: rounds_fixed,
                               rebuilt_items: rebuilt_items,
                               orphan_items: orphan_items,
                               foreign_items: foreign_items,
                               tasks: touched,
                               index_saved: saved,
                               index_save_failed: save_failed,
                               audit_saved: audit_saved}
    if dirty || orphan_items > 0 || save_failed {
        let summary = "M5 启动对账：修轮次 " + repaired_round.to_string() + " · 权威轮次 " + rounds_fixed.to_string() + " · 重建索引 " + rebuilt_items.to_string() + " · 孤儿 " + orphan_items.to_string() + " · 外来 " + foreign_items.to_string()
        if save_failed {
            STATE.status = summary + " · evidence_index 落盘/读回失败：保持拒绝态，可安全重启重试"
        } else if dirty {
            STATE.status = summary + "（索引已持久化并读回核对；审计见 m5_reconcile_audit.json / 事件 m5_index_reconcile）"
        } else {
            STATE.status = summary + "（无需改写索引；详见审计记录）"
        }
        saveState()
    }
}
fn m5_index_push_attach_item(item){
    if STATE.attach_items == nil { STATE.attach_items = [] }
    STATE.attach_items.push(item)
}
fn m5_index_set_lifecycle(attach_id, lifecycle, target){
    if STATE.attach_items == nil { return }
    let i = 0
    while i < STATE.attach_items.len() {
        let ai = STATE.attach_items[i]
        if ai.attach_id == attach_id {
            ai.lifecycle = lifecycle
            ai.last_updated_ms = nowMs()
            if target != nil && target != "" {
                ai.stored_abs = target
            }
        }
        i = i + 1
    }
}
fn m5_index_get(attach_id){
    if STATE.attach_items == nil { return nil }
    let i = 0
    while i < STATE.attach_items.len() {
        let ai = STATE.attach_items[i]
        if ai.attach_id == attach_id { return ai }
        i = i + 1
    }
    return nil
}
// 重新打开附件：用 stored_abs 当前字节 + fingerprint 校验；
// 不一致则更新 lifecycle=MISSING/CORRUPTED 并写入附件 tab_state。
fn m5_open_attach(attach_id){
    let t = currentTask()
    let tid = ""
    if t != nil { tid = t.id }
    return m5_open_attach_bound(attach_id, tid)
}
fn m5_open_attach_bound(attach_id, expected_task_id){
    let ai = m5_index_get(attach_id)
    if ai == nil {
        return {success: false, reason: "未找到索引（附件可能被清理）", lifecycle: M5_LIFECYCLE_MISSING}
    }
    // D-M5-03 修复：明确归属校验；不接受跨任务 ID 误读
    if expected_task_id != nil && expected_task_id != "" {
        if ai.task_id != expected_task_id {
            return {success: false, reason: "附件归属任务不一致", lifecycle: M5_LIFECYCLE_DENIED}
        }
    }
    if ai.lifecycle == M5_LIFECYCLE_QUARANTINED {
        return {success: false, reason: "附件已隔离", lifecycle: M5_LIFECYCLE_QUARANTINED}
    }
    if ai.lifecycle == M5_LIFECYCLE_DENIED {
        return {success: false, reason: "附件已拒（无权访问）", lifecycle: M5_LIFECYCLE_DENIED}
    }
    let lc = ai.lifecycle
    if lc == M5_LIFECYCLE_SELECTED || lc == M5_LIFECYCLE_SAVING || lc == M5_LIFECYCLE_VERIFYING {
        return {success: false, reason: "附件尚未完成校验", lifecycle: M5_LIFECYCLE_VERIFYING}
    }
    // D-M5-04（r8）：登记路径当前不可读时先按可信相对登记路径重解析；
    // 仍不可读才判 MISSING。
    let _open_exists = false
    try { if fs.exists(ai.stored_abs) { _open_exists = true } } catch { _open_exists = false }
    if !_open_exists {
        let _open_rel = ""
        try { _open_rel = ai.stored_rel } catch { _open_rel = "" }
        let _open_res = m5_resolve_existing(ai.stored_abs, _open_rel)
        if _open_res != "" {
            ai.stored_abs = _open_res
            ai.canonical_abs = _open_res + ".canonical"
        }
    }
    if !fs.exists(ai.stored_abs) {
        ai.lifecycle = M5_LIFECYCLE_MISSING
        m5_save_attach_index_commit()
        return {success: false, reason: "文件已丢失", lifecycle: M5_LIFECYCLE_MISSING}
    }
    let cur_bytes = m5_file_size(ai.stored_abs)
    if cur_bytes != ai.bytes {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "字节数与登记不一致", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    let cur_text = ""
    try { cur_text = fs.read(ai.stored_abs) } catch { cur_text = "" }
    // D-M5-05（r5）：与 canonical 全字节比对是 byte-perfect 校验，不依赖
    // m5_fingerprint 是否能区分非 printable 字节；任一差异即 CORRUPTED。
    let canonical_abs = ai.canonical_abs
    if canonical_abs == nil || canonical_abs == "" {
        canonical_abs = ai.stored_abs + ".canonical"
    }
    if !fs.exists(canonical_abs) {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "缺 canonical 快照", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    let canonical_text = ""
    try { canonical_text = fs.read(canonical_abs) } catch { canonical_text = "" }
    if cur_text != canonical_text {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "存盘与 canonical 不一致", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    let cur_sha = m5_fingerprint(cur_text)
    if cur_sha != ai.sha {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "内容指纹不一致", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    // D-M5-04（r3）：prefix32 / suffix32 二次校验；同长度同指纹但首/尾不同
    // 视为内容已被替换（防御指纹碰撞/算法不严密时的退化路径）。
    let cur_sig = m5_read_content_signature(ai.stored_abs)
    if cur_sig == nil {
        ai.lifecycle = M5_LIFECYCLE_MISSING
        m5_save_attach_index_commit()
        return {success: false, reason: "文件不可读", lifecycle: M5_LIFECYCLE_MISSING}
    }
    if cur_sig.prefix32 != ai.prefix32 || cur_sig.suffix32 != ai.suffix32 {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "内容前缀/后缀不一致", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    ai.lifecycle = M5_LIFECYCLE_READY
    ai.last_verified_ms = nowMs()
    m5_save_attach_index_commit()
    // D-M5-01（r3）：真实内容出口 — 把存盘内容文本、字节、签名打包返回；UI
    // 预览 / 打开 / 下载都从 content 字段取实际值，不再仅返回 reason/lifecycle。
    // 预览用 prefix32 + " … " + suffix32 形式给出首尾锚定，长文件自动压缩。
    let preview = cur_sig.prefix32
    if cur_sig.bytes > 64 { preview = preview + " … " + cur_sig.suffix32 }
    return {success: true, reason: "已重新打开", lifecycle: M5_LIFECYCLE_READY,
            attach_id: attach_id, task_id: ai.task_id,
            name: ai.name, original_name: ai.original_name,
            stored_abs: ai.stored_abs, mime: ai.mime,
            bytes: cur_sig.bytes, sha: cur_sig.sha,
            content: cur_text, content_preview: preview,
            prefix32: cur_sig.prefix32, suffix32: cur_sig.suffix32,
            opened_at: ai.last_verified_ms}
}
// 重新校验：用于 retry / submitCompletion / acceptCompletion。
// D-M5-03 修复：(1) 不再无脑把 lifecycle 升级到 READY；(2) DENIED / 过期
// 状态返回失败而不是 success_flag；(3) 支持 expected_task_id + expected_round 两个
// 维度校验归属 + 轮次一致。1-arg 包装 = 1-arg 调用方兼容；自动注入当前
// 任务 id 作为 expected_task_id，0 作为 expected_round（候选校验）。
fn m5_verify_attach(attach_id){
    let t = currentTask()
    let tid = ""
    if t != nil { tid = t.id }
    return m5_verify_attach_bound(attach_id, tid, 0)
}
// 带强归属 + 强轮次校验的 verify；submitCompletion / acceptCompletion 都走这条
fn m5_verify_attach_bound(attach_id, expected_task_id, expected_round){
    let ai = m5_index_get(attach_id)
    if ai == nil { return {success: false, reason: "未找到索引", lifecycle: M5_LIFECYCLE_MISSING} }
    if expected_task_id != nil && expected_task_id != "" {
        if ai.task_id != expected_task_id {
            return {success: false, reason: "附件归属任务不一致", lifecycle: M5_LIFECYCLE_DENIED}
        }
    }
    // D-M5-03 修复：expected_round=0 也要校验 ai.evidence_round == 0；任何非零
    // 都被视作 stale（"以为已绑但实际未绑"或"以为未绑但实际已绑"）。
    if expected_round != nil {
        if ai.evidence_round != expected_round {
            return {success: false, reason: "附件轮次与待验收轮次不一致", lifecycle: M5_LIFECYCLE_DENIED}
        }
    }
    if ai.lifecycle == M5_LIFECYCLE_QUARANTINED {
        return {success: false, reason: "已隔离", lifecycle: M5_LIFECYCLE_QUARANTINED}
    }
    if ai.lifecycle == M5_LIFECYCLE_DENIED {
        return {success: false, reason: "已拒（无权访问）", lifecycle: M5_LIFECYCLE_DENIED}
    }
    let lc = ai.lifecycle
    if lc == M5_LIFECYCLE_SELECTED || lc == M5_LIFECYCLE_SAVING || lc == M5_LIFECYCLE_VERIFYING {
        return {success: false, reason: "附件尚未完成校验", lifecycle: M5_LIFECYCLE_VERIFYING}
    }
    // D-M5-04（r8）：登记路径当前不可读时先按可信相对登记路径重解析；
    // 仍不可读才判 MISSING。
    let _vf_exists = false
    try { if fs.exists(ai.stored_abs) { _vf_exists = true } } catch { _vf_exists = false }
    if !_vf_exists {
        let _vf_rel = ""
        try { _vf_rel = ai.stored_rel } catch { _vf_rel = "" }
        let _vf_res = m5_resolve_existing(ai.stored_abs, _vf_rel)
        if _vf_res != "" {
            ai.stored_abs = _vf_res
            ai.canonical_abs = _vf_res + ".canonical"
        }
    }
    if !fs.exists(ai.stored_abs) {
        ai.lifecycle = M5_LIFECYCLE_MISSING
        m5_save_attach_index_commit()
        return {success: false, reason: "文件丢失", lifecycle: M5_LIFECYCLE_MISSING}
    }
    let cur_bytes = m5_file_size(ai.stored_abs)
    if cur_bytes != ai.bytes {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "字节不符", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    let cur_text = ""
    try { cur_text = fs.read(ai.stored_abs) } catch { cur_text = "" }
    // D-M5-05（r5）：与 canonical 全字节比对是 byte-perfect 校验，不依赖
    // m5_fingerprint 是否能区分非 printable 字节；任一差异即 CORRUPTED。
    let canonical_abs = ai.canonical_abs
    if canonical_abs == nil || canonical_abs == "" {
        canonical_abs = ai.stored_abs + ".canonical"
    }
    if !fs.exists(canonical_abs) {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "缺 canonical 快照", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    let canonical_text = ""
    try { canonical_text = fs.read(canonical_abs) } catch { canonical_text = "" }
    if cur_text != canonical_text {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "存盘与 canonical 不一致", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    let cur_sha = m5_fingerprint(cur_text)
    if cur_sha != ai.sha {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "指纹不符", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    // D-M5-04（r3）：prefix32 / suffix32 双保险。文件可能被改回相同 sha 但
    // 首尾不同；继续 CORRUPTED 处理。
    let cur_sig = m5_read_content_signature(ai.stored_abs)
    if cur_sig == nil {
        ai.lifecycle = M5_LIFECYCLE_MISSING
        m5_save_attach_index_commit()
        return {success: false, reason: "文件不可读", lifecycle: M5_LIFECYCLE_MISSING}
    }
    if cur_sig.prefix32 != ai.prefix32 || cur_sig.suffix32 != ai.suffix32 {
        ai.lifecycle = M5_LIFECYCLE_CORRUPTED
        m5_save_attach_index_commit()
        return {success: false, reason: "内容前缀/后缀不符", lifecycle: M5_LIFECYCLE_CORRUPTED}
    }
    // 只有到期校验主体匹配 + 状态最终才升级为 READY；DENIED 永不自愈。
    ai.lifecycle = M5_LIFECYCLE_READY
    ai.last_verified_ms = nowMs()
    m5_save_attach_index_commit()
    return {success: true, reason: "已校验", lifecycle: M5_LIFECYCLE_READY}
}
// 校验该任务在指定完工轮次下的所有附件；返回失败原因数组。
fn m5_verify_round(task_id, round){
    let out = {success: true, ok_count: 0, bad: []}
    if STATE.attach_items == nil { return out }
    let i = 0
    while i < STATE.attach_items.len() {
        let ai = STATE.attach_items[i]
        if ai.task_id != task_id { i = i + 1; continue }
        if ai.evidence_round != round { i = i + 1; continue }
        // 必须真实归属于该任务；不属于 = 他人任务。
        let r = m5_verify_attach_bound(ai.attach_id, task_id, round)
        if r.success {
            out.ok_count = out.ok_count + 1
        } else {
            out.success = false
            out.bad.push({attach_id: ai.attach_id, lifecycle: r.lifecycle, reason: r.reason})
        }
        i = i + 1
    }
    return out
}
// 工单级完整性校验：拒绝缺失 / 损坏 / 隔离 / 越权 / 过期轮次。
// D-M5-03 修复：M5 r1 m5_verify_attach 只接受 attach_id，回查 ai 后不核
// task_id，导致跨任务 / DENIED 能放行；混合一好一坏也按"件 ≥ 1 通过"放行。
// 现在 verify 强制三参（attach_id, task_id, round）并要求所有在用证据全部
// 通过；任意一件异常即整轮拒。
fn m5_check_task_round_ready(task, expected_round){
    if task == nil { return {success: false, reason: "任务为空", bad: [], ok_count: 0, total_in_round: 0} }
    let out = {success: true, ok_count: 0, total_in_round: 0, bad: [], stale: []}
    let i = 0
    while i < task.evidence.len() {
        let ev = task.evidence[i]
        if ev.demo { i = i + 1; continue }
        if ev.evidence_round != expected_round {
            if ev.evidence_round > 0 && ev.evidence_round < expected_round {
                out.stale.push({evidence_id: ev.id, evidence_round: ev.evidence_round})
            }
            i = i + 1; continue
        }
        out.total_in_round = out.total_in_round + 1
        // 把 task.id 与 expected_round 同时传入；任何一项对不上都返 DENIED
        let r = m5_verify_attach_bound(ev.id, task.id, expected_round)
        if !r.success {
            out.success = false
            out.bad.push({evidence_id: ev.id, lifecycle: r.lifecycle, reason: r.reason})
        } else {
            out.ok_count = out.ok_count + 1
        }
        i = i + 1
    }
    if out.total_in_round < 1 || out.ok_count != out.total_in_round {
        out.success = false
    }
    return out
}
// 把 demo 占位（bytes==0 / sha==""）清出 t.evidence；boot 时调用一次。
fn m5_drop_legacy_demo_evidence(task){
    if task == nil { return 0 }
    let kept = []
    let dropped = 0
    let i = 0
    while i < task.evidence.len() {
        let ev = task.evidence[i]
        let is_demo = false
        if ev.demo == true { is_demo = true }
        if ev.bytes == 0 && (ev.sha == nil || ev.sha == "") { is_demo = true }
        if is_demo {
            dropped = dropped + 1
        } else {
            kept.push(ev)
        }
        i = i + 1
    }
    task.evidence = kept
    return dropped
}
// 当前任务在 STATE.m5_last_round.by_task 的轮次；按"有新完工提交 + 1"。
fn m5_current_round(task_id){
    if STATE.m5_last_round == nil { STATE.m5_last_round = {by_task: {}} }
    let m = STATE.m5_last_round.by_task
    if m[task_id] == nil { return 0 }
    return m[task_id]
}
fn m5_set_round(task_id, round){
    if STATE.m5_last_round == nil { STATE.m5_last_round = {by_task: {}} }
    STATE.m5_last_round.by_task[task_id] = round
}
// 给当前任务所有 READY 附件绑定 evidence_round；新提交时由 submitCompletion 调用。
// D-M5-04 修复：M5 r1 不收 cand_ids，遍历 t.evidence 全表 → 命令被拒时已绑、
// → 回到初值 0 的字段再次绑回 → 重复轮；D-M5-03 混合证据被其中之一提前绑。
// 现在支持显式 cand_ids；调用方在命令边通过后再传入并落盘。
//
// D-M5-04 修复（r4）：本函数不再写 m5_save_attach_index。原实装在末尾无条件
// 落盘，导致"绑定的同时索引就写出"，与"仅 commit 成功后落索引"承诺不一致。
// 索引写入由调用方（submitCompletion 提交成功后 / 退回失败回滚路径）显式调用。
fn m5_bind_round(task, round, cand_ids){
    if task == nil { return 0 }
    let bound = 0
    let i = 0
    while i < task.evidence.len() {
        let ev = task.evidence[i]
        if ev.demo == true { i = i + 1; continue }
        let in_cand = false
        if cand_ids != nil {
            let j = 0
            while j < cand_ids.len() {
                if cand_ids[j] == ev.id { in_cand = true; break }
                j = j + 1
            }
        }
        if in_cand {
            if ev.lifecycle == M5_LIFECYCLE_READY {
                ev.evidence_round = round
                ev.last_verified_ms = nowMs()
                bound = bound + 1
                // 同步索引（内存中，不落盘）
                if STATE.attach_items != nil {
                    let k = 0
                    while k < STATE.attach_items.len() {
                        let ai = STATE.attach_items[k]
                        if ai.attach_id == ev.id {
                            ai.evidence_round = round
                            ai.last_verified_ms = ev.last_verified_ms
                        }
                        k = k + 1
                    }
                }
            }
        }
        i = i + 1
    }
    // 不在这里调 m5_save_attach_index；调用方控制。
    return bound
}
// D-M5-03 / D-M5-04 修复（r3）：验收以 completion 固化集合为准。
// 旧实现 m5_check_task_round_ready 遍历 task.evidence 中 round 匹配的成员；
// 一旦某成员被从 task.evidence 移除 / 改 round，原固定集合仍要求验收通过，
// 但代码会跳过消失的成员 → 集合被偷偷缩小。本实装：
//   (a) 以 completion.evidence_ids 为不可变引用集合；
//   (b) 对每个 id 显式检查：存在于 attach_items、task_id 一致、当前 round
//       等于 expected_round、lifecycle 处于终态可验、当前存盘字节/前缀/后缀
//       与 completion.evidence_digests[id] 一致；
//   (c) 任一缺失 / 错配 / 内容变化 / lifecycle 异常 → 即 fail；
//   (d) 不再遍历 task.evidence 过滤后取 round 匹配，避免集合被偷换。
fn m5_check_fixed_completion_set(task, completion, expected_round){
    if task == nil { return {success: false, reason: "任务为空", bad: [], ok_count: 0, total_in_round: 0, missing_ids: [], content_changed_ids: []} }
    let out = {success: true, ok_count: 0, total_in_round: 0, bad: [], stale: [], missing_ids: [], content_changed_ids: []}
    let fixed_ids = completion.evidence_ids
    if fixed_ids == nil { return {success: false, reason: "completion 未固化 evidence_ids", bad: [], ok_count: 0, total_in_round: 0, missing_ids: [], content_changed_ids: []} }
    let fixed_digests = completion.evidence_digests
    if fixed_digests == nil { return {success: false, reason: "completion 未固化 evidence_digests", bad: [], ok_count: 0, total_in_round: 0, missing_ids: [], content_changed_ids: []} }
    out.total_in_round = fixed_ids.len()
    if out.total_in_round < 1 { return {success: false, reason: "completion 没有任何证据引用", bad: [], ok_count: 0, total_in_round: 0, missing_ids: [], content_changed_ids: []} }
    let i = 0
    while i < fixed_ids.len() {
        let eid = fixed_ids[i]
        let ai = m5_index_get(eid)
        if ai == nil {
            out.success = false
            out.missing_ids.push(eid)
            out.bad.push({evidence_id: eid, lifecycle: M5_LIFECYCLE_MISSING, reason: "completion 引用了不存在的附件"})
            i = i + 1; continue
        }
        if ai.task_id != task.id {
            out.success = false
            out.bad.push({evidence_id: eid, lifecycle: M5_LIFECYCLE_DENIED, reason: "附件归属任务不一致"})
            i = i + 1; continue
        }
        if ai.evidence_round != expected_round {
            out.success = false
            out.bad.push({evidence_id: eid, lifecycle: M5_LIFECYCLE_DENIED, reason: "附件轮次与待验收轮次不一致"})
            i = i + 1; continue
        }
        if ai.lifecycle == M5_LIFECYCLE_QUARANTINED || ai.lifecycle == M5_LIFECYCLE_DENIED {
            out.success = false
            out.bad.push({evidence_id: eid, lifecycle: ai.lifecycle, reason: "附件被隔离/拒"})
            i = i + 1; continue
        }
        if ai.lifecycle == M5_LIFECYCLE_MISSING || ai.lifecycle == M5_LIFECYCLE_CORRUPTED {
            out.success = false
            out.bad.push({evidence_id: eid, lifecycle: ai.lifecycle, reason: "附件状态异常"})
            i = i + 1; continue
        }
        // D-M5-04（r3）：completion 固化 digest vs 当前存盘 digest 一致性。
        let cur_sig = m5_read_content_signature(ai.stored_abs)
        // 在固定 digests 数组里查找 eid 对应的固化摘要（线性扫描）。
        let bound_bytes = -1
        let bound_sha = ""
        let bound_p32 = ""
        let bound_s32 = ""
        let bound_ver = 0
        let bound_found = false
        let di2 = 0
        while di2 < fixed_digests.len() {
            if fixed_digests[di2].id == eid {
                bound_bytes = fixed_digests[di2].bytes
                bound_sha = fixed_digests[di2].sha
                bound_p32 = fixed_digests[di2].prefix32
                bound_s32 = fixed_digests[di2].suffix32
                bound_ver = fixed_digests[di2].version
                bound_found = true
                break
            }
            di2 = di2 + 1
        }
        if cur_sig == nil {
            out.success = false
            out.bad.push({evidence_id: eid, lifecycle: M5_LIFECYCLE_MISSING, reason: "存盘文件不可读"})
            i = i + 1; continue
        }
        if !bound_found {
            out.success = false
            out.bad.push({evidence_id: eid, lifecycle: M5_LIFECYCLE_CORRUPTED, reason: "completion 未固化此 id 的内容摘要"})
            i = i + 1; continue
        }
        // D-M5-04 (r3): 固化摘要四元组比对，用单一条件 if 链避免 || 跨行翻译为 or 丢冒号。
        let changed = false
        if cur_sig.bytes != bound_bytes { changed = true }
        if cur_sig.sha != bound_sha { changed = true }
        if cur_sig.prefix32 != bound_p32 { changed = true }
        if cur_sig.suffix32 != bound_s32 { changed = true }
        if changed {
            out.success = false
            out.content_changed_ids.push(eid)
            out.bad.push({evidence_id: eid, lifecycle: M5_LIFECYCLE_CORRUPTED, reason: "completion 固化的内容摘要与当前存盘不一致"})
            i = i + 1; continue
        }
        out.ok_count = out.ok_count + 1
        i = i + 1
    }
    if out.ok_count != out.total_in_round { out.success = false }
    return out
}
// 把指定任务的所有 evidence_round 重置为 0（仅在内存中）；用于 commit 失败时
// 回滚已绑定的轮次。D-M5-04（r3）回滚协议的一部分。
fn m5_reset_round_in_memory(task, round){
    if task == nil { return }
    let i = 0
    while i < task.evidence.len() {
        let ev = task.evidence[i]
        if ev.evidence_round == round { ev.evidence_round = 0 }
        i = i + 1
    }
    if STATE.attach_items != nil {
        let k = 0
        while k < STATE.attach_items.len() {
            let a = STATE.attach_items[k]
            if a.task_id == task.id && a.evidence_round == round {
                a.evidence_round = 0
            }
            k = k + 1
        }
    }
}

fn addEvidence(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if !isReporter(t, u) {
        if !isAssignee(t, u) {
            if !isManager(t, u) { fail("只有任务参与者能上传证据"); return }
        }
    }
    if readyCount(t) >= 10 { fail("单任务最多 10 件证据"); return }
    // D-M2-06 修复：证据登记也走命令边界，统一身份 / 版本 / 幂等。
    m5_init_forms()
    let abs_source = ""
    if STATE.draft_attach_path != nil {
        abs_source = STATE.draft_attach_path.abs_source
    }
    if abs_source == "" {
        fail("真实附件需在『附件源路径』输入源文件绝对路径（位于隔离 sandbox inbox 内）")
        return
    }
    let m5 = m5_attach_from_path(t, abs_source, u.id, "user_pasted_path")
    if m5 == nil { return }  // m5_attach_from_path 已经写 STATE.status
    let _ev = t.version
    let id = m5["attach_id"]
    let _params = {task_id: t.id, evidence_id: id, demo: false,
                   lifecycle: m5["lifecycle"], sha: m5["sha"], bytes: m5["bytes"]}
    LAST_KEY = generateStableKey("addEvidence", t, _params, _ev)
    if !runCommandBound("addEvidence", t, _params, _ev) { return }
    // M5：以 t.evidence 形式承载真实 lifecycle 字段；不再使用 demo 占位。
    t.evidence.push({id: id,
                     name: m5["name"],
                     bytes: m5["bytes"],
                     sha: m5["sha"],
                     ready: (m5["lifecycle"] == M5_LIFECYCLE_READY),
                     demo: false,
                     by: u.id,
                     at: nowMs(),
                     lifecycle: m5["lifecycle"],
                     stored_abs: m5["stored_abs"],
                     mime: m5["mime"],
                     evidence_round: 0,         // 0 表示尚未绑定完工轮次
                     version_added: t.version + 1,
                     last_verified_ms: m5["verified_ms"],
                     uploader_id: u.id,
                     note: "M5 真实附件 · lifecycle " + m5["lifecycle"]})
    // 同步进 STATE.attach_items 索引（跨重启重新打开用）。
    m5_index_push_attach_item(m5)
    m5_save_attach_index_commit()
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let log_lifecycle = m5["lifecycle"]
    let _m2_evok = logEvent("upload_evidence", t, {evidence_id: id, ready: (log_lifecycle == M5_LIFECYCLE_READY),
                                    demo: false,
                                    task_id: t.id,
                                    source: m5["source"],
                                    abs_source: abs_source,
                                    sha: m5["sha"], bytes: m5["bytes"],
                                    lifecycle: log_lifecycle,
                                    stored_abs: m5["stored_abs"],
                                    note: "M5 真实附件落盘 + 字节校验"})
    if _m2_evok { STATE.status = "已上传真实附件：" + id + "（lifecycle=" + log_lifecycle + "，sha=" + m5_short(m5["sha"], 12) + "）" }
    saveState()
    refreshLabels(t)
}

fn quarantineEvidence(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let _rp_params = nil
    let _rp_n = t.evidence.len() - 1
    if _rp_n >= 0 { _rp_params = {task_id: t.id, evidence_id: t.evidence[_rp_n].id, reason: "证据不可读"} }
    if m2ReplayAtTop("quarantineEvidence", t, _rp_params, true) { return }
    let u = getMe()
    if !isReporter(t, u) {
        if !isManager(t, u) { fail("只有报修人或经理能隔离证据"); return }
    }
    let n = t.evidence.len() - 1
    if n < 0 { fail("没有可隔离的证据"); return }
    let ev = t.evidence[n]
    // D-M2-06 修复：隔离证据也走命令边界。
    let _ev = t.version
    let _params = {task_id: t.id, evidence_id: ev.id, reason: "证据不可读"}
    LAST_KEY = generateStableKey("quarantineEvidence", t, _params, _ev)
    if !runCommandBound("quarantineEvidence", t, _params, _ev) { return }
    // M5：真实附件隔离 = move 文件到 quarantine/ 子目录；
    // 同时把 lifecycle 字段标记为 QUARANTINED，附加 last_quarantined_at。
    let moved_to = m5_move_to_quarantine(ev)
    ev.ready = false
    ev.lifecycle = M5_LIFECYCLE_QUARANTINED
    ev.last_quarantined_at = nowMs()
    ev.quarantine_target = moved_to
    m5_index_set_lifecycle(ev.id, M5_LIFECYCLE_QUARANTINED, moved_to)
    m5_save_attach_index_commit()
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("quarantine_evidence", t, {evidence_id: ev.id, status: M5_LIFECYCLE_QUARANTINED,
                                        reason: "证据不可读", task_id: t.id,
                                        moved_to: moved_to})
    if _m2_evok { STATE.status = "已隔离证据 " + ev.id + "；已移到 " + moved_to }
    saveState()
    refreshLabels(t)
}

fn submitCompletion(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——AWAITING 状态下重复提交必是重试（cid/round
    // 含 newId 与轮次，fp 无法跨状态重建），回退到最近 final 原结果；
    // IN_PROGRESS（被退回后）允许新轮次提交，不兜底。
    if m2ReplayAtTop("submitCompletion", t, nil, t.status == S_AWAITING) { return }
    if !isAssignee(t, getMe()) { fail("只有当前承接者能提交完工"); return }
    let dropped = m5_drop_legacy_demo_evidence(t)
    if dropped > 0 {
        logEvent("drop_legacy_demo_evidence", t, {dropped: dropped, task_id: t.id})
    }
    m4_init_forms()
    let text = STATE.draft_completion.text
    if text == "" { fail("请在『完工说明』框输入内容；不再使用默认示例"); return }
    if text == "已更换压缩机并清理现场" { fail("完工说明不能为默认示例；请写真实处置结果"); return }
    let disposition = STATE.draft_completion.disposition
    // D-M5-04 修复：先把目标 round / 候选引用集合在门外算好；runCommandBound 通过
    // 之前不消费 m5_last_round，不绑定 evidence_round，不写索引。这样 runCommandBound
    // 拒绝时（命令边界 / 版本冲突 / 锁失败）不留下副作用，retry 仍能命中同一 round。
    let prev_round = m5_current_round(t.id)
    let round = prev_round + 1
    // D-M5-04（r3）：显式复用旧证据 — 用户在 STATE.draft_select.reuse_ids 中
    // 显式勾选的、之前被 rejectCompletion 退回的证据（ev.last_rejected_at != nil）
    // 才能进入候选集；其它一律排除。退回后默认行为 = 旧证据不自动复用。
    let reuse_set = []
    if STATE.draft_select != nil {
        if STATE.draft_select.reuse_ids != nil {
            reuse_set = STATE.draft_select.reuse_ids
        }
    }
    // 收集当前任务上所有非 demo 证据的 verify 结果；任一失败即整轮拒。
    // 这是 D-M5-03 关键守卫：不能因为"至少一件 READY"就忽略其余坏件。
    // D-M5-04（r3）：旧证据若 last_rejected_at != nil 且不在 reuse_set 内，排除。
    let cand_ids = []
    let cand_bad = []
    let skipped_rejected = []
    let i = 0
    while i < t.evidence.len() {
        let ev = t.evidence[i]
        if ev.demo == true { i = i + 1; continue }
        // D-M5-04（r3）：退回过的证据必须显式复用才纳入。
        if ev.last_rejected_at != nil {
            let allowed = false
            let j = 0
            while j < reuse_set.len() {
                if reuse_set[j] == ev.id { allowed = true; break }
                j = j + 1
            }
            if !allowed {
                skipped_rejected.push({evidence_id: ev.id, reason: "上次被退回；需在『补充证据』面板显式勾选才能复用"})
                i = i + 1; continue
            }
        }
        // D-M5-03 修复：三参校验（task 归属 + 轮次 = 0 = 候选）
        let r = m5_verify_attach_bound(ev.id, t.id, 0)
        if r.success {
            cand_ids.push(ev.id)
        } else {
            cand_bad.push({evidence_id: ev.id, lifecycle: r.lifecycle, reason: r.reason})
        }
        i = i + 1
    }
    if cand_ids.len() < 1 {
        let bad_msg = "完工前必须至少有 1 件真实 READY 附件；请上传并通过字节校验"
        let bi = 0
        while bi < cand_bad.len() {
            bad_msg = bad_msg + " · " + cand_bad[bi].evidence_id + "=" + cand_bad[bi].lifecycle + "(" + cand_bad[bi].reason + ")"
            bi = bi + 1
        }
        if skipped_rejected.len() > 0 {
            bad_msg = bad_msg + " · 退回未显式复用=" + str(skipped_rejected.len()) + "件"
        }
        fail(bad_msg)
        return
    }
    if cand_bad.len() > 0 {
        let good_n = cand_ids.len()
        let bad_n = cand_bad.len()
        let bad_msg = "拒绝完工：本任务存在坏证据，必须先处理后再提交（好=" + good_n.to_string() + " · 坏=" + bad_n.to_string() + "）"
        let bi = 0
        while bi < cand_bad.len() {
            bad_msg = bad_msg + " · " + cand_bad[bi].evidence_id + "=" + cand_bad[bi].lifecycle + "(" + cand_bad[bi].reason + ")"
            bi = bi + 1
        }
        fail(bad_msg)
        return
    }
    let cid = newId()
    // D-M5-04（r3）：构造 completion 固化的 evidence_digests（每件证据的
    // {bytes, sha, prefix32, suffix32, version}）。验收时核对固化摘要 vs 当
    // 前存盘摘要；任一不匹配 → fail。固化基于保存时的 content_signature。
    // 用 (id, digest) 对数组而非裸 {} 字面量，避免空 dict 翻译适配问题。
    let digests = []
    let di = 0
    while di < cand_ids.len() {
        let eid = cand_ids[di]
        let ai = m5_index_get(eid)
        let sig_bytes = 0
        let sig_sha = "00000000"
        let sig_p32 = ""
        let sig_s32 = ""
        let sig_ver = 0
        if ai != nil {
            if ai.content_signature != nil {
                sig_bytes = ai.content_signature.bytes
                sig_sha = ai.content_signature.sha
                sig_p32 = ai.content_signature.prefix32
                sig_s32 = ai.content_signature.suffix32
                sig_ver = ai.content_signature.version
            } else {
                sig_bytes = ai.bytes
                sig_sha = ai.sha
                sig_p32 = ai.prefix32
                sig_s32 = ai.suffix32
                sig_ver = ai.version_added
            }
        }
        digests.push({id: eid, bytes: sig_bytes, sha: sig_sha,
                      prefix32: sig_p32, suffix32: sig_s32, version: sig_ver})
        di = di + 1
    }
    // 关键：把 round / bound_count / evidence_ids / evidence_digests 一起作为
    // runCommandBound 参数，让外面 reject / deny 时本函数内部状态完全无副作用
    // （round 不增、绑定不改、索引不写）。
    let _ev = t.version
    let _params = {task_id: t.id, completion_id: cid, completion_text: text,
                   disposition: disposition, evidence_round: round,
                   attached_count: cand_ids.len(), evidence_ids: cand_ids,
                   evidence_digests: digests,
                   proof_pick: STATE.attach_proof_pick}
    LAST_KEY = generateStableKey("submitCompletion", t, _params, _ev)
    if !runCommandBound("submitCompletion", t, _params, _ev) { return }
    // D-M5-04（r3）提交失败回滚：保留 prev_state 快照，commitSucceeded=false
    // 时把 round / 绑定 / completion 全部回退。
    let prev_completions_len = t.completions.len()
    let prev_status = t.status
    // 命令边通过后才落绑定：写索引、设 round、固 evidence_round；副作用集中一处
    let bound = m5_bind_round(t, round, cand_ids)
    m5_set_round(t.id, round)
    t.completions.push({id: cid, round: round, by: sessionActor(), text: text,
                        disposition: disposition, at: nowMs(),
                        evidence_round: round, attached_count: cand_ids.len(),
                        evidence_ids: cand_ids, evidence_digests: digests,
                        proof_pick: STATE.attach_proof_pick})
    t.status = S_AWAITING
    commit(t)
    if !commitSucceeded() {
        // D-M5-04（r3）回滚：内存中 t.completions / t.status / 绑定 / round 复原
        // 到 commit 前；on-disk evidence_index.json 在 commit 失败时也可能半写，
        // 重写一次以反映回滚后的真实状态。
        let kept_completions = []
        let ci = 0
        while ci < prev_completions_len {
            kept_completions.push(t.completions[ci])
            ci = ci + 1
        }
        t.completions = kept_completions
        t.status = prev_status
        m5_set_round(t.id, prev_round)
        m5_reset_round_in_memory(t, round)
        m5_save_attach_index_commit()
        logEvent("submit_completion_rollback", t, {completion_id: cid, task_id: t.id,
                                                  evidence_round: round, reason: "commit 失败"})
        STATE.status = "提交完工失败（commit 返回 false）已回滚；可重试"
        saveState()
        refreshLabels(t)
        return
    }
    // commit 成功后才把索引落盘（含 round / evidence_round / content_signature）。
    // D-M5-04（r5）：如果落盘失败，抑制『完工已提交 → AWAITING_ACCEPTANCE』
    // 的串，改用硬失败状态并落事件。commit 已写盘，任务库是权威事实；
    // D-M5-04（r6）：重启时 m5_reconcile_attach_index 会从 t.evidence 自动
    // 修平索引轮次，不再要求人工重传。
    let saved = m5_save_attach_index_commit()
    if !saved {
        logEvent("save_attach_index_failed", t, {stage: "submit_completion",
                                                 task_id: t.id, completion_id: cid,
                                                 evidence_round: round})
        STATE.status = "commit 已应用但 evidence_index 落盘失败；重启时启动对账将从任务事实自动修平索引"
        saveState()
        refreshLabels(t)
        return
    }
    let _m2_evok = logEvent("submit_completion", t, {completion_id: cid, round: round,
                                      completion_text: text, disposition: disposition,
                                      task_status: S_AWAITING, task_id: t.id,
                                      evidence_round: round,
                                      attached_count: cand_ids.len(),
                                      evidence_ids: cand_ids,
                                      evidence_digests_keys: cand_ids,
                                      proof_pick: STATE.attach_proof_pick})
    if _m2_evok { STATE.status = "完工已提交（round " + round.to_string() + " · 绑定 " + bound.to_string() + " 件证据）→ AWAITING_ACCEPTANCE" }
    // M6：提交完工 → 旧 ACTIVE 提醒失效（同 task_id 同角色）。
    m6_invalidate_for_task(t.id, "submit_completion")
    saveState()
    refreshLabels(t)
}

fn acceptCompletion(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——COMPLETED 状态下重复验收必是重试，回退到
    // 最近 final 原结果；AWAITING（新完工轮次待验）允许新验收，不兜底。
    if m2ReplayAtTop("acceptCompletion", t, nil, t.status == S_COMPLETED) { return }
    let u = getMe()
    if t.assignee == u.id { fail("承接者不能自验，需由报修人或经理验收"); return }
    if !isReporter(t, u) {
        if !isManager(t, u) { fail("只有原报修人或同项目经理能验收"); return }
    }
    // M5：必须存在一份"待验收"的完工记录（来自 submitCompletion）。
    let n = t.completions.len() - 1
    if n < 0 { fail("没有可验收的完工记录"); return }
    let last = t.completions[n]
    let target_round = 0
    if last.evidence_round != nil { target_round = last.evidence_round }
    if target_round < 1 { target_round = m5_current_round(t.id) }
    if target_round < 1 { fail("待验收记录未绑定 evidence_round；不能验收"); return }
    // M5：验收 = 重新核对 completion 固化引用集合（不是当前 task.evidence 过滤后
    // 的集合）。D-M5-03 修复：即便任务 evidence 列表被偷换（成员消失 / round 被
    // 改写），仍以 completion.evidence_ids + completion.evidence_digests 为准；
    // 任一缺失 / 内容变化 / lifecycle 异常 / 越权 / 过期轮次均拒绝。
    let check = m5_check_fixed_completion_set(t, last, target_round)
    if !check.success {
        let msg = "拒绝验收：completion 固定集合校验失败（success_flag=" + check.ok_count.to_string()
                + "/" + check.total_in_round.to_string() + "）"
        if check.missing_ids.len() > 0 {
            msg = msg + " · 丢失成员=" + str(check.missing_ids.len())
        }
        if check.content_changed_ids.len() > 0 {
            msg = msg + " · 内容变化=" + str(check.content_changed_ids.len())
        }
        let k = 0
        while k < check.bad.len() {
            let b = check.bad[k]
            msg = msg + " · " + b.evidence_id + "=" + b.lifecycle + "(" + b.reason + ")"
            k = k + 1
        }
        fail(msg)
        return
    }
    if check.total_in_round < 1 {
        fail("拒绝验收：completion 未固化任何 evidence_ids")
        return
    }
    // M5：所有可验主体必须真实可见（即与 t.reporter / 经理角色 / 主体 cross-check）。
    if !isReporter(t, u) && !isManager(t, u) {
        fail("只有原报修人或同项目经理能验收（防止界面冒名顶替）")
        return
    }
    // M5：经理代验收必须填理由；报修人自验不要理由。
    m5_init_forms()
    let manager_proxy_reason = ""
    if STATE.draft_acceptance_opinion != nil {
        manager_proxy_reason = STATE.draft_acceptance_opinion.manager_proxy_reason
    }
    let reason = ""
    if isManager(t, u) {
        if !isReporter(t, u) {
            if manager_proxy_reason == "" {
                fail("经理代验收必须填写『代验收理由』；不能默认跳过")
                return
            }
            // 防止默认值
            if manager_proxy_reason == "代报修人确认" {
                fail("经理代验收理由不能为默认示例『代报修人确认』；请写明具体原因")
                return
            }
            reason = manager_proxy_reason
        } else {
            reason = "原报修人本人验收"
        }
    } else {
        reason = "原报修人本人验收"
    }
    let _ev = t.version
    LAST_KEY = generateStableKey("acceptCompletion", t, {task_id: t.id, reason: reason,
                                                          evidence_round: target_round}, _ev)
    if !runCommandBound("acceptCompletion", t, {task_id: t.id, reason: reason,
                                                  evidence_round: target_round}, _ev) { return }
    t.status = S_COMPLETED
    // 标记已验收 evidence_round；未来轮次不再引用。
    let ak = 0
    while ak < t.evidence.len() {
        let av = t.evidence[ak]
        if av.evidence_round == target_round {
            av.accepted_round = target_round
            av.accepted_at = nowMs()
            av.accepted_by = u.id
        }
        ak = ak + 1
    }
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    // A-M5-02 修复（r3）：把验收意见与经理代验理由一同写入 accept_completion
    // 事件流，旧 r2 报告『draft_acceptance_opinion.text 未被读取/落账』闭环。
    let accept_opinion = ""
    if STATE.draft_acceptance_opinion != nil {
        accept_opinion = STATE.draft_acceptance_opinion.text
    }
    let _m2_evok = logEvent("accept_completion", t, {status: S_COMPLETED, accepted_round: last.round,
                                      evidence_round: target_round,
                                      evidence_ok_count: check.ok_count,
                                      evidence_total_in_round: check.total_in_round,
                                      content_changed_count: check.content_changed_ids.len(),
                                      missing_count: check.missing_ids.len(),
                                      opinion: accept_opinion,
                                      manager_proxy_reason: manager_proxy_reason,
                                      reason: reason, operator: sessionActor(), task_id: t.id})
    if _m2_evok { STATE.status = "已验收 → COMPLETED（round " + last.round.to_string() + " · 证据 " + check.ok_count.to_string() + "/" + check.total_in_round.to_string() + "）" }
    // M6：验收完成 → 旧 ACTIVE 提醒全部失效。
    m6_invalidate_for_task(t.id, "accept_completion")
    saveState()
    refreshLabels(t)
}

fn rejectCompletion(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M2-02 (r6)：原动作优先——IN_PROGRESS 且已有 final 退回记录时重复
    // 退回必是重试（rejected_round 已就地清零，fp 无法跨状态重建）；
    // AWAITING（新轮次提交后）允许新退回，不兜底。
    if m2ReplayAtTop("rejectCompletion", t, nil, t.status == S_IN_PROGRESS) { return }
    let u = getMe()
    if t.assignee == u.id { fail("承接者不能退回自己的完工"); return }
    if !isReporter(t, u) {
        if !isManager(t, u) { fail("只有原报修人或同项目经理能退回"); return }
    }
    let n = t.completions.len() - 1
    if n < 0 { fail("没有可退回的完工记录"); return }
    let last = t.completions[n]
    m4_init_forms()
    let reason = STATE.draft_reject.reason
    if reason == "" { fail("请在『拒绝原因』框输入内容；不再使用默认示例"); return }
    if reason == "需要补充处理" { fail("退回原因不能为默认示例『需要补充处理』；请写明"); return }
    let _ev = t.version
    let target_round = 0
    if last.evidence_round != nil { target_round = last.evidence_round }
    if target_round < 1 { target_round = m5_current_round(t.id) }
    // D-M5-04 修复：(a) 不再写 m5_set_round(t.id, target_round - 1)；那样会让
    // m5_current_round 倒退，下次提交复用同一 round 把旧附件自动绑回去。
    // 退回当前轮次用『就地把 evidence_round 置 0』即可；current_round 保持，
    // 下次提交会读到 prev+1（新轮次，旧引用要重新核验才可绑定）。
    // (b) 退回对象 = 上一次的 completions 索引 + 其固定 evidence_ids；不覆盖。
    let last_evidence_ids = []
    if last.evidence_ids != nil {
        last_evidence_ids = last.evidence_ids
    }
    let _params = {task_id: t.id, completion_id: last.id, reason: reason,
                   rejected_round: target_round, evidence_ids: last_evidence_ids}
    LAST_KEY = generateStableKey("rejectCompletion", t, _params, _ev)
    if !runCommandBound("rejectCompletion", t, _params, _ev) { return }
    // D-M5-04 修复（r4）：commit 失败回滚 — 先在内存里修改目标值，commit 后
    // 再落盘；如果 commit 失败，把 evidence_round 恢复到 target_round + 清回
    // last_rejected_at，并在 attach_items 上同步。索引写入只在 commit 成功后执行。
    let prev_status = t.status
    t.status = S_IN_PROGRESS
    // 仅清本轮本任务引用 → 0；旧 attachment bytes 不动，索引不删，事件可审计。
    // 先在内存里改（同步 t.evidence 与 STATE.attach_items），记录旧值用于失败恢复。
    // 用平行数组记录改动的下标 + 旧值；rollback 时按相同下标写回。
    let chg_ev_idx = []
    let chg_ev_old_round = []
    let chg_ev_old_rejected = []
    let chg_ai_idx = []
    let chg_ai_old_round = []
    let chg_ai_old_rejected = []
    let rk = 0
    while rk < t.evidence.len() {
        let ev = t.evidence[rk]
        if ev.evidence_round == target_round {
            chg_ev_idx.push(rk)
            chg_ev_old_round.push(ev.evidence_round)
            chg_ev_old_rejected.push(ev.last_rejected_at)
            ev.evidence_round = 0
            ev.last_rejected_at = nowMs()
        }
        rk = rk + 1
    }
    if STATE.attach_items != nil {
        let ai = 0
        while ai < STATE.attach_items.len() {
            let a = STATE.attach_items[ai]
            if a.task_id == t.id && a.evidence_round == target_round {
                chg_ai_idx.push(ai)
                chg_ai_old_round.push(a.evidence_round)
                chg_ai_old_rejected.push(a.last_rejected_at)
                a.evidence_round = 0
                a.last_rejected_at = nowMs()
            }
            ai = ai + 1
        }
    }
    commit(t)
    if !commitSucceeded() {
        // D-M5-04（r4）：reject commit 失败 — 把内存里所有刚改的字段回退到改前；
        // 索引不写盘；UI 只刷新，不留任何半提交副作用。
        t.status = prev_status
        let rj = 0
        while rj < chg_ev_idx.len() {
            let idx = chg_ev_idx[rj]
            let ev = t.evidence[idx]
            let old_round = chg_ev_old_round[rj]
            let old_rejected = chg_ev_old_rejected[rj]
            ev.evidence_round = old_round
            ev.last_rejected_at = old_rejected
            rj = rj + 1
        }
        if STATE.attach_items != nil {
            let ak = 0
            while ak < chg_ai_idx.len() {
                let idx = chg_ai_idx[ak]
                let a = STATE.attach_items[idx]
                let old_round = chg_ai_old_round[ak]
                let old_rejected = chg_ai_old_rejected[ak]
                a.evidence_round = old_round
                a.last_rejected_at = old_rejected
                ak = ak + 1
            }
        }
        logEvent("reject_completion_rollback", t, {completion_id: last.id, task_id: t.id,
                                                  evidence_round: target_round,
                                                  reason: "commit 失败"})
        STATE.status = "退回失败（commit 返回 false）已回滚；可重试"
        saveState()
        refreshLabels(t)
        return
    }
    // commit 成功后再落索引，确保失败重启时索引与任务状态一致。
    // D-M5-04（r5）：如果落盘失败，抑制『已退回 → IN_PROGRESS』的串，改用
    // 硬失败状态并落事件；commit 已写盘（status=IN_PROGRESS），任务库是权威
    // 事实；D-M5-04（r6）：重启时 m5_reconcile_attach_index 会从 t.evidence
    // 自动修平索引轮次与退回标记，不再要求人工重传。
    let saved = m5_save_attach_index_commit()
    if !saved {
        logEvent("save_attach_index_failed", t, {stage: "reject_completion",
                                                 task_id: t.id, completion_id: last.id,
                                                 evidence_round: target_round,
                                                 reason: reason})
        STATE.status = "commit 已应用但 evidence_index 落盘失败；重启时启动对账将从任务事实自动修平索引"
        saveState()
        refreshLabels(t)
        return
    }
    let _m2_evok = logEvent("reject_completion", t, {status: S_IN_PROGRESS, rejected_round: last.round,
                                      evidence_round: target_round,
                                      reason: reason, operator: sessionActor(),
                                      task_id: t.id})
    if _m2_evok { STATE.status = "已退回 → IN_PROGRESS（round " + last.round.to_string() + "）" }
    STATE.m4_invalidations.last_reject = nowMs()
    // M6：退回 → 旧 ACTIVE 提醒全部失效；后续重新提交完工时再登记。
    m6_invalidate_for_task(t.id, "reject_completion")
    saveState()
    refreshLabels(t)
}

fn cancelTask(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if m2ReplayAtTop("cancel", t, {task_id: t.id, reason: "用户取消"}, false) { return }
    let u = getMe()
    let permitted = false
    if isManager(t, u) { permitted = true }
    if isReporter(t, u) {
        if t.status == S_DRAFT { permitted = true }
        if t.status == S_OPEN { permitted = true }
    }
    if !permitted { fail("报修人只能取消自己的 DRAFT/OPEN；其它阶段需经理"); return }
    let _ev = t.version
    LAST_KEY = generateStableKey("cancel", t, {task_id: t.id, reason: "用户取消"}, _ev)
    if !runCommandBound("cancel", t, {task_id: t.id, reason: "用户取消"}, _ev) { return }
    t.status = S_CANCELLED
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED }
        if a.status == A_CONFIRMED { a.status = A_SUPERSEDED }
    }
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("cancel", t, {status: S_CANCELLED, reason: "用户取消", operator: sessionActor(),
                           task_id: t.id})
    if _m2_evok { STATE.status = "已取消 → CANCELLED" }
    // D-M6-02：任务取消要清理所有 ACTIVE 提醒——已取消任务不再需要跟进。
    m6_invalidate_for_task(t.id, "cancel")
    saveState()
    refreshLabels(t)
}

fn reassign(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    m4_init_forms()
    let _rp_params = nil
    if STATE.draft_reassign.new_tech_id != "" { _rp_params = {task_id: t.id, new_assignee: STATE.draft_reassign.new_tech_id, reason: STATE.draft_reassign.reason} }
    if m2ReplayAtTop("reassign", t, _rp_params, false) { return }
    if !isManager(t, getMe()) { fail("只有项目经理能改派"); return }
    // M4：改派对象 + 原因由表单输入（STATE.draft_reassign.new_tech_id +
    // .reason）。原 r3 demo 快捷『u-tech-1 ↔ u-tech-2』删除；用户须通过分配
    // 面板点选新技工。
    m4_init_forms()
    let new_tech_id = STATE.draft_reassign.new_tech_id
    let reason = STATE.draft_reassign.reason
    if new_tech_id == "" { fail("请从『新技工』面板选人；移除快捷『u-tech-1↔u-tech-2』"); return }
    if new_tech_id == t.assignee { fail("新技工与当前承接者相同，无需改派"); return }
    if reason == "" { fail("请在『改派原因』框输入内容；不再使用默认文案『原技工请假』"); return }
    if reason == "原技工请假" { fail("改派原因不能为默认文案『原技工请假』；请写明"); return }
    let target = activeAccount(new_tech_id)
    if target == nil { fail("改派对象不存在"); return }
    if !hasRole(target, t.project, "TECHNICIAN") { fail("改派对象不是本项目有效技工"); return }
    if !skillOk(target, t.category) { fail("改派对象技能不匹配：" + t.category); return }
    let _ev = t.version
    let _params = {task_id: t.id, new_assignee: target.id, reason: reason}
    LAST_KEY = generateStableKey("reassign", t, _params, _ev)
    if !runCommandBound("reassign", t, _params, _ev) { return }
    // 改派让旧技工不再能开工作业；保留 SUPERSEDED 历史与原因。
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED }
        if a.status == A_CONFIRMED { a.status = A_SUPERSEDED }
    }
    t.assignee = target.id
    t.status = S_ACCEPTED
    commit(t)
    if !commitSucceeded() { refreshLabels(t); return }
    let _m2_evok = logEvent("reassign", t, {assignee: target.id, reason: reason,
                             operator: sessionActor(), task_id: t.id,
                             previous_assignee: STATE.draft_reassign._previous_or_empty})
    if _m2_evok { STATE.status = "已改派给 " + target.id + "（任务回 ACCEPTED，原因：" + reason + "）" }
    STATE.m4_invalidations.last_reassign = nowMs()
    // 让相关旧 AI 建议与确认失效（接单 / 改派会触发）
    m4_invalidateConfirmation("reassign")
    // M6：改派 → 旧 ACTIVE 提醒全部失效（包含技工侧的 kickoff_checkin 等）。
    m6_invalidate_for_task(t.id, "reassign")
    saveState()
    refreshLabels(t)
}

fn togglePin(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    // D-M6-04 (r8)：该任务存在未清收藏对账标记（上次保存结果未知）→ 禁止新 key
    // 盲重做；重登/重启会按固定 key 自动对账收敛后再放行。
    if m6_pin_marker_pending_for(t.id) {
        STATE.status = "该任务上次收藏保存结果未知（对账标记未清），禁止盲重做；请重登或重启让对账按固定 key 核对后再操作"
        refreshLabels(t)
        return
    }
    // D-M2-02 (r6)：同向重复点击按 fp 命中原结果；反向（pin→unpin）是合法新意图
    let _rp_found = false
    for _rp_p in t.pinnedBy { if _rp_p == sessionActor() { _rp_found = true } }
    let _rp_action = "pin"
    if _rp_found { _rp_action = "unpin" }
    if m2ReplayAtTop("togglePin", t, {task_id: t.id, by: sessionActor(), action: _rp_action}, false) { return }
    let u = getMe()
    let found = false
    for p in t.pinnedBy {
        if p == u.id { found = true }
    }
    // D-M2-06 / D-M2-02：收藏切走命令边界（身份/版本/幂等检查由 runCommandBound 完成）。
    let _ev = t.version
    let _pin_action_6210 = "pin"
        if found { _pin_action_6210 = "unpin" }
        let _params = {task_id: t.id, by: u.id, action: _pin_action_6210}
    LAST_KEY = generateStableKey("togglePin", t, _params, _ev)
    if !runCommandBound("togglePin", t, _params, _ev) { return }
    // D-M6-04 r4：保存 pinnedBy 快照，用于 m6_save_prefs 失败时回退内存。
    let _pre_pin = []
    let _pi = 0
    while _pi < t.pinnedBy.len() {
        _pre_pin.push(t.pinnedBy[_pi])
        _pi = _pi + 1
    }
    let _pre_status = STATE.status
    if found {
        let kept = []
        for p in t.pinnedBy {
            if p != u.id { kept.push(p) }
        }
        t.pinnedBy = kept
        STATE.status = "已取消收藏"
    } else {
        t.pinnedBy.push(u.id)
        STATE.status = "已收藏（应用首页排序，不宣称系统级置顶窗口）"
    }
    // D-M6-04 (r3 修复轮 + r4 增强 + r5 精确收尾)：偏好不递增业务 version；走 m6_save_prefs()。
    // m6_save_prefs 返回 {state, reason, saved, readback}：
    //   - state="final"：偏好 + state + receipt 都成功，可继续。
    //   - state="needs_verify"：偏好已落盘（saved=true），但读回 / state / receipt
    //     任一异常；不能盲目回滚已落盘业务，仅在 UI 标"待核验"，调用方继续。
    //   - state="unexecuted"：actor 未激活或任务未执行；可回退。
    let _pref = m6_save_prefs()
    let _pref_state = ""
    if _pref != nil { _pref_state = _pref.state }
    if _pref_state == "unexecuted" {
        // 真正未执行：actor 未激活等 → 回退内存（恢复到变更前）
        let _restored = []
        let _ri = 0
        while _ri < _pre_pin.len() {
            _restored.push(_pre_pin[_ri])
            _ri = _ri + 1
        }
        t.pinnedBy = _restored
        STATE.status = _pre_status
        refreshLabels(t)
        return
    }
    if _pref_state == "needs_verify" {
        // D-M6-04 (r7)：精确消费 saved —— 确定未写盘（saved=false）与已写/结果未知分开。
        if _pref.saved == false {
            // 确定未写盘（如 tasks_write_failed）：回退内存变更，显示准确失败，
            // 不能把 saved=false 说成已生效。
            let _restored = []
            let _ri2 = 0
            while _ri2 < _pre_pin.len() {
                _restored.push(_pre_pin[_ri2])
                _ri2 = _ri2 + 1
            }
            t.pinnedBy = _restored
            let _rs = ""
            if _pref.reason != nil { _rs = _pref.reason }
            STATE.status = "收藏未保存：" + _rs + "（已回退，未落盘；可重试）"
            refreshLabels(t)
            return
        }
        // 已落盘（saved=true）但读回/state/receipt 未通过：偏好已生效，不能盲目回滚；
        // 让用户看到"待核验"。状态文本已在 m6_save_prefs 设置；version 不递增。
        if _pref.reason != nil && _pref.reason != "" {
            let _op_label = ""
            if found { _op_label = "取消" } else { _op_label = "添加" }
            STATE.status = "收藏" + _op_label + "已落盘但待核验：" + _pref.reason
        }
        refreshLabels(t)
        return
    }
    // state == "final"：完整成功
    logEvent("toggle_pin", t, {action: _params.action, by: u.id, task_id: t.id})
    saveEvents()
    refreshLabels(t)
}


// ─── 视图辅助 ──────────────────────────────────────────
fn whoLabel(t){
    if t == nil { return "未指派" }
    if t.assignee == nil { return "未指派" }
    return t.assignee
}
fn apptLine(t){
    if t == nil { return "无预约" }
    let c = apptOf(t, A_CONFIRMED)
    if c != nil { return "已确认预约" }
    let p = apptOf(t, A_PROPOSED)
    if p != nil { return "待确认预约" }
    return "无预约"
}
fn statusLine(t){
    if t == nil { return "无选中任务" }
    let dev = "未绑定"
    if t.asset != "" { dev = t.asset }
    return t.id + " · " + t.status + " · 承接 " + whoLabel(t) + " · 设备 " + dev + " · " + apptLine(t)
}
fn detailLine(){
    let t = currentTask()
    if t == nil { return "联系方式：（未选中任务）· 证据 0 件 · 完工轮次 0" }
    let contact = "联系方式：（接单前隐藏）"
    if canSeeContact(t, getMe()) { contact = "联系方式：" + t.contactInfo }
    return contact + " · 证据 " + readyCount(t).to_string()
           + " 件 · 完工轮次 " + t.completions.len().to_string()
}
fn factsLine(){
    return "任务 " + TASKS.len().to_string() + " 条 · 事件 " + EVENT_LOG.len().to_string()
           + " 条（events.jsonl）· 回执 " + RECEIPTS.len().to_string() + " 条（actions.jsonl）"
}

// 在 click handler 闭包内调用：把当前任务卡 / 状态条 / 事实条刷新到最新。
// 不能依赖 fn tick：tick 在另一 isolate 中读取 STATE/TASKS 等全局会读到陈旧值，
// 覆盖 click 刚写入的 label 文本。
let APPLE_REFRESH_STAGE = "not_started"
let APPLE_REFRESH_ERROR_STAGE = ""
fn refreshLabels(taskToShow){
    // One selection source for title, card and action area; no currentTask fallback.
    appleRefreshTaskHeading()
    APPLE_REFRESH_STAGE = "refreshLabels:scope_note"
    ui.scope_note.set_text(filteredVisibleIndices().len().to_string() + " 项任务 · " + m6_unread_follow_ups().len().to_string() + " 条提醒")
    APPLE_REFRESH_STAGE = "refreshLabels:m6_status_label"
    ui.m6_status_label.set_text(appleSidebarStatus())
    APPLE_REFRESH_STAGE = "refreshLabels:fu_banner"
    ui.fu_banner.set_text(m6_followup_banner_text())
    APPLE_REFRESH_STAGE = "refreshLabels:tasks_banner"
    ui.tasks_banner.set_text(m7_tasks_banner_text())
    APPLE_REFRESH_STAGE = "refreshLabels:fu_count"
    ui.fu_count.set_text("")
    if STATE.m6_dev_diag_open == true { ui.m6_diag_label.set_text(m6_diag_text()) }
    else { ui.m6_diag_label.set_text("") }
}

fn runAction(cmd){
    let actor=getMe()
    if actor.id == "" || !hasProjectRole(actor,STATE.project) { fail("身份或项目角色无效；禁止业务操作"); return }
    // M4：移除快捷写死参数。assignTask / bindAsset 现在都从 STATE.draft_assign /
    // draft_bind_asset 读取用户选定；不再向函数内推 u-tech-1 / as-a-1。新动作
    // cancelAppointment / rescheduleAppointmentFromForm 直接调度。
    m4_init_forms()
    if cmd == "confirmDraft" { confirmDraft(); return }
    if cmd == "acceptTask" { acceptTask(); return }
    if cmd == "assignTask" { assignTask(""); return }
    if cmd == "bindAsset" { bindAsset(""); return }
    if cmd == "unbindAsset" { unbindAsset(); return }
    if cmd == "proposeAppointment" { proposeAppointment(); return }
    if cmd == "confirmAppointment" { confirmAppointment(); return }
    if cmd == "rejectAppointment" { rejectAppointment(); return }
    if cmd == "cancelAppointment" { cancelAppointment(); return }
    if cmd == "rescheduleAppointment" { rescheduleAppointmentFromForm(); return }
    if cmd == "startProgress" { startProgress(); return }
    if cmd == "recordProgress" { recordProgress(); return }
    if cmd == "submitCompletion" { submitCompletion(); return }
    if cmd == "acceptCompletion" { acceptCompletion(); return }
    if cmd == "rejectCompletion" { rejectCompletion(); return }
    if cmd == "cancel" { cancelTask(); return }
    if cmd == "reassign" { reassign(); return }
    if cmd == "pin" { togglePin(); return }
    // M5：证据上传 / 隔离 / 预览 / 重试同步等 6 条 dispatch。
    // D-M5-01 修复：M5 r1 仅追加了 m5_openAttach / m5_retryVerify / 两个 sync，
    // 遗漏 addEvidence / quarantineEvidence 的真实分发；UI 上传/隔离按钮落到这
    // 两条后才真正落盘 / 隔离，而不是被 runAction 末尾的 fail("未知动作 ...")
    // 兜底。所有 UI 按钮 → 真实业务动作必须经此处。
    if cmd == "addEvidence" { addEvidence(); return }
    if cmd == "quarantineEvidence" { quarantineEvidence(); return }
    if cmd == "m5_openAttach" { m5_cmd_openAttach(); return }
    if cmd == "m5_retryVerify" { m5_cmd_retryVerify(); return }
    if cmd == "m5_syncAttachPath" { m5_cmd_syncAttachPath(); return }
    if cmd == "m5_syncAcceptOpinion" { m5_cmd_syncAcceptOpinion(); return }
    // M6：桌面体验收口 · 跨模块命令分发（搜索/失效/跳回/取消搜索/开发诊断）。
    if cmd == "m6_search" { m6_cmd_search(); return }
    if cmd == "m6_clearSearch" { m6_cmd_clear_search(); return }
    if cmd == "m6_dismiss" { m6_cmd_dismiss(argOrEmpty("fu_id")); return }
    if cmd == "m6_jump" { m6_cmd_jump(argOrEmpty("task_id")); return }
    if cmd == "m6_invalidate" { m6_cmd_invalidate(argOrEmpty("task_id")); return }
    if cmd == "m6_devDiag" { m6_cmd_dev_diag_toggle(); return }
    if cmd == "m6_recoverKeep" { m6_cmd_recover_keep(); return }
    if cmd == "m6_recoverOverwrite" { m6_cmd_recover_overwrite(); return }
    if cmd == "m6_requestHistory" { m6_cmd_request_history(); return }
    if cmd == "m6_requestPhase" { m6_cmd_request_phase(); return }
    fail("未知动作 " + cmd)
}
// M6 命令分发可能携带 fu_id / task_id 等字符串参数；与原生命令的 enum-only 参数
// 形式区分。新增辅助：从 STATE.m6_cmd_arg_by_run 取单参。
fn argOrEmpty(name){
    let m = STATE.m6_cmd_arg_by_run
    if m == nil { return "" }
    let v = m[name]
    if v == nil { return "" }
    return v
}
// M5 同步：把 TextInput 当前内容同步进 STATE.draft_attach_path.abs_source；
// 按 D-M3-02 同样的「按下动作前 editRawText」模式。
fn m5_cmd_syncAttachPath(){
    m5_init_forms()
    // 调用方在按钮 on_click 内已经走过 editRawText；这里再保险读一次。
    let cur = ""
    if STATE.draft_attach_path != nil { cur = STATE.draft_attach_path.abs_source }
    saveState()
    STATE.status = STATE.status + "（附件路径已同步：len=" + m5_text_len(cur).to_string() + "）"
    saveState()
    refreshDesktop()
}
// M5 同步：把验收意见/经理代验理由同步到 STATE.draft_acceptance_opinion。
fn m5_cmd_syncAcceptOpinion(){
    m5_init_forms()
    saveState()
    refreshDesktop()
}
// M5：打开附件 = 重新读 + 比对 fingerprint；把结果落 STATE.last_open_attach
// 与 ui.tab_state / ui.tab_lines；UI 真实可见 content / preview / bytes。
// D-M5-01 修复（r4）：旧实装只把 r.lifecycle / r.reason 写入 STATE.status，
// 不消费 r.content / r.content_preview，导致 UI 没有实际可读的内容出口。
// 新实装：
//   (1) r.success && content 非空 → STATE.last_open_attach = {attach_id, name,
//       content, content_preview, bytes, sha, stored_abs, lifecycle, reason,
//       opened_at}；
//   (2) 强制刷 attachments tab 的 tab_state / tab_lines 让用户能看到 preview
//       与 bytes；refreshDesktop() 重新调 refreshDetail()。
fn m5_cmd_openAttach(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if t.evidence.len() == 0 { fail("当前任务无证据条目"); return }
    let n = t.evidence.len() - 1
    let ev = t.evidence[n]
    let r = m5_open_attach_bound(ev.id, t.id)
    // D-M5-01（r4）：把 r 完整结果落到 STATE.last_open_attach；UI 通过
    // refreshDetail 在 attachments tab 读 preview / content / bytes / sha。
    STATE.last_open_attach = {attach_id: ev.id, task_id: t.id,
                              name: ev.name, stored_abs: ev.stored_abs,
                              lifecycle: r.lifecycle, reason: r.reason,
                              bytes: r.bytes, sha: r.sha,
                              content_preview: r.content_preview,
                              content: r.content,
                              prefix32: r.prefix32, suffix32: r.suffix32,
                              opened_at: r.opened_at}
    STATE.status = "附件 " + ev.id + " → " + r.lifecycle + "（" + r.reason + "）"
    if r.success { ev.lifecycle = M5_LIFECYCLE_READY } else { ev.lifecycle = r.lifecycle }
    saveState()
    refreshDesktop()
}
// M5：重试验证 = 重新读 + 比对 fingerprint，不变更 lifecycle 除非有问题。
fn m5_cmd_retryVerify(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if t.evidence.len() == 0 { fail("当前任务无证据条目"); return }
    let n = t.evidence.len() - 1
    let ev = t.evidence[n]
    let r = m5_verify_attach_bound(ev.id, t.id, 0)
    STATE.status = "重试 " + ev.id + " → " + r.lifecycle + "（" + r.reason + "）"
    if !r.success { ev.lifecycle = r.lifecycle }
    saveState()
    refreshDesktop()
}

fn setActor(id){ setActorM2(id) }
fn prevTask(){
    stepFiltered(-1)
    saveState()
    refreshLabels(nil)
}
fn nextTask(){
    stepFiltered(1)
    saveState()
    refreshLabels(nil)
}
// ─── 桌面 v2 桌面工作台视图 ─────────────────────────────────────
// 设计基线：design-references/2026-10-08-desktop-v2/DESIGN_SPEC.md（04-graphite 石墨）。
// 布局：顶部栏 76 + 状态条 36 + 主体（左 170 侧栏 / 中 列表 280 / 详情 自适应）+ 底部 32。
// 复用旧 main.splash 的命名 Label（task_status / task_detail / status_line / facts_line），
// 以及 17 个业务命令（confirmDraft/acceptTask/assignTask/bindAsset/unbindAsset/
//   proposeAppointment/confirmAppointment/rejectAppointment/startProgress/recordProgress/
//   addEvidence/quarantineEvidence/submitCompletion/acceptCompletion/rejectCompletion/
//   cancelTask/reassign）+ setActor/prevTask/nextTask/togglePin/createDraft。

// M1 视图状态辅助：以 task_id 为身份选任务；不再用下标。
fn findTaskById(id){
    if id == "" { return nil }
    for t in TASKS {
        if t.id == id { return t }
    }
    return nil
}
fn selectedTask(){
    let t = findTaskById(STATE.selected_task_id)
    if t != nil {
        if visibleToMe(t) { return t }
    }
    return nil
}
fn selectFirstVisibleTask(){
    let idxs = visibleIndices()
    if idxs.len() == 0 {
        STATE.selected_task_id = ""
        STATE.selectedIdx = 0
        return
    }
    let i = idxs[0]
    let t = TASKS[i]
    STATE.selected_task_id = t.id
    STATE.selectedIdx = i
}
fn selectTaskAtVisiblePos(pos){
    let idxs = visibleIndices()
    if idxs.len() == 0 {
        STATE.selected_task_id = ""
        STATE.selectedIdx = 0
        return
    }
    let p = pos
    if p < 0 { p = 0 }
    if p >= idxs.len() { p = idxs.len() - 1 }
    let i = idxs[p]
    let t = TASKS[i]
    STATE.selected_task_id = t.id
    STATE.selectedIdx = i
}
// M1 r2 修复 D-M1-03：在 filtered 列表（filter+nav+search 三层过滤）内按位置选；
// 不再借未筛选 visibleIndices，避免上一/下一条跨过滤错位选中未收藏/未筛选项。
fn selectTaskAtFilteredPos(pos){
    let idxs = filteredVisibleIndices()
    if idxs.len() == 0 {
        STATE.selected_task_id = ""
        STATE.selectedIdx = 0
        return
    }
    let p = pos
    if p < 0 { p = 0 }
    if p >= idxs.len() { p = idxs.len() - 1 }
    let i = idxs[p]
    let t = TASKS[i]
    STATE.selected_task_id = t.id
    STATE.selectedIdx = i
}
fn ensureSelectionVisible(){
    let t = selectedTask()
    if t != nil { return }
    selectFirstVisibleTask()
}

// 筛选 + 搜索作用于列表；不引入第二个事实库。
fn _strContains(haystack, needle){
    // M6 修复：真实子串包含；B-M4-01 (r7) 起走字符语义 _strIndexOf
    // （宿主无 index_of）。needle 为空 = 全匹配。
    if needle == "" { return true }
    if haystack == nil { return false }
    return _strIndexOf(haystack, needle) >= 0
}
fn matchSearch(t, q){
    if q == "" { return true }
    if _strContains(t.problem, q) { return true }
    if _strContains(t.space, q) { return true }
    if _strContains(t.contact, q) { return true }
    if _strContains(t.reporter, q) { return true }
    if t.assignee != nil { if _strContains(t.assignee, q) { return true } }
    if _strContains(t.status, q) { return true }
    if _strContains(t.asset, q) { return true }
    return false
}
fn isDone(t){
    return t.status == T_COMPLETED || t.status == T_CANCELLED
}
fn passesFilter(t){
    let f = STATE.filter
    if f == "active" { return !isDone(t) }
    if f == "done" { return isDone(t) }
    return true
}
fn passesNav(t){
    let n = STATE.nav
    let u = getMe()
    if n == "all" { return true }
    if n == "todo" {
        // 待我处理 = 当前阶段我需要动作（按 DESIGN_SPEC 角色 × 阶段矩阵）
        if !visibleToMe(t) { return false }
        if isDone(t) { return false }
        if isMine(t) {
            if t.status == T_ACCEPTED {
                if apptOf(t, A_PROPOSED) != nil { return true }
                return true
            }
            if t.status == T_SCHEDULED {
                let c = apptOf(t, A_CONFIRMED)
                if c != nil {
                    if nowMs() >= c.startMs { return true }
                    if nowMs() < c.endMs { return true }
                }
                return false
            }
            if t.status == T_INPROG { return true }
            if t.status == T_AWAIT { return false }
        }
        if isReporterMe(t) {
            if t.status == T_DRAFT { return true }
            if apptOf(t, A_PROPOSED) != nil { return true }
            if t.status == T_AWAIT { return true }
        }
        if isMgrU(u) {
            if t.status == T_OPEN { return true }
            if t.status == T_AWAIT { return true }
        }
        return false
    }
    if n == "fav" { return isPinnedByMe(t) }
    return true
}
// 返回过滤后的可见任务在 TASKS 中的下标列表；遵守 FILTER + NAV + SEARCH 三层。
fn filteredVisibleIndices(){
    let u = getMe()
    let out = []
    let q = STATE.search
    for i in 0..TASKS.len() {
        let t = TASKS[i]
        if !visible(t, u) { continue }
        if !passesNav(t) { continue }
        if !passesFilter(t) { continue }
        if !matchSearch(t, q) { continue }
        out.push(i)
    }
    return out
}
// 当前选中在 filtered 列表中的位置（-1 表示不在列表内）
fn selectedFilteredPos(){
    let idxs = filteredVisibleIndices()
    let t = selectedTask()
    if t == nil { return -1 }
    let i = 0
    while i < idxs.len() {
        if TASKS[idxs[i]].id == t.id { return i }
        i = i + 1
    }
    return -1
}
fn stepFiltered(dir){
    let idxs = filteredVisibleIndices()
    if idxs.len() == 0 { selectFirstVisibleTask(); return }
    let pos = selectedFilteredPos()
    let np = 0
    if pos < 0 { np = 0 }
    else { np = pos + dir }
    if np < 0 { np = 0 }
    if np >= idxs.len() { np = idxs.len() - 1 }
    // M1 r2 修复 D-M1-03：np 是 filtered 列表内的位置，必须在 filtered 列表里取
    // task_id，绝不借未筛选 visibleIndices 取位置（会导致上一/下一条跨过滤错位）。
    selectTaskAtFilteredPos(np)
}
// 任务列表最大展示条数，避免 ScrollYView 装载过多按钮；保留 PAGE 切换拉页。
fn pageStartIdx(){
    let per = 8
    return STATE.page * per
}
fn pageEndIdx(total){
    let per = 8
    let s = pageStartIdx()
    let e = s + per
    if e > total { e = total }
    return e
}
fn goPage(dir){
    let total = filteredVisibleIndices().len()
    let per = 8
    let next = STATE.page + dir
    let max_p = (total - 1) / per
    if max_p < 0 { max_p = 0 }
    if next < 0 { next = 0 }
    if next > max_p { next = max_p }
    STATE.page = next
}

// 当前角色 × 当前阶段的主动作 + 次动作。
// 主动作是状态机下一合法命令；次动作最多两个；不可用动作返回原因。
fn mainAction(t, u){
    if t == nil { return {label: "暂无任务", enabled: false, reason: "列表为空"} }
    if isTerminal(t) {
        // M4：终态只读 + 明确原因，桌面阶段、负责人、预约与动作回执一致。
        return {label: "协作记录已归档", enabled: false,
                reason: "任务处于 " + t.status + " 终态；只能查看不能修改（无主动作；拒绝任何写命令）"}
    }
    if t.status == T_DRAFT && isReporterMe(t) {
        return {label: "确认并提交报修", enabled: true, cmd: "confirmDraft", reason: ""}
    }
    if t.status == T_OPEN && isTechU(u) && skillMatchU(u, t.category) {
        return {label: "接下这项维修", enabled: true, cmd: "acceptTask", reason: ""}
    }
    if t.status == T_OPEN && isMgrU(u) {
        return {label: "分配技工（从面板选）", enabled: true, cmd: "assignTask",
                reason: ""}
    }
    if t.status == T_ACCEPTED && apptOf(t, A_PROPOSED) != nil && isReporterMe(t) {
        return {label: "确认到场时间", enabled: true, cmd: "confirmAppointment", reason: ""}
    }
    if t.status == T_ACCEPTED && isMine(t) && t.asset == "" {
        return {label: "先确认维修设备", enabled: false, cmd: "bindAsset",
                reason: "未绑定设备，请先选择空间内的有效设备（不能开工）"}
    }
    if t.status == T_ACCEPTED && isMine(t) {
        return {label: "提议到场时间（填表单）", enabled: true, cmd: "proposeAppointment", reason: ""}
    }
    if t.status == T_SCHEDULED && isMine(t) {
        let c = apptOf(t, A_CONFIRMED)
        if c == nil {
            return {label: "等待预约确认", enabled: false,
                    reason: "无已确认预约；当前 PROPOSED 改约或取消后才能继续"}
        }
        if nowMs() < c.startMs {
            return {label: "尚未到预约时间（只读）", enabled: false,
                    reason: "预约开始时间未到；当前为只读视图"}
        }
        if nowMs() >= c.endMs {
            return {label: "预约已超时（不能开工）", enabled: false,
                    reason: "预约时段已结束；必须重新预约后才能开工"}
        }
        return {label: "按约到场处理 → 开工", enabled: true, cmd: "startProgress", reason: ""}
    }
    if t.status == T_INPROG && isMine(t) {
        return {label: "记录处理进展", enabled: true, cmd: "recordProgress", reason: ""}
    }
    if t.status == T_AWAIT && t.assignee == u.id {
        return {label: "等待他人验收", enabled: false, reason: "承接者不能自验；由报修人或经理验收"}
    }
    if t.status == T_AWAIT && (isReporterMe(t) || isMgrU(u)) {
        return {label: "由你核对维修结果 → 验收", enabled: true, cmd: "acceptCompletion", reason: ""}
    }
    return {label: statusName(t.status), enabled: false, reason: "当前阶段无主动作"}
}
fn secondaryActions(t, u){
    if t == nil { return [] }
    let out = []
    if isTerminal(t) {
        // M4：终态只读；不能绑设备 / 改约 / 取消；只能查看 / 验收历史。
        if t.status == T_COMPLETED {
            out.push({label: "查看历史（已完成）", enabled: false, reason: "终态只读；任何写命令拒绝"})
        }
        if t.status == T_CANCELLED {
            out.push({label: "查看历史（已取消）", enabled: false, reason: "终态只读；任何写命令拒绝"})
        }
        return out
    }
    if t.status == T_DRAFT && isReporterMe(t) {
        out.push({label: "取消草稿", enabled: true, cmd: "cancel"})
        return out
    }
    if t.status == T_OPEN && isTechU(u) {
        if skillMatchU(u, t.category) {
            out.push({label: "技能已匹配，待承接", enabled: false, reason: "无需等待；点主动作接单"})
        }
        return out
    }
    if t.status == T_OPEN && isMgrU(u) {
        out.push({label: "改派（在分配前）", enabled: false,
                  reason: "未承接任务不能改派；请先分配"})
    }
    if t.status == T_ACCEPTED && isMine(t) {
        if t.asset != "" {
            out.push({label: "解绑设备", enabled: true, cmd: "unbindAsset"})
        }
        if apptOf(t, A_PROPOSED) != nil && isMine(t) {
            // 技工可主动改约或取消当前提议
            out.push({label: "改约（填表单）", enabled: true, cmd: "rescheduleAppointment"})
            out.push({label: "取消当前提议", enabled: true, cmd: "cancelAppointment"})
        }
        if apptOf(t, A_PROPOSED) != nil && isReporterMe(t) {
            out.push({label: "拒绝本提议", enabled: true, cmd: "rejectAppointment"})
        }
        return out
    }
    if t.status == T_SCHEDULED {
        if isMine(t) {
            out.push({label: "改约（先取消再提议）", enabled: false,
                      reason: "已确认预约不能直接改约；先取消当前预约再提议新时段"})
            out.push({label: "取消当前预约", enabled: true, cmd: "cancelAppointment"})
        }
        if isMine(t) || isReporterMe(t) || isMgrU(u) {
            out.push({label: "记录处置前预演", enabled: false, reason: "请先按约到场开工"})
        }
        return out
    }
    if t.status == T_INPROG {
        if isMine(t) {
            out.push({label: "上传现场证据", enabled: false,
                      reason: "宿主 picker 不可用；M5 真实附件完工再接"})
            out.push({label: "提交完工", enabled: false,
                      reason: "需先有真实证据到达 READY 状态"})
        }
        return out
    }
    if t.status == T_AWAIT && (isReporterMe(t) || isMgrU(u)) {
        if t.assignee != u.id {
            out.push({label: "退回重做（填原因）", enabled: true, cmd: "rejectCompletion"})
        }
        return out
    }
    // 拒收提议的 m3 接单后也可由报修人 / 经理在 ASSIGNED 但未确认前看到
    if (isReporterMe(t) || isMgrU(u)) && apptOf(t, A_PROPOSED) != nil && !isMine(t) {
        out.push({label: "拒绝本提议", enabled: true, cmd: "rejectAppointment"})
    }
    if !isDone(t) && (isReporterMe(t) || isMgrU(u)) {
        out.push({label: "取消任务", enabled: true, cmd: "cancel"})
    }
    if isMgrU(u) && t.assignee != nil && t.assignee != "" {
        out.push({label: "改派（填表单）", enabled: true, cmd: "reassign"})
    }
    return out
}
// 用于禁用按钮显示原因；不在动作表里也展示给用户。
fn disabledActionReason(t){
    let u = getMe()
    if t == nil { return "无选中任务" }
    if t.project != STATE.project { return "任务不在当前项目范围内" }
    if !visible(t, u) {
        if t.status == T_OPEN && isTechU(u) {
            return "技能与任务类别不匹配（" + categoryName(t.category) + "），等待匹配技工"
        }
        if t.assignee != nil && t.assignee != u.id {
            return "任务已分配给其它技工；当前身份不在可见范围"
        }
        return "当前主体无权限查看此任务；切换身份或项目"
    }
    return ""
}

let T_DRAFT = "DRAFT"
let T_OPEN = "OPEN"
let T_ACCEPTED = "ACCEPTED"
let T_SCHEDULED = "SCHEDULED"
let T_INPROG = "IN_PROGRESS"
let T_AWAIT = "AWAITING_ACCEPTANCE"
let T_COMPLETED = "COMPLETED"
let T_CANCELLED = "CANCELLED"

fn isTerminal(t){
    if t == nil { return false }
    return t.status == T_COMPLETED || t.status == T_CANCELLED
}
fn isMine(t){
    if t == nil { return false }
    return t.assignee == sessionActor()
}
fn isReporterMe(t){
    if t == nil { return false }
    return t.reporter == sessionActor()
}
fn isTechU(user){
    let r = user.roles[STATE.project]
    if r == nil { return false }
    for x in r { if x == "TECHNICIAN" { return true } }
    return false
}
fn isMgrU(user){
    let r = user.roles[STATE.project]
    if r == nil { return false }
    for x in r { if x == "MANAGER" { return true } }
    return false
}
fn skillMatchU(user, category){
    if category == "HVAC_NOT_COOLING" {
        for s in user.skills { if s == "HVAC" { return true } }
        return false
    }
    if category == "ELECTRICAL" {
        for s in user.skills { if s == "ELECTRICAL" { return true } }
        return false
    }
    return true
}
fn visibleToMe(t){
    let u = getMe()
    if t.project != STATE.project { return false }
    if isReporterMe(t) { return true }
    if isMine(t) { return true }
    if isMgrU(u) { return true }
    if isTechU(u) {
        if t.status == T_OPEN { return skillMatchU(u, t.category) }
    }
    return false
}
fn isPinnedByMe(t){
    if t == nil { return false }
    for p in t.pinnedBy { if p == sessionActor() { return true } }
    return false
}
fn categoryName(cat){
    if cat == "HVAC_NOT_COOLING" { return "空调维修" }
    if cat == "ELECTRICAL" { return "电气维修" }
    return cat
}
fn statusName(st){
    if st == T_DRAFT { return "草稿" }
    if st == T_OPEN { return "待接单" }
    if st == T_ACCEPTED { return "已接单" }
    if st == T_SCHEDULED { return "已预约" }
    if st == T_INPROG { return "维修中" }
    if st == T_AWAIT { return "待验收" }
    if st == T_COMPLETED { return "已完成" }
    if st == T_CANCELLED { return "已取消" }
    return st
}
fn stageIndexU(st){
    if st == T_OPEN { return 0 }
    if st == T_ACCEPTED { return 1 }
    if st == T_SCHEDULED { return 2 }
    if st == T_INPROG { return 3 }
    if st == T_AWAIT { return 4 }
    if st == T_COMPLETED { return 5 }
    if st == T_CANCELLED { return 5 }
    if st == T_DRAFT { return -1 }
    return -1
}
fn projectName(){
    if STATE.project == "prj-A" { return "项目 A" }
    if STATE.project == "prj-B" { return "项目 B" }
    return STATE.project
}
fn assetLabel(t){
    if t == nil { return "未绑定" }
    if t.asset == "" { return "未绑定" }
    for a in ASSETS {
        if a.id == t.asset { return a.code + " · " + a.name }
    }
    return t.asset
}
fn whoLabelU(t){
    if t == nil { return "未指派" }
    if t.assignee == nil { return "未指派" }
    return t.assignee
}
fn visibleCount(){
    let n = 0
    for t in TASKS { if visibleToMe(t) { n = n + 1 } } return n
}
fn nextStepTitleU(t){
    if t == nil { return "" }
    if isTerminal(t) { return "协作记录已归档" }
    let u = getMe()
    if t.status == T_DRAFT && isReporterMe(t) { return "确认并提交报修" }
    if t.status == T_OPEN && isTechU(u) {
        if skillMatchU(u, t.category) { return "接下这项维修" }
        return "等待匹配的技工接单"
    }
    if t.status == T_OPEN { return "等待维修人员接单" }
    if t.status == T_ACCEPTED {
        if apptOf(t, A_PROPOSED) != nil {
            if isReporterMe(t) { return "确认到场时间" }
            return "等待报修人确认预约"
        }
        if isMine(t) {
            if t.asset == "" { return "先确认维修设备" }
            return "提议到场时间"
        }
        return "维修人员处理中"
    }
    if t.status == T_SCHEDULED {
        if isMine(t) {
            let appt = apptOf(t, A_CONFIRMED)
            if appt == nil { return "等待预约确认" }
            if nowMs() < appt.startMs { return "尚未到预约时间" }
            return "按约到场处理"
        }
        return "等待维修人员按约到场"
    }
    if t.status == T_INPROG {
        if isMine(t) { return "记录处理进展" }
        return "维修人员处理中"
    }
    if t.status == T_AWAIT {
        if t.assignee == sessionActor() { return "等待他人验收" }
        if isReporterMe(t) || isMgrU(u) { return "由你核对维修结果" }
        return "等待独立验收"
    }
    return statusName(t.status)
}

// 桌面 v2 重算：写入已命名的 Label 槽位（已并入下方完整版 refreshDesktop）。

// 初次进入：保证 selected_task_id 落在可见任务。
// D-M2-01 修复(r7)：_m1_init_selection()/saveState() 移到脚本末尾集中初始化块。

// ─── 浅色控件：普通36、主操作44、输入40；圆角8、显式字体与间距 ──
// 保留既有模板名；AppleLabel 显式控制行距，FormInput 使用浅色输入底。
// Apple presentation tokens: 10.5pt = 14px; line box ~18.2px.
let AppleLabel = Label{width: Fit height: Fit padding: 0 margin: 0 max_lines: 0
    draw_text.color: ink draw_text.text_style.font_size: 10.5 draw_text.text_style.line_spacing: 1.3}
let Bar = ButtonFlat{width: Fit height: 36 padding: Inset{left: 12 right: 12 top: 8 bottom: 8} margin: 0
    draw_bg +: {color: surface color_hover: secondarySurface color_down: #xE5E5EA color_focus: surface color_disabled: canvas
        border_size: 1.0 border_color: border border_color_hover: #xC7C7CC border_color_focus: accent border_color_disabled: border border_radius: 8.0}
    draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink color_disabled: secondary}
    draw_text.text_style.font_size: 10.5 draw_text.text_style.line_spacing: 1.3}
let Acc = Bar{height: 44
    draw_bg +: {color: accent color_hover: accentHover color_down: accentDown color_focus: accentHover color_disabled: secondarySurface border_size: 0.0}
    draw_text +: {color: accentText color_hover: accentText color_down: accentText color_focus: accentText color_disabled: secondary}}
let Danger = Bar{}
let TextBtn = Bar{draw_bg +: {color: canvas color_hover: secondarySurface color_down: #xE5E5EA border_size: 0.0}
    draw_text +: {color: secondary color_hover: ink color_down: ink color_focus: ink}}
let Chip = TextBtn{}
let LinkBtn = TextBtn{padding: Inset{left: 8 right: 8 top: 8 bottom: 8}
    draw_bg +: {color: #x00000000 color_focus: #x00000000 border_size: 0.0}}
let NavRow = LinkBtn{width: Fill height: 36 align: Align{x: 0.0 y: 0.5}
    label_walk: Walk{width: Fill height: Fit} draw_text.color: ink}
let SelectionBg = RoundedView{width: Fill height: Fill visible: false
    draw_bg +: {color: #xE8F2FF border_radius: 6.0}}
let TabBtn = LinkBtn{width: Fill height: 34 padding: Inset{left: 4 right: 4 top: 8 bottom: 8}}

let TaskRowIdle = Bar{width: Fill height: 64 flow: Right{wrap: true} align: Align{x: 0.0 y: 0.5}
    label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {color: #x00000000 color_hover: #xE8F2FF color_down: #xDCEBFF color_focus: #xE8F2FF border_size: 0.0}
    draw_text +: {max_lines: 2 text_overflow: Ellipsis}}
let TaskRowSel = TaskRowIdle{draw_bg +: {color: #xE8F2FF border_size: 1.0 border_color: accent}}
let FormInput = TextInput{width: Fill height: 40 margin: 0 padding: Inset{left: 12 right: 12 top: 8 bottom: 8} empty_text: "请输入内容"
    draw_bg +: {color: surface color_hover: surface color_focus: surface color_down: surface color_empty: surface color_disabled: canvas
        border_size: 1.0 border_color: border border_color_hover: #xC7C7CC border_color_focus: accent border_color_down: accent
        border_color_empty: border border_color_disabled: border border_radius: 8.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_down: ink color_disabled: secondary
        color_empty: secondary color_empty_hover: secondary color_empty_focus: secondary}
    draw_text.text_style.font_size: 10.5 draw_text.text_style.line_spacing: 1.3}

// 任务行文本：使用 UI label max_lines 自然截断（避开字符串索引的低层字节歧义）。
fn _truncate(s, limit){
    if s == nil { return "" }
    return s
}
// 任务列表行按钮的展示文本：用户 · 状态 · 问题摘要。
fn _taskRowText(t, sel){
    let who = "未指派"
    if t.assignee != nil && t.assignee != "" { who = t.assignee }
    return t.problem + "\n" + statusName(t.status) + " · " + who
}
// 构建 task 选中事件：先关包，选中点击落 STATE 后刷屏。
fn _makeRowClick(tid){
    return || {
        STATE.selected_task_id = tid
        STATE.selectedIdx = -1
        let t = findTaskById(tid)
        if t != nil {
            for k in 0..TASKS.len() {
                if TASKS[k].id == tid {
                    STATE.selectedIdx = k
                    break
                }
            }
        }
        saveState()
        refreshDesktop()
    }
}

