                                    m4_submit_bind := Bar{width: Fill text: "绑定设备" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("bindAsset")
                                            refreshDesktop()
                                    }}
                                }
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    m4_submit_reassign := Bar{width: Fill text: "提交改派" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("reassign")
                                            refreshDesktop()
                                    }}
                                    m4_sync_inputs := Bar{width: Fill text: "更新表单内容" on_click: || { m4SyncTextInputs(); refreshDesktop() }}
                                }
                                // ─── 预约 ────
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    m4_submit_propose := Bar{width: Fill text: "提交预约" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("proposeAppointment")
                                            refreshDesktop()
                                    }}
                                    m4_submit_reschedule := Bar{width: Fill text: "提交改约" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("rescheduleAppointment")
                                            refreshDesktop()
                                    }}
                                }
                                // ─── 维修处理 ────
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    m4_submit_progress := Bar{width: Fill text: "记录处置" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("recordProgress")
                                            refreshDesktop()
                                    }}
                                    m4_submit_start_progress := Bar{width: Fill text: "开工" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("startProgress")
                                            refreshDesktop()
                                    }}
                                }
                                // ─── 维修证据与验收 ────
                                m5_attach_actions_label := AppleLabel{width: Fill text: "维修证据与验收" draw_text.color: accent draw_text.text_style.font_size: 10.5}
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    m5_add_btn := Bar{width: Fill text: "上传附件" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("addEvidence")
                                            refreshDesktop()
                                    }}
                                    m5_open_btn := Bar{width: Fill text: "打开/重读附件" on_click: || {
                                            runAction("m5_openAttach")
                                            refreshDesktop()
                                    }}
                                }
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    m4_submit_completion := Bar{width: Fill text: "提交完工" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("submitCompletion")
                                            refreshDesktop()
                                    }}
                                    m5_retry_btn := Bar{width: Fill text: "重试验证" on_click: || {
                                            runAction("m5_retryVerify")
                                            refreshDesktop()
                                    }}
                                }
                                // ─── 危险操作（与主操作分开，独立 Danger 行）────
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    m4_submit_cancel_appt := Danger{width: Fill text: "取消预约" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("cancelAppointment")
                                            refreshDesktop()
                                    }}
                                    m4_submit_reject_appt := Danger{width: Fill text: "拒绝提议" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("rejectAppointment")
                                            refreshDesktop()
                                    }}
                                }
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    m4_submit_reject_completion := Danger{width: Fill text: "退回重做" on_click: || {
                                            m4SyncTextInputs()
                                            runAction("rejectCompletion")
                                            refreshDesktop()
                                    }}
                                    m5_quarantine_btn := Danger{width: Fill text: "隔离证据" on_click: || {
                                            runAction("quarantineEvidence")
                                            refreshDesktop()
                                    }}
                                }
                                m4_history_label := AppleLabel{width: Fill text: "预约与分配变更：" + m4_invalidate_state_text() draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                    Bar{width: Fill text: "◀ 上一条" on_click: || prevTask()}
                                    Bar{width: Fill text: "下一条 ▶" on_click: || nextTask()}
                                    Bar{width: Fit text: "☆ 收藏" on_click: || togglePin()}
                                }
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6

                                    Bar{width: Fit text: "返回概览" on_click: || {
                                            STATE.detail_tab = "overview"
                                            refreshDesktop()
                                    }}
                                }
                                View{width: Fill height: Fit flow: Down spacing: 8
                        // D-M6-03：两既定 AI 链的桌面触发（当前选中任务；不直接写业务）。
                        Chip{width: Fill text: "设备历史建议" on_click: || m6_cmd_request_history()}
                        Chip{width: Fill text: "阶段建议" on_click: || m6_cmd_request_phase()}
                        m6_manual_entry_input := FormInput{width: Fill height: 40 text: "" empty_text: "填写补充说明"}
                        View{width: Fill height: Fit flow: Down spacing: 4
                            Chip{width: Fill text: "存为阶段说明" on_click: || m6_cmd_save_manual_entry("phase")}
                            Chip{width: Fill text: "存为历史备注" on_click: || m6_cmd_save_manual_entry("device")}
                        }
                        View{width: Fill height: Fit visible: false
                            Chip{width: Fill text: "开发诊断" on_click: || m6_cmd_dev_diag_toggle()}
                            m6_diag_label := AppleLabel{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                        }

                                }
                                status_line := AppleLabel{width: Fill text: STATE.status draw_text.color: accent draw_text.text_style.font_size: 10.5 max_lines: 0}

                            }
                        }
                    }
                    SolidView{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{left: 16 right: 16 top: 8 bottom: 8} new_batch: true draw_bg.color: surface
                        action_disabled_reason := AppleLabel{width: Fill height: Fit text: "" draw_text.color: secondary draw_text.text_style.font_size: 10.5 max_lines: 0}
                        View{width: Fill height: Fit flow: Right{wrap: true} spacing: 8
                            secondary_slot_1 := View{width: Fill height: Fit visible: false secondary_action_btn_1 := Bar{width: Fill text: "" on_click: || {
                                        let tt = selectedTask()
                                        if tt == nil { return }
                                        let arr = secondaryActions(tt, getMe())
                                        if arr.len() >= 1 {
                                            let s = arr[0]
                                            if s.enabled {
                                                if s.cmd != "" { runAction(s.cmd) }
                                            } else {
                                                STATE.status = "拒绝：次动作不可用（" + s.reason + "）"
                                                saveState()
                                                refreshDesktop()
                                            }
                                        }
                            }}}
                            secondary_slot_2 := View{width: Fill height: Fit visible: false secondary_action_btn_2 := Bar{width: Fill text: "" on_click: || {
                                        let tt = selectedTask()
                                        if tt == nil { return }
                                        let arr = secondaryActions(tt, getMe())
                                        if arr.len() >= 2 {
                                            let s = arr[1]
                                            if s.enabled {
                                                if s.cmd != "" { runAction(s.cmd) }
                                            } else {
                                                STATE.status = "拒绝：次动作不可用（" + s.reason + "）"
                                                saveState()
                                                refreshDesktop()
                                            }
                                        }
                            }}}
                        }
                        main_action_slot := View{width: Fill height: Fit flow: Right{wrap: true} spacing: 8 visible: false
                            main_action_btn := Acc{width: Fill text: "暂无任务" on_click: || {
                                    let tt = selectedTask()
                                    if tt == nil { return }
                                    let a = mainAction(tt, getMe())
                                    if a.enabled {
                                        if a.cmd != "" { runAction(a.cmd) }
                                    } else {
                                        STATE.status = "拒绝：主动作不可用（" + a.reason + "）"
                                        saveState()
                                        refreshDesktop()
                                    }
                            }}
                        }
                    }
                    }
                }
                draft_editor_page := View{width: Fill height: Fill flow: Down visible: false
                    View{width: Fill height: 64 flow: Right spacing: 12 padding: Inset{left: 16 right: 16 top: 14 bottom: 14} align: Align{y: 0.5}
                        draft_panel_header := AppleLabel{width: Fill text: "新建报修" draw_text.color: ink draw_text.text_style.font_size: 12}
                        LinkBtn{text: "取消" on_click: || {
                                closeDraftPanel()
                                refreshDesktop()
                        }}
                    }
                    ScrollYView{width: Fill height: Fill flow: Down
                        View{width: Fill height: Fit flow: Down spacing: 12 padding: Inset{left: 16 right: 16 top: 12 bottom: 96}

                            draft_input_label := AppleLabel{width: Fill text: "问题描述" draw_text.color: secondary draw_text.text_style.font_size: 9.75}
                            // D-M3-02：TextInput 在宿主内不支持 on_change 事件；
                            // 用 refreshFromTextInput() 在每个按钮按下前重读当前值再 editRawText。
                            // 这样键入后任何"请求 AI 建议 / 设为问题 / 人工确认"都拿到最新原文。
                            zh_input := FormInput{width: Fill height: 112 text: "" empty_text: "请描述故障现象、发生位置和时间"}
                            View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                Bar{text: "请求 AI 建议" on_click: || {
                                        editRawText(ui.zh_input.text())
                                        requestAiSuggestion()
                                        refreshDesktop()
                                }}
                                TextBtn{text: "清空输入" on_click: || {
                                        ui.zh_input.set_text("")
                                        editRawText("")
                                        refreshDesktop()
                                }}
                                TextBtn{text: "取消 AI 请求" on_click: || {
                                        cancelAiRequest()
                                        refreshDesktop()
                                }}
                            }
                            draft_pending_label := AppleLabel{width: Fill text: pendingDraftLabelText() draw_text.color: ink draw_text.text_style.font_size: 10.5 max_lines: 0}
                            ai_state_label := AppleLabel{width: Fill text: aiStateLabelText() draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                            ai_suggestion_label := AppleLabel{width: Fill text: aiSuggestionLabelText() draw_text.color: ink draw_text.text_style.font_size: 9.75 max_lines: 0}
                            input_validation_label := AppleLabel{width: Fill text: inputValidationLabelText() draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                            View{width: Fill height: Fit flow: Right{wrap: true} spacing: 6
                                Bar{text: "采纳 AI 建议" on_click: || {
                                        // D-M3-03 (r5)：采纳前重读输入框 + 完整守卫
                                        // (active / state / 失效标志 / 草稿与原文绑定)。
                                        editRawText(ui.zh_input.text())
                                        let _accept_status = _suggestionAcceptGate()
                                        if _accept_status == "" {
                                            STATE.status = "已采纳 AI 建议；可继续编辑"
                                        } else {
                                            STATE.status = "拒绝采纳：" + _accept_status + " (" + AI_STATE + ")"
                                        }
                                        saveState()
                                        refreshDesktop()
                                }}
                                Bar{text: "设为问题" on_click: || {
                                        // D-M3-02：先用当前 TextInput 文本喂 editRawText，再设 problem
                                        editRawText(ui.zh_input.text())
                                        editDraftField("problem", TASK_INPUT.raw_text)
                                        refreshDesktop()
                                }}

                            }
                            View{width: Fill height: Fit flow: Down spacing: 4
                                draft_space_label := AppleLabel{width: Fill text: "空间：" draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                                // 宿主 View.on_after_apply 只挂载直接子 widget；裸数组（nil 键的
                                // 非 newable 值）被 continue 跳过，原 _sp_chips 整体不挂载 →
                                // 空间选项恒空。改为固定命名槽位，仍只读 SPACES 且按当前项目过滤。
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 4
                                    draft_space_slot_0 := View{width: Fit height: Fit visible: false draft_space_chip_0 := Bar{width: Fit text: "" on_click: || {
                                            let ids = []
                                            for sp in SPACES { if sp.project == STATE.project { ids.push(sp.id) } }
                                            if ids.len() > 0 { editDraftField("space_id", ids[0]); refreshDesktop() }
                                    }}}
                                    draft_space_slot_1 := View{width: Fit height: Fit visible: false draft_space_chip_1 := Bar{width: Fit text: "" on_click: || {
                                            let ids = []
                                            for sp in SPACES { if sp.project == STATE.project { ids.push(sp.id) } }
                                            if ids.len() > 1 { editDraftField("space_id", ids[1]); refreshDesktop() }
                                    }}}
                                    draft_space_slot_2 := View{width: Fit height: Fit visible: false draft_space_chip_2 := Bar{width: Fit text: "" on_click: || {
                                            let ids = []
                                            for sp in SPACES { if sp.project == STATE.project { ids.push(sp.id) } }
                                            if ids.len() > 2 { editDraftField("space_id", ids[2]); refreshDesktop() }
                                    }}}
                                }
                            }
                            View{width: Fill height: Fit flow: Down spacing: 4
                                draft_asset_label := AppleLabel{width: Fill text: "设备：" draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                                // 同空间：固定命名槽位 + 当前项目过滤，避免裸数组被宿主忽略。
                                View{width: Fill height: Fit flow: Right{wrap: true} spacing: 4
                                    draft_asset_slot_0 := View{width: Fit height: Fit visible: false draft_asset_chip_0 := Bar{width: Fit text: "" on_click: || {
                                            let ids = []
                                            for a__row in ASSETS { if a__row.project == STATE.project && a__row.active { ids.push(a__row.id) } }
                                            if ids.len() > 0 { editDraftField("asset_id", ids[0]); refreshDesktop() }
                                    }}}
                                    draft_asset_slot_1 := View{width: Fit height: Fit visible: false draft_asset_chip_1 := Bar{width: Fit text: "" on_click: || {
                                            let ids = []
                                            for a__row in ASSETS { if a__row.project == STATE.project && a__row.active { ids.push(a__row.id) } }
                                            if ids.len() > 1 { editDraftField("asset_id", ids[1]); refreshDesktop() }
                                    }}}
                                    draft_asset_slot_2 := View{width: Fit height: Fit visible: false draft_asset_chip_2 := Bar{width: Fit text: "" on_click: || {
                                            let ids = []
                                            for a__row in ASSETS { if a__row.project == STATE.project && a__row.active { ids.push(a__row.id) } }
                                            if ids.len() > 2 { editDraftField("asset_id", ids[2]); refreshDesktop() }
                                    }}}
                                }
                            }
                            View{width: Fill height: Fit flow: Right{wrap: true} spacing: 4
                                draft_cat_label := AppleLabel{width: Fit text: "类目：" draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                                Bar{width: Fit text: "空调不制冷" on_click: || {
                                        editDraftField("category", "HVAC_NOT_COOLING")
                                        refreshDesktop()
                                }}
                                Bar{width: Fit text: "电气" on_click: || {
                                        editDraftField("category", "ELECTRICAL")
                                        refreshDesktop()
                                }}
                                Bar{width: Fit text: "清空类目" on_click: || {
                                        editDraftField("category", "")
                                        refreshDesktop()
                                }}
                            }
                            View{width: Fill height: Fit flow: Right{wrap: true} spacing: 4
                                draft_contact_label := AppleLabel{width: Fit text: "联系人：" draw_text.color: secondary draw_text.text_style.font_size: 9.75 max_lines: 0}
                                Bar{width: Fit text: "使用当前登录人" on_click: || {
                                        editDraftField("contact", getMe().name)
                                        refreshDesktop()
                                }}
                            }

                            // Full feedback scrolls with the form; the fixed area has a bounded 69-point height.
                            draft_feedback := AppleLabel{width: Fill text: "核对空间、设备、类目和联系人后提交。" draw_text.color: secondary}
                        }
                    }
                    SolidView{width: Fill height: 1 draw_bg.color: border}
                    SolidView{width: Fill height: Fit flow: Down spacing: 0 padding: Inset{left: 16 right: 16 top: 12 bottom: 12} draw_bg.color: surface new_batch: true
                        draft_submit_btn := Acc{width: Fill text: "确认提交报修" on_click: || {
                                // D-M3-02：确认前也要把最新原文 sync 到 TASK_INPUT
                                editRawText(ui.zh_input.text())
                                // D-M3-05 (r9 修复轮，对 r11 Review)：成功文案由
                                // confirmDraftModelBound 按经核验结果的 task_id /
                                // 实际阶段如实设置；此处不凭 currentTask() 或固定
                                // OPEN 文案覆盖，unknown/历史成功不被包装为当前 OPEN。
                                let _submit_ok = confirmDraftModelBound()
                                if !_submit_ok {
                                    STATE.status = "✗ 确认失败：" + AI_LAST_ERROR
                                }
                                saveState()
                                refreshDesktop()
                        }}
                    }
                }
            }
        }
    }
}


// ─── 周期性重算：1Hz 自动重绘命名 Label ───────────────
// M1 r1：补完列表 / 详情 / 行动区刷新；tick 在另一 isolate 内读 STATE/TASKS 仍
// 可能拿到陈旧值，但本实现每条 label 都按需重算，刷新文本而非覆写状态；click
// 闭包内的同步写入仍由 click handler 自己调用 refreshDesktop() 保障。
fn refreshTaskList(){
    let t = selectedTask()
    let idxs = filteredVisibleIndices()
    let total = idxs.len()
    let s = pageStartIdx()
    let e = pageEndIdx(total)
    if e > total { e = total }
    let rows = []
    let k = s
    while k < e {
        let ti = idxs[k]
        let tt = TASKS[ti]
        let sel = false
        if t != nil {
            if t.id == tt.id { sel = true }
        }
        rows.push(_taskRowText(tt, sel))
        k = k + 1
    }
    // 把 rows 写进 list_summary；行 click 由预生成 8 个按钮的 text / on_click 在
    // refreshTaskList 中改成：固定从 idxs[s..e] 读，第 i 个 row 是 tt，若点空行
    // 则忽略。为简化，索引用闭包捕获的整数变量。
    let summary = "共 " + total.to_string() + " 项 · 本页 " + (e - s).to_string() + " 项"
    APPLE_REFRESH_STAGE = "refreshTaskList:list_summary"
    ui.list_summary.set_text(summary)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_0"
    ui.task_row_slot_0.set_visible(rows.len() > 0)
    let selected_0 = false
    if t != nil && rows.len() > 0 { selected_0 = TASKS[idxs[s + 0]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_0"
    ui.task_row_bg_0.set_visible(selected_0)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_1"
    ui.task_row_slot_1.set_visible(rows.len() > 1)
    let selected_1 = false
    if t != nil && rows.len() > 1 { selected_1 = TASKS[idxs[s + 1]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_1"
    ui.task_row_bg_1.set_visible(selected_1)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_2"
    ui.task_row_slot_2.set_visible(rows.len() > 2)
    let selected_2 = false
    if t != nil && rows.len() > 2 { selected_2 = TASKS[idxs[s + 2]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_2"
    ui.task_row_bg_2.set_visible(selected_2)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_3"
    ui.task_row_slot_3.set_visible(rows.len() > 3)
    let selected_3 = false
    if t != nil && rows.len() > 3 { selected_3 = TASKS[idxs[s + 3]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_3"
    ui.task_row_bg_3.set_visible(selected_3)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_4"
    ui.task_row_slot_4.set_visible(rows.len() > 4)
    let selected_4 = false
    if t != nil && rows.len() > 4 { selected_4 = TASKS[idxs[s + 4]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_4"
    ui.task_row_bg_4.set_visible(selected_4)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_5"
    ui.task_row_slot_5.set_visible(rows.len() > 5)
    let selected_5 = false
    if t != nil && rows.len() > 5 { selected_5 = TASKS[idxs[s + 5]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_5"
    ui.task_row_bg_5.set_visible(selected_5)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_6"
    ui.task_row_slot_6.set_visible(rows.len() > 6)
    let selected_6 = false
    if t != nil && rows.len() > 6 { selected_6 = TASKS[idxs[s + 6]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_6"
    ui.task_row_bg_6.set_visible(selected_6)
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_slot_7"
    ui.task_row_slot_7.set_visible(rows.len() > 7)
    let selected_7 = false
    if t != nil && rows.len() > 7 { selected_7 = TASKS[idxs[s + 7]].id == t.id }
    APPLE_REFRESH_STAGE = "refreshTaskList:task_row_bg_7"
    ui.task_row_bg_7.set_visible(selected_7)
    // Only one summary for a single page; inactive directions are non-clickable, dim labels.
    let multiple = total > 8
    let has_prev = multiple && STATE.page > 0
    let has_next = multiple && e < total
    APPLE_REFRESH_STAGE = "refreshTaskList:pagination_prev"
    ui.pagination_prev_slot.set_visible(has_prev)
    APPLE_REFRESH_STAGE = "refreshTaskList:pagination_prev_dim"
    ui.pagination_prev_dim.set_visible(multiple && !has_prev)
    APPLE_REFRESH_STAGE = "refreshTaskList:pagination_next"
    ui.pagination_next_slot.set_visible(has_next)
    APPLE_REFRESH_STAGE = "refreshTaskList:pagination_next_dim"
    ui.pagination_next_dim.set_visible(multiple && !has_next)
    APPLE_REFRESH_STAGE = "refreshTaskList:page_note"
    if multiple {
        let pages = (total + 7 - (total + 7) % 8) / 8
        ui.page_note.set_text("· 第 " + (STATE.page + 1).to_string() + "/" + pages.to_string() + " 页 ·")
    } else { ui.page_note.set_text("共 " + total.to_string() + " 项") }
    // 写 8 行
    let i = 0
    while i < 8 {
        let row = ""
        if i < rows.len() { row = rows[i] }
        let btn = nil
        if i == 0 { btn = ui.task_row_0 }
        if i == 1 { btn = ui.task_row_1 }
        if i == 2 { btn = ui.task_row_2 }
        if i == 3 { btn = ui.task_row_3 }
        if i == 4 { btn = ui.task_row_4 }
        if i == 5 { btn = ui.task_row_5 }
        if i == 6 { btn = ui.task_row_6 }
        if i == 7 { btn = ui.task_row_7 }
        if btn != nil {
            if row == "" {
                btn.set_text(" ")
            } else {
                btn.set_text(row)
            }
        }
        i = i + 1
    }
}

// 用复刻的方式绑定 8 行 row click：把 task_id 数组写进 STATE.list_pick_ids;
// 0..7 → pick_row_0..pick_row_7 取 STATE.list_pick_ids[i] 选中。
fn pick_row_0(){
    let ids = STATE.list_pick_ids
    if ids == nil { return }
    let id = ids[0]
    if id == "" { return }
    STATE.selected_task_id = id
    let k = 0
    while k < TASKS.len() {
        if TASKS[k].id == id { STATE.selectedIdx = k; break }
        k = k + 1
    }
    saveState()
    refreshDesktop()
}
