// M1 r2 修复 D-M1-01：改为共享 detail_panel；按 STATE.detail_tab 写入 5 个命名 Label。
fn refreshDetail(){
    let t = selectedTask()
    let u = getMe()
    let tab = STATE.detail_tab
    if tab != "overview" && tab != "processing" && tab != "attachments"
        && tab != "history" && tab != "phase" && tab != "summary" {
        tab = "overview"
        STATE.detail_tab = "overview"
    }
    // The tab itself indicates selection; keep the legacy named sink empty.
    APPLE_REFRESH_STAGE = "refreshDetail:tab_indicator"
    ui.tab_indicator.set_text("")
    if t == nil {
        ui.tab_title.set_text("")
        ui.tab_summary.set_text("")
        ui.tab_lines.set_text("")
        ui.tab_state.set_text("")
        return
    }
    if tab == "overview" {
        APPLE_REFRESH_STAGE = "refreshDetail:tab_title"
        ui.tab_title.set_text(appleTaskStageText(t))
        let sp = t.space
        let sp_name = ""
        for s in SPACES {
            if s.id == sp { sp_name = s.name }
        }
        APPLE_REFRESH_STAGE = "refreshDetail:tab_summary"
        ui.tab_summary.set_text(appleTaskSummary(t))
        let lines = "问题：" + _truncate(t.problem, 80)
        if sp_name != "" { lines = lines + "\n地点：" + sp_name }
        lines = lines + "\n状态：" + statusName(t.status)
                     + "\n负责人：" + whoLabelU(t) + " · 报修人 " + t.reporter
        APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
        ui.tab_lines.set_text(lines)
        APPLE_REFRESH_STAGE = "refreshDetail:tab_state"
        ui.tab_state.set_text("")
        return
    }
    if tab == "processing" {
        APPLE_REFRESH_STAGE = "refreshDetail:tab_title"
        ui.tab_title.set_text("处理记录（共 " + t.notes.len().to_string() + " 条）")
        APPLE_REFRESH_STAGE = "refreshDetail:tab_summary"
        ui.tab_summary.set_text("处置轨迹 · 按事件写入时间顺序")
        let n = t.notes.len()
        let txt = ""
        if n == 0 {
            txt = "尚无处置记录"
        } else {
            let k = 0
            let lim = 6
            if n < lim { lim = n }
            while k < lim {
                let nt = t.notes[k]
                txt = txt + "\n· " + nt.kind + " · " + _truncate(nt.note, 40) + "（记录人：" + nt.by + "）"
                k = k + 1
            }
            if n > lim { txt = txt + "\n… 共 " + n.to_string() + " 条" }
        }
        APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
        ui.tab_lines.set_text(txt)
        APPLE_REFRESH_STAGE = "refreshDetail:tab_state"
        ui.tab_state.set_text("")
        return
    }
    // M6：阶段说明（静态参考 + m6_history_view 中的模型/人工阶段建议正文）
    if tab == "phase" {
        let pm = applePhaseMeaningText(t)
        APPLE_REFRESH_STAGE = "refreshDetail:tab_title"
        ui.tab_title.set_text("阶段说明 · " + statusName(t.status))
        APPLE_REFRESH_STAGE = "refreshDetail:tab_summary"
        ui.tab_summary.set_text("说明当前阶段的含义与可执行动作（不含机器自动判断根因）")
        // D-M6-03 (r7)：消费 m6_history_view —— 真实模型阶段建议 / 手工说明正文直接渲染；
        // 静态参考显式标注，不与模型建议混同。
        let hv = STATE.m6_history_view
        let body = ""
        // D-M6-03 (r8)：渲染重核 —— 主体/项目/任务事实版本/到期全部通过才显示；
        // 失效缓存显式提示，不静默混同「无建议」。
        if hv != nil && hv.kind == "phase" && m6_history_view_usable(hv, t) && hv.items != nil && hv.items.len() > 0 {
            let hi = 0
            while hi < hv.items.len() {
                let _tag = "模型阶段建议·待人工采纳"
                if hv.items[hi].kind == "manual" { _tag = "手工阶段说明" }
                body = body + "\n· [" + _tag + "] " + hv.items[hi].text + "\n    来源：" + hv.items[hi].source
                hi = hi + 1
            }
            body = body + "\n\n" + pm
        } else {
            if hv != nil && hv.kind == "phase" && hv.task_id == t.id {
                body = pm + "\n（缓存阶段建议已过期或主体/任务已变化，不再显示；请重新请求或手工记录）"
            } else {
                body = pm + "\n（无模型阶段建议；模型不可用或回包被拒时可手工记录）"
            }
        }
        APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
        ui.tab_lines.set_text(body)
        APPLE_REFRESH_STAGE = "refreshDetail:tab_state"
        ui.tab_state.set_text("")
        return
    }
    // M6：任务摘要跳回（同一 task_id，不带他人 grant）
    if tab == "summary" {
        APPLE_REFRESH_STAGE = "refreshDetail:tab_title"
        ui.tab_title.set_text("任务摘要 · " + _truncate(t.problem, 30))
        APPLE_REFRESH_STAGE = "refreshDetail:tab_summary"
        ui.tab_summary.set_text("仅显示当前身份可见的信息；处理记录按时间顺序排列。")
        let ln = m6_summary_lines(t)
        let jt = ""
        let ii = 0
        while ii < ln.len() {
            jt = jt + "\n· " + ln[ii]
            ii = ii + 1
        }
        APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
        ui.tab_lines.set_text(jt)
        APPLE_REFRESH_STAGE = "refreshDetail:tab_state"
        ui.tab_state.set_text("")
        return
    }
    // M6：设备历史（m6_history_view 建议正文 + AI_REQUESTS_LOG 审计依据；无 → 无历史说明未知）
    if tab == "history" {
        let hr = m6_history_render(t)
        APPLE_REFRESH_STAGE = "refreshDetail:tab_title"
        ui.tab_title.set_text("设备历史（建议 + AI 依据）")
        // D-M6-03 (r7)：消费 m6_history_view —— 模型/人工返回的真实建议正文先入视图，
        // 不再只读审计元数据。
        let hv_items = []
        let hv = STATE.m6_history_view
        // D-M6-03 (r8)：渲染重核（同 phase 页）——失效/换主体/换任务的缓存不显示。
        if hv != nil && hv.kind == "device" && m6_history_view_usable(hv, t) && hv.items != nil {
            hv_items = hv.items
        }
        let items_n = hr.items.len()
        APPLE_REFRESH_STAGE = "refreshDetail:tab_summary"
        ui.tab_summary.set_text(hr.note + " · 审计 " + items_n.to_string() + " 条 · 建议 " + hv_items.len().to_string() + " 条")
        if items_n == 0 && hv_items.len() == 0 {
            APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
            ui.tab_lines.set_text("无历史说明未知（没有针对该任务的 AI 请求记录或已返回建议）")
        } else {
            let jt = ""
            let hi2 = 0
            while hi2 < hv_items.len() {
                let _tag2 = "建议·待人工采纳"
                if hv_items[hi2].kind == "manual" { _tag2 = "手工历史备注" }
                jt = jt + "\n· [" + _tag2 + "] " + hv_items[hi2].text + "\n    来源：" + hv_items[hi2].source
                hi2 = hi2 + 1
            }
            let ii = 0
            while ii < hr.items.len() {
                jt = jt + "\n· [审计] " + hr.items[ii].kind + " · " + hr.items[ii].text + "\n    来源：" + hr.items[ii].source
                ii = ii + 1
            }
            APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
            ui.tab_lines.set_text(jt)
        }
        APPLE_REFRESH_STAGE = "refreshDetail:tab_state"
        ui.tab_state.set_text("建议需人工核对和采纳，采纳前不会修改维修任务。")
        return
    }
    // attachments (M5)
    let n2 = t.evidence.len()
    let ready = 0
    let m5_ready = 0
    let m5_bad = 0
    let k = 0
    while k < t.evidence.len() {
        let ev = t.evidence[k]
        if ev.demo == true { k = k + 1; continue }
        if ev.lifecycle != nil {
            if ev.lifecycle == M5_LIFECYCLE_READY { m5_ready = m5_ready + 1 }
            if ev.lifecycle != nil && ev.lifecycle != M5_LIFECYCLE_READY { m5_bad = m5_bad + 1 }
        }
        if ev.ready { ready = ready + 1 }
        k = k + 1
    }
    let cur_round = m5_current_round(t.id)
    APPLE_REFRESH_STAGE = "refreshDetail:tab_title"
    ui.tab_title.set_text("附件（共 " + n2.to_string() + " 条 · 已验证 " + m5_ready.to_string() + " / 异常 " + m5_bad.to_string() + " · 当前轮次 " + cur_round.to_string() + "）")
    APPLE_REFRESH_STAGE = "refreshDetail:tab_summary"
    ui.tab_summary.set_text("只有文件内容验证通过的附件才可作为维修证据。")
    let txt2 = ""
    if n2 == 0 {
        txt2 = "尚无附件登记；请在下方填入 inbox 内绝对路径后点『上传真实附件』。"
    } else {
        let k2 = 0
        let lim = 4
        if n2 < lim { lim = n2 }
        while k2 < lim {
            let ev = t.evidence[k2]
            let lifecycle = ev.lifecycle
            if lifecycle == nil { lifecycle = "UNKNOWN" }
            let round_str = "未登记"
            if ev.evidence_round != nil && ev.evidence_round > 0 { round_str = ev.evidence_round.to_string() }
            let status_line = appleAttachmentStateText(lifecycle) + " · 第 " + round_str + " 轮"
            let nm = _truncate(ev.name, 28)
            txt2 = txt2 + "\n· " + nm + " · " + ev.bytes.to_string() + " B · " + status_line
            k2 = k2 + 1
        }
        if n2 > lim { txt2 = txt2 + "\n… 共 " + n2.to_string() + " 条" }
    }
    // D-M5-01（r4）：把最近一次 m5_cmd_openAttach 的真实内容出口（preview /
    // content / bytes / sha / stored_abs）渲染到 tab_lines 与 tab_state，让
    // UI 不再只看到 lifecycle / reason 状态串。
    if STATE.last_open_attach != nil {
        let lo = STATE.last_open_attach
        let opened_task = ""
        if lo.task_id != nil { opened_task = lo.task_id }
        // 仅当最近打开的附件归属于当前任务时显示（避免上一任务遗留状态串污染）
        if opened_task == t.id {
            let preview = ""
            if lo.content_preview != nil { preview = lo.content_preview }
            let content_full = ""
            if lo.content != nil { content_full = lo.content }
            // tab_lines 已用作附件列表；preview 单独附加到 tab_state 上半部
            // （tab_state 默认显示 inbox_hint，preview 段落拼到 hint 之前）。
            let attach_panel = "最近打开：" + lo.attach_id + " · " + appleAttachmentStateText(lo.lifecycle)
                              + " · 大小 " + lo.bytes.to_string() + " B · 校验值 " + lo.sha + "\n"
                              + "预览：" + preview + "\n"
                              + "落盘：" + lo.stored_abs + "\n"
                              + "完整内容（" + lo.bytes.to_string() + " B）：\n" + content_full
            APPLE_REFRESH_STAGE = "refreshDetail:tab_state"
            ui.tab_state.set_text(attach_panel + "\n\n" + m5_inbox_hint_text())
            APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
            ui.tab_lines.set_text(txt2)
            return
        }
    }
    APPLE_REFRESH_STAGE = "refreshDetail:tab_lines"
    ui.tab_lines.set_text(txt2)
    APPLE_REFRESH_STAGE = "refreshDetail:tab_state"
    ui.tab_state.set_text(m5_inbox_hint_text())
}

fn refreshActionArea(){
    let t = selectedTask()
    let u = getMe()
    if t == nil {
        APPLE_REFRESH_STAGE = "refreshActionArea:main_action_btn"
        ui.main_action_btn.set_text("暂无任务")
        APPLE_REFRESH_STAGE = "refreshActionArea:action_disabled_reason"
        ui.action_disabled_reason.set_text("")
        APPLE_REFRESH_STAGE = "refreshActionArea:secondary_action_btn_1"
        ui.secondary_action_btn_1.set_text("")
        APPLE_REFRESH_STAGE = "refreshActionArea:secondary_action_btn_2"
        ui.secondary_action_btn_2.set_text("")
        return
    }
    let a = mainAction(t, u)
    APPLE_REFRESH_STAGE = "refreshActionArea:main_action_btn"
    ui.main_action_btn.set_text(a.label)
    if !a.enabled {
        APPLE_REFRESH_STAGE = "refreshActionArea:action_disabled_reason"
        ui.action_disabled_reason.set_text("原因：" + a.reason)
    } else {
        let extra = disabledActionReason(t)
        if extra == "" {
            APPLE_REFRESH_STAGE = "refreshActionArea:action_disabled_reason"
            ui.action_disabled_reason.set_text("")
        } else {
            APPLE_REFRESH_STAGE = "refreshActionArea:action_disabled_reason"
            ui.action_disabled_reason.set_text("提示：" + extra)
        }
    }
    let sec = secondaryActions(t, u)
    let s1 = ""
    let s2 = ""
    if sec.len() >= 1 {
        let x = sec[0]
        if x.label == nil { x.label = "" }
        if x.enabled { s1 = x.label }
        else { s1 = x.label + " · 不可用" }
    }
    if sec.len() >= 2 {
        let x = sec[1]
        if x.label == nil { x.label = "" }
        if x.enabled { s2 = x.label }
        else { s2 = x.label + " · 不可用" }
    }
    APPLE_REFRESH_STAGE = "refreshActionArea:secondary_action_btn_1"
    ui.secondary_action_btn_1.set_text(s1)
    APPLE_REFRESH_STAGE = "refreshActionArea:secondary_action_btn_2"
    ui.secondary_action_btn_2.set_text(s2)
}

// 维护 STATE.list_pick_ids（每次 tick 写）
fn refreshListPickIds(){
    let idxs = filteredVisibleIndices()
    let total = idxs.len()
    let s = pageStartIdx()
    let e = pageEndIdx(total)
    if e > total { e = total }
    let ids = []
    let k = 0
    while k < 8 {
        if k < (e - s) {
            let ti = idxs[s + k]
            let tt = TASKS[ti]
            ids.push(tt.id)
        } else {
            ids.push("")
        }
        k = k + 1
    }
    STATE.list_pick_ids = ids
}

// View::script_call implements set_visible(bool) in the pinned host; see APPLE_HOST_EVIDENCE.
// Containers retain their children, so every original ui.<id> stays uniquely addressable.

// r2 display adapters: never mutate AUTH, SESSION, STATE or task facts.
fn appleAuthText(){
    if AUTH_JOB != nil {
        let rounds = AUTH_JOB.round
        let percent = (rounds * 100 - (rounds * 100) % AUTH_ROUNDS) / AUTH_ROUNDS
        if rounds == AUTH_ROUNDS { return "正在登录… 100%\n4096 / 4096 轮，正在最终核验" }
        return "正在登录… " + percent.to_string() + "%\n已完成 " + rounds.to_string() + " / 4096 轮"
    }
    if AUTH_STATUS == "请登录；身份不可用时禁止业务写入" || AUTH_STATUS == "请输入账号 ID 与口令" { return "请输入账号和口令" }
    return AUTH_STATUS
}
fn appleFeedbackText(message){
    // Translate a generated AI-state suffix only; never rewrite task titles/data.
    let idle_at = _strIndexOf(message, " (IDLE)")
    if idle_at > 0 { return "尚未请求 AI 建议，请先请求建议后再采纳。" }
    return message
}
fn applePhaseMeaningText(t){
    // Keep the original explanation and its static-reference attribution; omit enum names.
    let parts = m6_phase_meaning(t).split("：")
    if parts.len() == 2 { return "阶段说明（静态参考）：" + parts[1] }
    return m6_phase_meaning(t)
}
fn appleAttachmentStateText(value){
    if value == "READY" { return "已验证" }
    if value == "MISSING" { return "文件缺失" }
    if value == "CORRUPTED" { return "文件校验失败" }
    if value == "QUARANTINED" { return "已隔离" }
    if value == "DENIED" { return "无访问权限" }
    if value == "SELECTED" { return "已选择" }
    if value == "SAVING" { return "正在保存" }
    if value == "VERIFYING" { return "正在验证" }
    return "状态未知"
}
fn appleEmptySelectionText(){
    if filteredVisibleIndices().len() == 0 { return "可新建报修，或调整筛选条件" }
    return "从左侧列表选择一项任务"
}
fn appleTaskStageText(t){
    if t.status == "DRAFT" { return "草稿 · 待提交" }
    return statusName(t.status)
}
fn appleTaskSummary(t){
    let text = statusName(t.status) + " · " + whoLabelU(t)
    let device = assetLabel(t)
    if device != nil && device != "" { text = text + " · 设备 " + device }
    return text
}
fn appleRefreshTaskHeading(){
    let t = selectedTask()
    if t == nil {
        APPLE_REFRESH_STAGE = "appleRefreshTaskHeading:task_status"
        ui.task_status.set_text("")
        APPLE_REFRESH_STAGE = "appleRefreshTaskHeading:task_detail"
        ui.task_detail.set_text("")
        return
    }
    APPLE_REFRESH_STAGE = "appleRefreshTaskHeading:task_status"
    ui.task_status.set_text(t.problem)
    let text = statusName(t.status) + " · " + whoLabel(t)
    if canSeeContact(t, getMe()) {
        if t.contactInfo != nil && t.contactInfo != "" { text = text + " · 联系方式：" + t.contactInfo }
    } else { text = text + " · 联系方式接单后可见" }
    text = text + " · 证据 " + readyCount(t).to_string() + " 件"
    APPLE_REFRESH_STAGE = "appleRefreshTaskHeading:task_detail"
    ui.task_detail.set_text(text)
}
fn appleSidebarStatus(){
    if STATE.tasks_pending_recovery == true || STATE.m6_followups_pending_recovery == true || STATE.m6_followups_dirty == true { return m6_status_label_text("nav") }
    if filteredVisibleIndices().len() == 0 { return "当前列表为空，可调整筛选。" }
    return ""
}
fn appleRefreshPresentation(){
    let task = selectedTask()
    APPLE_REFRESH_STAGE = "appleRefreshPresentation:m4_device_label"
    ui.m4_device_row.set_visible(true)
    ui.m4_device_label.set_text(m4_asset_state_text(task))
    APPLE_REFRESH_STAGE = "appleRefreshPresentation:m4_device_state_label"
    ui.m4_device_state_row.set_visible(false)
    ui.m4_device_state_label.set_text("")
    APPLE_REFRESH_STAGE = "appleRefreshPresentation:m4_assign_label"
    ui.m4_assign_label.set_text(m4_assign_state_text(task))
    // 预约表单（年/月/日/开始/结束）与处置类别：固定命名槽位填值（裸数组在宿主不挂载）。
    APPLE_REFRESH_STAGE = "appleRefreshPresentation:m4_appt_option_chips"
