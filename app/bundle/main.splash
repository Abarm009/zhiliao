// OctoSense Repair · 石墨主题维修协作工作台（Hub 脚本应用 / 修复版）
//
// 2026-10-06 修复（针对 N1/N2）：
//   - 取消 ScrollYView：固定版本宿主不实例化被裁剪的内容，所有 21 个动作按钮
//     改为单页紧凑布局，412×819 内全部可见。
//   - 添加 fn tick()：1Hz 自动重算 task_status / status / facts 三个 Label；
//     修复 N1「点击后界面不重绘」。
//   - 使用 name := Label{} 命名关键 Label，按钮点击后通过 ui.<name>.set_text(...)
//     直接更新对应文字；不依赖宿主对内联表达式重算。
//   - 用 `count = count + 1` 而非 `count += 1`，避免闭包赋值歧义（已用最小探针
//     确认复合赋值在 on_click 闭包内不生效）。
//
// 权威事实在本应用自己的宿主隔离存储里：
//   tasks.json     任务、预约、证据索引、完工轮次
//   actions.jsonl  命令回执（幂等键 + 指纹）
//   events.jsonl   事件流（含 task_id 与真实时间）
// 关闭重开后由 load() 回读。它不在本机拉起服务、不访问 127.0.0.1、不请求公网地址。
//
// 规则与后端 Python 领域核心一致。

let ink = #xE8F2EE
let secondary = #x8FA5A0
let surface = #x1F2D2F
let secondarySurface = #x2A3D3F
let accent = #x7DD3B0
let accentText = #x0E2920
let border = #x3E5A5C
let danger = #xF2A697
let heroBg = #x23393B

let S_DRAFT = "DRAFT"
let S_OPEN = "OPEN"
let S_ACCEPTED = "ACCEPTED"
let S_SCHEDULED = "SCHEDULED"
let S_IN_PROGRESS = "IN_PROGRESS"
let S_AWAITING = "AWAITING_ACCEPTANCE"
let S_COMPLETED = "COMPLETED"
let S_CANCELLED = "CANCELLED"
let A_PROPOSED = "PROPOSED"
let A_CONFIRMED = "CONFIRMED"
let A_SUPERSEDED = "SUPERSEDED"

let MIN_MS = 900000
let MAX_MS = 14400000
let LEAD_MS = 2592000000
let PROPOSAL_MS = 86400000

let STATE = {actor: "u-reporter-1", project: "prj-A", selectedIdx: 0, status: "准备就绪"}
let TASKS = []
let RECEIPTS = []
let EVENT_LOG = []
let LAST_KEY = ""
let ID_SEQ = 0

let USERS = [
    {id: "u-reporter-1", name: "报修人一", roles: {"prj-A": ["REPORTER"]}, skills: []},
    {id: "u-reporter-2", name: "报修人二", roles: {"prj-B": ["REPORTER"]}, skills: []},
    {id: "u-tech-1", name: "技工甲（HVAC）", roles: {"prj-A": ["TECHNICIAN"]}, skills: ["HVAC"]},
    {id: "u-tech-2", name: "技工乙（电气）", roles: {"prj-A": ["TECHNICIAN"], "prj-B": ["TECHNICIAN"]}, skills: ["ELECTRICAL"]},
    {id: "u-manager", name: "经理丙", roles: {"prj-A": ["MANAGER"]}, skills: []}
]
let SPACES = [
    {id: "sp-a-1", project: "prj-A", name: "东侧会议室"},
    {id: "sp-a-2", project: "prj-A", name: "东侧走廊"},
    {id: "sp-a-3", project: "prj-A", name: "配电间"}
]
let ASSETS = [
    {id: "as-a-1", project: "prj-A", code: "AC-001", name: "会议室空调", category: "HVAC_NOT_COOLING", services: ["sp-a-1"], active: true},
    {id: "as-a-2", project: "prj-A", code: "PWR-001", name: "强电箱", category: "ELECTRICAL", services: ["sp-a-3"], active: true},
    {id: "as-a-3", project: "prj-A", code: "EXH-001", name: "新风机", category: "HVAC_NOT_COOLING", services: ["sp-a-1", "sp-a-2"], active: true}
]

// ─── 基础 ───────────────────────────────────────────────
fn nowMs(){ floor(time_now() * 1000.0) }
fn newId(){
    ID_SEQ = ID_SEQ + 1
    return nowMs().to_string() + "-" + ID_SEQ.to_string() + "-" + STATE.actor
}
fn pickUser(list, id){
    for it in list {
        if it.id == id { return it }
    }
    return nil
}
fn getMe(){
    let u = pickUser(USERS, STATE.actor)
    if u == nil { return {id: STATE.actor, name: STATE.actor, roles: {}, skills: []} }
    return u
}
fn hasRole(user, project, role){
    let r = user.roles[project]
    if r == nil { return false }
    for x in r {
        if x == role { return true }
    }
    return false
}
fn skillOk(user, category){
    if category == "HVAC_NOT_COOLING" {
        for s in user.skills {
            if s == "HVAC" { return true }
        }
        return false
    }
    if category == "ELECTRICAL" {
        for s in user.skills {
            if s == "ELECTRICAL" { return true }
        }
        return false
    }
    return true
}
fn isReporter(t, u){ u.id == t.reporter }
fn isAssignee(t, u){
    if t.assignee == nil { return false }
    return t.assignee == u.id
}
fn isManager(t, u){ hasRole(u, t.project, "MANAGER") }
fn visible(t, u){
    if t.project != STATE.project { return false }
    if isReporter(t, u) { return true }
    if isAssignee(t, u) { return true }
    if isManager(t, u) { return true }
    if hasRole(u, t.project, "TECHNICIAN") {
        if t.status == S_OPEN {
            return skillOk(u, t.category)
        }
    }
    return false
}
fn canSeeContact(t, u){
    if isReporter(t, u) { return true }
    if isAssignee(t, u) { return true }
    return isManager(t, u)
}
fn services(assetId, spaceId){
    let a = pickUser(ASSETS, assetId)
    if a == nil { return false }
    for s in a.services {
        if s == spaceId { return true }
    }
    return false
}
fn readyCount(t){
    let n = 0
    for e in t.evidence {
        if e.ready { n = n + 1 }
    }
    return n
}
fn apptOf(t, status){
    for a in t.appointments {
        if a.status == status { return a }
    }
    return nil
}
fn sourceOk(cmd, t){
    let s = t.status
    if cmd == "confirmDraft" { return s == S_DRAFT }
    if cmd == "acceptTask" { return s == S_OPEN }
    if cmd == "assignTask" { return s == S_OPEN }
    if cmd == "proposeAppointment" { return s == S_ACCEPTED || s == S_SCHEDULED }
    if cmd == "confirmAppointment" { return s == S_ACCEPTED || s == S_SCHEDULED }
    if cmd == "rejectAppointment" { return s == S_ACCEPTED || s == S_SCHEDULED }
    if cmd == "startProgress" { return s == S_SCHEDULED }
    if cmd == "recordProgress" { return s == S_IN_PROGRESS }
    if cmd == "submitCompletion" { return s == S_IN_PROGRESS }
    if cmd == "acceptCompletion" { return s == S_AWAITING }
    if cmd == "rejectCompletion" { return s == S_AWAITING }
    if cmd == "cancel" {
        if s == S_DRAFT { return true }
        if s == S_OPEN { return true }
        if s == S_ACCEPTED { return true }
        if s == S_SCHEDULED { return true }
        if s == S_IN_PROGRESS { return true }
        return false
    }
    if cmd == "reassign" {
        if s == S_ACCEPTED { return true }
        if s == S_SCHEDULED { return true }
        return false
    }
    if cmd == "bindAsset" {
        if s == S_COMPLETED { return false }
        if s == S_CANCELLED { return false }
        return true
    }
    if cmd == "unbindAsset" {
        if s == S_COMPLETED { return false }
        if s == S_CANCELLED { return false }
        return true
    }
    return false
}

// ─── 持久化 ─────────────────────────────────────────────
// 全部以「整体 JSON 数组」覆盖式写入；文件名后缀只是历史习惯。
// 重启后 load() 一次 parse_json 即可恢复；旧版逐行 JSONL 数据走 split 兜底解析。
fn saveState(){ fs.write("state.json", STATE.to_json()) }
fn saveTasks(){ fs.write("tasks.json", TASKS.to_json()) }
fn saveReceipts(){ fs.write("actions.jsonl", RECEIPTS.to_json()) }
fn saveEvents(){ fs.write("events.jsonl", EVENT_LOG.to_json()) }
fn logEvent(kind, t, after){
    let entry = {at: nowMs(), kind: kind, actor: STATE.actor, task_id: t.id,
                 task_version: t.version, after: after}
    EVENT_LOG.push(entry)
    saveEvents()
}
// 兜底：按 "\n" 切行，逐行 parse_json，跳过空行/无效行。
// 旧版 demo 数据多为逐行 JSONL；新版写入是整体数组。
fn loadJsonlLines(path){
    if !fs.exists(path) { return nil }
    let text = fs.read(path)
    let whole = nil
    try { whole = text.parse_json() } catch _ { whole = nil }
    let whole_ok = false
    if whole != nil {
        let l = 0
        try { l = whole.len() } catch _ { l = 0 }
        if l > 0 { whole_ok = true }
    }
    if whole_ok { return whole }
    // 旧 JSONL 多行格式：text.index_of / text.slice 在 bytes-typed 上行为不一致，
    // 无法在脚本内逐行解析。用固定路径备份一次，后续启动不重复触发；
    // 原文件保留不覆盖，等待人工迁移。
    let backup = path + ".legacy.bak"
    let already_backed = fs.exists(backup)
    if !already_backed {
        let backup_ok = false
        try {
            fs.write(backup, text)
            backup_ok = true
        } catch _ {
            backup_ok = false
        }
        if backup_ok {
            STATE.status = "⚠ " + path + " 是旧 JSONL 多行格式；已备份至 " + backup
                         + "。原文件保留不覆盖；旧事件需人工迁移或放弃。"
        } else {
            STATE.status = "⚠ " + path + " 是旧 JSONL 多行格式；备份至 " + backup
                         + " 失败！原文件保留不覆盖，请人工处理。"
        }
    } else {
        STATE.status = "⚠ " + path + " 仍是旧 JSONL 多行格式；旧备份 " + backup
                     + " 存在，原文件保留不覆盖；旧事件需人工迁移或放弃。"
    }
    return nil
}
// 升级旧版伪 READY 演示证据：仅识别明确的演示占位标记
// （sha=="demo-sha" 或 name 以 "demo-" 开头）。
// **不**凭 bytes 大小判断——真实小附件也可能恰好 1024 字节。
fn scrubLegacyEvidence(){
    let touched = 0
    let ti = 0
    while ti < TASKS.len() {
        let t = TASKS[ti]
        let ei = 0
        let evid = t.evidence
        while ei < evid.len() {
            let e = evid[ei]
            let is_demo = false
            let esha = e.sha
            if esha == "demo-sha" { is_demo = true }
            let ename = e.name
            if ename.starts_with("demo-") { is_demo = true }
            if is_demo {
                if e.ready { touched = touched + 1 }
                e.ready = false
                e.demo = true
                e.bytes = 0
                e.sha = ""
                e.note = "迁移自旧版演示占位：宿主 picker 缺失，真实附件未落盘"
            }
            ei = ei + 1
        }
        ti = ti + 1
    }
    return touched
}
fn load(){
    if fs.exists("state.json") {
        let raw = fs.read("state.json").parse_json()
        if raw != nil { STATE = raw }
    }
    if fs.exists("tasks.json") {
        let raw = fs.read("tasks.json").parse_json()
        if raw != nil { TASKS = raw }
    }
    if fs.exists("actions.jsonl") {
        let raw = loadJsonlLines("actions.jsonl")
        if raw != nil { RECEIPTS = raw }
    }
    if fs.exists("events.jsonl") {
        let raw = loadJsonlLines("events.jsonl")
        if raw != nil {
            let l = raw.len()
            if l > 0 { EVENT_LOG = raw }
        }
        // raw == nil 时 loadJsonlLines 已经把旧 JSONL 备份到
        // events.jsonl.legacy.<ts>.bak，STATE.status 也已写入迁移提示；
        // 此处保留原文件（不被覆盖），等待人工恢复。
    }
    // 旧版伪 READY 演示证据迁移；触达则立刻写盘
    let migrated = scrubLegacyEvidence()
    if migrated > 0 {
        saveTasks()
    }
    // 把新格式 events/receipts 写盘（仅当 loadJsonlLines 返回非 nil 时）
    if fs.exists("events.jsonl") {
        let raw2 = loadJsonlLines("events.jsonl")
        if raw2 != nil { saveEvents() }
    }
    if fs.exists("actions.jsonl") {
        let raw2 = loadJsonlLines("actions.jsonl")
        if raw2 != nil { saveReceipts() }
    }
}

load()

// ─── 幂等 ───────────────────────────────────────────────
fn fingerprint(cmd, t, params){
    let base = {command: cmd, actor: STATE.actor, project: t.project, task: t.id, params: params}
    return base.to_json()
}
fn receiptFor(key, fp){
    for r in RECEIPTS {
        if r.actor == STATE.actor {
            if r.key == key {
                if r.fp == fp { return {kind: "hit", receipt: r} }
                return {kind: "conflict", receipt: r}
            }
        }
    }
    return {kind: "miss"}
}
fn recordReceipt(key, cmd, t, fp, result){
    RECEIPTS.push({action_id: newId(), key: key, actor: STATE.actor, command: cmd,
                   task_id: t.id, fp: fp, at: nowMs(), result: result})
    saveReceipts()
}

// ─── 命令边界与辅助 ─────────────────────────────────────
fn fail(msg){
    STATE.status = "拒绝：" + msg
    saveState()
}
fn currentTask(){
    if STATE.selectedIdx < 0 { return nil }
    if STATE.selectedIdx >= TASKS.len() { return nil }
    return TASKS[STATE.selectedIdx]
}
// 当前主体可见的任务下标列表。演示身份切换后必须按可见性过滤，
// 否则「报修人二」会看到「报修人一」的草稿；这只是前端展示过滤，
// 不等于宿主授权隔离，仍由宿主做最终访问控制。
fn visibleIndices(){
    let u = getMe()
    let out = []
    for i in 0..TASKS.len() {
        if visible(TASKS[i], u) { out.push(i) }
    }
    return out
}
fn firstVisibleIdx(){
    let idxs = visibleIndices()
    if idxs.len() == 0 { return -1 }
    return idxs[0]
}
fn stepVisible(from, dir){
    let idxs = visibleIndices()
    if idxs.len() == 0 { return -1 }
    let pos = -1
    for k in 0..idxs.len() {
        if idxs[k] == from { pos = k; break }
    }
    if pos < 0 { return idxs[0] }
    let np = pos + dir
    if np < 0 { return idxs[0] }
    if np >= idxs.len() { return idxs[idxs.len() - 1] }
    return idxs[np]
}
fn commit(t){
    t.version = t.version + 1
    t.updatedAtMs = nowMs()
    saveTasks()
}


// ─── 命令 ───────────────────────────────────────────────
fn createDraft(){
    let t = {id: newId(), project: STATE.project, space: "sp-a-1", category: "HVAC_NOT_COOLING",
             problem: "东侧会议室空调不制冷，希望今天下午处理", contact: "报修人一",
             contactInfo: "渠道：工作台", reporter: STATE.actor, assignee: nil, asset: "",
             status: S_DRAFT, version: 0, appointments: [], evidence: [], completions: [],
             notes: [], pinnedBy: [], createdAtMs: nowMs(), updatedAtMs: nowMs()}
    TASKS.push(t)
    STATE.selectedIdx = TASKS.len() - 1
    LAST_KEY = newId()
    let fp = fingerprint("createDraft", t, {problem: t.problem})
    recordReceipt(LAST_KEY, "createDraft", t, fp, {task_id: t.id, status: t.status})
    logEvent("create_draft", t, {status: t.status, task_id: t.id})
    STATE.status = "草稿已创建 " + t.id
    saveState()
    saveTasks()
    refreshLabels(t)
}

fn runCommand(cmd, t, params, result){
    let u = getMe()
    if !visible(t, u) { fail("任务不在当前主体可见范围内"); return false }
    if !sourceOk(cmd, t) { fail("命令 " + cmd + " 不允许从 " + t.status + " 执行"); return false }
    if LAST_KEY == "" { fail("缺少幂等键"); return false }
    let fp = fingerprint(cmd, t, params)
    let found = receiptFor(LAST_KEY, fp)
    if found.kind == "hit" {
        // 幂等命中：直接返回原 action_id，不重做 commit/event/version++
        STATE.status = "幂等命中：" + cmd + " → action_id " + found.receipt.action_id
        saveState()
        return false
    }
    if found.kind == "conflict" {
        fail("同 key 不同 payload 冲突：原命令已记录（" + cmd + "）")
        return false
    }
    recordReceipt(LAST_KEY, cmd, t, fp, result)
    return true
}

fn confirmDraft(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if !isReporter(t, u) { fail("只有原报修人能提交草稿"); return }
    if t.space == "" { fail("提交前必须确认服务空间（草稿已保留）"); return }
    if t.contact == "" { fail("提交前必须填写报修联系人（草稿已保留）"); return }
    LAST_KEY = newId()
    if !runCommand("confirmDraft", t, {task_id: t.id}, {status: S_OPEN}) { return }
    t.status = S_OPEN
    commit(t)
    logEvent("confirm_draft", t, {status: S_OPEN, task_id: t.id})
    STATE.status = "已提交报修 → OPEN"
    saveState()
    refreshLabels(t)
}

fn acceptTask(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if !hasRole(u, t.project, "TECHNICIAN") { fail("经理没有技工角色不得自主接单"); return }
    if !skillOk(u, t.category) { fail("技能与任务类别不匹配：" + t.category); return }
    LAST_KEY = newId()
    if !runCommand("acceptTask", t, {task_id: t.id}, {status: S_ACCEPTED}) { return }
    t.assignee = STATE.actor
    t.status = S_ACCEPTED
    commit(t)
    logEvent("accept_task", t, {status: S_ACCEPTED, assignee: t.assignee, task_id: t.id})
    STATE.status = "已接单 → ACCEPTED（" + STATE.actor + "）"
    saveState()
    refreshLabels(t)
}

fn assignTask(techId){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if !isManager(t, getMe()) { fail("只有项目经理能分配"); return }
    let target = pickUser(USERS, techId)
    if target == nil { fail("分配对象不存在"); return }
    if !hasRole(target, t.project, "TECHNICIAN") { fail("分配对象不是本项目有效技工"); return }
    if !skillOk(target, t.category) { fail("分配对象技能不匹配：" + t.category); return }
    LAST_KEY = newId()
    if !runCommand("assignTask", t, {task_id: t.id, assignee: techId, reason: "经理分配"},
                   {status: S_ACCEPTED}) { return }
    t.assignee = techId
    t.status = S_ACCEPTED
    commit(t)
    logEvent("assign_task", t, {status: S_ACCEPTED, assignee: techId, reason: "经理分配",
                                operator: STATE.actor, task_id: t.id})
    STATE.status = "已分配给 " + techId + "（经理分配）"
    saveState()
    refreshLabels(t)
}

fn bindAsset(assetId){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let a = pickUser(ASSETS, assetId)
    if a == nil { fail("设备不存在"); return }
    if !a.active { fail("设备已归档，不能新绑定"); return }
    if a.project != t.project { fail("设备不属于本项目"); return }
    if t.space == "" { fail("绑定前必须已确认服务空间"); return }
    if !services(a.id, t.space) { fail("设备不服务该空间；安装位置相同不算服务关系"); return }
    let u = getMe()
    let reason = ""
    if t.status == S_DRAFT {
        if !isReporter(t, u) { fail("草稿阶段只能原报修人选择设备"); return }
    }
    if t.status == S_IN_PROGRESS {
        if !isManager(t, u) { fail("维修中换设备只能同项目经理执行"); return }
        reason = "经理更正设备（" + t.asset + " → " + a.id + "）"
    }
    if t.status == S_OPEN || t.status == S_ACCEPTED || t.status == S_SCHEDULED {
        if !isReporter(t, u) {
            if !isAssignee(t, u) {
                if !isManager(t, u) { fail("只有报修人、当前承接者或经理能绑定设备"); return }
            }
        }
    }
    let old = t.asset
    LAST_KEY = newId()
    if !runCommand("bindAsset", t, {task_id: t.id, asset_id: a.id, reason: reason},
                   {asset_id: a.id}) { return }
    t.asset = a.id
    commit(t)
    logEvent("bind_asset", t, {asset_id: a.id, previous_asset_id: old, reason: reason,
                               operator: STATE.actor, task_id: t.id})
    STATE.status = "已绑定 " + a.code
    saveState()
    refreshLabels(t)
}

fn unbindAsset(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if t.status == S_IN_PROGRESS {
        if !isManager(t, u) { fail("维修中只能经理解绑"); return }
    }
    if !isReporter(t, u) {
        if !isAssignee(t, u) {
            if !isManager(t, u) { fail("只有报修人、当前承接者或经理能解绑"); return }
        }
    }
    let old = t.asset
    LAST_KEY = newId()
    if !runCommand("unbindAsset", t, {task_id: t.id, reason: "解除绑定"}, {asset_id: ""}) { return }
    t.asset = ""
    commit(t)
    logEvent("unbind_asset", t, {previous_asset_id: old, reason: "解除绑定",
                                 operator: STATE.actor, task_id: t.id})
    STATE.status = "已解绑设备"
    saveState()
    refreshLabels(t)
}

fn proposeAppointment(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if !hasRole(u, t.project, "TECHNICIAN") { fail("没有技工角色不能提议预约"); return }
    if t.assignee == nil { fail("任务尚未承接"); return }
    if t.assignee != u.id {
        if !isManager(t, u) { fail("只有当前承接者（或代行的经理）能提议"); return }
    }
    let start = nowMs() + 10000.0
    let end = start + 1800000.0
    if end - start < MIN_MS { fail("预约时长不得短于 15 分钟"); return }
    if end - start > MAX_MS { fail("预约时长不得超过 240 分钟"); return }
    if start > nowMs() + LEAD_MS { fail("预约开始不得晚于 30 天后"); return }
    let tech = t.assignee
    for other in TASKS {
        if other.id == t.id { continue }
        let c = apptOf(other, A_CONFIRMED)
        if c == nil { continue }
        if c.tech == tech {
            if c.startMs < end {
                if c.endMs > start { fail("该技工在其它任务上已有冲突的确认预约"); return }
            }
        }
    }
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED }
    }
    LAST_KEY = newId()
    if !runCommand("proposeAppointment", t,
                   {task_id: t.id, start_at_ms: start, end_at_ms: end},
                   {status: t.status}) { return }
    t.appointments.push({id: newId(), tech: tech, startMs: start, endMs: end,
                         status: A_PROPOSED, proposedBy: u.id, confirmedBy: "", reason: "",
                         createdMs: nowMs()})
    commit(t)
    logEvent("propose_appointment", t, {task_status: t.status, appt_status: A_PROPOSED,
                                        proposed_by: u.id, task_id: t.id})
    STATE.status = "已提议预约；仍为 " + t.status + "，等报修人确认"
    saveState()
    refreshLabels(t)
}

fn confirmAppointment(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if !isReporter(t, getMe()) { fail("只有原报修人能确认预约（P0 经理不代确认）"); return }
    let appt = apptOf(t, A_PROPOSED)
    if appt == nil { fail("没有待确认的提议"); return }
    let now = nowMs()
    let valid = PROPOSAL_MS
    if appt.startMs - appt.createdMs < valid { valid = appt.startMs - appt.createdMs }
    if now > appt.createdMs + valid { fail("提议已过期，请让技工重新提议"); return }
    if now >= appt.endMs { fail("提议时段已结束"); return }
    let tech = appt.tech
    for other in TASKS {
        if other.id == t.id { continue }
        let c = apptOf(other, A_CONFIRMED)
        if c == nil { continue }
        if c.tech == tech {
            if c.startMs < appt.endMs {
                if c.endMs > appt.startMs { fail("该技工在其它任务上时间冲突"); return }
            }
        }
    }
    LAST_KEY = newId()
    if !runCommand("confirmAppointment", t,
                   {task_id: t.id, appointment_id: appt.id}, {status: A_CONFIRMED}) { return }
    for a in t.appointments {
        if a.status == A_CONFIRMED { a.status = A_SUPERSEDED }
    }
    appt.status = A_CONFIRMED
    appt.confirmedBy = STATE.actor
    t.status = S_SCHEDULED
    commit(t)
    logEvent("confirm_appointment", t, {appointment_status: A_CONFIRMED, task_status: S_SCHEDULED,
                                        confirmed_by: STATE.actor, appointment_id: appt.id,
                                        task_id: t.id})
    STATE.status = "预约已确认 → SCHEDULED"
    saveState()
    refreshLabels(t)
}

fn rejectAppointment(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if !isReporter(t, getMe()) { fail("只有原报修人能拒绝预约"); return }
    let appt = apptOf(t, A_PROPOSED)
    if appt == nil { fail("没有可拒绝的提议"); return }
    LAST_KEY = newId()
    if !runCommand("rejectAppointment", t, {task_id: t.id, reason: "时间不合适"},
                   {status: t.status}) { return }
    appt.status = A_SUPERSEDED
    appt.reason = "时间不合适"
    let kept = apptOf(t, A_CONFIRMED)
    if kept != nil { t.status = S_SCHEDULED } else { t.status = S_ACCEPTED }
    commit(t)
    logEvent("reject_appointment", t, {status: t.status, reason: "时间不合适",
                                       kept_confirmed: kept != nil, task_id: t.id})
    if kept == nil {
        STATE.status = "已拒绝提议；无已确认预约，回到 ACCEPTED"
    } else {
        STATE.status = "已拒绝提议；旧确认仍有效，保持 SCHEDULED"
    }
    saveState()
    refreshLabels(t)
}

fn startProgress(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if !isAssignee(t, getMe()) { fail("只有当前承接者能开工"); return }
    if t.asset == "" { fail("开工前必须绑定有效设备"); return }
    let appt = apptOf(t, A_CONFIRMED)
    if appt == nil { fail("开工前必须存在已确认预约"); return }
    if appt.tech != STATE.actor { fail("确认预约属于其它技工"); return }
    let now = nowMs()
    if now < appt.startMs { fail("还没到预约开始时间"); return }
    if now >= appt.endMs { fail("预约已超时，需重新预约后才能开工"); return }
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED }
    }
    LAST_KEY = newId()
    if !runCommand("startProgress", t, {task_id: t.id}, {status: S_IN_PROGRESS}) { return }
    t.status = S_IN_PROGRESS
    commit(t)
    logEvent("start_progress", t, {status: S_IN_PROGRESS, appointment_id: appt.id,
                                   task_id: t.id})
    STATE.status = "已开工 → IN_PROGRESS"
    saveState()
    refreshLabels(t)
}

fn recordProgress(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if !isAssignee(t, getMe()) { fail("只有当前承接者能记录处置"); return }
    LAST_KEY = newId()
    if !runCommand("recordProgress", t, {task_id: t.id, kind: "INSPECTION",
                                         note: "到场检查压缩机与滤网"}, {note: "已记录"}) { return }
    t.notes.push({kind: "INSPECTION", note: "到场检查压缩机与滤网", by: STATE.actor, at: nowMs()})
    commit(t)
    logEvent("record_progress", t, {kind: "INSPECTION", operator: STATE.actor, task_id: t.id})
    STATE.status = "已记录处置：INSPECTION"
    saveState()
    refreshLabels(t)
}

fn addEvidence(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if !isReporter(t, u) {
        if !isAssignee(t, u) {
            if !isManager(t, u) { fail("只有任务参与者能上传证据"); return }
        }
    }
    if readyCount(t) >= 10 { fail("单任务最多 10 件证据"); return }
    let id = newId()
    // 真实附件 picker 与隔离存储读字节 API 暂不可用：
    // 只登记元数据，bytes=0 / sha="" / ready=false；不写入证据闭环门槛。
    // 后续若宿主补齐 picker，替换此 push 体即可，无需改动 submitCompletion。
    t.evidence.push({id: id, name: "demo-" + id + ".bin", bytes: 0,
                     sha: "", ready: false, demo: true, by: STATE.actor,
                     at: nowMs(),
                     note: "演示条目：宿主 picker / 隔离存储读字节 API 缺失，未真实落盘"})
    commit(t)
    logEvent("upload_evidence", t, {evidence_id: id, ready: false, demo: true,
                                     task_id: t.id, reason: "host_picker_missing"})
    STATE.status = "证据条目登记但未 READY（宿主无文件 picker，需真实附件才能完工）：" + id
    saveState()
    refreshLabels(t)
}

fn quarantineEvidence(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if !isReporter(t, u) {
        if !isManager(t, u) { fail("只有报修人或经理能隔离证据"); return }
    }
    let n = t.evidence.len() - 1
    if n < 0 { fail("没有可隔离的证据"); return }
    let ev = t.evidence[n]
    ev.ready = false
    commit(t)
    logEvent("quarantine_evidence", t, {evidence_id: ev.id, status: "QUARANTINED",
                                        reason: "证据不可读", task_id: t.id})
    STATE.status = "已隔离证据 " + ev.id + "；完工前需重新上传"
    saveState()
    refreshLabels(t)
}

fn submitCompletion(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if !isAssignee(t, getMe()) { fail("只有当前承接者能提交完工"); return }
    if readyCount(t) < 1 {
        fail("完工前必须至少有一份可读证据；请先上传或解除隔离")
        return
    }
    let round = t.completions.len() + 1
    let cid = newId()
    let text = "已更换压缩机并清理现场"
    LAST_KEY = newId()
    if !runCommand("submitCompletion", t, {task_id: t.id, completion_text: text},
                   {status: S_AWAITING}) { return }
    t.completions.push({id: cid, round: round, by: STATE.actor, text: text,
                        disposition: "REPAIRED", at: nowMs()})
    t.status = S_AWAITING
    commit(t)
    logEvent("submit_completion", t, {completion_id: cid, round: round,
                                      completion_text: text, task_status: S_AWAITING,
                                      task_id: t.id})
    STATE.status = "完工已提交（round " + round.to_string() + "）→ AWAITING_ACCEPTANCE"
    saveState()
    refreshLabels(t)
}

fn acceptCompletion(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if t.assignee == u.id { fail("承接者不能自验，需由报修人或经理验收"); return }
    if !isReporter(t, u) {
        if !isManager(t, u) { fail("只有原报修人或同项目经理能验收"); return }
    }
    let n = t.completions.len() - 1
    if n < 0 { fail("没有可验收的完工记录"); return }
    let last = t.completions[n]
    let reason = ""
    if isManager(t, u) {
        if !isReporter(t, u) { reason = "代报修人确认" }
    }
    LAST_KEY = newId()
    if !runCommand("acceptCompletion", t, {task_id: t.id, reason: reason},
                   {status: S_COMPLETED}) { return }
    t.status = S_COMPLETED
    commit(t)
    logEvent("accept_completion", t, {status: S_COMPLETED, accepted_round: last.round,
                                      reason: reason, operator: STATE.actor, task_id: t.id})
    STATE.status = "已验收 → COMPLETED（round " + last.round.to_string() + "）"
    saveState()
    refreshLabels(t)
}

fn rejectCompletion(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    if t.assignee == u.id { fail("承接者不能退回自己的完工"); return }
    if !isReporter(t, u) {
        if !isManager(t, u) { fail("只有原报修人或同项目经理能退回"); return }
    }
    let n = t.completions.len() - 1
    if n < 0 { fail("没有可退回的完工记录"); return }
    let last = t.completions[n]
    LAST_KEY = newId()
    if !runCommand("rejectCompletion", t, {task_id: t.id, reason: "需要补充处理"},
                   {status: S_IN_PROGRESS}) { return }
    t.status = S_IN_PROGRESS
    commit(t)
    logEvent("reject_completion", t, {status: S_IN_PROGRESS, rejected_round: last.round,
                                      reason: "需要补充处理", operator: STATE.actor,
                                      task_id: t.id})
    STATE.status = "已退回 → IN_PROGRESS（round " + last.round.to_string() + "）"
    saveState()
    refreshLabels(t)
}

fn cancelTask(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    let permitted = false
    if isManager(t, u) { permitted = true }
    if isReporter(t, u) {
        if t.status == S_DRAFT { permitted = true }
        if t.status == S_OPEN { permitted = true }
    }
    if !permitted { fail("报修人只能取消自己的 DRAFT/OPEN；其它阶段需经理"); return }
    LAST_KEY = newId()
    if !runCommand("cancel", t, {task_id: t.id, reason: "用户取消"},
                   {status: S_CANCELLED}) { return }
    t.status = S_CANCELLED
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED }
        if a.status == A_CONFIRMED { a.status = A_SUPERSEDED }
    }
    commit(t)
    logEvent("cancel", t, {status: S_CANCELLED, reason: "用户取消", operator: STATE.actor,
                           task_id: t.id})
    STATE.status = "已取消 → CANCELLED"
    saveState()
    refreshLabels(t)
}

fn reassign(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    if !isManager(t, getMe()) { fail("只有项目经理能改派"); return }
    let target = nil
    if t.assignee == "u-tech-1" { target = pickUser(USERS, "u-tech-2") }
    if t.assignee != "u-tech-1" { target = pickUser(USERS, "u-tech-1") }
    if target == nil { fail("改派对象不存在"); return }
    if !hasRole(target, t.project, "TECHNICIAN") { fail("改派对象不是本项目有效技工"); return }
    if !skillOk(target, t.category) { fail("改派对象技能不匹配：" + t.category); return }
    LAST_KEY = newId()
    if !runCommand("reassign", t, {task_id: t.id, assignee: target.id, reason: "原技工请假"},
                   {status: S_ACCEPTED}) { return }
    for a in t.appointments {
        if a.status == A_PROPOSED { a.status = A_SUPERSEDED }
        if a.status == A_CONFIRMED { a.status = A_SUPERSEDED }
    }
    t.assignee = target.id
    t.status = S_ACCEPTED
    commit(t)
    logEvent("reassign", t, {assignee: target.id, reason: "原技工请假",
                             operator: STATE.actor, task_id: t.id})
    STATE.status = "已改派给 " + target.id + "（任务回 ACCEPTED）"
    saveState()
    refreshLabels(t)
}

fn togglePin(){
    let t = currentTask()
    if t == nil { fail("无选中任务"); return }
    let u = getMe()
    let found = false
    for p in t.pinnedBy {
        if p == u.id { found = true }
    }
    if found {
        let kept = []
        for p in t.pinnedBy {
            if p != u.id { kept.push(p) }
        }
        t.pinnedBy = kept
        STATE.status = "已取消收藏"
    } else {
        t.pinnedBy.push(u.id)
        STATE.status = "已收藏（应用首页排序，不宣称系统级置顶窗口）"
    }
    commit(t)
    saveState()
    refreshLabels(t)
}


// ─── 视图辅助 ──────────────────────────────────────────
fn whoLabel(t){
    if t == nil { return "未指派" }
    if t.assignee == nil { return "未指派" }
    return t.assignee
}
fn apptLine(t){
    if t == nil { return "无预约" }
    let c = apptOf(t, A_CONFIRMED)
    if c != nil { return "已确认预约" }
    let p = apptOf(t, A_PROPOSED)
    if p != nil { return "待确认预约" }
    return "无预约"
}
fn statusLine(t){
    if t == nil { return "无选中任务" }
    let dev = "未绑定"
    if t.asset != "" { dev = t.asset }
    return t.id + " · " + t.status + " · 承接 " + whoLabel(t) + " · 设备 " + dev + " · " + apptLine(t)
}
fn detailLine(){
    let t = currentTask()
    if t == nil { return "联系方式：（未选中任务）· 证据 0 件 · 完工轮次 0" }
    let contact = "联系方式：（接单前隐藏）"
    if canSeeContact(t, getMe()) { contact = "联系方式：" + t.contactInfo }
    return contact + " · 证据 " + readyCount(t).to_string()
           + " 件 · 完工轮次 " + t.completions.len().to_string()
}
fn factsLine(){
    return "任务 " + TASKS.len().to_string() + " 条 · 事件 " + EVENT_LOG.len().to_string()
           + " 条（events.jsonl）· 回执 " + RECEIPTS.len().to_string() + " 条（actions.jsonl）"
}

// 在 click handler 闭包内调用：把当前任务卡 / 状态条 / 事实条刷新到最新。
// 不能依赖 fn tick：tick 在另一 isolate 中读取 STATE/TASKS 等全局会读到陈旧值，
// 覆盖 click 刚写入的 label 文本。
fn refreshLabels(taskToShow){
    let s = taskToShow
    if s == nil { s = currentTask() }
    let visibleCount = visibleIndices().len()
    if s == nil {
        ui.task_status.set_text("无可见任务（" + STATE.actor + "）")
        ui.task_detail.set_text("当前主体无可见任务 · 共 " + visibleCount.to_string() + " 条可见")
    } else {
        if !visible(s, getMe()) {
            ui.task_status.set_text("当前任务不在 " + STATE.actor + " 可见范围")
            ui.task_detail.set_text("请切换身份或选其它任务 · 共 " + visibleCount.to_string() + " 条可见")
        } else {
            let dev = "未绑定"
            if s.asset != "" { dev = s.asset }
            ui.task_status.set_text(s.id + " · " + s.status + " · 承接 " + whoLabel(s) + " · 设备 " + dev + " · " + apptLine(s))
            let contact = "联系方式：（接单前隐藏）"
            if canSeeContact(s, getMe()) { contact = "联系方式：" + s.contactInfo }
            ui.task_detail.set_text(contact + " · 证据 " + readyCount(s).to_string() + " 件 · 完工轮次 " + s.completions.len().to_string())
        }
    }
    ui.status_line.set_text("📍 " + STATE.status)
    ui.facts_line.set_text("任务 " + TASKS.len().to_string() + " 条（可见 " + visibleCount.to_string()
                          + "）· 事件 " + EVENT_LOG.len().to_string()
                          + " 条（events.jsonl）· 回执 " + RECEIPTS.len().to_string() + " 条（actions.jsonl）")
}

fn runAction(cmd){
    if cmd == "confirmDraft" { confirmDraft(); return }
    if cmd == "acceptTask" { acceptTask(); return }
    if cmd == "assignTask" { assignTask("u-tech-1"); return }
    if cmd == "bindAsset" { bindAsset("as-a-1"); return }
    if cmd == "unbindAsset" { unbindAsset(); return }
    if cmd == "proposeAppointment" { proposeAppointment(); return }
    if cmd == "confirmAppointment" { confirmAppointment(); return }
    if cmd == "rejectAppointment" { rejectAppointment(); return }
    if cmd == "startProgress" { startProgress(); return }
    if cmd == "recordProgress" { recordProgress(); return }
    if cmd == "submitCompletion" { submitCompletion(); return }
    if cmd == "acceptCompletion" { acceptCompletion(); return }
    if cmd == "rejectCompletion" { rejectCompletion(); return }
    if cmd == "cancel" { cancelTask(); return }
    if cmd == "reassign" { reassign(); return }
    if cmd == "pin" { togglePin(); return }
    fail("未知动作 " + cmd)
}

fn setActor(id){
    STATE.actor = id
    STATE.selectedIdx = firstVisibleIdx()
    STATE.status = "当前身份：" + id + "（演示切换；真实授权由宿主身份提供）"
    saveState()
    refreshLabels(nil)
}
fn prevTask(){
    STATE.selectedIdx = stepVisible(STATE.selectedIdx, -1)
    saveState()
    refreshLabels(nil)
}
fn nextTask(){
    STATE.selectedIdx = stepVisible(STATE.selectedIdx, 1)
    saveState()
    refreshLabels(nil)
}

// ─── 视图 ───────────────────────────────────────────────
// 固定版本 card-host 实测：ScrollYView 会把未实例化的子节点置 0×0，
// 所以此处用单页紧凑布局，全部动作按钮 412×819 内可见。
let Bar = ButtonFlat{height: 44 padding: Inset{left: 6 right: 6}
    draw_bg +: {color: secondarySurface color_hover: #x3D5759 color_down: #x1c2d2e border_size: 0.0 border_radius: 7.0}
    draw_text +: {color: ink color_hover: accent color_down: secondary}
    draw_text.text_style.font_size: 10 draw_text.text_style.font_weight: 500}
let Acc = ButtonFlat{height: 50 padding: Inset{left: 6 right: 6}
    draw_bg +: {color: accent color_hover: #x94DEC0 color_down: #x6BCC9F border_size: 0.0 border_radius: 8.0}
    draw_text +: {color: accentText color_hover: accentText color_down: accentText}
    draw_text.text_style.font_size: 11 draw_text.text_style.font_weight: 600}
let Danger = ButtonFlat{height: 44 padding: Inset{left: 6 right: 6}
    draw_bg +: {color: #x3A2A2C color_hover: #x4A3539 color_down: #x2a1d20 border_size: 0.0 border_radius: 7.0}
    draw_text +: {color: danger color_hover: danger color_down: secondary}
    draw_text.text_style.font_size: 10 draw_text.text_style.font_weight: 500}
let Chip = ButtonFlat{height: 34 padding: Inset{left: 6 right: 6}
    draw_bg +: {color: heroBg color_hover: #x2D484A color_down: #x1c2d2e border_size: 0.0 border_radius: 17.0}
    draw_text +: {color: ink color_hover: accent color_down: secondary}
    draw_text.text_style.font_size: 10}

SolidView{width: Fill height: Fill flow: Down spacing: 0 draw_bg.color: #x0F1819

    // ════ 顶部：标题 + 身份切换 ════
    View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{top: 14 bottom: 10 left: 16 right: 16}
            draw_bg.color: #x1A2C2E
        Label{width: Fill text: "维修协作" draw_text.color: ink draw_text.text_style.font_size: 20 draw_text.text_style.font_weight: 700}
        Label{width: Fill text: "OctoSense Repair · 持久应用" draw_text.color: secondary draw_text.text_style.font_size: 9}
        View{width: Fill height: Fit flow: Right spacing: 4
            Chip{text: "报修人一"  on_click: || setActor("u-reporter-1")}
            Chip{text: "报修人二"  on_click: || setActor("u-reporter-2")}
            Chip{text: "技工甲"    on_click: || setActor("u-tech-1")}
            Chip{text: "技工乙"    on_click: || setActor("u-tech-2")}
            Chip{text: "经理丙"    on_click: || setActor("u-manager")}
        }
    }

    // ════ 当前任务卡（命名 Label，可被 set_text 更新）═══
    View{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{top: 10 bottom: 8 left: 16 right: 16}
            draw_bg.color: surface draw_bg.border_radius: 10.0
        Label{width: Fill text: "📋 当前任务" draw_text.color: accent draw_text.text_style.font_size: 10 draw_text.text_style.font_weight: 600}
        task_status := Label{width: Fill text: statusLine(currentTask()) max_lines: 2
            draw_text.color: ink draw_text.text_style.font_size: 11 draw_text.text_style.font_weight: 500}
        task_detail := Label{width: Fill text: detailLine() max_lines: 2
            draw_text.color: secondary draw_text.text_style.font_size: 10}
        View{width: Fill height: Fit flow: Right spacing: 4
            Bar{text: "◀ 上一条" on_click: || prevTask()}
            Bar{text: "下一条 ▶" on_click: || nextTask()}
            Bar{text: "☆ 收藏" on_click: || togglePin()}
        }
    }

    // ════ 步骤区（极致紧凑，全部按钮单页可见）════
    View{width: Fill height: Fill flow: Down spacing: 2 padding: Inset{top: 2 bottom: 2 left: 12 right: 12}
        Acc{text: "＋ 新建报修草稿" on_click: || createDraft()}
        View{width: Fill height: Fit flow: Right spacing: 4
            Acc{text: "提交 OPEN" on_click: || runAction("confirmDraft")}
            Acc{text: "技工接单" on_click: || runAction("acceptTask")}
            Bar{text: "经理改派" on_click: || runAction("assignTask")}
            Bar{text: "绑定设备" on_click: || runAction("bindAsset")}
        }
        View{width: Fill height: Fit flow: Right spacing: 4
            Bar{text: "解绑设备" on_click: || runAction("unbindAsset")}
            Acc{text: "提议预约" on_click: || runAction("proposeAppointment")}
            Acc{text: "确认 SCH" on_click: || runAction("confirmAppointment")}
            Danger{text: "拒绝预约" on_click: || runAction("rejectAppointment")}
        }
        View{width: Fill height: Fit flow: Right spacing: 4
            Acc{text: "开工" on_click: || runAction("startProgress")}
            Bar{text: "记录处置" on_click: || runAction("recordProgress")}
            Bar{text: "上传证据" on_click: || addEvidence()}
            Bar{text: "隔离证据" on_click: || quarantineEvidence()}
        }
        View{width: Fill height: Fit flow: Right spacing: 4
            Acc{text: "提交完工" on_click: || runAction("submitCompletion")}
            Acc{text: "验收" on_click: || runAction("acceptCompletion")}
            Danger{text: "退回重做" on_click: || runAction("rejectCompletion")}
        }
        View{width: Fill height: Fit flow: Right spacing: 4
            Danger{text: "取消任务" on_click: || runAction("cancel")}
            Bar{text: "改派" on_click: || runAction("reassign")}
        }
    }

    // ════ 状态条（命名 Label）═══
    View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{top: 6 bottom: 12 left: 16 right: 16}
            draw_bg.color: #x0A1112
        status_line := Label{width: Fill text: "📍 " + STATE.status max_lines: 3
            draw_text.color: ink draw_text.text_style.font_size: 11}
        facts_line := Label{width: Fill text: factsLine() max_lines: 2
            draw_text.color: secondary draw_text.text_style.font_size: 10}
    }
}

// ─── 周期性重算：1Hz 自动重绘命名 Label ───────────────
// 固定版本 card-host 不对数据写做触发重排；通过 fn tick 让状态条
// 在每秒钟自动调用 set_text，达到「数据变化、屏幕跟着变」的效果。
fn tick(){
    // tick 不覆盖 task_status / task_detail（这两个由 click handler 通过 refreshLabels 管理），
    // 只刷新 status_line 和 facts_line。tick 在另一 isolate 中读取 STATE/TASKS，
    // 覆盖 task_status 会读到陈旧值。
    ui.status_line.set_text("📍 " + STATE.status)
    ui.facts_line.set_text("任务 " + TASKS.len().to_string() + " 条 · 事件 " + EVENT_LOG.len().to_string()
                          + " 条（events.jsonl）· 回执 " + RECEIPTS.len().to_string() + " 条（actions.jsonl）")
}
