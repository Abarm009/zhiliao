let secondary = #x6E6E73
let accent = #x007AFF
let accentText = #xFFFFFF
let border = #xE5E5EA
let danger = #x1D1D1F
let accentHover = #x006EE6
let accentDown = #x005FCC
let heroBg = #xF0F0F2

